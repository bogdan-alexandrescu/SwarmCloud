+          ['Pinned', <span className="mpc-pin">
+            {p.commit && <span>commit <code>{p.commit.slice(0, 12)}</code></span>}
+            <span>sha256 <code title={p.digest}>{short(p.digest)}</code></span>
+          </span>],
+          ['Installed', <>{p.installedBy} · {day(p.installedAt)}</>],
+          ['Runs on', <>{p.profiles.map((r) => <Chip key={r}>{r}</Chip>)}</>],
+          ...((p.needs.node || p.needs.hosts.length > 0) ? [['Needs', <>{p.needs.node && <Chip>node {p.needs.node}</Chip>}{p.needs.hosts.map((h) => <Chip key={h}>net: {h}</Chip>)}</>] as [string, ReactNode]] : []),
+        ]} />
+      </aside>
+    </div>
+  )
+}
+
+function SettingsTab({ p, member, stored }: { p: Plugin; member: boolean; stored: boolean }) {
+  if (member) {
+    return (
+      <section className="mpc-panel">
+        <Tick tip="Settings are set by an Engineering admin. Secrets are never shown.">View only</Tick>
+      </section>
+    )
+  }
+  return (
+    <>
+      <section className="mpc-panel" aria-labelledby="mpc-st-h">
+        <header className="mpc-panel-h">
+          <h2 id="mpc-st-h">{p.userConfig.length > 0 ? 'From userConfig' : 'Declared'} <em>{p.userConfig.length > 0 ? p.userConfig.length : 5}</em></h2>
+          <InfoTip about="settings" tip={p.userConfig.length > 0
+            ? 'Built from the plugin’s plugin.json userConfig. Set once for Engineering; a step may override a non-secret one.'
+            : 'This plugin declares no userConfig: these are the environment variables and files Engineering gives it.'} />
+          <span className="mpc-dim mpc-small mpc-push">Saved by owner@example.com · 6 Nov 2026, 02:04</span>
+        </header>
+        {p.userConfig.length > 0 ? <UserConfigForm p={p} target="workspace" stored={stored} /> : <DeclaredSettings inPlace />}
+      </section>
+      <div className="mpc-installbar">
+        <span className="mpc-small">{p.userConfig.length > 0 ? 'Threshold 0.7 → 0.75' : '.jev/rules.md: 1 line changed'} · from the next submission</span>
+        <span className="mpc-acts"><Button kind="ghost">Discard</Button><Button kind="primary">Save</Button></span>
+      </div>
+    </>
+  )
+}
+
+function Versions({ p, where }: { p: Plugin; where: 'admin' | 'workspace' }) {
+  const rows = p.name === 'jev-belay'
+    ? [
+      { v: '0.3.0', commit: '2b81f04', at: '2026-11-06T03:10:00Z', state: 'new' as const },
+      { v: '0.2.0', commit: '9f3c2e1', at: '2026-11-06T01:42:00Z', state: 'pinned' as const, who: 'owner@example.com' },
+      { v: '0.1.4', commit: '51ad0e7', at: '2026-10-29T16:20:00Z', state: 'old' as const, who: 'owner@example.com' },
+    ]
+    : [{ v: p.version, commit: p.commit?.slice(0, 7) ?? short(p.digest).slice(0, 7), at: p.installedAt, state: 'pinned' as const, who: p.installedBy }]
+  return (
+    <section className="mpc-panel" aria-labelledby="mpc-vr-h">
+      <header className="mpc-panel-h"><h2 id="mpc-vr-h">Versions</h2>
+        {p.scope !== 'builtin' && <Button size="sm" kind="ghost">Check for a new version</Button>}
+      </header>
+      <ul className="mpc-vers" role="list">
+        {rows.map((r) => (
+          <li key={r.v} className={`mpc-ver is-${r.state}`}>
+            <code className="mpc-ver-v">{r.v}</code>
+            <span className="mpc-small mpc-dim">commit <code>{r.commit}</code></span>
+            <span className="mpc-small mpc-dim">{r.state === 'new' ? `Tagged ${day(r.at)}` : `${r.who} · ${day(r.at)}`}</span>
+            <span className="mpc-ver-s">
+              {r.state === 'pinned' && <span className="mpc-scope is-pinned">Pinned</span>}
+              {r.state === 'new' && <><span className="mpc-scope is-new">New</span><a className="c-btn is-primary is-sm" href={href(where, { s: 'update', p: p.name })}>Review the update</a></>}
+              {r.state === 'old' && <Button size="sm" kind="ghost">Go back to 0.1.4</Button>}
+            </span>
+          </li>
+        ))}
+      </ul>
+    </section>
+  )
+}
+
+function Usage({ p, where }: { p: Plugin; where: 'admin' | 'workspace' }) {
+  const rows = p.name === 'jev-belay'
+    ? [
+      { ws: 'Engineering', wf: 'nightly-review', steps: ['review', 'fix', 'verify'], how: 'Added', last: '6 Nov 2026, 03:58' },
+      { ws: 'Engineering', wf: 'release-train', steps: ['build-notes', 'ship'], how: 'Added', last: '5 Nov 2026, 19:12' },
+      { ws: 'Engineering', wf: 'ssc-ui-lane', steps: ['build-cards', 'fix'], how: 'Added', last: '6 Nov 2026, 04:02' },
+    ]
+    : p.everyStep ? [{ ws: 'Engineering', wf: 'Every agent step', steps: ['default'], how: 'Every step', last: '6 Nov 2026, 04:10' }] : []
+  const ws = where === 'admin'
+  if (rows.length === 0) return <section className="mpc-panel"><span className="mpc-dim">No workflow names it</span></section>
+  return (
+    <section className="mpc-panel" aria-labelledby="mpc-us-h">
+      <header className="mpc-panel-h"><h2 id="mpc-us-h">Usage <em>3 workflows · 7 steps</em></h2></header>
+      <div className={`mpc-usage${ws ? ' has-ws' : ''}`} role="table" aria-label="Workflows that name it">
+        <div className="mpc-urow is-head" role="row">{ws && <span role="columnheader">Workspace</span>}<span role="columnheader">Workflow</span><span role="columnheader">Steps</span><span role="columnheader">How</span><span role="columnheader">Last run</span></div>
+        {rows.map((r) => (
+          <div key={r.wf} className="mpc-urow" role="row">
+            {ws && <span role="cell">{r.ws}</span>}
+            <span role="cell"><a href="/workflows">{r.wf}</a></span>
+            <span role="cell" className="mpc-chips">{r.steps.map((s) => <Chip key={s}>{s}</Chip>)}</span>
+            <span role="cell">{r.how}</span>
+            <span role="cell" className="mpc-dim">{r.last}</span>
+          </div>
+        ))}
+      </div>
+    </section>
+  )
+}
+
+/* ---------------------------------------------------------------- update */
+
+function UpdateView({ p, back }: { p: Plugin; back: string }) {
+  const before = `{
+  "name": "jev-belay",
+  "version": "0.2.0",
+  "userConfig": {
+    "threshold": {
+      "type": "number",
+      "default": 0.7
+    },`
+  return (
+    <div className="mpc-upd">
+      <section className="mpc-panel" aria-labelledby="mpc-u-h">
+        <header className="mpc-panel-h">
+          <h2 id="mpc-u-h">Update {p.name} <code>0.2.0</code> → <code>0.3.0</code></h2>
+          <span className="mpc-dim mpc-small mpc-push">commit 9f3c2e1 → 2b81f04 · sha256 7a4c9e02 → 0c5d81fe</span>
+        </header>
+        <div className="mpc-upd-grid">
+          <div className="mpc-sub">
+            <h3>Hooks <em>1 new</em></h3>
+            <ul className="mpc-hooks" role="list">
+              <li className="mpc-hook"><span className="mpc-hook-ev"><b>Stop</b></span><code className="mpc-hook-cmd">node belay.mjs</code><span className="mpc-dim mpc-small">unchanged</span></li>
+              <li className="mpc-hook is-new"><span className="mpc-hook-ev"><span className="mpc-scope is-new">New</span><b>PreToolUse</b><code>Bash</code></span><code className="mpc-hook-cmd">node guard.mjs</code><span className="mpc-runs">Runs every turn</span></li>
+            </ul>
+            <h3>Settings <em>1 changed · 1 new</em></h3>
+            <ul className="mpc-chg" role="list">
+              <li><code>threshold</code><span>default 0.7 → <b>0.8</b></span><span className="mpc-dim mpc-small">Engineering: 0.8</span></li>
+              <li className="is-new"><code>max_retries</code><span>new · number · default <b>2</b></span><span className="mpc-dim mpc-small">Engineering: default</span></li>
+            </ul>
+            <h3>Needs</h3>
+            <ul className="mpc-chg" role="list"><li><span>net</span><span>api.typesafe.ai</span><span className="mpc-dim mpc-small">unchanged</span></li></ul>
+          </div>
+          <div className="mpc-sub">
+            <h3>plugin.json</h3>
+            <pre className="mpc-diff" aria-label="plugin.json, changed lines">
+              {before.split('\n').map((l, i) => {
+                const del = l.includes('"version"') || l.includes('0.7')
+                return (
+                  <Fragment key={i}>
+                    <span className={del ? 'is-del' : ''}>{l}{'\n'}</span>
+                    {l.includes('"version"') && <span className="is-add">{'  "version": "0.3.0",\n'}</span>}
+                    {l.includes('0.7') && <span className="is-add">{'      "default": 0.8\n'}</span>}
+                  </Fragment>
+                )
+              })}
+              <span className="is-add">{'    "max_retries": {\n      "type": "number",\n      "title": "Max retries",\n      "default": 2\n    },\n'}</span>
+              <span>{'    …\n  },\n  "hooks": {\n'}</span>
+              <span className="is-add">{'    "PreToolUse": [{ "matcher": "Bash",\n      "command": "node guard.mjs" }],\n'}</span>
+              <span>{'    "Stop": [ … ]\n  }\n}'}</span>
+            </pre>
+          </div>
+        </div>
+      </section>
+      <div className="mpc-installbar">
+        <span className="mpc-small">Running steps keep 0.2.0 · steps from the next submission run 0.3.0</span>
+        <span className="mpc-acts"><a className="c-btn is-ghost" href={back}>Cancel</a><Button kind="primary">Update to 0.3.0</Button></span>
+      </div>
+    </div>
+  )
+}
+
+/* ---------------------------------------------------------------- builder sheet */
+
+function MpBuilder() {
+  const [profile, setProfile] = useState('codex')
+  const [open, setOpen] = useState(false)
+  const [enforceOn, setEnforceOn] = useState(true)
+  const [gstack, setGstack] = useState<string[]>(['review'])
+  useEffect(() => { if (profile === 'claude-code') setOpen(true) }, [profile])
+  return (
+    <div className="mpc-page">
+      <PageHead title="New workflow" />
+      <section className="mpc-panel mpc-step" aria-label="Step review">
+        <header className="mpc-panel-h"><span className="mpc-stepn">2</span><h2>review</h2><span className="mpc-dim mpc-small">after build</span></header>
+        <div className="mpc-row2">
+          <div className="mpc-field">
+            <label className="mpc-lbl" htmlFor="mpc-prof">Runner profile</label>
+            <select id="mpc-prof" className="c-inp" value={profile} onChange={(e) => setProfile(e.target.value)}>
+              <option value="codex">codex</option><option value="claude-code">claude-code</option><option value="claude-code-large">claude-code-large</option>
+            </select>
+          </div>
+          <div className="mpc-field">
+            <span className="mpc-lbl">Plugins</span>
+            <span className="mpc-chips">
+              {enforceOn && <Chip>jev-enforce · every step</Chip>}
+              {gstack.length > 0 && <Chip>gstack · Unattended · {gstack.join(', ')}</Chip>}
+              <Button size="sm" kind="ghost" onClick={() => setOpen(true)}>Plugins…</Button>
+            </span>
+          </div>
+        </div>
+        <div className="mpc-field"><label className="mpc-lbl" htmlFor="mpc-prompt">Prompt</label>
+          <textarea id="mpc-prompt" className="c-inp" rows={3} defaultValue="Review the build step's pull request against CONTRACT.md and leave findings as review comments." /></div>
+      </section>
+      {open && (
+        <aside className="psh-sheet mpc-sheet" role="dialog" aria-modal="false" aria-labelledby="mpc-sh-h">
+          <header className="psh-head">
+            <div><span className="psh-dim psh-small">Plugins for step</span><h2 id="mpc-sh-h">review</h2></div>
+            <Button size="sm" kind="ghost" onClick={() => setOpen(false)}>Close</Button>
+          </header>
+          <section className="psh-part">
+            <h3>On for every step <InfoTip about="defaults" tip="Engineering turns these on for every agent step. This step can turn one off." /></h3>
+            <div className={`mpc-shrow${enforceOn ? '' : ' is-off'}`}>
+              <Mono p={PLUGINS[3]!} sm />
+              <span className="mpc-shrow-t"><b>jev-enforce</b> <code>1.1.1-bgd.3</code><br /><span className="mpc-small mpc-dim">2 hooks · Engineering default</span></span>
+              <Switch on={enforceOn} label="jev-enforce on this step" onChange={setEnforceOn} />
+            </div>
+          </section>
+          <section className="psh-part">
+            <h3>Added on this step</h3>
+            <div className="mpc-shrow is-open">
+              <Mono p={PLUGINS[0]!} sm />
+              <span className="mpc-shrow-t"><b>gstack</b> <code>1.92.55.0</code><br /><span className="mpc-small mpc-dim">Unattended · {gstack.length} of 12 skills</span></span>
+              <Button size="sm" kind="ghost" onClick={() => setGstack([])}>Remove</Button>
+            </div>
+            <ul className="mpc-shskills" role="list">
+              {['review', 'investigate', 'qa-only', 'design-review', 'plan-eng-review'].map((s) => (
+                <li key={s}><label className={`psh-tick${gstack.includes(s) ? ' is-on' : ''}`}>
+                  <input type="checkbox" checked={gstack.includes(s)} onChange={() => setGstack(gstack.includes(s) ? gstack.filter((x) => x !== s) : [...gstack, s])} />
+                  <code>{s}</code></label></li>
+              ))}
+              <li className="mpc-dim mpc-small">+7 more</li>
+            </ul>
+          </section>
+          <section className="psh-part">
+            <h3>Add</h3>
+            <div className="mpc-shrow">
+              <Mono p={PLUGINS[2]!} sm />
+              <span className="mpc-shrow-t"><b>jev-belay</b> <code>0.2.0</code><br /><span className="mpc-small mpc-dim">1 hook · Platform</span></span>
+              <Button size="sm" kind="ghost">+ Add</Button>
+            </div>
+          </section>
+          <footer className="psh-foot">
+            <span className="mpc-chips">{enforceOn && <Chip>jev-enforce</Chip>}{gstack.length > 0 && <Chip>gstack · {gstack.join(', ')}</Chip>}</span>
+            <div className="psh-acts"><Button kind="primary" onClick={() => setOpen(false)}>Use on this step</Button></div>
+          </footer>
+        </aside>
+      )}
+    </div>
+  )
+}
