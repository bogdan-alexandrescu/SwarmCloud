@@ -0,0 +1,284 @@
+/* MOCK-HOOK FILE */
+/* Managed plugins, direction "cards" (MpCards.tsx, ?mp=cards). Console tokens
+   only, so light and dark follow the theme; no type below --t-micro (12px). */
+
+.mpc-page { display: flex; flex-direction: column; gap: var(--ctl-s3); min-width: 0; max-width: 1240px; padding-bottom: 72px; }
+.mpc-dim { color: var(--text-dim); }
+.mpc-small { font-size: var(--t-meta); line-height: var(--lh-meta); }
+.mpc-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+.mpc-acts { display: inline-flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.mpc-push { margin-left: auto; }
+.mpc-chips { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; min-width: 0; }
+.mpc-wrap { overflow-wrap: anywhere; }
+.mpc-crumb { display: flex; gap: 8px; align-items: center; font-size: var(--t-meta); line-height: var(--lh-meta); color: var(--text-dim); }
+.mpc-crumb a { color: var(--info-ink); text-decoration: none; }
+.mpc-crumb a:hover { text-decoration: underline; }
+
+/* The switch: a checkbox drawn as one, its state said beside it. */
+.mpc-switch { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: var(--t-meta); line-height: var(--lh-meta); flex: none; position: relative; }
+.mpc-switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
+.mpc-track { width: 30px; height: 18px; border-radius: 999px; background: var(--ctl-q-fill); border: 1px solid var(--ctl-bd); position: relative; transition: background .12s; flex: none; }
+.mpc-track > span { position: absolute; top: 2px; left: 2px; width: 12px; height: 12px; border-radius: 50%; background: var(--text-dim); transition: left .12s; }
+.mpc-switch input:checked + .mpc-track { background: var(--info); border-color: var(--info); }
+.mpc-switch input:checked + .mpc-track > span { left: 14px; background: var(--ctl-onac); }
+.mpc-switch input:focus-visible + .mpc-track { outline: 2px solid var(--info); outline-offset: 2px; }
+.mpc-switch.is-inert { cursor: default; opacity: .55; }
+.mpc-switch.is-changed .mpc-track { box-shadow: 0 0 0 2px color-mix(in srgb, var(--warn) 55%, transparent); }
+.mpc-switch-w { min-width: 4ch; }
+.mpc-toggle { display: inline-flex; align-items: center; gap: 8px; }
+
+/* The monogram, tinted by scope. */
+.mpc-mono { flex: none; width: 36px; height: 36px; border-radius: var(--r-tile); display: grid; place-items: center; font: 600 var(--t-meta)/var(--lh-flush) var(--mono); color: var(--text); background: var(--surface-2); border: 1px solid var(--line); }
+.mpc-mono.is-sm { width: 28px; height: 28px; font-size: var(--t-micro); }
+.mpc-mono.is-platform { background: color-mix(in srgb, var(--info) 14%, var(--surface)); border-color: color-mix(in srgb, var(--info) 40%, var(--line)); color: var(--info-ink); }
+.mpc-mono.is-workspace { background: color-mix(in srgb, var(--ok) 14%, var(--surface)); border-color: color-mix(in srgb, var(--ok) 40%, var(--line)); color: var(--ok-ink); }
+
+.mpc-scope { flex: none; display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: var(--r-pill); font-size: var(--t-micro); line-height: var(--lh-micro); font-weight: 600; border: 1px solid var(--line); color: var(--text-dim); background: var(--surface-2); white-space: nowrap; }
+.mpc-scope.is-platform { color: var(--info-ink); border-color: color-mix(in srgb, var(--info) 40%, var(--line)); background: color-mix(in srgb, var(--info) 8%, var(--surface)); }
+.mpc-scope.is-workspace { color: var(--ok-ink); border-color: color-mix(in srgb, var(--ok) 40%, var(--line)); background: color-mix(in srgb, var(--ok) 8%, var(--surface)); }
+.mpc-scope.is-pinned { color: var(--text); }
+.mpc-scope.is-new { color: var(--warn-ink); border-color: color-mix(in srgb, var(--warn) 50%, var(--line)); background: color-mix(in srgb, var(--warn) 10%, var(--surface)); }
+
+.mpc-badges { display: inline-flex; flex-wrap: wrap; gap: 4px; }
+.mpc-badge { display: inline-flex; gap: 4px; align-items: baseline; padding: 1px 7px; border-radius: var(--r-xs); background: var(--surface-2); border: 1px solid var(--line-soft); font-size: var(--t-micro); line-height: var(--lh-micro); color: var(--text-dim); white-space: nowrap; }
+.mpc-badge b { color: var(--text); font-variant-numeric: tabular-nums; }
+.mpc-badge.is-hook { border-color: color-mix(in srgb, var(--warn) 45%, var(--line)); background: color-mix(in srgb, var(--warn) 8%, var(--surface)); }
+
+.mpc-tick { display: inline-flex; align-items: center; gap: 4px; font-size: var(--t-meta); line-height: var(--lh-meta); color: var(--text-dim); }
+.mpc-tick svg { width: 14px; height: 14px; }
+.mpc-tick.is-ok { color: var(--ok-ink); font-weight: 600; }
+
+/* Filters over the grid. */
+.mpc-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
+.mpc-filters { display: inline-flex; gap: 4px; flex-wrap: wrap; }
+.mpc-filter { height: 30px; padding: 0 12px; border-radius: var(--r-pill); border: 1px solid var(--line); background: var(--surface); color: var(--text); font: 500 var(--t-meta)/var(--lh-meta) var(--font); cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
+.mpc-filter em { font-style: normal; color: var(--text-dim); font-variant-numeric: tabular-nums; }
+.mpc-filter.is-on { border-color: var(--text); background: var(--surface-2); }
+
+/* The grid of cards. */
+.mpc-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--ctl-s3); }
+.mpc-card { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--r-card); background: var(--surface); min-width: 0; }
+.mpc-card:hover { border-color: var(--ctl-bd); box-shadow: var(--ctl-shadow); }
+.mpc-card.is-off .mpc-card-top, .mpc-card.is-off .mpc-card-mid { opacity: .62; }
+.mpc-card-top { display: flex; align-items: center; gap: 10px; padding: 14px 14px 10px; color: inherit; text-decoration: none; min-width: 0; }
+.mpc-card-top:hover b { text-decoration: underline; }
+.mpc-card-id { display: flex; flex-direction: column; min-width: 0; flex: 1; }
+.mpc-card-id b { font-size: var(--t-body); line-height: var(--lh-body); font-weight: 600; overflow-wrap: anywhere; }
+.mpc-card-id code { font: 400 var(--t-micro)/var(--lh-micro) var(--mono); color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.mpc-card-mid { display: flex; flex-direction: column; gap: 8px; padding: 0 14px 12px; flex: 1; }
+.mpc-card-src { font: 400 var(--t-micro)/var(--lh-micro) var(--mono); color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.mpc-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 10px 14px; border-top: 1px solid var(--line-soft); background: var(--bg); border-radius: 0 0 var(--r-card) var(--r-card); }
+
+/* The platform switches: one card at the top of the platform catalogue. */
+.mpc-switches { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--ctl-s3); border: 1px solid var(--line); border-radius: var(--r-card); background: var(--surface); padding: 4px 14px; }
+.mpc-sw { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 0; min-width: 0; }
+.mpc-sw + .mpc-sw { border-left: 1px solid var(--line-soft); padding-left: var(--ctl-s3); }
+.mpc-sw-l { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.mpc-sw-t { display: inline-flex; align-items: center; gap: 4px; font-weight: 600; font-size: var(--t-body); line-height: var(--lh-body); }
+.mpc-sw-t .c-tip { bottom: calc(100% + 6px); top: auto; width: 440px; max-width: 70vw; white-space: normal; }
+.mpc-sw-pending { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 8px 0 10px; border-top: 1px solid var(--line-soft); }
+.mpc-sw-pending b { color: var(--warn-ink); }
+
+/* A segmented radio group. */
+.mpc-seg { display: inline-flex; border: 1px solid var(--ctl-bd); border-radius: var(--r-ctl); overflow: hidden; flex: none; }
+.mpc-seg.is-wide { display: flex; }
+.mpc-seg.is-wide .mpc-seg-o { flex: 1; justify-content: center; }
+.mpc-seg-o { position: relative; display: inline-flex; align-items: center; height: 30px; padding: 0 12px; font-size: var(--t-meta); line-height: var(--lh-meta); cursor: pointer; background: var(--surface); color: var(--text); white-space: nowrap; }
+.mpc-seg-o + .mpc-seg-o { border-left: 1px solid var(--ctl-bd); }
+.mpc-seg-o input { position: absolute; opacity: 0; width: 1px; height: 1px; }
+.mpc-seg-o.is-on { background: var(--text); color: var(--bg); font-weight: 600; }
+.mpc-seg-o:has(input:focus-visible) { outline: 2px solid var(--info); outline-offset: -2px; }
+
+/* Panels, fields. */
+.mpc-panel { border: 1px solid var(--line); border-radius: var(--r-card); background: var(--surface); padding: 14px 16px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
+.mpc-panel-h { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
+.mpc-panel-h h2 { margin: 0; font-size: var(--t-body); line-height: var(--lh-body); font-weight: 600; display: inline-flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
+.mpc-panel-h h2 em, .mpc-sub h3 em, .mpc-man-sec h3 em { font-style: normal; font-weight: 400; color: var(--text-dim); font-size: var(--t-meta); }
+.mpc-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
+.mpc-lbl { font-size: var(--t-meta); line-height: var(--lh-meta); font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
+.mpc-lbl .mpc-dim { font-weight: 400; }
+.mpc-row2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 12px; }
+.mpc-err { color: var(--bad-ink); font-size: var(--t-meta); line-height: var(--lh-meta); }
+.c-inp.is-bad { border-color: var(--bad-ink); box-shadow: 0 0 0 1px var(--bad-ink); }
+
+/* Add plugin: source left, preview right. */
+.mpc-add { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: var(--ctl-s3); align-items: start; }
+.mpc-srctabs { display: flex; gap: 0; border-bottom: 1px solid var(--line); }
+.mpc-srctab { padding: 6px 14px; font-size: var(--t-meta); line-height: var(--lh-meta); color: var(--text-dim); text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -1px; }
+.mpc-srctab.is-on { color: var(--text); border-bottom-color: var(--text); font-weight: 600; }
+.mpc-src-acts { display: flex; justify-content: flex-end; }
+.mpc-file { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px dashed var(--ctl-bd); border-radius: var(--r-tile); background: var(--bg); font-size: var(--t-meta); line-height: var(--lh-meta); }
+.mpc-file svg { width: 22px; height: 22px; color: var(--text-dim); flex: none; }
+.mpc-file > span { flex: 1; min-width: 0; overflow-wrap: anywhere; }
+.mpc-digest code { font: 400 var(--t-micro)/var(--lh-micro) var(--mono); overflow-wrap: anywhere; color: var(--text); }
+.mpc-radios { list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); border-radius: var(--r-tile); }
+.mpc-radios li + li { border-top: 1px solid var(--line-soft); }
+.mpc-radio { display: flex; align-items: center; gap: 10px; padding: 8px 12px; font-size: var(--t-meta); line-height: var(--lh-meta); cursor: pointer; }
+.mpc-radio code { font: 400 var(--t-micro)/var(--lh-micro) var(--mono); color: var(--text-dim); }
+.mpc-radio .mpc-dim { margin-left: auto; }
+.mpc-radio.is-on { background: color-mix(in srgb, var(--info) 6%, var(--surface)); }
+
+.mpc-preview { min-height: 280px; }
+.mpc-resolving { display: flex; flex-direction: column; gap: 12px; }
+.mpc-resolving .c-spin { display: inline-block; vertical-align: -2px; margin-right: 4px; }
+.mpc-steps { margin: 0; padding: 0 0 0 4px; list-style: none; display: flex; flex-direction: column; gap: 6px; font-size: var(--t-meta); line-height: var(--lh-meta); color: var(--text-faint); }
+.mpc-steps li::before { content: '○'; margin-right: 8px; }
+.mpc-steps li.is-done { color: var(--text-dim); }
+.mpc-steps li.is-done::before { content: '✓'; color: var(--ok-ink); }
+.mpc-steps li.is-now { color: var(--text); font-weight: 600; }
+.mpc-steps li.is-now::before { content: '●'; color: var(--info); }
+.mpc-skel { display: flex; flex-direction: column; gap: 8px; }
+.mpc-skel span { height: 14px; border-radius: var(--r-xs); background: var(--surface-2); }
+.mpc-skel span:nth-child(2) { width: 70%; }
+.mpc-skel span:nth-child(3) { width: 45%; }
+
+.mpc-man { display: flex; flex-direction: column; gap: 14px; }
+.mpc-man-h { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
+.mpc-man-h .mpc-card-id { flex: 0 1 auto; }
+.mpc-man-h .mpc-tick { margin-left: auto; }
+.mpc-man-sec h3, .mpc-sub h3 { margin: 0 0 6px; font-size: var(--t-meta); line-height: var(--lh-meta); font-weight: 600; display: flex; gap: 6px; align-items: center; }
+.mpc-hooks { list-style: none; margin: 0; padding: 0; display: block; }
+.mpc-hook { display: grid; grid-template-columns: minmax(120px, auto) minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 8px 10px; border: 1px solid color-mix(in srgb, var(--warn) 40%, var(--line)); border-left-width: 3px; border-radius: var(--r-xs); background: color-mix(in srgb, var(--warn) 5%, var(--surface)); font-size: var(--t-meta); line-height: var(--lh-meta); }
+.mpc-hook + .mpc-hook { margin-top: 6px; }
+.mpc-hook-ev { display: inline-flex; gap: 6px; align-items: center; flex-wrap: wrap; }
+.mpc-hook-ev code, .mpc-hook-cmd { font: 400 var(--t-micro)/var(--lh-micro) var(--mono); }
+.mpc-hook-cmd { color: var(--text); overflow-wrap: anywhere; }
+.mpc-runs { font-size: var(--t-micro); line-height: var(--lh-micro); font-weight: 600; color: var(--warn-ink); white-space: nowrap; }
+.mpc-hook.is-new { border-color: var(--warn-ink); }
+.mpc-warnword { color: var(--warn-ink); }
+
+.mpc-facts { margin: 0; display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 8px 16px; font-size: var(--t-meta); line-height: var(--lh-meta); }
+.mpc-facts > div { display: contents; }
+.mpc-facts dt { color: var(--text-dim); }
+.mpc-facts dd { margin: 0; display: flex; flex-wrap: wrap; gap: 4px; align-items: center; min-width: 0; }
+.mpc-pin { display: flex; flex-direction: column; gap: 2px; }
+.mpc-pin code { font: 400 var(--t-micro)/var(--lh-micro) var(--mono); color: var(--text); }
+
+.mpc-installbar { position: sticky; bottom: 12px; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 14px; border: 1px solid var(--line); border-radius: var(--r-card); background: var(--surface); box-shadow: var(--ctl-shadow-pop); }
+.mpc-savebar { position: sticky; bottom: 12px; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 14px; border: 1px solid var(--warn-ink); border-radius: var(--r-card); background: var(--surface); box-shadow: var(--ctl-shadow-pop); }
+
+/* The settings form. */
+.mpc-form { list-style: none; margin: 0; padding: 0; display: block; }
+.mpc-frow { display: grid; grid-template-columns: minmax(180px, 240px) minmax(0, 1fr) 160px; gap: 12px; align-items: center; padding: 10px 0; border-top: 1px solid var(--line-soft); }
+.mpc-frow:first-child { border-top: 0; padding-top: 0; }
+.mpc-frow-l { display: flex; flex-direction: column; gap: 0; min-width: 0; }
+.mpc-frow-l code { font-family: var(--mono); }
+.mpc-ftitle { font-weight: 600; font-size: var(--t-body); line-height: var(--lh-body); display: inline-flex; align-items: center; gap: 4px; }
+.mpc-frow-v { min-width: 0; }
+.mpc-frow-r { justify-self: end; }
+.mpc-num { max-width: 120px; }
+.mpc-num.is-changed { box-shadow: 0 0 0 2px color-mix(in srgb, var(--warn) 55%, transparent); }
+.mpc-secret { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; min-width: 0; }
+.mpc-secret .c-inp { flex: 1; min-width: 200px; }
+.mpc-stored { display: inline-flex; gap: 10px; align-items: center; flex-wrap: wrap; }
+.mpc-ovr { height: 26px; padding: 0 10px; border-radius: var(--r-pill); border: 1px dashed var(--ctl-bd); background: transparent; color: var(--text-dim); font: 500 var(--t-micro)/var(--lh-micro) var(--font); cursor: pointer; white-space: nowrap; }
+.mpc-ovr.is-on { border-style: solid; color: var(--text); background: var(--surface-2); }
+.mpc-lock { font-size: var(--t-micro); line-height: var(--lh-micro); color: var(--text-dim); padding: 3px 8px; border: 1px solid var(--line); border-radius: var(--r-pill); }
+
+.mpc-declared { display: flex; flex-direction: column; gap: 18px; }
+.mpc-sub { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; min-width: 0; }
+.mpc-sub > * { max-width: 100%; }
+.mpc-envtable { width: 100%; border: 1px solid var(--line); border-radius: var(--r-tile); }
+.mpc-env { display: grid; grid-template-columns: minmax(0, 1.5fr) 110px minmax(0, 1.4fr) 110px 36px; gap: 8px; align-items: center; padding: 6px 10px; }
+.mpc-env + .mpc-env { border-top: 1px solid var(--line-soft); }
+.mpc-env.is-head { font-size: var(--t-micro); line-height: var(--lh-micro); color: var(--text-dim); background: var(--surface-2); border-radius: var(--r-tile) var(--r-tile) 0 0; }
+.mpc-env .c-inp { width: 100%; }
+.mpc-fileed { width: 100%; border: 1px solid var(--line); border-radius: var(--r-tile); overflow: hidden; }
+.mpc-fileed-h { display: flex; justify-content: space-between; gap: 10px; padding: 6px 10px; background: var(--surface-2); border-bottom: 1px solid var(--line-soft); font-size: var(--t-meta); line-height: var(--lh-meta); }
+.mpc-fileed-h code { font-family: var(--mono); }
+.mpc-code { display: block; width: 100%; box-sizing: border-box; border: 0; resize: vertical; padding: 10px 12px; background: var(--bg); color: var(--text); font: 400 var(--t-meta)/var(--lh-meta) var(--mono); }
+.mpc-code:focus { outline: 2px solid var(--info); outline-offset: -2px; }
+
+/* The plugin's page. */
+.mpc-phead { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
+.mpc-phead .mpc-mono { width: 44px; height: 44px; font-size: var(--t-body); }
+.mpc-phead-t { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
+.mpc-phead-t h1 { margin: 0; font-size: var(--t-title); line-height: var(--lh-title); font-weight: 600; display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
+.mpc-phead-t h1 code { font: 400 var(--t-meta)/var(--lh-meta) var(--mono); color: var(--text-dim); }
+.mpc-phead-m { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.mpc-phead > .mpc-acts { gap: 16px; }
+.mpc-ov { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: var(--ctl-s3); align-items: start; }
+.mpc-ov-main { display: flex; flex-direction: column; gap: var(--ctl-s3); min-width: 0; }
+.mpc-skills { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0 18px; }
+.mpc-skills li { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 6px 0; border-top: 1px solid var(--line-soft); }
+.mpc-skills code { font: 400 var(--t-meta)/var(--lh-meta) var(--mono); }
+.mpc-skills li.is-hidden code { color: var(--text-faint); text-decoration: line-through; }
+
+.mpc-vers { list-style: none; margin: 0; padding: 0; display: block; }
+.mpc-ver { display: grid; grid-template-columns: 110px 160px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 0; border-top: 1px solid var(--line-soft); }
+.mpc-ver:first-child { border-top: 0; }
+.mpc-ver-v { font: 600 var(--t-body)/var(--lh-body) var(--mono); }
+.mpc-ver-s { display: inline-flex; gap: 10px; align-items: center; justify-self: end; }
+.mpc-ver.is-old .mpc-ver-v { color: var(--text-dim); }
+
+.mpc-usage { border: 1px solid var(--line); border-radius: var(--r-tile); }
+.mpc-urow { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) 120px 160px; gap: 12px; align-items: center; padding: 8px 12px; font-size: var(--t-meta); line-height: var(--lh-meta); }
+.mpc-usage.has-ws .mpc-urow { grid-template-columns: 120px minmax(0, 1fr) minmax(0, 1.4fr) 110px 150px; }
+.mpc-wslist { list-style: none; margin: 0; padding: 0; }
+.mpc-wslist li { display: grid; grid-template-columns: 160px 120px minmax(0, 1fr); gap: 12px; align-items: center; padding: 6px 0; border-top: 1px solid var(--line-soft); font-size: var(--t-meta); line-height: var(--lh-meta); }
+.mpc-wslist li.is-off b { color: var(--text-dim); font-weight: 500; }
+.mpc-urow + .mpc-urow { border-top: 1px solid var(--line-soft); }
+.mpc-urow.is-head { font-size: var(--t-micro); line-height: var(--lh-micro); color: var(--text-dim); background: var(--surface-2); }
+.mpc-urow a { color: var(--info-ink); font-weight: 600; text-decoration: none; }
+
+/* The update. */
+.mpc-upd { display: flex; flex-direction: column; gap: var(--ctl-s3); }
+.mpc-upd-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; align-items: start; }
+.mpc-upd-grid h3 + * { margin-bottom: 10px; }
+.mpc-chg { list-style: none; margin: 0; padding: 0; width: 100%; border: 1px solid var(--line); border-radius: var(--r-tile); }
+.mpc-chg li { display: grid; grid-template-columns: 110px minmax(0, 1fr) auto; gap: 10px; padding: 7px 10px; font-size: var(--t-meta); line-height: var(--lh-meta); align-items: center; }
+.mpc-chg li + li { border-top: 1px solid var(--line-soft); }
+.mpc-chg li.is-new { background: var(--diff-add-bg); }
+.mpc-chg code { font-family: var(--mono); }
+.mpc-diff { margin: 0; width: 100%; box-sizing: border-box; padding: 10px 0; border: 1px solid var(--line); border-radius: var(--r-tile); background: var(--bg); font: 400 var(--t-micro)/var(--lh-micro) var(--mono); overflow-x: auto; }
+.mpc-diff > span { display: block; padding: 0 12px; white-space: pre; }
+.mpc-diff > span.is-add { background: var(--diff-add-bg); }
+.mpc-diff > span.is-add::before { content: '+ '; color: var(--ok-ink); margin-left: -12px; padding-left: 2px; }
+.mpc-diff > span.is-del { background: var(--diff-del-bg); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--bad-ink) 60%, transparent); }
+
+/* Remove: the counts over the list; the shared hint is hidden here only. */
+.mpc-rm { display: flex; flex-direction: column; gap: 8px; }
+.mpc-rm-n { margin: 0; display: inline-flex; align-items: center; gap: 4px; font-size: var(--t-body); line-height: var(--lh-body); }
+.mpc-rm-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); border-radius: var(--r-tile); }
+.mpc-rm-list li { display: flex; justify-content: space-between; gap: 10px; padding: 6px 10px; font-size: var(--t-meta); line-height: var(--lh-meta); }
+.mpc-rm-list li + li { border-top: 1px solid var(--line-soft); }
+.c-dlg:has(.mpc-rm) .c-field .c-hint { display: none; }
+
+/* The builder's step and its plugin sheet. */
+.mpc-step { max-width: 620px; }
+.mpc-stepn { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-2); border: 1px solid var(--line); font-size: var(--t-micro); line-height: var(--lh-flush); font-weight: 600; }
+.mpc-sheet { overflow-y: auto; }
+.mpc-sheet .psh-part h3 { display: flex; align-items: center; gap: 4px; }
+.mpc-shrow { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--r-tile); background: var(--surface); }
+.mpc-shrow.is-off { background: var(--bg); }
+.mpc-shrow.is-off .mpc-shrow-t { opacity: .6; }
+.mpc-shrow-t { flex: 1; min-width: 0; font-size: var(--t-meta); line-height: var(--lh-meta); }
+.mpc-shrow-t code { font: 400 var(--t-micro)/var(--lh-micro) var(--mono); color: var(--text-dim); }
+.mpc-shskills { list-style: none; margin: 8px 0 0; padding: 0 0 0 38px; display: grid; grid-template-columns: 1fr 1fr; gap: 2px 10px; }
+
+/* The phone. */
+@media (max-width: 720px) {
+  .mpc-switches { grid-template-columns: 1fr; }
+  .mpc-sw + .mpc-sw { border-left: 0; padding-left: 0; border-top: 1px solid var(--line-soft); }
+  .mpc-grid { grid-template-columns: 1fr; }
+  .mpc-add, .mpc-ov, .mpc-upd-grid, .mpc-row2 { grid-template-columns: 1fr; }
+  .mpc-frow { grid-template-columns: 1fr; gap: 6px; }
+  .mpc-frow-r { justify-self: start; }
+  .mpc-phead > .mpc-acts { width: 100%; justify-content: space-between; }
+  .mpc-ver { grid-template-columns: 1fr auto; }
+  .mpc-urow { grid-template-columns: 1fr 1fr; }
+  .mpc-usage.has-ws .mpc-urow { grid-template-columns: 1fr 1fr; }
+  .mpc-wslist li { grid-template-columns: 1fr auto; }
+  .mpc-env { grid-template-columns: 1fr 1fr; }
+  .mpc-sw-t .c-tip { width: 300px; }
+  .mpc-installbar, .mpc-savebar { flex-wrap: nowrap; padding: 8px 10px; gap: 8px; }
+  /* The pending change wraps to a second line rather than being cut: when it takes effect must stay readable. */
+  .mpc-installbar > .mpc-small, .mpc-savebar > .mpc-small { flex: 1; min-width: 0; }
+  .mpc-installbar .mpc-acts, .mpc-savebar .mpc-acts { flex-wrap: nowrap; }
+}
+.mpc-card-desc { font-size: var(--t-meta); line-height: var(--lh-meta); color: var(--text); }
+.mpc-mark { background: color-mix(in srgb, var(--bad) 22%, transparent); color: var(--bad-ink); border-radius: var(--r-xs); }
+.mpc-facts code { font: 400 var(--t-micro)/var(--lh-micro) var(--mono); }
+/* The typed-confirmation's Remove, while disabled, reads as disabled in both themes (the shared
+   .c-btn.is-danger-filled:disabled keeps a maroon fill and red border in dark). */
+.c-dlg:has(.mpc-rm) .c-btn.is-danger-filled:disabled { background: var(--surface-2); border-color: var(--line); color: var(--text-faint); }
