+// MOCK-HOOK FILE
+/**
+ * MANAGED PLUGINS, DIRECTION "CARDS" (mock-up only, ?mp=cards). The catalogue
+ * is a grid of cards, Add plugin is a full page (source left, live manifest
+ * preview right, then settings), and each plugin has its own page with tabs
+ * Overview, Settings, Versions and Usage. Every fixture here is invented
+ * (MOCK-HOOK): no route serves any of it.
+ *
+ * Addresses: /admin/plugins?mp=cards&s=<state> (the platform catalogue) and
+ * /config/plugins?mp=cards&s=<state> (Engineering's), /submit/workflow?mp=cards
+ * for the builder's step sheet. `s` is catalogue | switches | add | plugin |
+ * update; `p` names a plugin, `tab` a tab, `src` a source, `st` a state.
+ */
+import { Fragment, useEffect, useState, type ReactNode } from 'react'
+import { Banner, Button, Chip, Tabs, TypedConfirm } from './components'
+import { InfoTip } from './People'
+import { PageHead } from './Shell'
+import './styles/pluginsheet.css'
+import './styles/mpc.css'
+
+/* ---------------------------------------------------------------- fixtures */
+
+type Scope = 'builtin' | 'platform' | 'workspace'
+type FieldType = 'string' | 'number' | 'boolean'
+interface UcField { key: string; type: FieldType; title: string; description: string; sensitive?: boolean; default?: string | number | boolean }
+interface Hook { event: string; matcher?: string; command: string }
+interface Plugin {
+  name: string
+  mono: string
+  /** plugin.json's description, as the manifest says it. */
+  description: string
+  version: string
+  scope: Scope
+  source: string
+  license?: string
+  commit?: string
+  digest: string
+  installedBy: string
+  installedAt: string
+  skills: { name: string; offered: boolean }[]
+  hooks: Hook[]
+  commands: string[]
+  agents: string[]
+  mcp: string[]
+  profiles: string[]
+  needs: { node?: string; hosts: string[] }
+  userConfig: UcField[]
+  allowed: boolean
+  everyStep: boolean
+  /** Platform: the workspaces that allow it. */
+  allowedIn?: string[]
+}
+
+const CC = ['claude-code', 'claude-code-large', 'claude-code-review', 'claude-code-browser', 'claude-code-lightpanda']
+
+const GSTACK_SKILLS = ['review', 'investigate', 'health', 'qa-only', 'qa', 'design-review', 'document-generate', 'document-release', 'ship',
+  'plan-eng-review', 'plan-design-review', 'autoplan', 'office-hours', 'plan-ceo-review', 'plan-devex-review', 'spec',
+  'design-consultation', 'design-html', 'cso']
+
+const BELAY_UC: UcField[] = [
+  { key: 'typesafe_api_key', type: 'string', title: 'TypeSafe API key', description: 'The key belay sends each Stop check to TypeSafe with.', sensitive: true },
+  { key: 'threshold', type: 'number', title: 'Threshold', description: 'The score below which a turn is held back (0 to 1).', default: 0.7 },
+  { key: 'check', type: 'boolean', title: 'Check', description: 'Run the check on every Stop.', default: true },
+  { key: 'log', type: 'boolean', title: 'Log', description: 'Write each verdict to the step log.', default: true },
+  { key: 'shadow', type: 'boolean', title: 'Shadow', description: 'Report only: never hold a turn back.', default: false },
+]
+
+// MOCK-HOOK: the platform's three workspaces, and who allowed a platform plugin in each.
+const WORKSPACES = [
+  { name: 'Engineering', set: 'owner@example.com · 6 Nov 2026' },
+  { name: 'Research', set: 'mira@example.com · 4 Nov 2026' },
+  { name: 'Design', set: 'theo@example.com · 4 Nov 2026' },
+]
+
+const PLUGINS: Plugin[] = [
+  {
+    name: 'gstack', mono: 'gs', description: 'Review, QA, planning and design skills', version: '1.92.55.0', scope: 'builtin', source: 'Agent image', digest: 'sha256:5d1e…a04c',
+    installedBy: 'the image build', installedAt: '2026-11-03T09:12:00Z',
+    skills: GSTACK_SKILLS.map((s) => ({ name: s, offered: s !== 'cso' })), hooks: [], commands: [], agents: [], mcp: [],
+    profiles: CC, needs: { hosts: [] }, userConfig: [], allowed: true, everyStep: false, allowedIn: ['Engineering', 'Research', 'Design'],
+  },
+  {
+    name: 'security-audit', mono: 'sa', description: 'Cloudflare’s security audit skill', version: 'c1c8a8c', scope: 'builtin', source: 'Agent image', digest: 'sha256:c1c8…a6a8',
+    installedBy: 'the image build', installedAt: '2026-09-14T08:00:00Z',
+    skills: [{ name: 'security-audit', offered: true }], hooks: [], commands: [], agents: [], mcp: [],
+    profiles: CC, needs: { node: '20', hosts: [] }, userConfig: [], allowed: false, everyStep: false, allowedIn: ['Research'],
+  },
+  {
+    name: 'jev-belay', mono: 'jb', description: 'Holds a turn back when Jev scores it below a threshold', version: '0.2.0', scope: 'platform', source: 'github.com/valentynkit/jev-belay', license: 'MIT',
+    commit: '9f3c2e1d7b40a8c65e21f0b9d3a7c4e18b2f6d05', digest: 'sha256:7a4c9e02b1f3d85a6e0c47b2193fd8e5c60a1b7e94d23f8c5ab01e6d7f92c3a4',
+    installedBy: 'owner@example.com', installedAt: '2026-11-06T01:42:00Z',
+    skills: [], hooks: [{ event: 'Stop', command: 'node belay.mjs' }], commands: [], agents: [], mcp: [],
+    profiles: ['claude-code', 'claude-code-large', 'claude-code-review'], needs: { node: '20', hosts: ['api.typesafe.ai'] },
+    userConfig: BELAY_UC, allowed: true, everyStep: false, allowedIn: ['Engineering'],
+  },
+  {
+    name: 'jev-enforce', mono: 'je', description: 'Checks each edit against the workspace’s rules', version: '1.1.1-bgd.3', scope: 'workspace', source: 'jev-enforce-1.1.1-bgd.3.tar.gz',
+    license: 'MIT', digest: 'sha256:e3b7c4a91d0f26b85c13e7a49f02d6b8c5e1a37f90d4b26c8e5a1f73b09d4c62',
+    installedBy: 'owner@example.com', installedAt: '2026-11-06T01:55:00Z',
+    skills: [], hooks: [{ event: 'Stop', command: 'node dist/src/cli.js' }, { event: 'PostToolUse', matcher: 'Edit|Write|MultiEdit', command: 'node dist/src/cli.js' }],
+    commands: [], agents: [], mcp: [], profiles: ['claude-code', 'claude-code-large', 'claude-code-review', 'claude-code-browser'],
+    needs: { node: '20', hosts: ['api.typesafe.ai'] }, userConfig: [], allowed: true, everyStep: true,
+  },
+]
+
+const SCOPE_WORDS: Readonly<Record<Scope, string>> = { builtin: 'Built in', platform: 'Platform', workspace: 'Engineering only' }
+const SCOPE_TIP: Readonly<Record<Scope, string>> = {
+  builtin: 'Baked into the agent image. It can be allowed or not; never removed.',
+  platform: 'In the platform catalogue. Each workspace allows it from its own Plugins page.',
+  workspace: 'Installed by an Engineering admin. No other workspace sees it.',
+}
+
+function day(iso: string): string {
+  return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
+}
+function short(sha: string): string {
+  return sha.replace(/^sha256:/, '').slice(0, 12)
+}
+
+/* ---------------------------------------------------------------- address */
+
+/** The address as the page was opened: the router drops a query it does not know once it has read it. */
+const BOOT = typeof location === 'undefined' ? '' : location.search
+
+interface At { s: string; p: string; tab: string; src: string; st: string; secret: string; who: string }
+function readAt(): At {
+  const q = new URLSearchParams(BOOT)
+  return { s: q.get('s') ?? 'catalogue', p: q.get('p') ?? 'jev-belay', tab: q.get('tab') ?? 'overview', src: q.get('src') ?? 'github', st: q.get('st') ?? '', secret: q.get('secret') ?? '', who: q.get('who') ?? 'admin' }
+}
+function href(where: 'admin' | 'workspace', q: Record<string, string>): string {
+  const base = where === 'admin' ? '/admin/plugins' : '/config/plugins'
+  return `${base}?${new URLSearchParams({ mp: 'cards', ...q }).toString()}`
+}
+
+/** True on a ?mp=cards address. */
+export function mpCardsOn(): boolean {
+  return new URLSearchParams(BOOT).get('mp') === 'cards'
+}
+
+/** The page for a console address under ?mp=cards, or null to leave it to the app. */
+export function mpCardsFor(screen: string): ReactNode {
+  if (!mpCardsOn()) return null
+  if (screen === 'admin/plugins') return <MpCardsScreen where="admin" />
+  if (screen === 'config/plugins') return <MpCardsScreen where="workspace" />
+  if (screen === 'work/new-workflow') return <MpBuilder />
+  return null
+}
+
+export function MpCardsScreen({ where }: { where: 'admin' | 'workspace' }) {
+  const at = readAt()
+  if (at.s === 'add') return <AddPage where={where} at={at} />
+  if (at.s === 'plugin' || at.s === 'update') return <PluginPage where={where} at={at} />
+  const member = at.who === 'member'
+  return (
+    <div className="mpc-page">
+      <PageHead title="Plugins" info={<InfoTip about="plugins" tip={where === 'admin'
+        ? 'The platform catalogue. Each workspace allows plugins from it; a workspace admin may also install plugins of its own.'
+        : 'Plugins Engineering allows. Allowed, a step can add it; Every step, it loads on each agent step unless the step turns it off.'} />}>
+        {!member && <a className="c-btn is-primary" href={href(where, { s: 'add', src: 'github' })}>Add plugin</a>}
+      </PageHead>
+      <Catalogue where={where} at={at} />
+    </div>
+  )
+}
+
+/* ---------------------------------------------------------------- bits */
+
+function Switch({ on, label, word, onChange, inert = false, changed = false }: {
+  on: boolean; label: string; word?: [string, string]; onChange?: (v: boolean) => void; inert?: boolean; changed?: boolean
+}) {
+  const [w1, w0] = word ?? ['On', 'Off']
+  return (
+    <label className={`mpc-switch${inert ? ' is-inert' : ''}${changed ? ' is-changed' : ''}`}>
+      <input type="checkbox" checked={on} disabled={inert} aria-label={label} onChange={(e) => onChange?.(e.target.checked)} />
+      <span className="mpc-track" aria-hidden><span /></span>
+      <span className="mpc-switch-w">{on ? w1 : w0}</span>
+    </label>
+  )
+}
+
+function Mono({ p, sm = false }: { p: Pick<Plugin, 'mono' | 'scope'>; sm?: boolean }) {
+  return <span className={`mpc-mono is-${p.scope}${sm ? ' is-sm' : ''}`} aria-hidden>{p.mono}</span>
+}
+
+function ScopeChip({ scope }: { scope: Scope }) {
+  return <span className={`mpc-scope is-${scope}`} title={SCOPE_TIP[scope]}>{SCOPE_WORDS[scope]}</span>
+}
+
+function Badges({ p }: { p: Plugin }) {
+  const offered = p.skills.filter((s) => s.offered).length
+  return (
+    <span className="mpc-badges">
+      {p.skills.length > 0 && <span className="mpc-badge"><b>{offered}</b> {offered === 1 ? 'skill' : 'skills'}</span>}
+      {p.hooks.length > 0 && <span className="mpc-badge is-hook" title="Hooks run code on every turn"><b>{p.hooks.length}</b> {p.hooks.length === 1 ? 'hook' : 'hooks'}</span>}
+      {p.mcp.length > 0 && <span className="mpc-badge"><b>{p.mcp.length}</b> MCP</span>}
+      {p.commands.length > 0 && <span className="mpc-badge"><b>{p.commands.length}</b> commands</span>}
+    </span>
+  )
+}
+
+function Tick({ children, tip }: { children: ReactNode; tip: string }) {
+  return (
+    <span className="mpc-tick">
+      <svg viewBox="0 0 16 16" aria-hidden><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" strokeWidth="1.8" /></svg>
+      {children}
+      <InfoTip about={typeof children === 'string' ? children : 'this'} tip={tip} />
+    </span>
+  )
+}
+
+/* ---------------------------------------------------------------- catalogue */
+
+function Catalogue({ where, at }: { where: 'admin' | 'workspace'; at: At }) {
+  const member = at.who === 'member'
+  const [filter, setFilter] = useState<'all' | Scope>('all')
+  const [state, setState] = useState(() => Object.fromEntries(PLUGINS.map((p) => [p.name, { allowed: p.allowed, every: p.everyStep }])))
+  const list = PLUGINS.filter((p) => filter === 'all' || p.scope === filter)
+  const changed = PLUGINS.filter((p) => state[p.name]!.allowed !== p.allowed || state[p.name]!.every !== p.everyStep)
+  const counts = { all: PLUGINS.length, builtin: 2, platform: 1, workspace: 1 }
+  return (
+    <>
+      {where === 'admin' && <PlatformSwitches open={at.s === 'switches'} />}
+      <div className="mpc-bar">
+        <div className="mpc-filters" role="group" aria-label="Show">
+          {(['all', 'builtin', 'platform', 'workspace'] as const).map((k) => (
+            <button key={k} type="button" className={`mpc-filter${filter === k ? ' is-on' : ''}`} aria-pressed={filter === k} onClick={() => setFilter(k)}>
+              {k === 'all' ? 'All' : SCOPE_WORDS[k]} <em>{counts[k]}</em>
+            </button>
+          ))}
+        </div>
+        {where === 'workspace' && member && <Tick tip="Only an Engineering admin changes what is allowed. Ask one on People and roles.">View only</Tick>}
+        {where === 'workspace' && !member && <span className="mpc-dim mpc-small">Set by owner@example.com · 6 Nov 2026</span>}
+      </div>
+      <ul className="mpc-grid" role="list">
+        {list.map((p) => {
+          const s = state[p.name]!
+          return (
+            <li key={p.name} className={`mpc-card${s.allowed || where === 'admin' ? '' : ' is-off'}`}>
+              <a className="mpc-card-top" href={href(where, { s: 'plugin', p: p.name, tab: 'overview', ...(member ? { who: 'member' } : {}) })}>
+                <Mono p={p} />
+                <span className="mpc-card-id">
+                  <b>{p.name}</b>
+                  <code>{p.version}</code>
+                </span>
+                <ScopeChip scope={p.scope} />
+              </a>
+              <div className="mpc-card-mid">
+                <span className="mpc-card-desc">{p.description}</span>
+                <Badges p={p} />
+                <span className="mpc-card-src" title={p.source}>{p.scope === 'builtin' ? 'Agent image' : p.source.replace(/^github\.com\//, '')}</span>
+              </div>
+              {where === 'admin' ? (
+                <div className="mpc-card-foot">
+                  <span className="mpc-small">{p.scope === 'workspace' ? <>Private to <b>Engineering</b></> : <>Allowed in <b>{p.allowedIn?.length ?? 0}</b> of 3 workspaces</>}</span>
+                  <span className="mpc-small mpc-dim">{p.scope === 'builtin' ? `Image ${day(p.installedAt)}` : `Pinned ${day(p.installedAt)}`}</span>
+                </div>
+              ) : (
+                <div className="mpc-card-foot">
+                  <span className="mpc-toggle"><span className="mpc-small">Allowed</span>
+                    <Switch on={s.allowed} label={`${p.name}: allowed in Engineering`} inert={member} changed={s.allowed !== p.allowed}
+                      onChange={(v) => setState({ ...state, [p.name]: { allowed: v, every: v ? s.every : false } })} />
+                  </span>
+                  <span className="mpc-toggle"><span className="mpc-small">Every step</span>
+                    <Switch on={s.every} label={`${p.name}: on for every step`} inert={member || !s.allowed} changed={s.every !== p.everyStep}
+                      onChange={(v) => setState({ ...state, [p.name]: { ...s, every: v } })} />
+                  </span>
+                </div>
+              )}
+            </li>
+          )
+        })}
+      </ul>
+      {changed.length > 0 && (
+        <div className="mpc-savebar" role="region" aria-label="Changes not saved">
+          <span className="mpc-small">{changed.map((p) => p.name).join(', ')}: changed · refused or loaded from the next submission</span>
+          <span className="mpc-acts">
+            <Button kind="ghost" onClick={() => setState(Object.fromEntries(PLUGINS.map((p) => [p.name, { allowed: p.allowed, every: p.everyStep }])))}>Discard</Button>
+            <Button kind="primary">Save and sign</Button>
+          </span>
+        </div>
+      )}
+    </>
+  )
+}
+
+/* ---------------------------------------------------------------- platform switches */
+
+function PlatformSwitches({ open }: { open: boolean }) {
+  const [contracts, setContracts] = useState(true)
+  const [review, setReview] = useState<'off' | 'report' | 'enforce'>(open ? 'enforce' : 'report')
+  const pending = review !== 'report' || !contracts
+  return (
+    <section className="mpc-switches" aria-label="Platform settings">
+      <div className="mpc-sw">
+        <div className="mpc-sw-l">
+          <span className="mpc-sw-t">Work contracts
+            <InfoTip about="work contracts" tip="Each step runs under a signed work contract. Off: steps from the next submission carry none; running steps keep theirs." />
+          </span>
+          <span className="mpc-small mpc-dim">ops@example.com · 2 Nov 2026, 14:08</span>
+        </div>
+        <Switch on={contracts} label="Work contracts" onChange={setContracts} />
+      </div>
+      <div className="mpc-sw">
+        <div className="mpc-sw-l">
+          <span className="mpc-sw-t">Jev’s contract review
+            <InfoTip end about="contract review" tip="Report: Jev’s findings go on the run; nothing is held. Enforce: a step whose contract fails review is refused at submission, in every workspace." />
+          </span>
+          <span className="mpc-small mpc-dim">owner@example.com · 5 Nov 2026, 22:41</span>
+        </div>
+        <div className="mpc-seg" role="radiogroup" aria-label="Jev’s contract review">
+          {(['off', 'report', 'enforce'] as const).map((k) => (
+            <label key={k} className={`mpc-seg-o${review === k ? ' is-on' : ''}`}>
+              <input type="radio" name="mpc-review" checked={review === k} onChange={() => setReview(k)} />
+              {k === 'off' ? 'Off' : k === 'report' ? 'Report' : 'Enforce'}
+            </label>
+          ))}
+        </div>
+      </div>
+      {pending && (
+        <div className="mpc-sw-pending" role="region" aria-label="Change not applied">
+          <span className="mpc-small">
+            {review !== 'report' && <>Contract review: Report → <b>{review === 'off' ? 'Off' : 'Enforce'}</b> · every workspace, from the next submission</>}
+            {!contracts && <>Work contracts: On → <b>Off</b></>}
+          </span>
+          <span className="mpc-acts">
+            <Button size="sm" kind="ghost" onClick={() => { setReview('report'); setContracts(true) }}>Cancel</Button>
+            <Button size="sm" kind="primary">Apply</Button>
+          </span>
+        </div>
+      )}
+    </section>
+  )
+}
+
+/* ---------------------------------------------------------------- add plugin */
+
+function AddPage({ where, at }: { where: 'admin' | 'workspace'; at: At }) {
+  const src = at.src
+  const [target, setTarget] = useState<'platform' | 'workspace'>(where === 'admin' && src !== 'upload' ? 'platform' : 'workspace')
+  const st = at.st // '' resolving | 'read' | 'failed'
+  const upload = src === 'upload'
+  const read = st === 'read' || upload
+  const failed = st === 'failed'
+  const p = upload ? PLUGINS[3]! : PLUGINS[2]!
+  const back = href(where, { s: 'catalogue' })
+  return (
+    <div className="mpc-page">
+      <nav className="mpc-crumb" aria-label="Breadcrumb"><a href={back}>Plugins</a><span aria-hidden>/</span><span>Add plugin</span></nav>
+      <PageHead title="Add plugin" />
+      <div className="mpc-add">
+        <section className="mpc-panel mpc-src" aria-label="Source">
+          <div className="mpc-field">
+            <span className="mpc-lbl">Install into</span>
+            <div className="mpc-seg is-wide" role="radiogroup" aria-label="Install into">
+              {where === 'admin' && (
+                <label className={`mpc-seg-o${target === 'platform' ? ' is-on' : ''}`}>
+                  <input type="radio" name="mpc-target" checked={target === 'platform'} onChange={() => setTarget('platform')} />Platform catalogue
+                </label>
+              )}
+              <label className={`mpc-seg-o${target === 'workspace' ? ' is-on' : ''}`}>
+                <input type="radio" name="mpc-target" checked={target === 'workspace'} onChange={() => setTarget('workspace')} />Engineering only
+              </label>
+            </div>
+          </div>
+          <div className="mpc-field">
+            <span className="mpc-lbl">Source</span>
+            <div className="mpc-srctabs" role="tablist" aria-label="Source">
+              {([['github', 'GitHub'], ['marketplace', 'Marketplace'], ['upload', 'Upload']] as const).map(([k, l]) => (
+                <a key={k} role="tab" aria-selected={src === k} className={`mpc-srctab${src === k ? ' is-on' : ''}`} href={href(where, { s: 'add', src: k })}>{l}</a>
+              ))}
+            </div>
+          </div>
+          {src === 'github' && (
+            <>
+              <div className="mpc-field">
+                <label className="mpc-lbl" htmlFor="mpc-repo">Repository
+                  <InfoTip about="the repository" tip={target === 'platform'
+                    ? 'Fetched with the platform’s GitHub App. A private repository needs the App installed on its owner.'
+                    : 'Fetched through Engineering’s GitHub connection, so a private repository it reaches works.'} />
