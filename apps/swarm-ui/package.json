{
  "name": "swarm-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "NODE_OPTIONS=--max-old-space-size=3072 eslint --concurrency 2 --max-warnings 0 .",
    "lint:prune": "NODE_OPTIONS=--max-old-space-size=3072 eslint --concurrency 2 --prune-suppressions .",
    "test": "npm run test:components && npm run test:node",
    "test:components": "vitest run",
    "test:node": "node tests/run.mjs && node --import ./test/register-ts.mjs --test test/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@novnc/novnc": "1.4.0",
    "@visx/axis": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "dompurify": "3.4.17",
    "mermaid": "12.2.0",
    "onnxruntime-web": "1.31.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vis-network": "10.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.14.0",
    "jsdom": "25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.73.0",
    "vite": "^5.4.11",
    "vitest": "3.2.7"
  }
}
