index 0000000..cb18569
--- /dev/null
+++ b/apps/swarm-ui/src/StepCardB.tsx
@@ -0,0 +1,345 @@
+// MOCK-HOOK FILE
+// Step-card mock-up, direction B (?sc=b): the inspector head is the card's title (step + state), then a sticky
+// action bar of icon-and-label buttons, three or four stat tiles, a short attempt timeline, and one Details fold.
+// Every fact here is an invented fixture (MOCK-HOOK); nothing is read from the API.
+import { useEffect, useState, useSyncExternalStore, type ReactNode } from 'react'
+import { Button, ButtonLink } from './components'
+import './styles/step-card-b.css'
+
+export type ScbKind = 'running' | 'finished' | 'failed' | 'parked' | 'attempts'
+
+type Outcome = 'running' | 'succeeded' | 'failed'
+
+interface Attempt {
+  outcome: Outcome
+  /** Start, as the clock prints it (UTC). */
+  start: string
+  /** End, or null while it runs. */
+  end: string | null
+  ms: number
+  /** A running attempt's start as an instant, so its elapsed time keeps pace with the graph's node. */
+  since?: number
+  exit: number | null
+  costUsd: number | null
+  tokens: number | null
+  checkpoints: number
+}
+
+interface Fixture {
+  attempts: readonly Attempt[]
+  allowed: number
+  pr: number | null
+  /** Files changed, or null when the step's changes were not counted. */
+  files: number | null
+  error: string | null
+  waitsOn: string | null
+  /** Other workflows of this shape on the board that hold this step. */
+  others: number
+}
+
+const FIXTURES: Readonly<Record<ScbKind, Fixture>> = {
+  running: {
+    attempts: [{ outcome: 'running', start: 'Oct 19 11:41', end: null, ms: 0, since: Date.UTC(2026, 9, 19, 11, 41), exit: null, costUsd: null, tokens: 182_400, checkpoints: 2 }],
+    allowed: 3,
+    pr: null,
+    files: null,
+    error: null,
+    waitsOn: null,
+    others: 0,
+  },
+  finished: {
+    attempts: [{ outcome: 'succeeded', start: '11:36', end: '11:41', ms: 5 * 60_000 + 3_000, exit: 0, costUsd: 0.42, tokens: 1_204_000, checkpoints: 3 }],
+    allowed: 3,
+    pr: 3251,
+    files: 7,
+    error: null,
+    waitsOn: null,
+    others: 2,
+  },
+  failed: {
+    // THREE ATTEMPTS, AS THE GRAPH'S FIXTURE RECORDS ("attempt 3 of 3"); the newest is the node's 59s.
+    attempts: [
+      { outcome: 'failed', start: '11:20', end: '11:22', ms: 1 * 60_000 + 41_000, exit: 2, costUsd: 0.09, tokens: 81_000, checkpoints: 1 },
+      { outcome: 'failed', start: '11:22', end: '11:24', ms: 1 * 60_000 + 12_000, exit: 2, costUsd: 0.07, tokens: 64_500, checkpoints: 1 },
+      { outcome: 'failed', start: '11:25', end: '11:26', ms: 59_000, exit: 2, costUsd: 0.11, tokens: 96_300, checkpoints: 1 },
+    ],
+    allowed: 3,
+    pr: null,
+    files: 2,
+    error:
+      'exit status 2: pytest was interrupted: 1 error during collection\n' +
+      'ERROR tests/unit/test_checkpoints.py - ImportError: cannot import name ‘Checkpoint’\n' +
+      'from swarm_common.checkpoints (apps/common/swarm_common/checkpoints.py)\n' +
+      '!!!!!!!! Interrupted: 1 error during collection !!!!!!!!',
+    waitsOn: null,
+    others: 1,
+  },
+  parked: { attempts: [], allowed: 3, pr: null, files: null, error: null, waitsOn: 'scan-terraform', others: 0 },
+  attempts: {
+    attempts: [
+      // THE NEWEST IS THE NODE'S 2m; the three differ in length so the bar shows it.
+      { outcome: 'failed', start: '11:32', end: '11:33', ms: 1 * 60_000 + 5_000, exit: 137, costUsd: 0.08, tokens: 41_200, checkpoints: 0 },
+      { outcome: 'failed', start: '11:33', end: '11:38', ms: 5 * 60_000 + 2_000, exit: 1, costUsd: null, tokens: null, checkpoints: 1 },
+      { outcome: 'succeeded', start: '11:38', end: '11:40', ms: 2 * 60_000 + 10_000, exit: 0, costUsd: 0.31, tokens: 140_900, checkpoints: 4 },
+    ],
+    allowed: 3,
+    pr: null,
+    files: 3,
+    error: null,
+    waitsOn: null,
+    others: 0,
+  },
+}
+
+// THE STEP THE CARD SHOWS, for the Needs-you row of the same step: the card holds its error, so the row does not
+// print it again (review sc-b, finding 6).
+let shown: string | null = null
+const heard = new Set<() => void>()
+const setShown = (id: string | null) => {
+  shown = id
+  heard.forEach((f) => f())
+}
+export function useScbShown(): string | null {
+  return useSyncExternalStore(
+    (f) => {
+      heard.add(f)
+      return () => heard.delete(f)
+    },
+    () => shown,
+    () => null,
+  )
+}
+
+/** `?sc=b` turns the mock on; `&scx=<kind>` pins a fixture, else the step's own state picks one. */
+export function scbOn(): boolean {
+  return typeof window !== 'undefined' && new URLSearchParams(window.location.search).get('sc') === 'b'
+}
+
+export function scbKind(hue: string, word: string): ScbKind {
+  const pinned = new URLSearchParams(window.location.search).get('scx')
+  if (pinned !== null && pinned in FIXTURES) return pinned as ScbKind
+  if (word.includes('fail')) return 'failed'
+  if (word.includes('run')) return 'running'
+  if (hue === 'park' || word.includes('park') || word.includes('not started')) return 'parked'
+  return 'finished'
+}
+
+const dur = (ms: number) => {
+  const h = Math.floor(ms / 3_600_000)
+  if (h >= 24) return `${Math.floor(h / 24)}d ${h % 24}h`
+  const m = Math.floor(ms / 60_000)
+  const s = Math.floor((ms % 60_000) / 1000)
+  if (m === 0) return `${s}s`
+  return m >= 60 ? `${Math.floor(m / 60)}h ${m % 60}m` : `${m}m ${String(s).padStart(2, '0')}s`
+}
+const tok = (n: number) => (n >= 1_000_000 ? `${(n / 1_000_000).toFixed(1)}M` : `${Math.round(n / 1000)}k`)
+const WORD: Record<Outcome, string> = { running: 'running', succeeded: 'succeeded', failed: 'failed' }
+
+function Ic({ d }: { d: ReactNode }) {
+  return (
+    <svg className="c-ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+      {d}
+    </svg>
+  )
+}
+const IC = {
+  agent: <Ic d={<><rect x="5" y="7" width="14" height="11" rx="3" /><path d="M12 7V4M9 12h.01M15 12h.01M9.5 15h5" /></>} />,
+  logs: <Ic d={<path d="M5 6h14M5 10h14M5 14h9M5 18h6" />} />,
+  changes: <Ic d={<><path d="M12 5v6M9 8h6M9 17h6" /><rect x="4.5" y="3.5" width="15" height="17" rx="2" /></>} />,
+  pr: <Ic d={<><circle cx="7" cy="6" r="2" /><circle cx="7" cy="18" r="2" /><circle cx="17" cy="18" r="2" /><path d="M7 8v8M17 16V9a2 2 0 0 0-2-2h-4M13 5l-2 2 2 2" /></>} />,
+  stop: <Ic d={<rect x="7" y="7" width="10" height="10" rx="1.5" />} />,
+  retry: <Ic d={<><path d="M19 12a7 7 0 1 1-2.05-4.95" /><path d="M19 4v4h-4" /></>} />,
+  prev: <Ic d={<path d="m15 6-6 6 6 6" />} />,
+  next: <Ic d={<path d="m9 6 6 6-6 6" />} />,
+}
+
+/** One stat: label over figure; an unreported figure is a dash whose tooltip says so. */
+function Tile({ label, value, missing, hint }: { label: string; value: string | null; missing: string; hint?: string }) {
+  return (
+    <div className={`scb-tile${value === null ? ' is-absent' : ''}`}>
+      <span className="scb-tile-k">{label}</span>
+      {value === null ? (
+        <span className="scb-tile-v" title={missing} aria-label={`${label}: ${missing}`} tabIndex={0}>
+          —
+        </span>
+      ) : (
+        <span className="scb-tile-v" title={hint}>
+          {value}
+        </span>
+      )}
+    </div>
+  )
+}
+
+export function StepCardB({ kind, stepId, agentHref }: { kind: ScbKind; stepId: string; agentHref: string }) {
+  const fx = FIXTURES[kind]
+  const n = fx.attempts.length
+  // THE PAGER STARTS ON THE NEWEST ATTEMPT; `&sca=<n>` pins one for a frame.
+  const pinned = Number(new URLSearchParams(window.location.search).get('sca'))
+  const [at, setAt] = useState(pinned >= 1 && pinned <= n ? pinned - 1 : n - 1)
+  const [whole, setWhole] = useState(false)
+  useEffect(() => {
+    document.documentElement.classList.add('scb')
+    setShown(stepId)
+    return () => {
+      document.documentElement.classList.remove('scb')
+      setShown(null)
+    }
+  }, [stepId])
+  const tries = fx.attempts.map((a) => (a.since === undefined ? a : { ...a, ms: Math.max(0, Date.now() - a.since) }))
+  const cur = tries[at] ?? null
+  const running = cur !== null && cur.outcome === 'running'
+  const total = tries.reduce((s, a) => s + a.ms, 0)
+  // A FAILED STEP'S ONE ACTION IS RETRY, ON THE CARD (finding 7): only once its newest attempt has failed.
+  const retry = n > 0 && fx.attempts[n - 1]!.outcome === 'failed'
+  const others = fx.others > 0
+  const details = cur !== null || others
+
+  return (
+    <section className="scb" aria-label={`Step ${stepId}`}>
+      <div className="scb-bar" role="toolbar" aria-label="Step actions">
+        <ButtonLink href={agentHref} size="sm" icon={IC.agent}>
+          Agent
+        </ButtonLink>
+        {n > 0 && (
+          <ButtonLink href={`${agentHref}/logs`} size="sm" icon={IC.logs}>
+            Logs
+          </ButtonLink>
+        )}
+        {n > 0 && (
+          <ButtonLink
+            href="#changes"
+            size="sm"
+            icon={IC.changes}
+            title={fx.files === null ? 'Not counted yet' : `This step’s changes in this workflow`}
+          >
+            Changes
+            {fx.files !== null && <span className="scb-count">{fx.files}</span>}
+          </ButtonLink>
+        )}
+        {fx.pr !== null && (
+          <ButtonLink href="#pr" size="sm" icon={IC.pr} title="Opens on GitHub">
+            PR #{fx.pr}
+          </ButtonLink>
+        )}
+        {running && (
+          <Button size="sm" kind="danger" icon={IC.stop} className="scb-stop">
+            Stop
+          </Button>
+        )}
+        {retry && (
+          <Button size="sm" kind="primary" icon={IC.retry} className="scb-stop">
+            Retry
+          </Button>
+        )}
+      </div>
+
+      {/* ONE LINE; the head's ↑ is its action (finding 9), so the card draws no second one. */}
+      {fx.waitsOn !== null && (
+        <div className="scb-wait">
+          Waits on <b className="mono">{fx.waitsOn}</b>
+        </div>
+      )}
+
+      {fx.error !== null && (
+        <div className="scb-err" role="group" aria-label="Error">
+          <pre className={`scb-err-text${whole ? ' is-whole' : ''}`}>{fx.error}</pre>
+          {fx.error.split('\n').length > 2 && (
+            <Button size="sm" onClick={() => setWhole(!whole)} aria-expanded={whole}>
+              {whole ? 'Less' : 'Show all'}
+            </Button>
+          )}
+        </div>
+      )}
+
+      {cur !== null && (
+        <div className="scb-tiles">
+          <Tile label="Elapsed" value={dur(cur.ms)} missing="" />
+          <Tile label="Attempt" value={`${at + 1} / ${fx.allowed}`} missing="" hint={`Attempt ${at + 1} of the ${fx.allowed} allowed`} />
+          <Tile label="Cost" value={cur.costUsd === null ? null : `$${cur.costUsd.toFixed(2)}`} missing={running ? 'Cost is reported when the attempt ends' : 'This attempt’s cost was not reported'} />
+          <Tile label="Tokens" value={cur.tokens === null ? null : tok(cur.tokens)} missing="This attempt’s tokens were not reported" />
+        </div>
+      )}
+
+      {cur !== null && (
+        <div className="scb-tl">
+          <div className="scb-tl-row">
+            {n > 1 && (
+              <Button size="sm" kind="ghost" iconOnly icon={IC.prev} disabled={at === 0} onClick={() => setAt(at - 1)}>
+                Previous attempt
+              </Button>
+            )}
+            <ol className={`scb-tl-bar${n === 1 ? ' is-one' : ''}`} aria-label="Attempts">
+              {tries.map((a, i) => (
+                <li key={i} style={{ flexGrow: n === 1 ? 1 : Math.max(a.ms / total, 0.12) * 100 }}>
+                  {n === 1 ? (
+                    <span className={`scb-seg is-${a.outcome}`} title={`${WORD[a.outcome]} · ${dur(a.ms)}`} />
+                  ) : (
+                    <button
+                      type="button"
+                      className={`scb-seg is-${a.outcome}${i === at ? ' is-here' : ''}`}
+                      aria-pressed={i === at}
+                      title={`Attempt ${i + 1} · ${WORD[a.outcome]} · ${dur(a.ms)}${a.exit !== null ? ` · exit ${a.exit}` : ''}`}
+                      onClick={() => setAt(i)}
+                    >
+                      {i + 1}
+                    </button>
+                  )}
+                </li>
+              ))}
+            </ol>
+            {n > 1 && (
+              <Button size="sm" kind="ghost" iconOnly icon={IC.next} disabled={at === n - 1} onClick={() => setAt(at + 1)}>
+                Next attempt
+              </Button>
+            )}
+          </div>
+          {/* THE SELECTED ATTEMPT'S OWN TIMES (finding 11): with one attempt the bar is that attempt, so its ends
+              are the bar's; with several, one span under the bar names the ringed segment's start and end. */}
+          {n === 1 ? (
+            <div className="scb-tl-ends">
+              <span title="Started (UTC)">{cur.start}</span>
+              <span title={running ? 'Still running' : 'Ended (UTC)'}>{cur.end ?? 'now'}</span>
+            </div>
+          ) : (
+            <div className="scb-tl-ends is-one-span" title={`Attempt ${at + 1}, UTC`}>
+              <span>
+                {cur.start} – {cur.end ?? 'now'}
+              </span>
+            </div>
+          )}
+        </div>
+      )}
+
+      {details && (
+        <details className="scb-more" open={new URLSearchParams(window.location.search).get('scd') === '1'}>
+          <summary>Details</summary>
+          <dl className="scb-facts">
+            {cur !== null && (
+              <>
+                <dt>Exit code</dt>
+                <dd title={cur.exit === null ? 'Still running' : undefined}>{cur.exit ?? '—'}</dd>
+                <dt>Checkpoints</dt>
+                <dd>{cur.checkpoints}</dd>
+              </>
+            )}
+            {others && (
+              <>
+                <dt>Other workflows</dt>
+                <dd className="scb-others">
+                  <Button size="sm" kind="ghost" iconOnly icon={IC.prev} disabled>
+                    Newer workflow
+                  </Button>
+                  <span>1 / {fx.others + 1}</span>
+                  <Button size="sm" kind="ghost" iconOnly icon={IC.next}>
+                    Older workflow
+                  </Button>
+                </dd>
+              </>
+            )}
+          </dl>
+        </details>
+      )}
+    </section>
+  )
+}
