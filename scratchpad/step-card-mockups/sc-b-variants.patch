diff --git a/apps/swarm-ui/src/styles/step-card-b.css b/apps/swarm-ui/src/styles/step-card-b.css
new file mode 100644
index 0000000..f61be8d
--- /dev/null
+++ b/apps/swarm-ui/src/styles/step-card-b.css
@@ -0,0 +1,175 @@
+/* MOCK-HOOK FILE
+   Step-card mock-up, direction B (?sc=b). Tokens only, so both themes draw it. */
+
+/* The inspector's head is the card's title: the step and its state, one step up in size. */
+.scb .wi-title-text { font-size: var(--t-lead); }
+
+.scb { display: flex; flex-direction: column; gap: var(--ctl-s3); min-width: 0; }
+
+/* The action bar sticks under the inspector's own sticky head while the body scrolls. */
+.scb-bar {
+  position: sticky;
+  top: 39px;
+  z-index: 1;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--ctl-s2);
+  padding: var(--ctl-s2) 0;
+  background: var(--bg);
+  border-bottom: 1px solid var(--line-soft);
+}
+.scb-bar .scb-stop { margin-left: auto; }
+.scb-bar .scb-stop ~ .scb-stop { margin-left: 0; }
+.scb-count {
+  min-width: 18px;
+  padding: 0 5px;
+  border-radius: 9px;
+  background: var(--surface-2);
+  color: var(--text-dim);
+  font: 550 var(--t-micro) / var(--lh-micro) var(--mono);
+  text-align: center;
+}
+
+/* Parked, never attempted: one line; the head's ↑ is its action. */
+.scb-wait {
+  padding: var(--ctl-s2) var(--ctl-s3);
+  border: 1px dashed color-mix(in srgb, var(--s-park) 60%, transparent);
+  border-radius: var(--r-ctl);
+  color: var(--text);
+  font-size: var(--t-body);
+}
+
+/* The error, in the agent's own words: four lines, the rest one press away. */
+.scb-err {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--ctl-s1);
+  padding: var(--ctl-s2) var(--ctl-s3);
+  border: 1px solid color-mix(in srgb, var(--s-bad) 55%, transparent);
+  border-left-width: 3px;
+  border-radius: var(--r-ctl);
+  background: color-mix(in srgb, var(--s-bad) 7%, var(--surface));
+}
+.scb-err-text {
+  margin: 0;
+  max-width: 100%;
+  color: var(--text);
+  font: var(--t-micro) / var(--lh-micro) var(--mono);
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  display: -webkit-box;
+  -webkit-line-clamp: 3;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.scb-err-text.is-whole { display: block; }
+
+/* Stat tiles: label over figure, no box (design-system §6.2); an absent figure is a dashed dash. */
+.scb-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(92px, 1fr)); gap: var(--ctl-s2); }
+.scb-tile {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+  padding: var(--ctl-s2) 10px;
+  border: 1px solid transparent;
+  border-radius: var(--r-ctl);
+  background: var(--surface);
+}
+.scb-tile.is-absent { border-style: dashed; border-color: var(--line-soft); background: none; }
+.scb-tile-k { color: var(--text-faint); font: 550 var(--t-micro) / var(--lh-micro) var(--font); }
+.scb-tile-v {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--text);
+  font: 600 var(--t-lead) / var(--lh-flush) var(--font);
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.scb-tile.is-absent .scb-tile-v { color: var(--text-faint); cursor: help; width: fit-content; }
+.scb-tile-v:focus-visible { outline: 2px solid var(--info); outline-offset: 2px; border-radius: 4px; }
+
+/* The attempt timeline: one segment per attempt, as long as it ran; the pager's arrows at its ends. */
+.scb-tl { display: flex; flex-direction: column; gap: 4px; }
+.scb-tl-row { display: flex; align-items: center; gap: var(--ctl-s1); }
+.scb-tl-bar { display: flex; flex: 1 1 auto; gap: 3px; margin: 0; padding: 0; list-style: none; min-width: 0; }
+.scb-tl-bar > li { flex-basis: 0; min-width: 28px; }
+.scb-seg {
+  width: 100%;
+  height: 24px;
+  border: 1px solid transparent;
+  border-radius: 6px;
+  font: 600 var(--t-micro) / var(--lh-flush) var(--mono);
+  color: var(--text);
+  cursor: pointer;
+}
+.scb-seg.is-succeeded { background: color-mix(in srgb, var(--ok) 22%, var(--surface)); }
+.scb-seg.is-failed { background: color-mix(in srgb, var(--s-bad) 22%, var(--surface)); }
+.scb-seg.is-running {
+  background: repeating-linear-gradient(-45deg, color-mix(in srgb, var(--s-live) 30%, var(--surface)) 0 6px, color-mix(in srgb, var(--s-live) 16%, var(--surface)) 6px 12px);
+}
+.scb-tl-bar.is-one .scb-seg { display: block; height: 10px; }
+.scb-seg.is-here { border-color: var(--text); box-shadow: inset 0 0 0 1px var(--text); }
+.scb-seg:focus-visible { outline: 2px solid var(--info); outline-offset: 2px; }
+.scb-tl-ends { display: flex; justify-content: space-between; color: var(--text-faint); font: var(--t-micro) / var(--lh-micro) var(--mono); }
+.scb-tl-ends.is-one-span { justify-content: center; }
+
+/* Everything else, behind one fold. */
+.scb-more { border-top: 1px solid var(--line-soft); padding-top: var(--ctl-s2); }
+.scb-more > summary {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  height: var(--h-sm);
+  padding: 0 10px;
+  border: 1px solid var(--ctl-bd, var(--line));
+  border-radius: var(--r-ctl);
+  background: var(--surface);
+  color: var(--text);
+  font: 550 var(--t-micro) / var(--lh-flush) var(--font);
+  cursor: pointer;
+  list-style: none;
+}
+.scb-more > summary::-webkit-details-marker { display: none; }
+.scb-more > summary::before { content: '▸'; color: var(--text-dim); }
+.scb-more[open] > summary::before { content: '▾'; }
+.scb-more > summary:focus-visible { outline: 2px solid var(--info); outline-offset: 2px; }
+.scb-facts {
+  display: grid;
+  grid-template-columns: max-content minmax(0, 1fr);
+  gap: 6px var(--ctl-s3);
+  align-items: center;
+  margin: var(--ctl-s2) 0 0;
+  font-size: var(--t-meta);
+}
+.scb-facts dt { color: var(--text-dim); }
+.scb-facts dd { margin: 0; color: var(--text); font-variant-numeric: tabular-nums; }
+.scb-others { display: inline-flex; align-items: center; gap: var(--ctl-s1); }
+
+/* THE SHEET'S BACK IS A BUTTON, not an arrow-styled link (finding 12). */
+.scb .wi-back {
+  display: inline-flex;
+  align-items: center;
+  height: var(--h-sm);
+  min-height: 0;
+  padding: 0 10px;
+  border: 1px solid var(--ctl-bd, var(--line));
+  border-radius: var(--r-ctl);
+  background: var(--surface);
+  color: var(--text);
+  font: 550 var(--t-micro) / var(--lh-flush) var(--font);
+}
+.scb .wi-back:hover { background: var(--surface-2); }
+
+@media (max-width: 720px) {
+  .scb-bar { position: static; }
+  /* ONE ROW ON A PHONE (finding 12): the buttons share the width rather than leave one on a row by itself. */
+  .scb-bar { flex-wrap: nowrap; gap: 6px; }
+  .scb-bar > .c-btn { flex: 1 1 auto; min-width: 0; justify-content: center; padding: 0 8px; }
+  .scb-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
