+.pc-options > li.is-shown { border-color: var(--text); }
+.pc-options .c-chip { margin-left: 8px; }
+.pc-html { width: 100%; height: 360px; border: 1px solid var(--line); border-radius: var(--r-ctl); background: #fff; }
+.pc-html.is-tall { height: 520px; }
+.pc-diagram { max-width: 100%; height: auto; background: #fff; border-radius: var(--r-ctl); border: 1px solid var(--line); }
+.pc-pre { white-space: pre-wrap; font: var(--t-micro)/var(--lh-micro) var(--mono); margin: 0; }
+.pc-fig { margin: 8px 0; }
+.pc-fig figcaption { font-size: var(--t-micro); color: var(--text-dim); }
+.pc-cap { caption-side: top; text-align: left; padding: 8px 12px; font-size: var(--t-meta); font-weight: 600; }
+.c-tbl td.pc-wrap { white-space: normal; padding-top: 6px; padding-bottom: 6px; }
+.pc-item > p { margin: 0 0 4px; }
+.c-card > .pc-item + .pc-item { margin-top: 0; }
