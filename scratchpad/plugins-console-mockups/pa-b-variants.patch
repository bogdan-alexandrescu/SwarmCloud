@@ -0,0 +1,199 @@
+// MOCK-HOOK FILE: direction B, the workflow builder's steps with a one-line plugin chip, and the guided picker
+// sheet (plugin, then mode, then skills) (features.md §2, B1-B11).
+
+import { useState } from 'react'
+import { Button, Chip, Dash } from '../../components'
+import { PageHead } from '../../Shell'
+import {
+  MODES, builderSteps, gstackEntry, neverOffered, pluginsRead, refusalWords, skillNotes, workflowName,
+  type BuilderStep, type PluginMode, type UsedPlugins,
+} from '../fixtures'
+import { MODE_MEANS, MODE_WORDS } from '../parts'
+import type { MockState } from '../switches'
+
+/** rest: the six steps, the two gstack steps' chips, the review step's last run. open: the sheet open on
+ *  `review`, unattended chosen, two of its skills ticked so far. answered: the finished run, what each used. */
+export function BuilderB({ state, bridgeLanded }: { state: MockState; bridgeLanded: boolean }) {
+  const [open, setOpen] = useState<string | null>(state === 'open' ? 'review' : null)
+  const finished = state === 'answered'
+  return (
+    <div className={`pb-page pb-builder${open !== null ? ' has-sheet' : ''}`}>
+      <PageHead title="A workflow" />
+      <div className="pb-wf-head">
+        <span className="pb-dim">Workflow</span> <b>{workflowName}</b>
+        <span className="pb-dim">· {builderSteps.length} steps · repository</span> <code>example-org/roombook</code>
+      </div>
+      <div className="pb-build">
+        <ol className="pb-steps" role="list">
+          {builderSteps.map((s, i) => (
+            <StepRow key={s.step_id} n={i + 1} step={s} finished={finished}
+              picking={open === s.step_id} onPick={() => setOpen(open === s.step_id ? null : s.step_id)} />
+          ))}
+        </ol>
+        {open !== null && (
+          <PickerSheet step={builderSteps.find((s) => s.step_id === open)!} bridgeLanded={bridgeLanded}
+            half={state === 'open'} onClose={() => setOpen(null)} />
+        )}
+      </div>
+      <div className="pb-submitbar">
+        <span className="pb-dim">1 step is refused; the workflow cannot be submitted until it changes.</span>
+        <Button kind="primary" disabled>Submit workflow</Button>
+      </div>
+    </div>
+  )
+}
+
+function StepRow({ n, step, finished, picking, onPick }: { n: number; step: BuilderStep; finished: boolean; picking: boolean; onPick: () => void }) {
+  const loads = gstackEntry(true).runner_profiles.includes(step.runner_profile)
+  const gs = step.plugins?.gstack
+  return (
+    <li className={`pb-step${picking ? ' is-picking' : ''}${step.refusal !== null ? ' is-refused' : ''}`}>
+      <span className="pb-step-n">{n}</span>
+      <div className="pb-step-body">
+        <div className="pb-step-top">
+          <b className="pb-step-id">{step.step_id}</b>
+          <span className="pb-step-title">{step.title}</span>
+        </div>
+        <div className="pb-row pb-small">
+          <span className="pb-dim">Runner</span> <Chip>{step.runner_profile}</Chip>
+          {step.depends_on.length > 0 && <><span className="pb-dim">after</span> {step.depends_on.map((d) => <code key={d}>{d}</code>)}</>}
+        </div>
+        <div className="pb-row pb-step-plugin" data-f="B8">
+          {gs !== undefined ? (
+            <button type="button" className={`pb-sumchip${step.refusal !== null ? ' is-bad' : ''}`} onClick={onPick}
+              title={`gstack, ${MODE_WORDS[gs.mode]} mode: ${gs.skills.join(', ')}`} aria-expanded={picking}>
+              <span className="pb-sumchip-k">gstack</span>
+              <span>{MODE_WORDS[gs.mode]}</span>
+              <span className="pb-sumchip-s">{gs.skills.join(' · ')}</span>
+            </button>
+          ) : loads ? (
+            <Button size="sm" kind="ghost" onClick={onPick}>+ Add a plugin</Button>
+          ) : (
+            <span className="pb-dim pb-small">Plugins: this runner profile cannot load them</span>
+          )}
+        </div>
+        {step.refusal !== null && (
+          <p className="pb-refusal" data-f="B5 B11" role="alert">
+            <b>Refused at submission:</b> {step.refusal}. Pick a claude-code profile, or remove the plugin.
+          </p>
+        )}
+        {step.used !== null && (finished || step.step_id === 'review' || step.step_id === 'plan-checkout') && <UsedLine used={step.used} />}
+      </div>
+    </li>
+  )
+}
+
+/** What the last finished attempt used (B9) and how often each skill ran (B10); not read is a dash, not 0. */
+function UsedLine({ used }: { used: UsedPlugins }) {
+  return (
+    <>
+      {Object.entries(used).map(([name, u]) => (
+        <div key={name} className="pb-used" data-f="B9 B10">
+          <span className="pb-dim">Last run used</span>
+          <span className="pb-used-p">{name} {u.version} · {MODE_WORDS[u.mode]}</span>
+          {u.skills.map((s) => (
+            <span key={s} className="pb-used-s">
+              <code>{s}</code>
+              {u.skill_runs === null
+                ? <Dash why="Not known: the agent's stream was not read, so no run was counted" />
+                : <b className={(u.skill_runs[s] ?? 0) === 0 ? 'is-zero' : ''}>×{u.skill_runs[s] ?? 0}</b>}
+            </span>
+          ))}
+          {u.skill_runs === null && <span className="pb-dim pb-small">times each ran: not known (stream not read)</span>}
+        </div>
+      ))}
+    </>
+  )
+}
+
+/** The guided sheet: 1 plugin, 2 mode, 3 skills; each a choice by name from the catalogue. */
+function PickerSheet({ step, bridgeLanded, half, onClose }: { step: BuilderStep; bridgeLanded: boolean; half: boolean; onClose: () => void }) {
+  const read = pluginsRead({ canEdit: true, bridgeLanded })
+  const entry = read.catalogue[0]!
+  const loads = entry.runner_profiles.includes(step.runner_profile)
+  const chosen = step.plugins?.gstack
+  const [mode, setMode] = useState<PluginMode>(chosen?.mode ?? 'unattended')
+  const offered = entry.modes[mode].skills
+  const [ticked, setTicked] = useState<string[]>(half ? ['review', 'investigate'] : chosen?.skills ?? [])
+  const toggle = (s: string) => setTicked(ticked.includes(s) ? ticked.filter((x) => x !== s) : [...ticked, s])
+  return (
+    <aside className="pb-sheet" aria-label={`Plugin for step ${step.step_id}`}>
+      <header className="pb-sheet-h">
+        <div>
+          <span className="pb-dim pb-small">Plugin for step</span>
+          <h2>{step.step_id}</h2>
+        </div>
+        <Button size="sm" kind="ghost" onClick={onClose}>Close</Button>
+      </header>
+
+      <section className="pb-q" data-f="B1 B4 B5">
+        <h3><span className="pb-q-n">1</span>Plugin</h3>
+        {!loads ? (
+          <p className="pb-refusal">{refusalWords.profile(step.runner_profile)}.</p>
+        ) : (
+          <ul className="pb-choices" role="list">
+            {read.catalogue.map((p) => {
+              const allowed = read.plugins.allowed.includes(p.name)
+              return (
+                <li key={p.name}>
+                  <label className={`pb-choice${allowed ? ' is-on' : ' is-off'}`}>
+                    <input type="radio" name="pb-plugin" defaultChecked={allowed} disabled={!allowed} />
+                    <span><b>{p.name}</b> <Chip>{p.version}</Chip><br />
+                      <span className="pb-dim pb-small">{allowed ? `Allowed in this workspace · runs on ${step.runner_profile}` : refusalWords.notAllowed}</span>
+                    </span>
+                  </label>
+                </li>
+              )
+            })}
+          </ul>
+        )}
+        <p className="pb-dim pb-small">Only plugins this workspace allows can be picked (Config › Plugins).</p>
+      </section>
+
+      <section className="pb-q" data-f="B2 B7">
+        <h3><span className="pb-q-n">2</span>Mode</h3>
+        <ul className="pb-choices" role="list">
+          {MODES.map((m) => {
+            const av = entry.modes[m].available
+            return (
+              <li key={m}>
+                <label className={`pb-choice${m === mode ? ' is-on' : ''}${av ? '' : ' is-off'}`}>
+                  <input type="radio" name="pb-mode" checked={m === mode} disabled={!av} onChange={() => { setMode(m); setTicked([]) }} />
+                  <span><b>{MODE_WORDS[m]}</b><br />
+                    <span className="pb-dim pb-small">{av ? MODE_MEANS[m] : `Not yet: ${entry.modes[m].reason}`}</span>
+                  </span>
+                </label>
+              </li>
+            )
+          })}
+        </ul>
+      </section>
+
+      <section className="pb-q" data-f="B3">
+        <h3><span className="pb-q-n">3</span>Skills it may use <span className="pb-count">{ticked.length} of {offered.length}</span></h3>
+        <ul className="pb-ticks" role="list">
+          {offered.map((s) => (
+            <li key={s}>
+              <label className={`pb-tick${ticked.includes(s) ? ' is-on' : ''}`}>
+                <input type="checkbox" checked={ticked.includes(s)} onChange={() => toggle(s)} />
+                <code>{s}</code>
+                <span className="pb-dim">{skillNotes[s] ?? 'what it does: not known'}</span>
+              </label>
+            </li>
+          ))}
+        </ul>
+        <p className="pb-dim pb-small">
+          Never offered in any mode: {neverOffered.flatMap((g) => g.skills).slice(0, 4).join(', ')} and {neverOffered.flatMap((g) => g.skills).length - 4} more (Config › Plugins says why).
+        </p>
+      </section>
+
+      <footer className="pb-sheet-f">
+        <span className="pb-sumchip is-preview" aria-label="What the step will show">
+          <span className="pb-sumchip-k">gstack</span><span>{MODE_WORDS[mode]}</span>
+          <span className="pb-sumchip-s">{ticked.length === 0 ? 'no skill yet' : ticked.join(' · ')}</span>
+        </span>
+        <Button kind="primary" disabled={ticked.length === 0}>Use on this step</Button>
+      </footer>
+    </aside>
+  )
+}
