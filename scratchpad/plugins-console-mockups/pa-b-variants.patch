+    </section>${summary}</main>`
+  return `<!doctype html><html><body style="margin:0;background:${bg};color:${ink}">${header}${body}</body></html>`
+}
+
+export const Q13 = 'Where should the checkout show how long the room stays held?'
+export const Q13_OPTIONS = [
