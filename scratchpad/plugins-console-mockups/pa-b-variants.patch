+// MOCK-HOOK FILE: direction B, Needs you: the real NeedsYou with the plugin steps' parked questions beside the other
+// kinds, and one card per parked plugin step saying which plugin, mode and skill asked (features.md §4, N1-N5).
+
+import { ButtonLink } from '../../components'
+import { PageHead } from '../../Shell'
+import type { Task } from '../../types'
+import { NeedsYou, type NeedItem } from '../../work/NeedsYou'
