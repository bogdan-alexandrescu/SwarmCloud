+    plugins: { gstack: { mode: 'unattended', skills: ['review', 'investigate', 'health', 'plan-eng-review'] } },
+    used: { gstack: { version: '1.92.55.0', mode: 'unattended', skills: ['review', 'investigate', 'health', 'plan-eng-review'],
+      skill_runs: { review: 2, investigate: 1, health: 0, 'plan-eng-review': 1 } } },
+    refusal: null },
