+// MOCK-HOOK FILE: direction B, the interview as the whole planning page, one question at a time, and the
+// proposal as its own page with the decision bar fixed at the bottom (features.md §3, I1-I18).
+
+import { useLayoutEffect, useRef, useState } from 'react'
+import { Button, Chip } from '../../components'
+import { PageHead } from '../../Shell'
+import { designerInterview, designerTask, plannerRun, type AnswerVia, type Preview } from '../fixtures'
+import { MODE_WORDS, PreviewView, at, person } from '../parts'
+import { leftWords, plainLabel } from '../PlanInterview'
+import type { MockState } from '../switches'
+
+/** Where an answer came from, as a short mark beside the name. */
+const VIA_SHORT: Readonly<Record<AnswerVia, string>> = {
+  console: 'Console', 'voice-it': 'Voice it', 'claude-code': 'Claude Code', 'github-comment': 'GitHub',
+}
+
+export function PlanB({ state }: { state: MockState }) {
+  return state === 'proposal' ? <ProposalB /> : <InterviewB state={state} />
+}
+
+function initials(email: string | null): string {
+  return person(email).split(' ').map((w) => w[0]).join('').slice(0, 2)
+}
+
+function InterviewB({ state }: { state: MockState }) {
+  const answered = state === 'answered'
+  const read = designerInterview(answered ? 'answered' : 'open')
+  const q = read.questions[0]!
+  const [picked, setPicked] = useState<string>(q.recommended!)
+  const [ownWords, setOwnWords] = useState(state === 'open')
+  const [big, setBig] = useState<string | null>(null)
+  const left = leftWords(read.waiting.expires_at)
+  const gs = designerTask.plugins.gstack
+  const n = read.interview.length + 1
+  const railList = useRef<HTMLOListElement>(null)
+  // The current question sits at the rail's end: open the rail scrolled to it.
+  useLayoutEffect(() => { const el = railList.current; if (el !== null) el.scrollTop = el.scrollHeight }, [])
+  const viaCount = (v: AnswerVia) => read.interview.filter((r) => r.answer.via === v).length
+  return (
+    <div className="pb-page pb-iv">
+      <PageHead title="Design interview" />
+      <div className="pb-iv-facts" data-f="I14 I13">
