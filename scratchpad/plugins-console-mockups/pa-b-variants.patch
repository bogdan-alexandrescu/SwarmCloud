+import { MODE_WORDS, at } from '../parts'
+import { leftWords } from '../PlanInterview'
+import type { MockState } from '../switches'
+
+/** A task as the Workflows list reads one, trimmed to what a Needs-you row draws. Invented. */
+function task(id: string, workflow: string, step: string, profile: string, repo: string): Task {
+  return {
+    id, tenant_id: 'u-bogdan', state: 'FAILED', runner_profile: profile, resource_class: 'standard', provider: null, priority: 0,
+    created_at: '2026-10-19T09:00:00Z', updated_at: '2026-10-19T11:10:00Z', started_at: null, completed_at: null,
+    submitted_by: 'kenji.sato@example.com', attempt_count: 1, max_attempts: 3, park_reason: null, blocked_by: null,
+    workflow_id: workflow, step_id: step, depends_on: null, repository_url: `https://github.com/example-org/${repo}`,
+  } as unknown as Task
+}
+
+export function NeedsB({ state }: { state: MockState }) {
+  const designer = designerInterview('open')
+  const showDesigner = state !== 'answered'
+  const items: NeedItem[] = [
+    { kind: 'failed', task: task('task_ncrm_build_88a1', 'wf_northwind_contacts', 'build', 'claude-code-large', 'northwind-crm'),
+      title: 'wf_northwind_contacts › build', why: 'Tests failed: 3 of 412 in contacts/import' },
+    ...(showDesigner ? [{
+      kind: 'question' as const, taskId: designerTask.task_id, index: 0, title: `${designerTask.step_id} (question 13)`,
+      question: Q13, options: Q13_OPTIONS, recommended: Q13_OPTIONS[0]!.label, mayAnswer: true,
+    }] : []),
+    { kind: 'question', taskId: unattendedTask.task_id, index: 0, title: `${unattendedTask.workflow_id} › ${unattendedTask.step_id}`,
+      question: unattendedTask.question, options: unattendedTask.options, recommended: unattendedTask.recommended, mayAnswer: true },
+  ]
+  const parked = [
+    ...(showDesigner ? [{ id: designerTask.task_id, step: designerTask.step_id, repo: designerTask.repository, mode: designerTask.plugins.gstack.mode,
+      skill: designer.skill ?? 'not known', asked: designer.waiting.asked_at, expires: designer.waiting.expires_at, page: true }] : []),
+    { id: unattendedTask.task_id, step: unattendedTask.step_id, repo: unattendedTask.repository, mode: unattendedTask.plugins.gstack.mode,
+      skill: unattendedTask.skill, asked: unattendedTask.asked_at, expires: unattendedTask.expires_at, page: false },
+  ]
+  return (
+    <div className="pb-page pb-needs">
+      <PageHead title="Workflows" />
+      <div className="pb-needs-grid">
+        <div className="pb-needs-main" data-f="N1 N2 N3">
+          <NeedsYou items={items} approvals={[]} />
+        </div>
+        <aside className="pb-needs-side" aria-label="Plugin steps parked on a question" data-f="N4 N5">
+          <h2>Plugin steps parked <span className="pb-count">{parked.length}</span></h2>
+          <p className="pb-dim pb-small">Each holds no machine while it waits. Unanswered in 24 hours, it ends with the question open: nobody&rsquo;s answer is guessed.</p>
+          {parked.map((p) => (
+            <section key={p.id} className="pb-park">
+              <b>{p.step}</b> <code className="pb-dim pb-small">{p.repo}</code>
+              <span className="pb-sumchip is-static"><span className="pb-sumchip-k">gstack</span><span>{MODE_WORDS[p.mode]}</span><span className="pb-sumchip-s">asked by {p.skill}</span></span>
+              <span className="pb-small"><b>{leftWords(p.expires) ?? 'expired'}</b> <span className="pb-dim">left · asked {at(p.asked)}</span></span>
+              {p.page
+                ? <ButtonLink size="sm" kind="secondary" href="/runs/run_4c1e09d2">Open the interview with its 4 designs</ButtonLink>
+                : <span className="pb-dim pb-small">It ran unattended and this question has no recommended answer, so it waits for you: answer it in its row (Question, wf_northwind_contacts › review).</span>}
+            </section>
+          ))}
+        </aside>
+      </div>
+    </div>
+  )
+}
