+/* MOCK-HOOK FILE: the plugins console scaffold's plain layout. Console tokens only (styles.css, components.css). */
+.pc-page { display: flex; flex-direction: column; gap: var(--ctl-s3); max-width: 1100px; min-width: 0; }
+.pc-item { min-width: 0; }
+.pc-item + .pc-item { margin-top: 12px; }
+.pc-lead { margin: 0; font-size: var(--t-body); color: var(--text-dim); max-width: var(--measure); }
+.pc-dim { color: var(--text-dim); }
+.pc-small { font-size: var(--t-micro); line-height: var(--lh-micro); }
+.pc-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0; }
+.pc-h3 { margin: 12px 0 6px; font-size: var(--t-meta); font-weight: 600; }
+.pc-list { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 4px; font-size: var(--t-meta); }
+.pc-facts { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 4px 16px; margin: 0; font-size: var(--t-meta); }
+.pc-facts dt { color: var(--text-dim); }
+.pc-facts dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
+.pc-skill code, .pc-gap { font: var(--t-micro)/var(--lh-micro) var(--mono); margin-right: 4px; }
+.pc-mode { border-top: 1px solid var(--line-soft); padding-top: 4px; }
+.pc-refusal { margin: 4px 0; padding: 6px 10px; border-left: 3px solid var(--s-warn, var(--warn)); background: var(--surface-2); font-size: var(--t-meta); }
+.pc-form { display: flex; flex-direction: column; gap: 10px; border: 1px solid var(--line); border-radius: var(--r-ctl); padding: 12px; }
+.pc-form fieldset { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
+.pc-form legend { font-weight: 600; font-size: var(--t-meta); margin-bottom: 4px; }
+.pc-check { display: flex; gap: 8px; align-items: flex-start; font-size: var(--t-meta); }
+.pc-field { display: flex; flex-direction: column; gap: 4px; font-size: var(--t-meta); margin-top: 8px; }
+.pc-field textarea { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--ctl-bd); border-radius: var(--r-ctl); padding: 8px; }
+.pc-question { margin: 0; font-size: var(--t-lead, 16px); font-weight: 600; }
+.pc-options { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
