+// MOCK-HOOK FILE: the interview on the planning page, and the proposal, plain layout (features.md §3, I1-I18).
+
+import { useState } from 'react'
+import { FIXTURE_CLOCK } from '../api'
+import { Banner, Button, Card, Chip } from '../components'
+import { PageHead } from '../Shell'
+import { designerInterview, designerTask, plannerRun } from './fixtures'
+import { Item, MODE_WORDS, PluginSummary, PreviewView, Skill, at, person, via } from './parts'
+import type { MockState } from './switches'
+
+/** Hours and minutes from the fixture clock to `iso`; null once past. */
+export function leftWords(iso: string | null): string | null {
+  if (iso === null) return null
+  const ms = Date.parse(iso) - Date.parse(FIXTURE_CLOCK)
+  if (ms <= 0) return null
+  const m = Math.floor(ms / 60_000)
+  return `${Math.floor(m / 60)} h ${m % 60} min`
+}
+
+/** The CLI marks the recommended option by ending its label in "(Recommended)"; the chip says it once. */
+export function plainLabel(label: string | null): string {
+  return (label ?? 'no label').replace(/\s*\(Recommended\)$/, '')
+}
+
+/** rest: the designer step mid-interview, question 13 open, the recommended option's preview shown.
+ *  open: the person's own-words box open, another option's preview shown. answered: question 13 answered,
+ *  the step waiting to resume. proposal: a planner-mode issue run whose interview ended, waiting for approval. */
+export function PlanInterview({ state }: { state: MockState }) {
+  return state === 'proposal' ? <Proposal /> : <Interview state={state} />
+}
+
+function Interview({ state }: { state: MockState }) {
+  const read = designerInterview(state === 'answered' ? 'answered' : 'open')
+  const q = read.questions[0]!
+  const [shown, setShown] = useState<string>(state === 'open' ? q.options[1]!.label! : q.recommended!)
+  const [ownWords, setOwnWords] = useState(state === 'open')
+  const left = leftWords(read.waiting.expires_at)
+  const gs = designerTask.plugins.gstack
+  return (
+    <div className="pc-page">
+      <PageHead title="roombook-checkout-redesign" />
+      <Item f="I14">
+        <dl className="pc-facts">
+          <dt>Step</dt><dd>{designerTask.step_id} in {designerTask.workflow_id} · {designerTask.repository} · {designerTask.runner_profile}</dd>
+          <dt>Plugin</dt><dd><PluginSummary plugins={designerTask.plugins} /> gstack 1.92.55.0, {MODE_WORDS[gs.mode]} mode: {gs.skills.join(', ')}</dd>
+        </dl>
+      </Item>
+      <Item f="I13">
+        <Banner tone="info" title={read.waiting.open ? 'Parked: waiting for your answer' : 'Answered: the step will resume'}>
+          {read.waiting.open
+            ? 'The step holds no machine and no slot while it waits. Your answer starts it again, in the same conversation.'
+            : 'The answer is recorded. The step is queued to start again with it; it holds nothing until then.'}
+        </Banner>
+      </Item>
+      <Item f="I15"><p className="pc-lead">Question {read.interview.length + 1}. {read.interview.length} answered so far; how many more the agent will ask is not known.</p></Item>
+
+      <Card title={<>Question {read.interview.length + 1}</>}>
+        <Item f="I1"><p className="pc-question">{q.question}</p>{q.context !== null && <p className="pc-dim">{q.context}</p>}</Item>
+        <Item f="I5"><p className="pc-dim pc-small">Asked by the skill <Skill name={read.skill ?? 'not known'} /> at {at(read.waiting.asked_at)}.</p></Item>
+        <Item f="I2 I3">
+          <ul className="pc-options" role="list">
+            {q.options.map((o) => (
+              <li key={o.label} className={o.label === shown ? 'is-shown' : ''}>
+                <label className="pc-check">
+                  <input type="radio" name="q13" disabled={!read.waiting.open} defaultChecked={state === 'answered' && o.label === q.answer?.choice} />
+                  <span><b>{plainLabel(o.label)}</b>{o.label === q.recommended && <Chip>Recommended</Chip>}<br /><span className="pc-dim">{o.description}</span></span>
+                </label>
+                <Button size="sm" kind="ghost" onClick={() => setShown(o.label!)}>{o.label === shown ? 'Preview shown' : 'Show preview'}</Button>
+              </li>
+            ))}
+          </ul>
+        </Item>
+        <Item f="I4">
+          <h3 className="pc-h3">Preview: {plainLabel(shown)}</h3>
+          <PreviewView preview={read.previews[shown]} tall />
+        </Item>
+        <Item f="I9 I10">
+          {read.waiting.open ? (
+            <div className="pc-row">
+              <Button kind="primary">Answer with the chosen option</Button>
+              <Button>Use the recommended answer</Button>
+              <Button kind="ghost" onClick={() => setOwnWords(!ownWords)}>Answer in my own words</Button>
+            </div>
+          ) : (
+            <p>Answered by {person(q.answer!.by)} {via(q.answer!.via)} at {at(q.answer!.at)}: {q.answer!.choice}</p>
+          )}
+          {ownWords && read.waiting.open && (
+            <label className="pc-field">Your answer, in your own words<textarea rows={3} defaultValue="The summary, but show the timer only in the last 5 minutes." /></label>
+          )}
+        </Item>
+        <Item f="I11 I12">
+          <p className="pc-dim pc-small">
+            {left === null ? 'Its 24 hours are up.' : <>Waits {left} more (24 hours from when it was asked, until {at(read.waiting.expires_at)}).</>}{' '}
+            Unanswered by then, the step ends with the question left open; nobody&rsquo;s answer is guessed. The first answer stands: a second one is refused.
+          </p>
+        </Item>
+      </Card>
+
+      <Card level={3} title="The proposal">
+        <Item f="I16 I17 I18">
+          <p className="pc-dim">Not yet: the interview is still running. When it ends, the design doc, its diagrams and the chosen HTML design
+            are shown here to Approve, Edit or Reject. This workflow asks a person to approve; it is not set to approve automatically.</p>
+        </Item>
+      </Card>
+
+      <Card title={<>Answered so far ({read.interview.length})</>}>
+        <Item f="I6 I7 I8">
+          <div className="c-tbl">
+            <table>
+              <thead><tr><th>#</th><th>Question</th><th>Answer</th><th>Who</th><th>Where</th><th>Skill</th></tr></thead>
+              <tbody>
+                {read.interview.map((r) => (
+                  <tr key={r.n}>
+                    <td>{r.n}</td><td className="pc-wrap">{r.question}</td><td className="pc-wrap">{r.answer.choice}</td>
+                    <td>{person(r.answer.by)}</td><td>{via(r.answer.via)}</td><td><code>{r.skill}</code></td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        </Item>
+      </Card>
+    </div>
+  )
+}
+
+function Proposal() {
+  const r = plannerRun
+  const [auto] = useState(r.plan_approval === 'auto')
+  return (
+    <div className="pc-page">
+      <PageHead title={r.issue.title} />
+      <Item f="I14">
+        <dl className="pc-facts">
+          <dt>Run</dt><dd>{r.id} · {r.issue.ref} · started by {person(r.created_by)}</dd>
+          <dt>Planner</dt><dd><PluginSummary plugins={r.plugins} /> {r.plugins.gstack.skills.join(', ')}</dd>
+          <dt>Interview</dt><dd>Ended {at(r.interview.ended_at)} after {r.interview.asked} questions: {r.interview.answered_by.map(([b, v, n]) => `${n} by ${person(b)} ${via(v)}`).join(', ')}</dd>
+        </dl>
+      </Item>
+      <Card title="The proposal">
+        <Item f="I16">
+          <p>{r.plan.summary}</p>
+          <ol className="pc-list">{r.plan.steps.map((s) => <li key={s.step_id}><b>{s.title}</b> <span className="pc-dim">{s.prompt}</span></li>)}</ol>
+          <p className="pc-dim">Requirements: {r.plan.requirements.join('; ')}. Estimate: {r.plan.estimate}.</p>
+          <h3 className="pc-h3">Design doc: <code>{r.proposal.design_doc}</code></h3>
+          <p>{r.proposal.design_doc_lead}</p>
+          {r.proposal.diagrams.map((d) => (
+            <figure key={d.title} className="pc-fig"><PreviewView preview={{ kind: 'diagram', svg: d.svg, alt: d.alt }} /><figcaption>{d.title}</figcaption></figure>
+          ))}
+        </Item>
+        <Item f="I17 I18">
+          {auto ? (
+            <p>Approved automatically: this run was started with plan approval set to automatic.</p>
+          ) : (
+            <>
+              <p className="pc-row">
+                <Button kind="primary">Approve</Button><Button>Edit</Button><Button kind="danger">Reject</Button>
+              </p>
+              <p className="pc-dim pc-small">You decide on revision {r.plan_revision}, digest <code>{r.plan_digest.slice(0, 19)}</code>. If the plan changes before you decide, the decision is refused and the new plan shown. This run asks a person to approve; a run started with automatic approval would go ahead on its own.</p>
+            </>
+          )}
+        </Item>
+      </Card>
+    </div>
+  )
+}
