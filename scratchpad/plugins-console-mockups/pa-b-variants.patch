+// MOCK-HOOK FILE: the plugins console mock-ups' entry: ?pa picks the direction, ?ps the screen, ?pst the state.
+
+import { BuilderPlugins } from './BuilderPlugins'
+import { ConfigPlugins } from './ConfigPlugins'
+import { NeedsPlugins } from './NeedsPlugins'
+import { PlanInterview } from './PlanInterview'
+import { MOCK_BRIDGE_LANDED, MOCK_PA, MOCK_PS, MOCK_PST, MOCK_PV } from './switches'
+import './pluginsconsole.css'
+import { BuilderB } from './B/BuilderB' // MOCK-HOOK
+import { ConfigB } from './B/ConfigB' // MOCK-HOOK
+import { NeedsB } from './B/NeedsB' // MOCK-HOOK
+import { PlanB } from './B/PlanB' // MOCK-HOOK
+import './B/b.css' // MOCK-HOOK
+
+/** Directions a and b are built by later steps; until then each draws the base layout under its name. */
+export function PluginsConsole() {
+  const screen = MOCK_PA === 'b' ? screenB() /* MOCK-HOOK: direction B */ : (() => {
+    switch (MOCK_PS) {
+      case 'config': return <ConfigPlugins state={MOCK_PST} viewer={MOCK_PV === 'viewer'} bridgeLanded={MOCK_BRIDGE_LANDED} />
+      case 'builder': return <BuilderPlugins state={MOCK_PST} bridgeLanded={MOCK_BRIDGE_LANDED} />
+      case 'plan': return <PlanInterview state={MOCK_PST} />
+      case 'needs': return <NeedsPlugins state={MOCK_PST} />
+    }
+  })()
+  return <div className={`pc-root pc-${MOCK_PA ?? 'base'}`} data-pa={MOCK_PA} data-ps={MOCK_PS} data-pst={MOCK_PST}>{screen}</div>
+}
+
+/** MOCK-HOOK: direction B's layouts (capability cards, guided picker, full-page interview). */
+function screenB() {
+  switch (MOCK_PS) {
+    case 'config': return <ConfigB state={MOCK_PST} viewer={MOCK_PV === 'viewer'} bridgeLanded={MOCK_BRIDGE_LANDED} />
+    case 'builder': return <BuilderB state={MOCK_PST} bridgeLanded={MOCK_BRIDGE_LANDED} />
+    case 'plan': return <PlanB state={MOCK_PST} />
+    case 'needs': return <NeedsB state={MOCK_PST} />
+  }
+}
