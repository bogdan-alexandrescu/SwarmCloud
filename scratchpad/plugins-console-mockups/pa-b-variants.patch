+// MOCK-HOOK FILE: direction B, Config › Plugins as one capability card per plugin (features.md §1, C1-C14).
+
+import { useState } from 'react'
+import { Banner, Button, Chip, Tabs } from '../../components'
+import { PageHead } from '../../Shell'
+import { MODES, builderSteps, changes, neverOffered, pluginsRead, refusalWords, skillNotes, type PluginMode } from '../fixtures'
+import { MODE_MEANS, MODE_WORDS, at, person } from '../parts'
+import type { MockState } from '../switches'
+
+type CardTab = PluginMode | 'never'
+
+/** rest: the admin's page, gstack allowed. open: the allow switch turned off, not saved yet, with what it would
+ *  refuse. answered: saved, the new row on top. ?pv=viewer: the switch read only, and why. */
+export function ConfigB({ state, viewer, bridgeLanded }: { state: MockState; viewer: boolean; bridgeLanded: boolean }) {
+  const read = pluginsRead({ canEdit: !viewer, bridgeLanded })
+  const [tab, setTab] = useState<CardTab>('unattended')
+  const [on, setOn] = useState(state !== 'open')
+  const saved = state === 'answered'
+  const dirty = on !== read.plugins.allowed.includes('gstack')
+  const history = saved
+    ? [{ at: '2026-10-19T11:59:00Z', by: 'ana.moreau@example.com', before: ['gstack'], after: ['gstack'] }, ...changes]
+    : changes
+  const naming = builderSteps.filter((s) => s.plugins?.gstack !== undefined)
+  const neverCount = neverOffered.reduce((n, g) => n + g.skills.length, 0)
+  return (
+    <div className="pb-page pb-config">
+      <PageHead title="Plugins" />
+      <p className="pb-lead" data-f="C14">
+        Skills an agent step can load, from a closed catalogue. Each plugin is built into the agent images at one version.
+        Steps pick a plugin, a mode and skills by name; nothing here takes a path, a command, a web address or a version.
+      </p>
+
+      <div className="pb-cfg">
+        <div className="pb-cfg-main">
+          {read.catalogue.map((p) => {
+            const allowed = on
+            return (
+              <section key={p.name} className={`pb-cap${allowed ? ' is-on' : ''}`} aria-label={`${p.name} plugin`}>
+                <header className="pb-cap-h">
+                  <div className="pb-cap-id">
+                    <span className="pb-cap-mark" aria-hidden="true">{p.name.slice(0, 1)}</span>
+                    <div>
+                      <h2 data-f="C1">{p.name}</h2>
+                      <p className="pb-row" data-f="C2">
+                        <Chip title="Fixed in the agent image; nobody chooses a version">{p.version}</Chip>
+                        <span className="pb-dim pb-small">pinned in the image, never chosen here</span>
+                      </p>
+                    </div>
+                  </div>
+                  <div className="pb-allow" data-f="C8 C10 C13">
+                    <label className={`pb-switch${!read.can_edit ? ' is-ro' : ''}`}>
+                      <input type="checkbox" role="switch" checked={allowed} disabled={!read.can_edit}
+                        onChange={() => setOn(!on)} aria-describedby="pb-allow-why" />
+                      <span className="pb-switch-track" aria-hidden="true"><span /></span>
+                      <span className="pb-switch-word">{allowed ? 'Allowed in this workspace' : 'Not allowed in this workspace'}</span>
+                    </label>
+                    <span id="pb-allow-why" className="pb-dim pb-small">
+                      {read.can_edit ? 'You are an admin: you can change this' : 'Read only: only the workspace’s owner or an admin changes this'}
+                    </span>
+                  </div>
+                </header>
+
+                <div className="pb-cap-runs" data-f="C3">
+                  <span className="pb-dim">Runs on</span>
+                  {p.runner_profiles.map((r) => <Chip key={r}>{r}</Chip>)}
+                  <span className="pb-dim pb-small">other runner profiles cannot load plugins</span>
+                </div>
+
+                <p className="pb-cap-modes" data-f="C6" aria-label="Which modes run today">
+                  {MODES.map((m) => (
+                    <span key={m} className={`pb-mode-state${p.modes[m].available ? ' is-on' : ''}`} title={p.modes[m].reason}>
+                      {MODE_WORDS[m]}: {p.modes[m].available ? 'runs today' : 'not yet'}
+                    </span>
+                  ))}
+                </p>
+                <Tabs
+                  label={`${p.name} skills by mode`}
+                  current={tab}
+                  onSelect={(k) => setTab(k as CardTab)}
+                  className="pb-cap-tabs"
+                  tabs={[
+                    ...MODES.map((m) => ({ key: m, label: MODE_WORDS[m]!, count: p.modes[m].skills.length })),
+                    { key: 'never', label: 'Never offered', count: neverCount },
+                  ]}
+                />
+                {tab === 'never' ? (
+                  <div className="pb-cap-panel" data-f="C7">
+                    <p className="pb-mode-means">gstack ships these, but no step can use them, in any mode.</p>
+                    <ul className="pb-never" role="list">
+                      {neverOffered.map((g) => (
+                        <li key={g.skills.join()}>
+                          <span className="pb-row">{g.skills.map((s) => <code key={s} className="pb-skill-name is-off">{s}</code>)}</span>
+                          <span className="pb-dim">{g.why}</span>
+                        </li>
+                      ))}
+                    </ul>
+                  </div>
+                ) : (
+                  <div className="pb-cap-panel" data-f="C4 C5 C6">
+                    <p className="pb-mode-means">
+                      {p.modes[tab].available
+                        ? <span>{MODE_WORDS[tab]} {MODE_MEANS[tab]}.</span>
+                        : <><Chip tone="park">Not yet</Chip> <span>{MODE_WORDS[tab]} {p.modes[tab].reason}.</span></>}
+                    </p>
+                    <ul className="pb-skills" role="list">
+                      {p.modes[tab].skills.map((s) => (
+                        <li key={s}>
+                          <code className="pb-skill-name">{s}</code>
+                          <span>{skillNotes[s] ?? <span className="pb-dim">what it does: not known</span>}</span>
+                        </li>
+                      ))}
+                    </ul>
+                  </div>
+                )}
+              </section>
+            )
+          })}
+
+          {dirty && read.can_edit && (
+            <div className="pb-pending" data-f="C10 C11 B6">
+              <Banner tone="warn" title="Not saved: gstack would no longer be allowed"
+                actions={<><Button kind="ghost" onClick={() => setOn(!on)}>Cancel</Button><Button kind="primary">Save and sign</Button></>}>
+                {naming.length} steps in <b>roombook: checkout redesign</b> name gstack ({naming.map((s) => s.step_id).join(', ')});
+                from the next submission each is refused: &ldquo;{refusalWords.notAllowed}&rdquo;. Steps already running keep what they loaded.
+              </Banner>
+            </div>
+          )}
+          {saved && <Banner tone="info" title="Saved and signed">Ana Moreau saved the setting at {at('2026-10-19T11:59:00Z')}. It is in the history on the right.</Banner>}
+        </div>
+
+        <aside className="pb-cfg-side">
+          <section className="pb-side-card" data-f="C8 C9 C11">
+            <h2>This workspace may use</h2>
+            <p className="pb-row">
+              {on ? <Chip tone="live">gstack</Chip> : <span className="pb-dim">No plugin</span>}
+            </p>
+            <dl className="pb-facts">
+              <dt>When nobody chose</dt><dd>No plugin is allowed</dd>
+              <dt>Signed</dt><dd>Only a signed setting allows anything; an unsigned one allows nothing</dd>
+              <dt>Workspace</dt><dd><code>{read.tenant_id}</code></dd>
+            </dl>
+          </section>
+          <section className="pb-side-card" data-f="C12">
+            <h2>Changes <span className="pb-count">{history.length}</span></h2>
+            <ol className="pb-audit" role="list">
+              {history.map((h) => (
+                <li key={h.at}>
+                  <b>{person(h.by)}</b>
+                  <span className="pb-dim pb-small">{at(h.at)}</span>
+                  <span className="pb-small">
+                    {h.before.length === 0 ? 'none' : h.before.join(', ')} &rarr; {h.after.length === 0 ? 'none' : h.after.join(', ')}
+                  </span>
+                </li>
+              ))}
+            </ol>
+            <p className="pb-dim pb-small">Newest first, from the audit log; each change is signed.</p>
+          </section>
+        </aside>
+      </div>
+    </div>
+  )
+}
