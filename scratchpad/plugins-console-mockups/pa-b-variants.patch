+        <span className="pb-dim">in</span> <code>{designerTask.repository}</code>
+        <span className="pb-sumchip is-static" title={`gstack ${MODE_WORDS[gs.mode]}: ${gs.skills.join(', ')}`}>
+          <span className="pb-sumchip-k">gstack 1.92.55.0</span><span>{MODE_WORDS[gs.mode]}</span>
+          <span className="pb-sumchip-s">{gs.skills.join(' · ')}</span>
+        </span>
+        {read.waiting.open
+          ? <Chip tone="park" title="While it waits the step holds no lease, no slot and no container">Parked: holds no machine</Chip>
+          : <Chip tone="live" title="Queued to start again in the same conversation">Answered: queued to resume</Chip>}
+      </div>
+
+      <div className="pb-iv-grid">
+        <nav className="pb-rail" aria-label="Questions answered so far" data-f="I6 I7 I8 I15">
+          <div className="pb-rail-h">
+            <b>{answered ? n : n - 1} answered</b>
+            <span className="pb-dim pb-small">how many more: not known</span>
+            <span className="pb-row pb-small" aria-label="Where they were answered">
+              <span className="pb-via is-console">Console <b>{viaCount('console') + (answered ? 1 : 0)}</b></span>
+              <span className="pb-via is-voice-it">Voice it <b>{viaCount('voice-it')}</b></span>
+              <span className="pb-via is-claude-code">Claude Code <b>{viaCount('claude-code')}</b></span>
+            </span>
+          </div>
+          <ol className="pb-rail-list" role="list" ref={railList}>
+            {read.interview.map((r) => (
+              <li key={r.n} className="pb-rail-item">
+                <span className="pb-rail-n">{r.n}</span>
+                <div className="pb-rail-body">
+                  <span className="pb-rail-q" title={r.question}>{r.question}</span>
+                  <span className="pb-rail-a">{plainLabel(r.answer.choice)}</span>
+                  <span className="pb-rail-who">
+                    <span className="pb-av" aria-hidden="true">{initials(r.answer.by)}</span>
+                    {person(r.answer.by)} <span className={`pb-via is-${r.answer.via}`}>{VIA_SHORT[r.answer.via ?? 'console']}</span>
+                  </span>
+                </div>
+              </li>
+            ))}
+            <li className={`pb-rail-item ${answered ? 'is-just' : 'is-now'}`} aria-current={answered ? undefined : 'step'}>
+              <span className="pb-rail-n">{n}</span>
+              <div className="pb-rail-body">
+                <span className="pb-rail-q">{q.question}</span>
+                {answered
+                  ? <>
+                      <span className="pb-rail-a">{plainLabel(q.answer!.choice)}</span>
+                      <span className="pb-rail-who"><span className="pb-av" aria-hidden="true">{initials(q.answer!.by)}</span>{person(q.answer!.by)} <span className="pb-via is-console">Console</span> <span className="pb-dim">just now</span></span>
+                    </>
+                  : <span className="pb-rail-a is-now">Waiting for an answer</span>}
+              </div>
+            </li>
+          </ol>
+          <p className="pb-rail-end pb-small" data-f="I16 I18">
+            <b>Then:</b> the design proposal (design doc, diagrams, the chosen design) for you to Approve, Edit or Reject.
+            This run asks a person; it is not set to approve automatically.
+          </p>
+        </nav>
+
+        <main className="pb-iv-main">
+          {!answered ? (
+            <>
+              <header className="pb-qhead">
+                <span className="pb-qnum">Question {n}</span>
+                <span className="pb-dim pb-small" data-f="I5">asked by <code className="pb-skill-name">{read.skill}</code> at {at(read.waiting.asked_at)}</span>
+              </header>
+              <h2 className="pb-qtext" data-f="I1">{q.question}</h2>
+              {q.context !== null && <p className="pb-dim pb-qctx">{q.context}</p>}
+              <ul className="pb-opts" role="radiogroup" aria-label={`Answers to question ${n}`} data-f="I2 I3 I4">
+                {q.options.map((o, i) => {
+                  const rec = o.label === q.recommended
+                  return (
+                    <li key={o.label} className={`pb-opt${o.label === picked ? ' is-picked' : ''}${rec ? ' is-rec' : ''}`}>
+                      <label className="pb-opt-h">
+                        <input type="radio" name="pb-q13" checked={o.label === picked} onChange={() => setPicked(o.label!)} />
+                        <span className="pb-opt-k">{String.fromCharCode(65 + i)}</span>
+                        <span className="pb-opt-l"><b>{plainLabel(o.label)}</b>{rec && <Chip tone="live">Recommended</Chip>}</span>
+                      </label>
+                      <p className="pb-opt-d">{o.description}</p>
+                      <Shot preview={read.previews[o.label!]} onBig={() => setBig(o.label!)} />
+                    </li>
+                  )
+                })}
+              </ul>
+              {!ownWords && (
+                <p className="pb-none-fit pb-small">
+                  None of these fits? <button type="button" className="c-link" onClick={() => setOwnWords(true)}>Answer in your own words</button>
+                </p>
+              )}
+              {big !== null && (
+                <div className="pb-big" role="dialog" aria-label={`Preview: ${plainLabel(big)}`}>
+                  <div className="pb-big-h"><b>{plainLabel(big)}</b><Button size="sm" kind="ghost" onClick={() => setBig(null)}>Close</Button></div>
+                  <PreviewView preview={read.previews[big]} tall />
+                </div>
+              )}
+            </>
+          ) : (
+            <div className="pb-done" data-f="I1 I2 I4">
+              <header className="pb-qhead">
+                <span className="pb-qnum">Question {n} answered</span>
+                <span className="pb-dim pb-small">by {person(q.answer!.by)} in the console at {at(q.answer!.at)} · the recommended answer</span>
+              </header>
+              <h2 className="pb-qtext">{q.question}</h2>
+              <div className="pb-done-pick">
+                <span className="pb-opt-k">A</span><b>{plainLabel(q.answer!.choice)}</b><Chip tone="live">Recommended</Chip>
+                <span className="pb-dim pb-small">B, C and D were not chosen</span>
+              </div>
+              <div className="pb-done-shot">{(() => { const pv = read.previews[q.answer!.choice!]; return pv?.kind === 'html' ? <HtmlShot preview={pv} /> : <PreviewView preview={pv} tall /> })()}</div>
+              <div className="pb-next">
+                <b>Next:</b> the step starts again with this answer, in the same conversation. It holds no machine until then.
+                Question {n + 1} or the proposal appears here when it comes; you can leave this page.
+              </div>
+            </div>
+          )}
+          <div className="pb-dbar" data-f="I9 I10 I11 I12">
+            {!answered ? (
+              <>
+                <div className="pb-dbar-left">
+                  <span className="pb-expiry" title={`Asked ${at(read.waiting.asked_at)}; unanswered by ${at(read.waiting.expires_at)}, the step ends with the question left open`}>
+                    <b>{left ?? 'expired'}</b> left of 24 h
+                  </span>
+                  <span className="pb-dim pb-small">Never answered for anyone. The first answer stands.</span>
+                </div>
+                {ownWords && (
+                  <label className="pb-own">
+                    <span className="pb-small">In your own words</span>
+                    <textarea rows={2} defaultValue="The summary, but show the timer only in the last 5 minutes." />
+                  </label>
+                )}
+                <div className="pb-dbar-acts">
+                  {ownWords && <Button kind="ghost" onClick={() => setOwnWords(false)}>Pick an option instead</Button>}
+                  {ownWords ? <Button kind="primary">Send my answer</Button> : (
+                    <>
+                      <Button>Use the recommended answer</Button>
+                      <Button kind="primary">Answer {String.fromCharCode(65 + q.options.findIndex((o) => o.label === picked))}</Button>
+                    </>
+                  )}
+                </div>
+              </>
+            ) : (
+              <>
+                <div className="pb-dbar-left"><b>Answer saved</b><span className="pb-dim pb-small">A second answer to question {n} is refused: the first one stands.</span></div>
+                <div className="pb-dbar-acts"><Button kind="ghost">Back to Needs you</Button></div>
+              </>
+            )}
+          </div>
+        </main>
+      </div>
+    </div>
+  )
+}
+
+/** A rendered design, drawn at desktop width and scaled into the option card; Enlarge shows it full width. */
+function Shot({ preview, onBig }: { preview: Preview | undefined; onBig: () => void }) {
+  if (preview === undefined) return <p className="pb-dim">No preview came with this option.</p>
+  return preview.kind !== 'html' ? <div className="pb-shot-other"><PreviewView preview={preview} /></div> : <HtmlShot preview={preview} onBig={onBig} />
+}
+
+function HtmlShot({ preview, onBig }: { preview: Extract<Preview, { kind: 'html' }>; onBig?: () => void }) {
+  const box = useRef<HTMLDivElement>(null)
+  const [scale, setScale] = useState(0.42)
+  useLayoutEffect(() => {
+    const el = box.current
+    if (el === null) return
+    const fit = () => setScale(el.clientWidth / 820)
+    fit()
+    const ro = new ResizeObserver(fit)
+    ro.observe(el)
+    return () => ro.disconnect()
+  }, [])
+  return (
+    <div className="pb-shot">
+      <div className="pb-shot-frame" ref={box}>
+        <iframe title={preview.title} sandbox="" srcDoc={preview.html} tabIndex={-1} scrolling="no" style={{ transform: `scale(${scale})` }} />
+      </div>
+      {onBig !== undefined && <button type="button" className="pb-shot-big" onClick={onBig}>Enlarge</button>}
+    </div>
+  )
+}
+
+function ProposalB() {
+  const r = plannerRun
+  const gs = r.plugins.gstack
+  const total = r.interview.answered_by.reduce((n, [, , c]) => n + c, 0)
+  return (
+    <div className="pb-page pb-prop">
+      <PageHead title={r.issue.title} />
+      <div className="pb-iv-facts" data-f="I14">
+        <code>{r.issue.ref}</code>
+        <span className="pb-dim">run</span> <code>{r.id}</code>
+        <span className="pb-sumchip is-static"><span className="pb-sumchip-k">gstack 1.92.55.0</span><span>{MODE_WORDS[gs.mode]}</span><span className="pb-sumchip-s">{gs.skills.join(' · ')}</span></span>
+        <Chip tone="park">Plan waiting for approval</Chip>
+      </div>
+
+      <div className="pb-prop-grid">
+        <aside className="pb-rail pb-rail-done" data-f="I6 I7 I8 I15">
+          <div className="pb-rail-h">
+            <b>Interview ended</b>
+            <span className="pb-dim pb-small">{at(r.interview.ended_at)} · {r.interview.asked} questions</span>
+          </div>
+          <ul className="pb-rail-tally" role="list">
+            {r.interview.answered_by.map(([by, v, c]) => (
+              <li key={v}><span className="pb-av" aria-hidden="true">{initials(by)}</span>{person(by)} <span className={`pb-via is-${v}`}>{VIA_SHORT[v]}</span><b>{c}</b></li>
+            ))}
+          </ul>
+          <p className="pb-dim pb-small">{total} of {r.interview.asked} answered. The questions themselves are on the step&rsquo;s page.</p>
+          <p className="pb-small">Started by {person(r.created_by)}</p>
+        </aside>
+
+        <main className="pb-prop-main" data-f="I16">
+          <section className="pb-prop-sec">
+            <h2>The plan</h2>
+            <p className="pb-prop-lead">{r.plan.summary}</p>
+            <ol className="pb-plan-steps" role="list">
+              {r.plan.steps.map((s, i) => (
+                <li key={s.step_id}><span className="pb-q-n">{i + 1}</span><div><b>{s.title}</b> <code className="pb-dim">{s.step_id}</code><p className="pb-dim">{s.prompt}</p></div></li>
+              ))}
+            </ol>
+            <dl className="pb-facts">
+              <dt>Requirements</dt><dd className="pb-row">{r.plan.requirements.map((q) => <Chip key={q}>{q}</Chip>)}</dd>
+              <dt>Estimate</dt><dd>{r.plan.estimate}</dd>
+            </dl>
+          </section>
+          <section className="pb-prop-sec">
+            <h2>Design doc <code className="pb-small">{r.proposal.design_doc}</code></h2>
+            <p>{r.proposal.design_doc_lead}</p>
+          </section>
+          <section className="pb-prop-sec">
+            <h2>Diagrams <span className="pb-count">{r.proposal.diagrams.length}</span></h2>
+            {r.proposal.diagrams.map((d) => (
+              <figure key={d.title} className="pb-fig"><PreviewView preview={{ kind: 'diagram', svg: d.svg, alt: d.alt }} /><figcaption>{d.title}</figcaption></figure>
+            ))}
+          </section>
+          <div className="pb-dbar is-decide" data-f="I17 I18">
+            <div className="pb-dbar-left">
+              <b>Revision {r.plan_revision}</b>
+              <span className="pb-dim pb-small">digest <code>{r.plan_digest.slice(7, 19)}</code> · if the plan changes first, the decision is refused and the new one shown</span>
+            </div>
+            {r.plan_approval === 'auto'
+              ? <div className="pb-dbar-acts"><Chip tone="live">Approved automatically</Chip></div>
+              : (
+                <div className="pb-dbar-acts">
+                  <span className="pb-dim pb-small">This run asks a person to approve</span>
+                  <Button kind="danger">Reject</Button><Button>Edit</Button><Button kind="primary">Approve</Button>
+                </div>
+              )}
+          </div>
+        </main>
+      </div>
+
+    </div>
+  )
+}
