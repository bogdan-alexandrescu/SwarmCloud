+// MOCK-HOOK FILE: shared parts of the plugins console mock-ups. Plain on purpose: the directions restyle them.
+
+import type { ReactNode } from 'react'
+import { Chip, Dash } from '../components'
+import { PEOPLE, VIA_WORDS, skillNotes, type AnswerVia, type Preview, type StepPlugins, type UsedPlugins } from './fixtures'
+
+export const MODE_WORDS: Readonly<Record<string, string>> = {
+  unattended: 'Unattended', planner: 'Planner', designer: 'Designer',
+}
+export const MODE_MEANS: Readonly<Record<string, string>> = {
+  unattended: 'answers what has a recommended answer itself; anything else waits for a person',
+  planner: 'interviews a person, then proposes a plan for approval',
+  designer: 'interviews a person, then proposes a design for approval',
+}
+
+export function person(email: string | null): string {
+  if (email === null) return 'not known'
+  return PEOPLE[email] ?? email
+}
+
+export function via(v: AnswerVia | null): string {
+  return v === null ? 'where: not recorded' : VIA_WORDS[v]
+}
+
+/** A date at the fixture clock, in words the console uses: "19 Oct, 11:22 UTC". */
+export function at(iso: string | null): string {
+  if (iso === null) return 'not known'
+  const d = new Date(iso)
+  const month = d.toLocaleString('en-GB', { month: 'short', timeZone: 'UTC' })
+  return `${d.getUTCDate()} ${month}, ${String(d.getUTCHours()).padStart(2, '0')}:${String(d.getUTCMinutes()).padStart(2, '0')} UTC`
+}
+
+/** One region of the scaffold, carrying the features.md ids it places. */
+export function Item({ f, children, className }: { f: string; children: ReactNode; className?: string }) {
+  return <div className={`pc-item${className ? ` ${className}` : ''}`} data-f={f}>{children}</div>
+}
+
+/** A skill by name, with what it does when the fixture knows. */
+export function Skill({ name, notes = false }: { name: string; notes?: boolean }) {
+  const note = skillNotes[name]
+  return (
+    <span className="pc-skill">
+      <code>{name}</code>
+      {notes && (note !== undefined ? <span className="pc-dim"> {note}</span> : <span className="pc-dim"> (what it does: not known)</span>)}
+    </span>
+  )
+}
+
+/** The chosen set on a step, compactly (B8). */
+export function PluginSummary({ plugins }: { plugins: StepPlugins | null }) {
+  if (plugins === null) return <span className="pc-dim">No plugins</span>
+  return (
+    <span className="pc-row">
+      {Object.entries(plugins).map(([name, p]) => (
+        <Chip key={name} title={`${name}, ${MODE_WORDS[p.mode]} mode: ${p.skills.join(', ')}`}>
+          {name} · {MODE_WORDS[p.mode]} · {p.skills.length} skill{p.skills.length === 1 ? '' : 's'}
+        </Chip>
+      ))}
+    </span>
+  )
+}
+
+/** What a finished step used (B9) and how often each skill ran (B10). */
+export function UsedTable({ used }: { used: UsedPlugins }) {
+  return (
+    <>
+      {Object.entries(used).map(([name, u]) => (
+        <div key={name} className="c-tbl">
+          <table>
+            <caption className="pc-cap">{name} {u.version}, {MODE_WORDS[u.mode]} mode</caption>
+            <thead><tr><th>Skill</th><th className="is-num">Times it ran</th></tr></thead>
+            <tbody>
+              {u.skills.map((s) => (
+                <tr key={s}>
+                  <td><Skill name={s} /></td>
+                  <td className="is-num">
+                    {u.skill_runs === null ? <Dash why="Not known: the agent's stream was not read" /> : u.skill_runs[s] ?? 0}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+          {u.skill_runs === null && <p className="pc-dim pc-small">Not known: the agent&rsquo;s stream was not read, so no run was counted. A measured zero shows as 0.</p>}
+        </div>
+      ))}
+    </>
+  )
+}
+
+/** One option's preview (I4). HTML runs in a sandboxed frame with no scripts; a diagram is an image. */
+export function PreviewView({ preview, tall = false }: { preview: Preview | undefined; tall?: boolean }) {
+  if (preview === undefined) return <p className="pc-dim">No preview came with this option.</p>
+  if (preview.kind === 'text') return <pre className="pc-pre">{preview.body}</pre>
+  if (preview.kind === 'diagram') {
+    return <img className="pc-diagram" alt={preview.alt} src={`data:image/svg+xml;charset=utf-8,${encodeURIComponent(preview.svg)}`} />
+  }
+  return <iframe className={`pc-html${tall ? ' is-tall' : ''}`} title={preview.title} sandbox="" srcDoc={preview.html} />
+}
