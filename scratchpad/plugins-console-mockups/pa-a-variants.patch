+// MOCK-HOOK FILE: direction A's own small parts (lane PLUGINS-CONSOLE-MOCKUPS, step build-a).
+
+import type { ReactNode } from 'react'
+import { FIXTURE_CLOCK } from '../../api'
+import { skillNotes } from '../fixtures'
+
+const NOW = Date.parse(FIXTURE_CLOCK)
+export const agoA = (minutes: number): string => new Date(NOW - minutes * 60_000).toISOString()
+
+/** Read once at module load, like switches.ts: `?pw=none` draws the workspace with no plugin allowed. */
+const query = typeof location === 'undefined' ? new URLSearchParams() : new URLSearchParams(location.search)
+export const A_NONE_ALLOWED = query.get('pw') === 'none'
+
+/** NOT SERVED, direction A's one new shape: the workspace setting goes down to skills, per mode.
+ *  Today `plugins.allowed` names plugins only; A adds `plugins.skills_off[plugin][mode]` (signed with the
+ *  same block). Default: every offered skill of an allowed plugin is on. */
+export type SkillsOff = Record<string, string[]>
+export const SKILLS_OFF_REST: SkillsOff = { unattended: ['ship'] }
+/** config-open: the admin mid-change, two more unattended skills switched off and not saved yet. */
+export const SKILLS_OFF_PENDING: SkillsOff = { unattended: ['ship', 'qa', 'document-release'] }
+
+/** The audit rows A draws (newest first). The route serves the last one only; the rest are NOT SERVED. */
+export interface ChangeRow { at: string; by: string; what: string }
+export const CHANGES_A: readonly ChangeRow[] = [
+  { at: agoA(3 * 60 + 12), by: 'bogdan@example.com', what: 'Unattended: ship switched off' },
+  { at: agoA(26 * 60), by: 'bogdan@example.com', what: 'gstack allowed (was: none)' },
+]
+
+/** An on/off switch: a checkbox drawn as a switch, its name said beside it or as its label. */
+export function Switch({ on, label, disabled = false, changed = false, onChange, quiet = false }: {
+  on: boolean; label: string; disabled?: boolean; changed?: boolean; onChange?: (on: boolean) => void; quiet?: boolean
+}) {
+  return (
+    <label className={`pa-switch${changed ? ' is-changed' : ''}${disabled ? ' is-off' : ''}`} title={label}>
+      <input type="checkbox" role="switch" checked={on} disabled={disabled} aria-label={label}
+        onChange={(e) => onChange?.(e.target.checked)} />
+      <span className="pa-switch-track" aria-hidden><span /></span>
+      {!quiet && <span className="pa-switch-word">{on ? 'On' : 'Off'}</span>}
+    </label>
+  )
+}
+
+/** A skill name as the console prints names: mono, its few words as its title. */
+export function SkillName({ name, children }: { name: string; children?: ReactNode }) {
+  return <code className="pa-skill" title={skillNotes[name] ?? 'What it does: not known'}>{name}{children}</code>
+}
+
+/** Minutes as "38 min", "3 h 12 min". */
+export function minutesWords(m: number): string {
+  if (m < 60) return `${m} min`
+  return `${Math.floor(m / 60)} h${m % 60 === 0 ? '' : ` ${m % 60} min`}`
+}
+
+export function minutesSince(iso: string | null): number | null {
+  return iso === null ? null : Math.round((NOW - Date.parse(iso)) / 60_000)
+}
