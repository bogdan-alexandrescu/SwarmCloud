+
+/** The read, as `_serve_wait` answers it; `skill`, `previews` and `interview` are NOT SERVED (marked). */
+export interface InterviewRead {
+  task_id: string
+  count: number
+  questions: ServedQuestion[]
+  redacted: boolean
+  redaction_count: number
+  may_answer: boolean
+  may_answer_because: string | null
+  status: 'ok'
+  attempt_id: string
+  waiting: { open: boolean; blocking: number[]; unanswered: number[]; asked_at: string | null; expires_at: string | null; issue_comment_url: string | null }
+  /** NOT SERVED: the skill that asked (not in the hook payload; read off the session). */
+  skill: string | null
+  /** NOT SERVED: per option label, its preview. */
+  previews: Record<string, Preview>
+  /** NOT SERVED: every earlier question of this interview (main keeps 5 earlier waits). */
+  interview: { n: number; question: string; skill: string; answer: ServedAnswer }[]
+}
+
