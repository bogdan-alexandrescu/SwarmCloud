diff --git a/apps/swarm-ui/src/pluginsconsole/A/BuilderA.tsx b/apps/swarm-ui/src/pluginsconsole/A/BuilderA.tsx
new file mode 100644
index 0000000..0d89554
--- /dev/null
+++ b/apps/swarm-ui/src/pluginsconsole/A/BuilderA.tsx
@@ -0,0 +1,239 @@
+// MOCK-HOOK FILE: direction A, the workflow builder: each step card gets a Plugins row (the chosen set compact, what
+// the last run used), opening in place to a mode segmented control and skill chips, refusals inline under it
+// (features.md §2, B1-B11). The stages and cards borrow the real builder's classes (SubmitWorkflow.tsx `wfb-*`).
+
+import { Fragment, useState } from 'react'
+import { Button, Chip, Dash, Segmented } from '../../components'
+import { PageHead } from '../../Shell'
+import { CLAUDE_CODE_PROFILES, MODES, builderSteps, gstackEntry, pluginsRead, refusalWords, skillNotes, workflowName,
+  type BuilderStep, type PluginMode, type StepPlugins, type UsedPlugins } from '../fixtures'
+import { MODE_MEANS, MODE_WORDS } from '../parts'
+import type { MockState } from '../switches'
+import { A_NONE_ALLOWED, SKILLS_OFF_REST } from './shared'
+
+/** Stages from `depends_on`, as the builder draws them: a step sits one stage below the last it waits for. */
+function stagesOf(steps: readonly BuilderStep[]): BuilderStep[][] {
+  const depth = new Map<string, number>()
+  for (const s of steps) depth.set(s.step_id, s.depends_on.length === 0 ? 0 : Math.max(...s.depends_on.map((d) => depth.get(d) ?? 0)) + 1)
+  const out: BuilderStep[][] = []
+  for (const s of steps) (out[depth.get(s.step_id)!] ??= []).push(s)
+  return out
+}
+
+/** rest: the six steps, the gstack steps showing their choice and what their last run used. open: the picker open on
+ *  `review` (unattended), mid-change. answered: the run finished, what each step used. */
+export function BuilderA({ state, bridgeLanded }: { state: MockState; bridgeLanded: boolean }) {
+  const [openStep, setOpenStep] = useState<string | null>(state === 'open' ? 'review' : null)
+  const stages = stagesOf(builderSteps)
+  const refused = builderSteps.filter((s) => s.refusal !== null)
+  return (
+    <div className="pa-page pa-builder">
+      <PageHead title="New workflow" />
+      <p className="pa-lead">{workflowName} · <span className="mono">example-org/roombook</span> · {builderSteps.length} steps, opened from its last run</p>
+      <div className="pa-wfb">
+        {stages.map((inStage, i) => (
+          <Fragment key={i}>
+            {i > 0 && (
+              <div className="sbf-flow" aria-hidden="true">
+                <svg viewBox="0 0 22 26" focusable="false"><path d="M11 1v20M4 15l7 7 7-7" fill="none" stroke="currentColor" strokeWidth="1.6" /></svg>
+              </div>
+            )}
+            <div className="wfb-stage" data-stage={i}>
+              <div className="wfb-stage-h">
+                <span className="wfb-stage-n">Stage {i + 1}</span>
+                <span className="wfb-stage-say">{i === 0 ? 'starts immediately' : inStage.length > 1 ? `${inStage.length} steps run together` : `after ${inStage[0]!.depends_on.join(', ')}`}</span>
+              </div>
+              <div className={`wfb-steps pa-steps${inStage.length > 1 ? ' is-two' : ''}`}>
+                {inStage.map((s) => (
+                  <StepCardA key={s.step_id} step={s} open={openStep === s.step_id} finished={state === 'answered'}
+                    bridgeLanded={bridgeLanded} onOpen={() => setOpenStep(s.step_id)} onClose={() => setOpenStep(null)} />
+                ))}
+              </div>
+            </div>
+          </Fragment>
+        ))}
+      </div>
+      <div className="pa-submitbar" data-f="B11">
+        {refused.length > 0
+          ? <span className="pa-refuse-line"><b>Submit refused at {refused.map((s) => s.step_id).join(', ')}</b> · nothing was started; the reason is on the step.</span>
+          : <span className="pa-dim">Ready to submit.</span>}
+        <Button kind="primary">Submit workflow</Button>
+      </div>
+    </div>
+  )
+}
+
+function StepCardA({ step, open, finished, bridgeLanded, onOpen, onClose }: {
+  step: BuilderStep; open: boolean; finished: boolean; bridgeLanded: boolean; onOpen: () => void; onClose: () => void
+}) {
+  const canLoad = CLAUDE_CODE_PROFILES.includes(step.runner_profile)
+  return (
+    <div className={`wfb-step pa-step${step.refusal !== null ? ' is-bad' : ''}${open ? ' is-open' : ''}`}>
+      <div className="wfb-step-h pa-step-h">
+        <span className="mono pa-step-id">{step.step_id}</span>
+        <span className="pa-step-title">{step.title}</span>
+        <span className="pa-step-runner"><span className="pa-k">Runner</span> <span className="mono">{step.runner_profile}</span></span>
+      </div>
+      <div className="pa-plugrow">
+        <span className="pa-k">Plugins</span>
+        <div className="pa-plugrow-v">
+          {open
+            ? <Picker step={step} bridgeLanded={bridgeLanded} onDone={onClose} />
+            : <ChosenLine plugins={step.plugins} used={step.used} finished={finished} canLoad={canLoad} onOpen={onOpen} />}
+          {step.refusal !== null && (
+            <p className="pa-refuse" data-f="B5 B11">
+              <b>{step.runner_profile} cannot load plugins.</b> gstack runs on the {CLAUDE_CODE_PROFILES.length} claude-code profiles only.
+              Choose one of them as this step&rsquo;s runner, or remove gstack.
+              <span className="pa-refuse-acts"><Button size="sm">Use claude-code-review</Button><Button size="sm" kind="ghost">Remove gstack</Button></span>
+            </p>
+          )}
+        </div>
+      </div>
+    </div>
+  )
+}
+
+/** B8: the chosen set on the step, compact: plugin, mode, the skill names. B9, B10: what the last finished attempt
+ *  used rides on the same chips (the times each skill ran), with its version and mode on one line under them. */
+function ChosenLine({ plugins, used, finished, canLoad, onOpen }: {
+  plugins: StepPlugins | null; used: UsedPlugins | null; finished: boolean; canLoad: boolean; onOpen: () => void
+}) {
+  if (plugins === null) {
+    return (
+      <p className="pa-chosen is-none">
+        <span className="pa-dim">None</span>
+        {canLoad
+          ? <button type="button" className="c-link is-sm" onClick={onOpen}>Add a plugin</button>
+          : <span className="pa-dim pa-small">· this runner cannot load plugins</span>}
+      </p>
+    )
+  }
+  return (
+    <>
+      {Object.entries(plugins).map(([name, p]) => {
+        const u = used?.[name] ?? null
+        const extra = u === null ? [] : u.skills.filter((s) => !p.skills.includes(s))
+        return (
+          <div key={name} className="pa-chosen-wrap">
+            <p className="pa-chosen" data-f="B8">
+              <span className="pa-chosen-plugin">{name}</span>
+              <span className="pa-mode-tag">{MODE_WORDS[p.mode]}</span>
+              <span className="pa-chosen-skills">
+                {[...p.skills, ...extra].map((s) => (
+                  <span key={s} className="pa-run" data-f={u === null ? undefined : 'B10'}>
+                    <code className="pa-skill">{s}</code>
+                    {u !== null && u.skill_runs !== null && <b className={u.skill_runs[s] === 0 ? 'is-zero' : ''}>×{u.skill_runs[s] ?? 0}</b>}
+                  </span>
+                ))}
+              </span>
+              {canLoad && <button type="button" className="c-link is-sm" onClick={onOpen}>Change</button>}
+            </p>
+            {u !== null && (
+              <p className="pa-used" data-f="B9 B10">
+                {finished ? 'This run used' : 'Last run used'} <span className="mono pa-used-v">{name} {u.version}</span>{'\u00a0'}· {MODE_WORDS[u.mode]} mode ·{' '}
+                {u.skill_runs === null
+                  ? <>times each skill ran <Dash why="Not known: the agent's stream was not read" /> not known: its stream was not read</>
+                  : <>×n is how many times each skill ran; ×0 ran none</>}
+                {u.skills.length !== p.skills.length && <> · it used {u.skills.length} skills</>}
+              </p>
+            )}
+          </div>
+        )
+      })}
+    </>
+  )
+}
+
+/** B1-B4, B6, B7: the picker, in place on the step. */
+function Picker({ step, bridgeLanded, onDone }: { step: BuilderStep; bridgeLanded: boolean; onDone: () => void }) {
+  const read = pluginsRead({ canEdit: false, bridgeLanded, allowed: A_NONE_ALLOWED ? [] : ['gstack'] })
+  const entry = gstackEntry(bridgeLanded)
+  const first = step.plugins?.gstack
+  const allowed = read.plugins.allowed.includes(entry.name)
+  const [mode, setMode] = useState<PluginMode>(first?.mode ?? 'unattended')
+  // Mid-change: `health` and `plan-eng-review` taken off, `qa-only` added; 3 of the 11 the workspace allows.
+  const [skills, setSkills] = useState<string[]>(step.step_id === 'review' ? ['review', 'investigate', 'qa-only'] : first?.skills ?? [])
+  const offered = entry.modes[mode]
+  // MOCK-HOOK: the change against what the step has saved, so the open picker says why it differs from the card at rest.
+  const saved = first?.mode === mode ? first.skills : []
+  const added = skills.filter((s) => !saved.includes(s))
+  const takenOff = saved.filter((s) => !skills.includes(s))
+  const offHere = SKILLS_OFF_REST[mode] ?? []
+  if (!allowed) {
+    return (
+      <div className="pa-picker" data-f="B4 B6">
+        <p className="pa-refuse"><b>No plugin can be added:</b> {refusalWords.notAllowed}.</p>
+        <p className="pa-row"><Button size="sm" kind="ghost" onClick={onDone}>Close</Button></p>
+      </div>
+    )
+  }
+  return (
+    <div className="pa-picker">
+      <div className="pa-pick-line" data-f="B1 B4">
+        <span className="pa-pick-k">Plugin</span>
+        <span className="pa-pick-v">
+          <Chip onClick={() => undefined} pressed>{entry.name}</Chip>
+          <span className="pa-dim pa-small">{entry.version}, pinned in the image · {read.plugins.allowed.length} of {read.catalogue.length} catalogue plugin allowed here</span>
+        </span>
+      </div>
+      <div className="pa-pick-line" data-f="B2 B7">
+        <span className="pa-pick-k">Mode</span>
+        <span className="pa-pick-v">
+          <Segmented small label="Mode" value={mode} onChange={(m) => { setMode(m); setSkills([]) }}
+            options={MODES.map((m) => ({ key: m, label: MODE_WORDS[m], title: MODE_MEANS[m] }))} />
+          <span className="pa-dim pa-small">{MODE_MEANS[mode]}</span>
+          {!offered.available && <span className="pa-refuse is-block">{refusalWords.mode(mode)}.</span>}
+        </span>
+      </div>
+      <div className="pa-pick-line" data-f="B3 B6">
+        <span className="pa-pick-k">Skills <span className="pa-dim">{skills.length} of {offered.skills.length - offHere.length}</span></span>
+        <span className="pa-pick-v">
+          <span className="pa-skillchips">
+            {offered.skills.map((s) => {
+              const off = offHere.includes(s)
+              const on = skills.includes(s)
+              const changed = added.includes(s) ? ' is-added' : takenOff.includes(s) ? ' is-taken-off' : ''
+              return off
+                ? <span key={s} className="pa-skillchip is-refused" title="Switched off for this workspace in Config › Plugins">{s}</span>
+                : (
+                  <button key={s} type="button" className={`pa-skillchip${on ? ' is-on' : ''}${changed}`} aria-pressed={on}
+                    disabled={!offered.available} title={changed === ' is-added' ? 'Added, not saved' : changed === ' is-taken-off' ? 'Taken off, not saved' : MODE_MEANS[mode]}
+                    onClick={() => setSkills(on ? skills.filter((x) => x !== s) : [...skills, s])}>
+                    {on && <svg viewBox="0 0 16 16" aria-hidden><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" strokeWidth="1.8" /></svg>}
+                    {s}
+                  </button>
+                )
+            })}
+          </span>
+          {offHere.length > 0 && (
+            <span className="pa-refuse is-block" data-f="B6">
+              <b>{offHere.join(', ')}</b>: not allowed in this workspace (switched off by its admin in Config › Plugins).
+            </span>
+          )}
+          {(added.length > 0 || takenOff.length > 0) && (
+            <span className="pa-unsaved is-block">
+              <b>Not saved yet:</b>
+              {added.length > 0 && <span>added {added.map((x) => <code key={x} className="pa-skill">{x}</code>)}</span>}
+              {takenOff.length > 0 && <span>taken off {takenOff.map((x) => <code key={x} className="pa-skill">{x}</code>)}</span>}
+              <span className="pa-dim">· saved: {saved.length} skills, as the step shows at rest; Done keeps the change</span>
+            </span>
+          )}
+          <span className="pa-picked-notes">
+            {skills.map((s) => (
+              <span key={s}><code className="pa-skill">{s}</code> {pickedNote(s)}</span>
+            ))}
+          </span>
+        </span>
+      </div>
+      <p className="pa-pick-foot">
+        <Button size="sm" kind="primary" onClick={onDone}>Done</Button>
+        <Button size="sm" kind="ghost" onClick={onDone}>Remove gstack</Button>
+        <span className="pa-dim pa-small">By name only: the version comes with the image.</span>
+      </p>
+    </div>
+  )
+}
+
+function pickedNote(s: string): string {
+  return skillNotes[s] ?? 'what it does: not known'
+}
diff --git a/apps/swarm-ui/src/pluginsconsole/A/ConfigA.tsx b/apps/swarm-ui/src/pluginsconsole/A/ConfigA.tsx
