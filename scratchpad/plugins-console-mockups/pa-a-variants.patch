@@ -0,0 +1,218 @@
+// MOCK-HOOK FILE: direction A, Config › Plugins: a dense catalogue table whose row opens to the skills per mode,
+// each with its workspace switch, the never-offered skills and the audit line (features.md §1, C1-C14).
+
+import { useState } from 'react'
+import { Banner, Button, Chip } from '../../components'
+import { PageHead } from '../../Shell'
+import { MODES, neverOffered, pluginsRead, skillNotes, type PluginMode } from '../fixtures'
+import { MODE_MEANS, MODE_WORDS, at, person } from '../parts'
+import type { MockState } from '../switches'
+import { A_NONE_ALLOWED, CHANGES_A, SKILLS_OFF_PENDING, SKILLS_OFF_REST, Switch, type ChangeRow, type SkillsOff } from './shared'
+
+const SAVED_AT = '2026-10-19T11:59:00Z'
+
+/** MOCK-HOOK: "gbrain skills" and "iOS skills" are families, not one skill each, so they are counted apart. */
+const isFamily = (name: string) => name.endsWith(' skills')
+const neverFamilies = neverOffered.reduce((n, g) => n + g.skills.filter(isFamily).length, 0)
+const neverSkills = neverOffered.reduce((n, g) => n + g.skills.length, 0) - neverFamilies
+
+export function ConfigA({ state, viewer, bridgeLanded }: { state: MockState; viewer: boolean; bridgeLanded: boolean }) {
+  const read = pluginsRead({ canEdit: !viewer, bridgeLanded, allowed: A_NONE_ALLOWED ? [] : ['gstack'] })
+  const saved: SkillsOff = state === 'answered' ? SKILLS_OFF_PENDING : SKILLS_OFF_REST
+  const [off, setOff] = useState<SkillsOff>(state === 'open' ? SKILLS_OFF_PENDING : saved)
+  const [allowed, setAllowed] = useState<string[]>(read.plugins.allowed)
+  const [openRow, setOpenRow] = useState<string | null>('gstack')
+  const history: ChangeRow[] = state === 'answered'
+    ? [{ at: SAVED_AT, by: 'bogdan@example.com', what: 'Unattended: qa, document-release switched off' }, ...CHANGES_A]
+    : [...CHANGES_A]
+  const pending = MODES.flatMap((m) => {
+    const now = off[m] ?? []
+    const was = saved[m] ?? []
+    return [
+      ...now.filter((s) => !was.includes(s)).map((s) => ({ m, s, on: false })),
+      ...was.filter((s) => !now.includes(s)).map((s) => ({ m, s, on: true })),
+    ]
+  })
+  const pluginPending = allowed.join() !== read.plugins.allowed.join()
+  const dirty = pending.length + (pluginPending ? 1 : 0)
+  const flip = (m: PluginMode, s: string, on: boolean) =>
+    setOff({ ...off, [m]: on ? (off[m] ?? []).filter((x) => x !== s) : [...(off[m] ?? []), s] })
+  const last = history[0]!
+
+  return (
+    <div className="pa-page pa-config">
+      <PageHead title="Plugins" />
+      <p className="pa-lead" data-f="C14">
+        Agent steps load plugins from the platform&rsquo;s closed catalogue. Each plugin is built into the agent images at one
+        pinned version; a step names a plugin, a mode and skills by name. Nothing here takes a path, a command, a web address or a version.
+      </p>
+
+      {state === 'answered' && (
+        <Banner tone="info" title="Saved and signed">
+          Unattended <code>qa</code> and <code>document-release</code> are off for this workspace. Recorded as Bogdan, {at(SAVED_AT)}.
+        </Banner>
+      )}
+
+      <dl className="pa-strip">
+        <div data-f="C8">
+          <dt>This workspace may use</dt>
+          <dd>{read.plugins.allowed.length === 0 ? <span>No plugin</span> : read.plugins.allowed.map((n) => <Chip key={n}>{n}</Chip>)}</dd>
+        </div>
+        <div data-f="C9">
+          <dt>When nobody has chosen</dt>
+          <dd>No plugin allowed</dd>
+        </div>
+        <div data-f="C11">
+          <dt>Setting</dt>
