+// MOCK-HOOK FILE: the plugins console mock-ups' fixtures (lane PLUGINS-CONSOLE-MOCKUPS). Invented data only.
+//
+// Every shape below is either what main serves (named beside it) or, where main
+// serves nothing yet, the smallest honest shape, marked NOT SERVED. base-notes.md
+// lists both. Times count from the console's FIXTURE_CLOCK, as every fixture does.
+
+import { FIXTURE_CLOCK } from '../api'
+
+const NOW = Date.parse(FIXTURE_CLOCK)
+const ago = (minutes: number): string => new Date(NOW - minutes * 60_000).toISOString()
+const ahead = (minutes: number): string => new Date(NOW + minutes * 60_000).toISOString()
+
+export const TENANT = 'u-bogdan'
+export const PEOPLE: Readonly<Record<string, string>> = {
+  'bogdan@example.com': 'Bogdan',
+  'ana.moreau@example.com': 'Ana Moreau',
+  'kenji.sato@example.com': 'Kenji Sato',
+}
+
+// --- Config › Plugins: GET /v1/workspaces/{t}/plugins (swarm_api/plugins.py `view`) -------------------
+
+export type PluginMode = 'unattended' | 'planner' | 'designer'
+export const MODES: readonly PluginMode[] = ['unattended', 'planner', 'designer']
+
+/** `catalogue_view()`: one entry. The install path is the image's and is not served. */
+export interface CatalogueEntry {
+  name: string
+  version: string
+  runner_profiles: string[]
+  modes: Record<PluginMode, { skills: string[]; available: boolean; reason?: string }>
+}
+
+/** `view()`: what GET and PUT answer. */
+export interface PluginsRead {
+  tenant_id: string
+  plugins: { allowed: string[] }
+  defaults: { plugins: { allowed: string[] } }
+  set_at: string | null
+  set_by: string | null
+  can_edit: boolean
+  catalogue: CatalogueEntry[]
+}
+
+export const CLAUDE_CODE_PROFILES = [
+  'claude-code', 'claude-code-large', 'claude-code-review', 'claude-code-browser', 'claude-code-lightpanda',
+]
+
+/** The bridge's reason, word for word (`plugincatalogue.BRIDGE_REASON`). */
+export const BRIDGE_REASON =
+  'runs an interview with a person, which needs the question bridge; until it lands only unattended mode runs'
+
+/** gstack as `plugincatalogue.GSTACK` lists it. `bridgeLanded` draws the console the plan builds for:
+ *  planner and designer available. False draws main today: both refused with BRIDGE_REASON. */
+export function gstackEntry(bridgeLanded: boolean): CatalogueEntry {
+  const mode = (skills: string[], always = false) =>
+    always || bridgeLanded ? { skills, available: true } : { skills, available: false, reason: BRIDGE_REASON }
+  return {
+    name: 'gstack',
+    version: '1.92.55.0',
+    runner_profiles: CLAUDE_CODE_PROFILES,
+    modes: {
+      unattended: mode(['review', 'investigate', 'health', 'qa-only', 'qa', 'design-review', 'document-generate',
+        'document-release', 'ship', 'plan-eng-review', 'plan-design-review', 'autoplan'], true),
+      planner: mode(['office-hours', 'plan-ceo-review', 'plan-eng-review', 'plan-devex-review', 'autoplan', 'spec']),
+      designer: mode(['design-consultation', 'plan-design-review', 'design-review', 'design-html']),
+    },
+  }
+}
+
+export function pluginsRead(opts: { canEdit: boolean; allowed?: string[]; bridgeLanded?: boolean }): PluginsRead {
+  return {
+    tenant_id: TENANT,
+    plugins: { allowed: opts.allowed ?? ['gstack'] },
+    defaults: { plugins: { allowed: [] } },
+    set_at: ago(26 * 60),
+    set_by: 'bogdan@example.com',
+    can_edit: opts.canEdit,
+    catalogue: [gstackEntry(opts.bridgeLanded ?? true)],
+  }
+}
+
+/** NOT SERVED: what each skill does, in a few words (from gstack's own skill descriptions). */
+export const skillNotes: Readonly<Record<string, string>> = {
+  review: 'Reviews the change for bugs before it lands',
+  investigate: 'Finds the root cause of a failure, step by step',
+  health: 'Scores the codebase: tests, types, lint, dead code',
+  'qa-only': 'Tests the running app and reports, fixes nothing',
+  qa: 'Tests the running app and fixes what it finds',
+  'design-review': 'Checks the built pages against the design',
+  'document-generate': 'Writes the missing docs for what changed',
+  'document-release': 'Brings the docs up to date for a release',
+  ship: 'Prepares the hand-off; never pushes',
+  'plan-eng-review': 'Reviews a plan as an engineering lead',
+  'plan-design-review': 'Reviews a plan as a designer',
+  autoplan: 'Runs the plan reviews one after another',
+  'office-hours': 'Interviews you about the problem before any plan',
+  'plan-ceo-review': 'Challenges the plan’s scope and ambition',
+  'plan-devex-review': 'Reviews a plan for developer experience',
+  spec: 'Writes the specification as a file, nothing else',
+  'design-consultation': 'Interviews you to build a design system',
+  'design-html': 'Turns the chosen design into working HTML',
+}
+
+/** NOT SERVED: the skills gstack ships that are never offered, and why (design doc, "Never offered"). */
+export const neverOffered: ReadonlyArray<{ skills: string[]; why: string }> = [
+  { skills: ['careful', 'guard'], why: 'They answer “ask” before risky commands, and nobody can answer inside an agent' },
+  { skills: ['cso'], why: 'Left out of the first catalogue: as packaged it cannot run (Bogdan, in the approved plugins plan)' },
+  { skills: ['gstack-upgrade'], why: 'The version is pinned in the image; nothing upgrades at run time' },
+  { skills: ['land-and-deploy', 'canary'], why: 'They merge and deploy; the platform’s merge step does that' },
+  { skills: ['captain', 'pair-agent', 'connect-chrome', 'setup-browser-cookies'], why: 'They drive another agent or a person’s own browser' },
+  { skills: ['gbrain skills', 'iOS skills', 'plan-tune'], why: 'They need tools or accounts the agent images do not carry' },
+  { skills: ['design-shotgun', 'second opinion'], why: 'They call an outside AI service; none is used at first' },
+]
+
+/** NOT SERVED by the plugins route: the audit rows (`workspace_plugins_set`) for this workspace, newest first. */
+export const changes: ReadonlyArray<{ at: string; by: string; before: string[]; after: string[] }> = [
+  { at: ago(26 * 60), by: 'bogdan@example.com', before: [], after: ['gstack'] },
+]
+
+// --- A step's plugins: metadata.work_contract.capabilities.plugins (workcontract.to_document) ---------
+
+export type StepPlugins = Record<string, { mode: PluginMode; skills: string[] }>
+
+/** An attempt's `result_summary.plugins` (agent_worker/plugins.record). `skill_runs: null` = NOT READ:
+ *  the fixture's way to draw a stream the worker could not read (record() itself writes counts). */
+export type UsedPlugins = Record<string, { version: string; mode: PluginMode; skills: string[]; skill_runs: Record<string, number> | null }>
+
+export interface BuilderStep {
+  step_id: string
+  title: string
+  runner_profile: string
+  depends_on: string[]
+  plugins: StepPlugins | null
+  /** What the step's last finished attempt used; null when it has not run. */
+  used: UsedPlugins | null
+  /** Submission's refusal for this step (422 `plugin_refused`), word for word as `check_step` says it. */
+  refusal: string | null
+}
+
+export const workflowName = 'roombook: checkout redesign'
+export const builderSteps: readonly BuilderStep[] = [
+  { step_id: 'scope', title: 'Read the checkout and list what it does', runner_profile: 'claude-code', depends_on: [],
+    plugins: null, used: null, refusal: null },
+  { step_id: 'plan-checkout', title: 'Plan the redesign with the team', runner_profile: 'claude-code', depends_on: ['scope'],
