+// MOCK-HOOK FILE: the step's plugin picker in the workflow builder, plain layout (features.md §2, B1-B11).
+
+import { useState } from 'react'
+import { Banner, Button, Card, Segmented } from '../components'
+import { PageHead } from '../Shell'
+import { CLAUDE_CODE_PROFILES, MODES, builderSteps, gstackEntry, pluginsRead, refusalWords, workflowName,
+  type PluginMode, type StepPlugins } from './fixtures'
+import { Item, MODE_MEANS, MODE_WORDS, PluginSummary, Skill, UsedTable } from './parts'
+import type { MockState } from './switches'
+
+/** rest: six steps opened from the workflow's last run (what each used shown), the chosen sets compact, the picker closed. open: the picker open on the planner step.
+ *  answered: the workflow finished, each step showing what it used. */
+export function BuilderPlugins({ state, bridgeLanded }: { state: MockState; bridgeLanded: boolean }) {
+  const [openStep, setOpenStep] = useState<string | null>(state === 'rest' ? 'plan-checkout' : state === 'open' ? 'review' : null)
+  const finished = state === 'answered'
+  return (
+    <div className="pc-page">
+      <PageHead title="New workflow" />
+      <p className="pc-lead">{workflowName} · example-org/roombook · {builderSteps.length} steps</p>
+      <Item f="B11">
+        <Banner tone="bad" title="Submission refused at step second-look">
+          {builderSteps.find((s) => s.step_id === 'second-look')!.refusal}. Nothing was started; change the step and submit again.
+        </Banner>
+      </Item>
+      {builderSteps.map((s) => (
+        <Card key={s.step_id} level={3} title={<>{s.step_id} <span className="pc-dim">{s.title}</span></>}>
+          <dl className="pc-facts">
+            <dt>Runner</dt><dd>{s.runner_profile}</dd>
+            <dt>After</dt><dd>{s.depends_on.length === 0 ? 'starts first' : s.depends_on.join(', ')}</dd>
+            <dt>Plugins</dt>
+            <dd>
+              <Item f="B8"><PluginSummary plugins={s.plugins} /></Item>
+            </dd>
+          </dl>
+          {s.step_id === 'second-look' && (
+            <Item f="B5"><p className="pc-refusal">This step&rsquo;s runner, {s.runner_profile}, cannot load plugins: gstack runs only on {CLAUDE_CODE_PROFILES.join(', ')}. Pick one of those runners, or remove gstack from this step.</p></Item>
+          )}
+          {s.used !== null && (
+            <Item f="B9 B10">
+              <h4 className="pc-h3">{finished ? 'This run used' : 'Its last run used'}</h4>
+              <UsedTable used={s.used} />
+            </Item>
+          )}
+          {finished && s.used === null && s.plugins !== null && <p className="pc-dim">This step did not run, so nothing was used.</p>}
+          {!finished && CLAUDE_CODE_PROFILES.includes(s.runner_profile) && (
+            openStep === s.step_id
+              ? <Picker initial={s.plugins} bridgeLanded={bridgeLanded} onDone={() => setOpenStep(null)} />
+              : <p><Button size="sm" onClick={() => setOpenStep(s.step_id)}>{s.plugins === null ? 'Add a plugin' : 'Change plugins'}</Button></p>
+          )}
+        </Card>
+      ))}
+      <Card level={3} title="What the picker says when it refuses">
+        <Item f="B6"><p className="pc-refusal">When the workspace has not allowed gstack: {refusalWords.notAllowed}.</p></Item>
+        <Item f="B7"><p className="pc-refusal">When a mode does not run yet: {refusalWords.mode('designer')}.</p></Item>
+      </Card>
+    </div>
+  )
+}
+
+function Picker({ initial, bridgeLanded, onDone }: { initial: StepPlugins | null; bridgeLanded: boolean; onDone: () => void }) {
+  const read = pluginsRead({ canEdit: false, bridgeLanded })
+  const entry = gstackEntry(bridgeLanded)
+  const first = initial?.gstack
+  const [on, setOn] = useState(first !== undefined)
+  const [mode, setMode] = useState<PluginMode>(first?.mode ?? 'unattended')
+  const [skills, setSkills] = useState<string[]>(first?.skills ?? [])
+  const offered = entry.modes[mode]
+  const allowed = read.plugins.allowed.includes(entry.name)
+  return (
+    <form className="pc-form" onSubmit={(e) => { e.preventDefault(); onDone() }}>
+      <Item f="B1 B4">
+        <fieldset>
+          <legend>Plugin</legend>
+          <label className="pc-check">
+            <input type="checkbox" checked={on} disabled={!allowed} onChange={(e) => setOn(e.target.checked)} />
+            {entry.name} {entry.version}
+          </label>
+          <p className="pc-dim pc-small">Only plugins this workspace allows are offered. Allowed here: {read.plugins.allowed.join(', ') || 'none'}.</p>
+        </fieldset>
+      </Item>
+      {on && (
+        <>
+          <Item f="B2">
+            <Segmented label="Mode" value={mode} onChange={(m) => { setMode(m); setSkills([]) }}
+              options={MODES.map((m) => ({ key: m, label: MODE_WORDS[m] }))} />
+            <p className="pc-dim pc-small">{MODE_WORDS[mode]}: {MODE_MEANS[mode]}.</p>
+            {!offered.available && <p className="pc-refusal">{refusalWords.mode(mode)}.</p>}
+          </Item>
+          <Item f="B3">
+            <fieldset disabled={!offered.available}>
+              <legend>Skills it may use ({skills.length} of {offered.skills.length})</legend>
+              {offered.skills.map((s) => (
+                <label key={s} className="pc-check">
+                  <input type="checkbox" checked={skills.includes(s)}
+                    onChange={(e) => setSkills(e.target.checked ? [...skills, s] : skills.filter((x) => x !== s))} />
+                  <Skill name={s} notes />
+                </label>
+              ))}
+            </fieldset>
+          </Item>
+        </>
+      )}
+      <p className="pc-row"><Button kind="primary" type="submit">Done</Button><Button kind="ghost" onClick={onDone}>Cancel</Button></p>
+    </form>
+  )
+}
