+
+/** MOCK-HOOK: a rendered HTML design drawn at its own layout width and scaled down whole to the room it has, so a
+ *  narrow column shows the same design smaller instead of reflowing it into a broken one. Says the scale it drew at. */
+const DESIGN_WIDTH = 860
+function ScaledPreview({ preview }: { preview: Preview | undefined }) {
+  const box = useRef<HTMLDivElement>(null)
+  const [size, setSize] = useState<{ w: number; h: number } | null>(null)
+  useLayoutEffect(() => {
+    const el = box.current
+    if (el === null) return
+    const read = () => setSize({ w: el.clientWidth, h: el.clientHeight })
+    read()
+    const ro = new ResizeObserver(read)
+    ro.observe(el)
+    return () => ro.disconnect()
+  }, [])
+  if (preview === undefined || preview.kind !== 'html') return <PreviewView preview={preview} />
+  const scale = size === null ? 1 : Math.min(1, size.w / DESIGN_WIDTH)
+  return (
+    <div className="pa-scaled-wrap">
+      <div ref={box} className="pa-scaled">
+        {size !== null && (
+          <iframe title={preview.title} sandbox="" srcDoc={preview.html}
+            style={{ width: DESIGN_WIDTH, height: Math.round(size.h / scale), transform: `scale(${scale})` }} />
+        )}
+      </div>
+      <span className="pa-scaled-k">{scale < 1 ? `Drawn at ${Math.round(scale * 100)}% of its ${DESIGN_WIDTH} px width` : 'Drawn at full size'}</span>
+    </div>
+  )
+}
