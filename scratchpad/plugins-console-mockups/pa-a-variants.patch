+// MOCK-HOOK FILE: the plugins console mock-ups' URL switches, read ONCE at module load.
+//
+// The console's router rewrites the address bar to its own path and drops any
+// query it does not know, so the switches are captured before App first
+// renders (App.tsx imports this module) and kept for the page's life.
+//   ?pa=base|a|b                  the direction (base: the scaffold's plain layout)
+//   ?ps=config|builder|plan|needs the screen
+//   ?pst=rest|open|answered|proposal the state (what each means per screen: base-notes.md)
+//   ?pv=admin|viewer              who reads Config › Plugins (default admin)
+//   ?pb=today                     draw main as it is today: planner and designer refused (bridge not landed)
+// The theme is the console's own switch (Profile; stored in local storage as `swarm.theme`).
+
+export type MockDirection = 'base' | 'a' | 'b'
+export type MockScreen = 'config' | 'builder' | 'plan' | 'needs'
+export type MockState = 'rest' | 'open' | 'answered' | 'proposal'
+
+function pick<T extends string>(q: URLSearchParams, key: string, allowed: readonly T[], fallback: T): T {
+  const v = q.get(key)
+  return v !== null && (allowed as readonly string[]).includes(v) ? (v as T) : fallback
+}
+
+const query = typeof location === 'undefined' ? new URLSearchParams() : new URLSearchParams(location.search)
+const pa = query.get('pa')
+
+/** Null when no `?pa`: the console draws itself unchanged. */
+export const MOCK_PA: MockDirection | null = pa === 'base' || pa === 'a' || pa === 'b' ? pa : null
+export const MOCK_PS: MockScreen = pick(query, 'ps', ['config', 'builder', 'plan', 'needs'] as const, 'config')
+export const MOCK_PST: MockState = pick(query, 'pst', ['rest', 'open', 'answered', 'proposal'] as const, 'rest')
+export const MOCK_PV: 'admin' | 'viewer' = pick(query, 'pv', ['admin', 'viewer'] as const, 'admin')
+export const MOCK_BRIDGE_LANDED: boolean = query.get('pb') !== 'today'
+
+/** The console path each screen sits under, so the section nav and page chrome are the real ones. */
+export const SCREEN_PATH: Readonly<Record<MockScreen, string>> = {
+  config: '/config/plugins',
+  builder: '/submit/workflow',
+  plan: '/runs/run_4c1e09d2',
+  needs: '/workflows',
+}
