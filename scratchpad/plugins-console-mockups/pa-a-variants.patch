+    { kind: 'question' as const, taskId: 'task_rb_copy_51d2', index: 0, title: 'roombook › copy-review',
+      question: 'Use “Book now” or “Reserve” on the room page?', options: [{ label: 'Book now', description: null }, { label: 'Reserve', description: null }],
+      recommended: null, mayAnswer: true },
+    { kind: 'handoff', task: task('task_rb_login_77e0', 'wf_roombook_checkout', 'qa-login', 'RUNNING'), title: 'roombook › qa-login' },
