diff --git a/apps/swarm-ui/src/styles/vt-stage-a.css b/apps/swarm-ui/src/styles/vt-stage-a.css
new file mode 100644
index 0000000..d9ce4b6
--- /dev/null
+++ b/apps/swarm-ui/src/styles/vt-stage-a.css
@@ -0,0 +1,329 @@
+/* MOCK-HOOK FILE
+   VOICE IT'S OWN SPEECH, TALK, DIRECTION A: THE STAGE (?vt=a). Console tokens
+   only; glass and glow are tokens mixed with transparency. */
+
+.vta {
+  --vta-pin: var(--paused);
+  position: relative; isolation: isolate; overflow: clip;
+  display: grid; grid-template-rows: auto minmax(0, 1fr) auto auto auto;
+  gap: 10px; min-width: 0;
+  height: max(600px, calc(100dvh - 96px));
+  padding: 12px 16px 12px;
+  border: 1px solid var(--line-soft); border-radius: var(--r-dlg); background: var(--bg);
+}
+.vta-sky {
+  position: absolute; inset: 0; z-index: -1; pointer-events: none;
+  background:
+    radial-gradient(ellipse 60% 40% at 50% 100%, color-mix(in srgb, var(--info) 14%, transparent), transparent 70%),
+    radial-gradient(ellipse 40% 50% at 50% 30%, color-mix(in srgb, var(--info) 6%, transparent), transparent 70%);
+}
+.vta-ic { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
+.vta-ic.is-fill { width: 16px; height: 16px; fill: currentColor; stroke: none; }
+.vta-ic.is-tick { width: 14px; height: 14px; }
+.vta-tab .vta-ic { width: 15px; height: 15px; }
+
+/* ---- head: the visuals and the budget line -------------------------------- */
+.vta-head { display: flex; align-items: center; gap: 12px; min-width: 0; min-height: 30px; }
+.vta-tabs { display: flex; gap: 4px; min-width: 0; overflow-x: auto; scrollbar-width: none; }
+.vta-tab {
+  display: inline-flex; align-items: center; gap: 6px; flex: none; height: 30px; padding: 0 10px;
+  font: 500 var(--t-meta)/1 var(--font); color: var(--text-dim);
+  border: 1px solid transparent; border-radius: var(--r-pill); background: transparent; cursor: pointer;
+}
+.vta-tab:hover { color: var(--text); background: var(--vt-glass-dim); }
+.vta-tab[aria-pressed="true"] { color: var(--text); border-color: var(--vt-glass-line); background: var(--vt-glass); }
+.vta-tab-pins {
+  display: inline-grid; place-items: center; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px;
+  font: 600 var(--t-micro)/1 var(--font); font-variant-numeric: tabular-nums;
+  color: var(--paused-ink); background: color-mix(in srgb, var(--paused) 16%, transparent);
+}
+.vta-budget { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; flex: none; padding: 4px 2px; cursor: default; }
+.vta-head > .c-tip-host { margin-left: auto; }
+.vta-head > .c-tip-host .c-tip { left: auto; right: 0; }
+.vta-budget-n { font: 500 var(--t-meta)/1 var(--font); font-variant-numeric: tabular-nums; color: var(--text); }
+.vta-budget-of { color: var(--text-faint); }
+.vta-budget-track { width: 64px; height: 4px; border-radius: 2px; background: color-mix(in srgb, var(--text) 12%, transparent); overflow: hidden; }
+.vta-budget-fill { display: block; height: 100%; background: var(--text-dim); border-radius: 2px; }
+.vta-budget.is-warn .vta-budget-n { color: var(--warn-ink); font-weight: 600; }
+.vta-budget.is-warn .vta-budget-fill { background: var(--warn); }
+.vta-budget.is-warn .vta-budget-track { width: 96px; }
+.vta-budget.is-cap .vta-budget-n { color: var(--bad-ink); font-weight: 600; }
+.vta-budget.is-cap .vta-budget-fill { background: var(--bad); }
+.vta-budget.is-cap .vta-budget-track { width: 96px; }
+
+/* ---- the stage ------------------------------------------------------------- */
+.vta-stage { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); min-height: 0; min-width: 0; }
+.vta-stage.has-cards { grid-template-columns: minmax(0, 1fr) 320px; gap: 16px; }
+.vta-frame { container-type: size; min-width: 0; min-height: 0; display: grid; place-items: center; }
+/* The sheet would fall under the 12 px text floor at the fitted scale: it keeps that floor and the stage pans. */
+.vta-frame.is-pan { place-items: safe center; overflow: auto; scrollbar-width: thin; border-radius: var(--r-card); }
+.vta-sheet {
+  position: relative; flex: none;
+  border-radius: var(--r-card); overflow: visible;
+  box-shadow: 0 0 0 1px var(--vt-glass-line), 0 24px 60px -30px color-mix(in srgb, var(--info) 45%, transparent);
+  animation: vta-in 260ms ease-out;
+}
+.vta-sheet-body { font-size: var(--t-body); position: absolute; left: 0; top: 0; width: 960px; height: 600px; transform-origin: 0 0; border-radius: inherit; overflow: hidden; }
+@keyframes vta-in { from { opacity: 0; transform: scale(0.985); } }
+
+/* ---- notes and the pointer ------------------------------------------------- */
+.vta-notes-layer { position: absolute; inset: 0; cursor: crosshair; touch-action: none; }
+.vta-region {
+  position: absolute; pointer-events: none; border-radius: 6px;
+  border: 1.5px dashed var(--vta-pin); background: color-mix(in srgb, var(--paused) 10%, transparent);
+}
+.vta-region.is-dragging { border-style: solid; background: color-mix(in srgb, var(--paused) 14%, transparent); }
+.vta-point {
+  position: absolute; pointer-events: none; border-radius: 14px;
+  border: 2px solid var(--info); box-shadow: 0 0 0 6px color-mix(in srgb, var(--info) 18%, transparent), 0 0 28px color-mix(in srgb, var(--info) 45%, transparent);
+  opacity: 0.35; transition: opacity 300ms ease;
+}
+.vta-point.is-on { opacity: 1; animation: vta-breathe 1.8s ease-in-out infinite; }
+@keyframes vta-breathe { 50% { box-shadow: 0 0 0 10px color-mix(in srgb, var(--info) 10%, transparent), 0 0 36px color-mix(in srgb, var(--info) 55%, transparent); } }
+.vta-pin-at { position: absolute; width: 0; height: 0; z-index: 2; }
+.vta-pin {
+  position: absolute; left: -14px; top: -14px; width: 28px; height: 28px; padding: 0;
+  display: grid; place-items: center; border-radius: 50% 50% 50% 4px;
+  font: 700 var(--t-micro)/1 var(--font); color: var(--bg); background: var(--vta-pin);
+  border: 2px solid var(--bg); box-shadow: 0 4px 12px -2px color-mix(in srgb, #000 45%, transparent); cursor: pointer;
+  transition: transform 140ms ease;
+}
+.vta-pin:hover, .vta-pin.is-open { transform: scale(1.12); }
+.vta-pin:focus-visible { outline: 2px solid var(--info); outline-offset: 2px; }
+.vta-pin-note {
+  position: absolute; left: 22px; top: -14px; width: 260px;
+  display: flex; flex-direction: column; gap: 6px; padding: 10px 12px 6px;
+  border: 1px solid color-mix(in srgb, var(--paused) 40%, var(--line)); border-radius: var(--r-card);
+  background: var(--surface); box-shadow: var(--sk-sh, 0 12px 32px -12px rgba(0,0,0,.5));
+  animation: vta-pop 200ms ease-out;
+}
+.vta-pin-at.is-flip .vta-pin-note { left: auto; right: 22px; }
+.vta-pin-note.is-waiting { width: auto; padding: 10px 14px; }
+.vta-pin-note.is-landed { animation: vta-land 420ms cubic-bezier(.2,.9,.3,1.2); }
+@keyframes vta-pop { from { opacity: 0; transform: translateY(4px); } }
+@keyframes vta-land { from { opacity: 0; transform: translateY(-10px) scale(0.96); } }
+.vta-pin-text { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); }
+.vta-pin-foot { display: flex; align-items: center; gap: 4px; color: var(--text-faint); }
+.vta-pin-acts { margin-left: auto; display: inline-flex; gap: 2px; }
+.vta-via { display: inline-grid; place-items: center; width: 22px; height: 22px; color: var(--text-faint); }
+.vta-pin-wait { display: inline-flex; gap: 4px; }
+.vta-pin-wait > span { width: 6px; height: 6px; border-radius: 50%; background: var(--paused); animation: vta-wait 1s ease-in-out infinite; }
+.vta-pin-wait > span:nth-child(2) { animation-delay: .15s; }
+.vta-pin-wait > span:nth-child(3) { animation-delay: .3s; }
+@keyframes vta-wait { 50% { opacity: .25; transform: translateY(-2px); } }
+
+/* ---- cards at the right edge ----------------------------------------------- */
+.vta-cards { display: flex; flex-direction: column; gap: 10px; min-height: 0; overflow-y: auto; align-self: center; }
+.vta-card {
+  display: flex; flex-direction: column; gap: 10px; padding: 14px 14px 12px;
+  border: 1px solid var(--vt-glass-line); border-radius: var(--r-card); background: var(--surface);
+  box-shadow: 0 18px 40px -24px color-mix(in srgb, #000 60%, transparent);
+  animation: vta-slide 320ms cubic-bezier(.2,.8,.2,1);
+}
+.vta-card.is-leaving { animation: vta-leave 400ms ease-in forwards; }
+@keyframes vta-slide { from { opacity: 0; transform: translateX(48px); } }
+@keyframes vta-leave { to { opacity: 0; transform: translateX(64px); } }
+.vta-card.is-readback { border-left: 3px solid var(--paused); }
+.vta-card.is-readback.is-confirmed { border-left-color: var(--ok); }
+.vta-card.is-readback.is-refused { border-left-color: var(--text-faint); }
+.vta-card.is-readback.is-expired { border-left-color: var(--line); background: var(--bg); box-shadow: none; }
+.vta-card.is-expired .vta-rb-heard, .vta-card.is-expired .vta-rb-target, .vta-card.is-expired dt { color: var(--text-faint); }
+.vta-card-kind { margin: 0; font-size: var(--t-meta); color: var(--text-dim); }
+.vta-card-title { margin: 0; font-size: var(--t-lead); line-height: var(--lh-lead); font-weight: 600; color: var(--text); }
+.vta-card-lines { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
+.vta-card-lines code { font: var(--t-meta)/var(--lh-meta) var(--mono); color: var(--text-dim); overflow-wrap: anywhere; }
+.vta-card-acts { display: flex; align-items: center; gap: 8px; }
+.vta-rb { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; }
+.vta-rb dt { font-size: var(--t-meta); line-height: var(--lh-meta); color: var(--text-dim); }
+.vta-rb dd { margin: 0 0 8px; }
+.vta-rb-heard { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text-dim); font-style: italic; }
+.vta-rb-target { font-size: var(--t-lead); line-height: var(--lh-lead); font-weight: 600; color: var(--text); }
+.vta-rb dd:last-child { margin-bottom: 0; }
+.vta-card-acts > .c-tip-host { margin-left: auto; }
+.vta-rb-clock {
+  position: relative; display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
+  font: 600 var(--t-micro)/1 var(--font); font-variant-numeric: tabular-nums; color: var(--text-dim); cursor: default;
+  box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--text) 10%, transparent);
+}
+.vta-rb-clock::before {
+  content: ""; position: absolute; inset: 0; border-radius: 50%;
+  background: conic-gradient(var(--paused) var(--left), transparent 0);
+  -webkit-mask: radial-gradient(circle, transparent 0 13.5px, #000 14px); mask: radial-gradient(circle, transparent 0 13.5px, #000 14px);
+}
+.vta-card-acts > .c-tip-host .c-tip { left: auto; right: 0; }
+.vta-rb-done { margin: 0; display: flex; align-items: center; gap: 6px; font-weight: 600; color: var(--ok-ink); }
+.vta-rb-via { font-weight: 400; font-style: italic; color: var(--text-dim); }
+.vta-rb-done.is-refused { color: var(--text); }
+.vta-rb-done.is-expired { color: var(--text-dim); font-weight: 500; }
+.vta-rb-clock.is-out { color: var(--text-faint); }
+
+/* ---- captions: the thin strip --------------------------------------------- */
+.vta-caps {
+  justify-self: center; width: min(100%, 980px); max-height: calc(3 * 1.5em + 12px); overflow-y: auto;
+  display: flex; flex-direction: column; gap: 2px; padding: 2px 4px;
+  font-size: var(--t-lead); line-height: 1.5;
+  -webkit-mask: linear-gradient(to bottom, transparent, #000 14px); mask: linear-gradient(to bottom, transparent, #000 14px);
+  scrollbar-width: thin;
+}
+.vta-cap { margin: 0; display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 10px; align-items: baseline; }
+.vta-cap-who { font-size: var(--t-meta); font-weight: 600; color: var(--text-faint); text-align: right; }
+.vta-cap.is-agent .vta-cap-who { color: var(--info-ink); }
+.vta-cap-text { color: var(--text-dim); min-width: 0; overflow-wrap: anywhere; }
+.vta-cap:last-child .vta-cap-text { color: var(--text); }
+.vta-cap.is-you.is-partial .vta-cap-text { color: var(--text-dim); }
+.vta-caret { display: inline-block; width: 2px; height: 1em; margin-left: 3px; vertical-align: -0.12em; background: currentColor; animation: vta-blink 1s steps(2) infinite; }
+.vta-cap.is-agent .vta-caret { background: var(--info); }
+@keyframes vta-blink { 50% { opacity: 0; } }
+
+/* ---- the one fallback line ------------------------------------------------- */
+.vta-fallback {
+  justify-self: center; margin: 0; display: inline-flex; align-items: center; gap: 12px; padding: 4px 4px 4px 14px;
+  font-size: var(--t-body); color: var(--text);
+  border: 1px solid color-mix(in srgb, var(--warn) 45%, var(--line)); border-radius: var(--r-pill);
+  background: color-mix(in srgb, var(--warn) 9%, var(--surface));
+}
+
+/* ---- the bar: ring, Start/Stop, status words ------------------------------- */
+.vta-bar { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 18px; min-height: 108px; }
+.vta-bar-l { justify-self: end; display: inline-flex; gap: 6px; }
+/* Held while reconnecting: drawn faint so they never read as live. */
+.vta-bar-l button:disabled { opacity: .38; cursor: default; }
+.vta-bar-r { justify-self: start; display: inline-flex; align-items: flex-end; gap: 12px; min-width: 0; }
+/* The engine is named beside the status words, set off by a rule so it never reads as one more phase. */
+.vta-bar-r > .c-tip-host:last-child { padding-left: 12px; border-left: 1px solid var(--line); line-height: 1.5; }
+.vta-ring { position: relative; width: 112px; height: 112px; display: grid; place-items: center; color: var(--text-faint); }
+.vta-ring > svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
+.vta-ring-base { fill: none; stroke: currentColor; stroke-opacity: .35; stroke-width: 1.2; }
+.vta-ring-wave { fill: color-mix(in srgb, currentColor 7%, transparent); stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
+.vta-ring-glow { fill: none; stroke: currentColor; stroke-width: 6; opacity: .28; filter: blur(3px); }
+.vta-ring-think { fill: none; stroke: var(--info); stroke-width: 2; transform-origin: 60px 60px; animation: vta-think 1.4s ease-in-out infinite; }
+@keyframes vta-think { 50% { opacity: .3; transform: scale(.94); } }
+.vta-ring-spin { fill: none; stroke: var(--paused); stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 60 229; transform-origin: 60px 60px; animation: vta-spin 1.6s linear infinite; }
+@keyframes vta-spin { to { transform: rotate(360deg); } }
+.vta-ring.is-mic { color: var(--text-dim); }
+.vta-ring.is-voice { color: var(--info); }
+.vta-ring.is-text { color: var(--text-faint); }
+.vta-ring.is-starting { color: var(--paused); }
+.vta-ring.is-thinking { color: var(--info); }
+.vta-ring.is-reconnecting { color: var(--warn); }
+.vta-ring.is-reconnecting .vta-ring-spin { stroke: var(--warn); }
+.vta-go {
+  position: relative; z-index: 1; width: 72px; height: 72px; border-radius: 50%;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
+  font: 600 var(--t-meta)/1 var(--font); cursor: pointer;
+  color: var(--bg); background: var(--info); border: 0;
+  box-shadow: 0 10px 28px -10px color-mix(in srgb, var(--info) 70%, transparent);
+}
+.vta-go.is-live { color: var(--text); background: var(--surface); border: 1px solid var(--vt-glass-line); box-shadow: none; }
+.vta-go:focus-visible { outline: 2px solid var(--info); outline-offset: 3px; }
+.vta-status { font-size: var(--t-lead); line-height: 1.2; font-weight: 600; color: var(--text); }
+.vta-status.is-warn { color: var(--warn-ink); }
+.vta-status.is-ended { color: var(--bad-ink); cursor: default; border-bottom: 1px dotted currentColor; }
+/* Text mode: no voice trace; the session goes on through one field, and Stop ends it. */
+.vta-say { display: flex; align-items: center; gap: 8px; width: min(560px, 100%); }
+.vta-say-inp { flex: 1; min-width: 0; }
+.vta-engine { font-size: var(--t-meta); color: var(--text-faint); border-bottom: 1px dotted color-mix(in srgb, var(--text-faint) 60%, transparent); cursor: default; }
+.vta-bar-r .c-tip { top: auto; bottom: calc(100% + 8px); }
+.vta-phases { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 3px; }
+.vta-phases li { display: flex; align-items: center; gap: 7px; font-size: var(--t-body); color: var(--text-dim); }
+.vta-phases li.is-now { color: var(--text); font-weight: 600; font-size: var(--t-lead); }
+.vta-phases li.is-done .vta-ic { color: var(--ok-ink); }
+.vta-phase-what { font: var(--t-meta)/1 var(--mono); color: var(--text-dim); font-weight: 400; }
+.vta-secs { font-weight: 400; font-size: var(--t-meta); font-variant-numeric: tabular-nums; color: var(--text-faint); }
+.vta-dot { width: 8px; height: 8px; margin: 0 3px; border-radius: 50%; background: var(--paused); animation: vta-wait 1.2s ease-in-out infinite; }
+@media (prefers-reduced-motion: reduce) {
+  .vta-ring-spin, .vta-ring-think, .vta-dot, .vta-caret, .vta-point.is-on, .vta-pin-wait > span { animation: none; }
+}
+
+/* ---- the visuals' own drawing (fixtures) ----------------------------------- */
+/* The mock-up frame: a page drawn small, in the console's own tokens. */
+.vtm { width: 100%; height: 100%; display: flex; flex-direction: column; background: var(--surface); font-family: var(--font); color: var(--text); }
+.vtm-chrome { display: flex; align-items: center; gap: 7px; height: 38px; padding: 0 16px; border-bottom: 1px solid var(--line-soft); background: var(--bg); }
+.vtm-chrome > span { width: 11px; height: 11px; border-radius: 50%; background: var(--line); }
+.vtm-chrome em { margin-left: 14px; font-style: normal; font-size: var(--t-body); color: var(--text-faint); }
+.vtm-page { flex: 1; display: flex; flex-direction: column; gap: 14px; padding: 22px 32px; }
+.vtm-head { display: flex; align-items: center; gap: 12px; }
+.vtm-head b { font-size: var(--t-figure); font-weight: 600; }
+.vtm i { font-style: normal; }
+.vtm-chip { padding: 3px 10px; border-radius: 999px; font-size: var(--t-body); }
+.vtm-chip.is-bad { color: var(--bad-ink); background: color-mix(in srgb, var(--bad) 14%, transparent); }
+.vtm-sp { flex: 1; }
+.vtm-btn { padding: 7px 14px; border-radius: 8px; font-size: var(--t-body); border: 1px solid var(--line); }
+.vtm-btn.is-q { color: var(--text-dim); }
+.vtm-filters { display: flex; align-items: center; gap: 6px; padding: 8px 10px; border-radius: 10px; background: var(--bg); }
+.vtm-seg { padding: 6px 12px; border-radius: 8px; font-size: var(--t-body); color: var(--text-dim); }
+.vtm-seg.is-on { color: var(--text); background: var(--surface); box-shadow: 0 0 0 1px var(--line); }
+.vtm-search { width: 220px; padding: 6px 12px; border-radius: 8px; font-size: var(--t-body); color: var(--text-faint); border: 1px solid var(--line); }
+.vtm-rows { display: flex; flex-direction: column; }
+.vtm-row { display: flex; align-items: center; gap: 14px; height: 46px; padding: 0 10px; border-bottom: 1px solid var(--line-soft); font-size: var(--t-body); }
+.vtm-row b { font-weight: 500; width: 150px; }
+.vtm-row > span { color: var(--text-dim); }
+.vtm-dot { width: 10px; height: 10px; border-radius: 50%; }
+.vtm-row.is-ok .vtm-dot { background: var(--ok); }
+.vtm-row.is-bad .vtm-dot { background: var(--bad); }
+.vtm-row.is-bad { background: color-mix(in srgb, var(--bad) 6%, transparent); }
+.vtm-row.is-wait .vtm-dot { background: transparent; box-shadow: inset 0 0 0 2px var(--text-faint); }
+.vtm-dur { font-variant-numeric: tabular-nums; }
+.vtm-summary { display: flex; gap: 28px; margin-top: auto; font-size: var(--t-body); color: var(--text-dim); }
+.vtm-summary b { color: var(--text); font-size: var(--t-title); margin-right: 4px; }
+
+/* The diagram. */
+.vtd { width: 100%; height: 100%; display: block; background: var(--surface); font-family: var(--font); }
+.vtd-zone { fill: color-mix(in srgb, var(--info) 5%, transparent); stroke: var(--line); stroke-dasharray: 6 6; }
+.vtd-zone-t { fill: var(--text-faint); font-size: var(--t-title); font-weight: 600; }
+.vtd-node rect { fill: var(--bg); stroke: var(--line); stroke-width: 1.5; }
+.vtd-node.is-hot rect { stroke: var(--info); }
+.vtd-t { fill: var(--text); font-size: var(--t-title); font-weight: 600; }
+.vtd-s { fill: var(--text-dim); font-size: var(--t-title); }
+.vtd-edge { fill: none; stroke: var(--text-faint); stroke-width: 1.8; }
+.vtd-head { fill: var(--text-faint); }
+
+/* The code slice. */
+.vtc { width: 100%; height: 100%; display: flex; flex-direction: column; background: var(--surface); }
+.vtc-head { display: flex; align-items: center; justify-content: space-between; height: 42px; padding: 0 20px; border-bottom: 1px solid var(--line-soft); background: var(--bg); font-size: var(--t-body); color: var(--text-faint); }
+.vtc-head code { font: 500 1em/1 var(--mono); color: var(--text); }
+.vtc-lines { margin: 0; padding: 10px 0; list-style: none; font: 1.107em/1.516 var(--mono); }
+.vtc-lines li { display: grid; grid-template-columns: 58px 1fr; padding-right: 20px; color: var(--text); }
+.vtc-lines code { font: inherit; white-space: pre; }
+.vtc-n { padding-right: 16px; text-align: right; color: var(--text-faint); font-variant-numeric: tabular-nums; }
+.vtc-lines li.is-pointed { background: color-mix(in srgb, var(--info) 16%, transparent); box-shadow: inset 4px 0 0 var(--info); }
+.vtc-lines li.is-pointed .vtc-n { color: var(--info-ink); font-weight: 600; }
+
+/* The failed step's log. */
+.vtl { width: 100%; height: 100%; display: flex; flex-direction: column; background: var(--surface); }
+.vtl-head { display: flex; align-items: center; gap: 10px; height: 50px; padding: 0 20px; border-bottom: 1px solid var(--line-soft); background: var(--bg); font-size: var(--t-title); color: var(--text-dim); }
+.vtl-head b { color: var(--text); font-size: var(--t-figure); }
+.vtl-x { color: var(--bad-ink); font-weight: 700; }
+.vtl-body { margin: 0; padding: 14px 20px; font: 1.3em/1.55 var(--mono); color: var(--text-dim); white-space: pre; overflow: hidden; }
+.vtl-body .is-ok { color: var(--ok-ink); }
+.vtl-body .is-bad { color: var(--bad-ink); }
+.vtl-body .is-hot { color: var(--text); background: color-mix(in srgb, var(--bad) 12%, transparent); }
+.vtl-body .is-dim { color: var(--text-faint); }
+
+/* ---- phone ----------------------------------------------------------------- */
+@media (max-width: 760px) {
+  .vta { height: max(560px, calc(100dvh - 150px)); padding: 8px 8px 6px; gap: 8px; border-radius: var(--r-card);
+    grid-template-rows: auto auto minmax(0, 1fr) auto auto; }
+  /* The visual takes the width it needs and no more; the captions get the rest. */
+  .vta-frame { aspect-ratio: 16 / 10; }
+  /* Panned at the text floor, the visual gets a square window so more of it shows at once. */
+  .vta-frame.is-pan { aspect-ratio: 1 / 1; }
+  .vta-bar-r { flex-direction: column; align-items: flex-start; gap: 4px; }
+  .vta-bar-r > .c-tip-host:last-child { padding-left: 0; border-left: 0; }
+  .vta-bar.is-text { grid-template-columns: minmax(0, 1fr); }
+  .vta-bar.is-text .vta-bar-l { display: none; }
+  .vta-head { flex-wrap: wrap; gap: 6px; }
+  .vta-head > .c-tip-host { order: -1; margin-left: auto; }
+  .vta-tabs { flex-basis: 100%; }
+  .vta-tab-title { max-width: 9em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+  .vta-stage.has-cards { grid-template-columns: minmax(0, 1fr); }
+  .vta-cards { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; }
+  .vta-caps { align-self: end; max-height: 100%; font-size: var(--t-body); }
+  .vta-cap { grid-template-columns: minmax(0, 1fr); gap: 0; }
+  .vta-cap-who { text-align: left; }
+  .vta-bar { min-height: 92px; gap: 10px; }
+  .vta-ring { width: 96px; height: 96px; }
+  .vta-go { width: 62px; height: 62px; }
+  .vta-pin { width: 24px; height: 24px; left: -12px; top: -12px; font-size: var(--t-micro); }
+  .vta-pin-note { width: 200px; }
+}
