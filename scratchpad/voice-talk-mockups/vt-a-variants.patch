+          <Button kind="secondary" size="sm" onClick={() => setFallback(null)}>
+            Text
+          </Button>
+        </p>
+      )}
+
+      <footer className={`vta-bar${textMode ? ' is-text' : ''}`}>
+        <div className="vta-bar-l">
+          {live && (
+            <>
+              <Button kind="ghost" size="sm" iconOnly icon={<MicGlyph off={muted} />} aria-pressed={muted} disabled={scene.trace === 'reconnecting'} onClick={() => setMuted(!muted)}>
+                {muted ? 'Unmute' : 'Mute'}
+              </Button>
+              <Button kind="ghost" size="sm" iconOnly icon={<HoldGlyph />} disabled={scene.trace === 'reconnecting'}>
+                Push to talk
+              </Button>
+            </>
+          )}
+        </div>
+        {textMode ? (
+          // Text mode has no voice trace: the session goes on through this field, and Stop still ends it.
+          <form
+            className="vta-say"
+            onSubmit={(e) => {
+              e.preventDefault()
+              const words = draft.trim()
+              if (words === '') return
+              setSaid((l) => [...l, { side: 'you', text: words }])
+              setDraft('')
+            }}
+          >
+            <input className="c-inp vta-say-inp" aria-label="Say to Voice it" placeholder="Say to Voice it" value={draft} onChange={(e) => setDraft(e.target.value)} />
+            <Button kind="primary" size="sm" type="submit" disabled={draft.trim() === ''}>
+              Send
+            </Button>
+            <Button kind="secondary" size="sm" icon={<StopGlyph />}>
+              Stop
+            </Button>
+          </form>
+        ) : (
+          <TraceRing trace={muted ? 'idle' : scene.trace} live={live || scene.trace === 'starting'} />
+        )}
