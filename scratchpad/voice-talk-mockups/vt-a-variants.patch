+// ---- pieces --------------------------------------------------------------------
+
+function clock(secs: number): string {
+  return `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`
+}
+
+/** The one or two status words; an ended session's words carry their reason in a tooltip. */
+function StatusWords({ status, trace, spent }: { status: string; trace: Trace; spent: number }) {
+  if (trace === 'ended') {
+    return (
+      <Tooltip tip={`The session ended at its ${money(spent)} cap and the speech machine stopped. Start opens a new session.`}>
+        <span className="vta-status is-ended" role="status" tabIndex={0}>
+          {status}
+        </span>
+      </Tooltip>
+    )
+  }
+  return (
+    <span className={`vta-status${trace === 'reconnecting' || status === 'engine down' ? ' is-warn' : ''}`} role="status">
+      {status}
+    </span>
+  )
+}
+
+function EngineTick({ engine, text, cause }: { engine: Engine; text: boolean; cause: string | null }) {
+  if (text) {
+    const why = cause === 'engine down' ? 'the speech server did not come back within 3 minutes and the machine stopped' : 'own speech could not start'
+    return (
+      <Tooltip tip={`Text mode: this browser hears you and reads the replies aloud, and you can type, because ${why}. Stop and Start again to retry own speech.`}>
+        <span className="vta-engine" tabIndex={0}>
+          this browser
+        </span>
+      </Tooltip>
+    )
+  }
+  const tip =
+    engine === 'own'
+      ? 'Own speech: speech-to-text and the voice run on the L4 in us-central1-a; a fast Claude model answers, the planner acts as you.'
+      : 'GPT-Live: OpenAI realtime voice, chosen in Settings; the planner acts as you.'
+  return (
+    <Tooltip tip={tip}>
+      <span className="vta-engine" tabIndex={0}>
+        {engine === 'own' ? 'own speech' : 'GPT-Live'}
+      </span>
+    </Tooltip>
+  )
+}
+
+function BudgetLine({ spent, cap, day, dayCap, engine }: { spent: number; cap: number; day: number; dayCap: number; engine: Engine }) {
+  const share = spent / cap
+  const warn = share >= 0.8
+  const atCap = share >= 1
+  const tip = `This session: ${money(spent)} spent and reserved of ${money(cap)}. Today: ${money(day)} of ${money(dayCap)}. ${
+    engine === 'own' ? 'Includes the speech machine from its start call; its disk is platform cost, not counted.' : 'Includes GPT-Live talk time.'
+  } At the cap the session ends${engine === 'own' ? ' and the machine stops' : ''}.`
+  return (
+    <Tooltip tip={tip}>
+      <span className={`vta-budget${atCap ? ' is-cap' : warn ? ' is-warn' : ''}`} tabIndex={0}>
+        <span className="vta-budget-n">
+          {money(spent)} <span className="vta-budget-of">/ {money(cap)}</span>
+        </span>
+        <span className="vta-budget-track" aria-hidden="true">
+          <span className="vta-budget-fill" style={{ width: `${Math.min(100, share * 100)}%` }} />
+        </span>
+      </span>
+    </Tooltip>
+  )
+}
+
+function Captions({ lines }: { lines: Line[] }) {
+  const box = useRef<HTMLDivElement>(null)
+  useLayoutEffect(() => {
+    if (box.current) box.current.scrollTop = box.current.scrollHeight
+  }, [lines])
+  return (
+    <div className="vta-caps" ref={box} role="log" aria-live="polite" aria-label="Captions">
+      {lines.map((l, i) => (
+        <p key={i} className={`vta-cap is-${l.side}${l.partial ? ' is-partial' : ''}`}>
+          <span className="vta-cap-who">{l.side === 'you' ? 'You' : 'Voice it'}</span>
+          <span className="vta-cap-text">
+            {l.text}
+            {l.partial && <span className="vta-caret" aria-hidden="true" />}
+          </span>
+        </p>
+      ))}
+    </div>
+  )
+}
+
+/** The voice trace: a ring of the live level around Start/Stop. */
+function TraceRing({ trace, live }: { trace: Trace; live: boolean }) {
+  const [t, setT] = useState(0)
+  useEffect(() => {
+    if (trace !== 'mic' && trace !== 'voice') return
+    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
+    let raf = 0
+    const tick = (now: number) => {
+      setT(now / 1000)
+      raf = window.requestAnimationFrame(tick)
+    }
+    raf = window.requestAnimationFrame(tick)
+    return () => window.cancelAnimationFrame(raf)
+  }, [trace])
+  const amp = trace === 'voice' ? 7 : trace === 'mic' ? 4 : 0
+  const R = 46
+  const pts: string[] = []
+  const N = 96
+  for (let i = 0; i <= N; i++) {
+    const a = (i / N) * Math.PI * 2
+    const v =
+      amp * (0.55 * Math.sin(a * 5 + t * 3.1) + 0.3 * Math.sin(a * 9 - t * 4.7) + 0.25 * Math.sin(a * 3 + t * 1.7)) * (0.6 + 0.4 * Math.sin(t * 2.3 + a * 2))
+    const r = R + Math.max(-amp * 0.35, v)
+    pts.push(`${(60 + r * Math.cos(a)).toFixed(2)},${(60 + r * Math.sin(a)).toFixed(2)}`)
+  }
+  return (
+    <div className={`vta-ring is-${trace}`}>
+      <svg viewBox="0 0 120 120" aria-hidden="true">
+        <circle className="vta-ring-base" cx="60" cy="60" r={R} />
+        {amp > 0 && <polygon className="vta-ring-glow" points={pts.join(' ')} />}
+        {amp > 0 && <polygon className="vta-ring-wave" points={pts.join(' ')} />}
+        {(trace === 'starting' || trace === 'reconnecting') && <circle className="vta-ring-spin" cx="60" cy="60" r={R} />}
+        {trace === 'thinking' && <circle className="vta-ring-think" cx="60" cy="60" r={R} />}
+      </svg>
+      <button type="button" className={`vta-go${live ? ' is-live' : ''}`}>
+        {live ? <StopGlyph /> : <MicGlyph />}
+        <span>{live ? 'Stop' : 'Start'}</span>
+      </button>
+    </div>
+  )
+}
+
+function ReadBackCard({ rb, leaving, onAnswer }: { rb: ReadBack; leaving: boolean; onAnswer: () => void }) {
+  return (
+    <section className={`vta-card is-readback is-${rb.state}${leaving ? ' is-leaving' : ''}`} aria-label="Read-back">
+      <dl className="vta-rb">
+        <dt>Heard</dt>
+        <dd className="vta-rb-heard">“{rb.heard}”</dd>
+        <dt>Will {rb.action}</dt>
+        <dd className="vta-rb-target">{rb.target}</dd>
+      </dl>
+      {rb.state === 'confirmed' && (
+        <p className="vta-rb-done" role="status">
+          <TickGlyph />
+          <span>Go</span>
+          <span className="vta-rb-via">“{rb.via}”</span>
+        </p>
+      )}
+      {rb.state === 'refused' && (
+        <p className="vta-rb-done is-refused" role="status">
+          <CrossGlyph />
+          <span>Not that</span>
+          <span className="vta-rb-via">“{rb.via}”</span>
+        </p>
+      )}
+      {rb.state === 'expired' && (
+        // Expired: nothing ran; the card greys and stays for the record (§7.4).
+        <p className="vta-rb-done is-expired" role="status">
+          <Tooltip tip="No answer within 45 s of the question, so nothing ran.">
+            <span className="vta-rb-clock is-out" tabIndex={0} style={{ ['--left' as string]: '0%' }}>
+              0s
+            </span>
+          </Tooltip>
+          <span>expired</span>
+        </p>
+      )}
+      {rb.state === 'pending' && (
+        <div className="vta-card-acts">
+          <Button kind="primary" size="sm" onClick={onAnswer}>
+            Go
+          </Button>
+          <Button kind="secondary" size="sm" onClick={onAnswer}>
+            Not that
+          </Button>
+          <Tooltip tip={`Expires in ${rb.secsLeft} s and nothing runs. Say “go” or “not that”; a bare “yes” is not a go.`}>
+            <span className="vta-rb-clock" tabIndex={0} style={{ ['--left' as string]: `${(rb.secsLeft / 45) * 100}%` }}>
+              {rb.secsLeft}s
+            </span>
+          </Tooltip>
+        </div>
+      )}
+    </section>
+  )
+}
+
+function ProposalCard({ p, leaving, onAnswer }: { p: Proposal; leaving: boolean; onAnswer: () => void }) {
+  return (
+    <section className={`vta-card is-proposal${leaving ? ' is-leaving' : ''}`} aria-label="Proposal">
+      <p className="vta-card-kind">{p.refs.join(' · ')}</p>
+      <h3 className="vta-card-title">{p.title}</h3>
+      <ul className="vta-card-lines">
+        {p.lines.map((l) => (
+          <li key={l}>
+            <code>{l}</code>
+          </li>
+        ))}
+      </ul>
+      <div className="vta-card-acts">
+        <Button kind="primary" size="sm" onClick={onAnswer}>
+          Approve
+        </Button>
+        <Button kind="secondary" size="sm" onClick={onAnswer}>
+          Not now
+        </Button>
+      </div>
+    </section>
+  )
+}
+
+const TEXT_FLOOR = 12
+
+/** The smallest font size, in the sheet's own pixels, of any text drawn in it. */
+function smallestText(root: HTMLElement): number {
+  let min = Infinity
+  const walk = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
+  for (let n = walk.nextNode(); n !== null; n = walk.nextNode()) {
+    if (n.textContent?.trim() && n.parentElement) min = Math.min(min, parseFloat(getComputedStyle(n.parentElement).fontSize))
+  }
+  return Number.isFinite(min) ? min : TEXT_FLOOR
+}
+
+/** The visual, drawn at 960×600 and scaled to the stage; pins and the pointer ride above it. */
+function Sheet({
+  visual,
+  pins,
+  openPin,
+  setOpenPin,
+  pointAt,
+  onRegion,
+  speaking,
+}: {
+  visual: VisualKey
+  pins: Pin[]
+  openPin: string | null
+  setOpenPin: (id: string | null) => void
+  pointAt: Scene['pointAt']
+  onRegion: (r: { x: number; y: number; w: number; h: number }) => void
+  speaking: boolean
+}) {
+  const box = useRef<HTMLDivElement>(null)
+  const body = useRef<HTMLDivElement>(null)
+  const [fit, setFit] = useState({ k: 1, pan: false })
+  const k = fit.k
+  const [drag, setDrag] = useState<{
+    x0: number
+    y0: number
+    x: number
+    y: number
+  } | null>(null)
+  // Fit the 960×600 sheet to the stage, but never below the scale at which its smallest text is
+  // 12 px (the console's floor): on a narrow stage the sheet stays readable and the stage pans.
+  useLayoutEffect(() => {
+    const frame = box.current?.parentElement
+    if (!frame || !body.current) return
+    const floor = TEXT_FLOOR / smallestText(body.current)
+    const measure = () => {
+      const k = Math.min(frame.clientWidth / 960, frame.clientHeight / 600)
+      setFit(k >= floor ? { k, pan: false } : { k: floor, pan: true })
+    }
+    const ro = new ResizeObserver(measure)
+    ro.observe(frame)
+    measure()
+    return () => ro.disconnect()
+  }, [visual])
+  useLayoutEffect(() => {
+    const frame = box.current?.parentElement
+    if (!frame) return
+    frame.classList.toggle('is-pan', fit.pan)
+    if (!fit.pan) return
+    // Panned: bring what is being talked about into the window, the pointed-at part or else the first pin.
+    // A region is read from its start (its pin, at the region's right end, is a pan away); a point is centred.
+    const first = pins[0]
+    const at = pointAt?.kind === 'box' ? { x: pointAt.x + pointAt.w / 2, y: pointAt.y + pointAt.h / 2, edge: 0.5 } : first && (first.w !== undefined ? { x: first.x, y: first.y, edge: 0.14 } : { x: first.x, y: first.y, edge: 0.5 })
+    if (at) {
+      frame.scrollLeft = Math.max(0, at.x * 960 * fit.k - frame.clientWidth * at.edge)
+      frame.scrollTop = Math.max(0, at.y * 600 * fit.k - frame.clientHeight * 0.4)
+    }
+    // Only on a change of scale: a pin added later must not move the window under the person.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [fit.pan, fit.k])
+  const at = (e: ReactPointerEvent) => {
+    const r = box.current!.getBoundingClientRect()
+    return {
+      x: Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)),
+      y: Math.min(1, Math.max(0, (e.clientY - r.top) / r.height)),
+    }
+  }
+  const region = drag && {
+    x: Math.min(drag.x0, drag.x),
+    y: Math.min(drag.y0, drag.y),
+    w: Math.abs(drag.x - drag.x0),
+    h: Math.abs(drag.y - drag.y0),
+  }
+  const pct = (v: number) => `${(v * 100).toFixed(2)}%`
+  return (
+    <div className={`vta-sheet is-${visual}`} ref={box} style={{ width: 960 * k, height: 600 * k }}>
+      <div className="vta-sheet-body" ref={body} style={{ transform: `scale(${k})` }}>
+        {visual === 'mockup' && <MockupVisual />}
+        {visual === 'diagram' && <DiagramVisual />}
+        {visual === 'code' && <CodeVisual pointAt={pointAt?.kind === 'lines' ? pointAt : undefined} />}
+        {visual === 'log' && <LogVisual />}
+      </div>
+      <div
+        className="vta-notes-layer"
+        onPointerDown={(e) => {
+          if (e.target !== e.currentTarget) return
+          const p = at(e)
+          setOpenPin(null)
+          setDrag({ x0: p.x, y0: p.y, x: p.x, y: p.y })
+        }}
+        onPointerMove={(e) => drag && setDrag({ ...drag, ...at(e) })}
+        onPointerUp={() => {
+          if (region && region.w > 0.02 && region.h > 0.02) onRegion(region)
+          setDrag(null)
+        }}
+      >
+        {pointAt?.kind === 'box' && (
+          <span
+            className={`vta-point${speaking ? ' is-on' : ''}`}
+            style={{
+              left: pct(pointAt.x),
+              top: pct(pointAt.y),
+              width: pct(pointAt.w),
+              height: pct(pointAt.h),
+            }}
+            aria-hidden="true"
+          />
+        )}
+        {region && (
+          <span
+            className="vta-region is-dragging"
+            style={{
+              left: pct(region.x),
+              top: pct(region.y),
+              width: pct(region.w),
+              height: pct(region.h),
+            }}
+          />
+        )}
+        {pins.map((p) => (
+          <PinMark key={p.id} pin={p} open={openPin === p.id} onToggle={() => setOpenPin(openPin === p.id ? null : p.id)} pct={pct} />
+        ))}
+      </div>
+    </div>
+  )
+}
+
+function PinMark({ pin, open, onToggle, pct }: { pin: Pin; open: boolean; onToggle: () => void; pct: (v: number) => string }) {
+  const isRegion = pin.w !== undefined && pin.h !== undefined
+  const px = isRegion ? pin.x + (pin.w ?? 0) : pin.x
+  const py = pin.y
+  const flip = px > 0.62
+  return (
+    <>
+      {isRegion && (open || pin.text === '') && (
+        <span
+          className="vta-region"
+          style={{
+            left: pct(pin.x),
+            top: pct(pin.y),
+            width: pct(pin.w ?? 0),
+            height: pct(pin.h ?? 0),
+          }}
+          aria-hidden="true"
+        />
+      )}
+      <span className={`vta-pin-at${flip ? ' is-flip' : ''}`} style={{ left: pct(px), top: pct(py) }}>
+        <button type="button" className={`vta-pin${open ? ' is-open' : ''}`} aria-expanded={open} aria-label={`Note ${pin.n}`} onClick={onToggle}>
+          {pin.n}
+        </button>
+        {open && (
+          <span className={`vta-pin-note${pin.text === '' ? ' is-waiting' : ' is-landed'}`} role="note">
+            {pin.text === '' ? (
+              <span className="vta-pin-wait" aria-label="Listening for the note">
+                <span />
+                <span />
+                <span />
+              </span>
+            ) : (
+              <>
+                <span className="vta-pin-text">{pin.text}</span>
+                <span className="vta-pin-foot">
+                  <ViaGlyph via={pin.via} />
+                  <span className="vta-pin-acts">
+                    <Button kind="ghost" size="sm">
+                      Resolve
+                    </Button>
+                    <Button kind="ghost" size="sm">
+                      To work
+                    </Button>
+                  </span>
+                </span>
+              </>
+            )}
+          </span>
+        )}
+      </span>
+    </>
+  )
+}
