+          {scene.phases !== undefined ? (
+            <ol className="vta-phases" aria-label="Starting">
+              {scene.phases.map((p) => (
+                <li key={p.word} className={p.done ? 'is-done' : 'is-now'}>
+                  {p.done ? <TickGlyph /> : <span className="vta-dot" aria-hidden="true" />}
+                  <span>{p.word}</span>
+                  {p.what !== undefined && <code className="vta-phase-what">{p.what}</code>}
+                  <span className="vta-secs">{clock(p.secs)}</span>
+                </li>
+              ))}
+            </ol>
+          ) : (
+            scene.status !== null && <StatusWords status={muted ? 'muted' : scene.status} trace={scene.trace} spent={scene.budget?.spent ?? 0} />
+          )}
+          {scene.trace !== 'idle' && <EngineTick engine={scene.engine} text={textMode} cause={scene.status} />}
+        </div>
+      </footer>
+    </div>
+  )
+}
