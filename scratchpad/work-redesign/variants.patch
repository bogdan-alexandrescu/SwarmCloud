+@container wdmain (max-width: 560px) {
+  .wd-cell { min-height: 34px; padding: 2px 4px; align-items: center; }
+  .wd-cell-time { display: none; }
+  .wd-colhead { writing-mode: vertical-rl; transform: rotate(180deg); max-height: 6.5em; justify-self: center; }
+}
+.wd-flow { display: flex; flex-direction: column; gap: 4px; }
+.wd-flow-row { display: flex; gap: 4px; align-items: stretch; }
