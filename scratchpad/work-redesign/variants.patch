+/** A workflow's spend as a figure: "+" (with its tooltip) only while a step still runs, "—" when nothing was measured. */
+function wfSpent(w: Workflow, byId: Map<string, Task>): ReactNode {
+  if (w.workflow_id === HARD_WF) return money(MOCK_SPEND.workflowUsd, true)
+  let sum = 0, known = 0
+  for (const s of w.steps) {
+    const c = s.task_id ? byId.get(s.task_id)?.cost_usd_total : null
+    if (typeof c === 'number') { sum += c; known += 1 }
+  }
+  if (known === 0) return money(null)
+  return money(sum, !TERMINAL_STATES.has(w.state as Task['state']))
+}
+
+function wfTitle(w: Workflow, byId: Map<string, Task>): string {
+  if (w.workflow_id === HARD_WF) return HARD_WF_TITLE
+  const first = w.steps[0]?.task_id ? byId.get(w.steps[0].task_id) : undefined
+  return String(first?.metadata?.title ?? w.workflow_id)
+}
+
+function TallyChips({ c }: { c: Tally }) {
+  return (
+    <div className="wd-row wd-tally">
+      <span className="wd-t is-running" title="Running">▶ <b>{c.running}</b> running</span>
+      <span className="wd-t is-waiting" title="Waiting on earlier steps">◷ <b>{c.waiting}</b> waiting</span>
+      <span className="wd-t is-done" title="Done">✓ <b>{c.done}</b> done</span>
+      <span className="wd-t is-failed" title="Failed">✗ <b>{c.failed}</b> failed</span>
+      {c.browsers > 0 && <span className="wd-t" title="Live browser agents"><span className="wd-dot is-live" aria-hidden /> <b>{c.browsers}</b> browsers</span>}
+    </div>
+  )
+}
+
+// --------------------------------------------------------------------------
+// The stage x feature matrix: a row per stage, a column per feature
+// --------------------------------------------------------------------------
+
+type Grid = { stages: string[]; cols: string[]; cell: (stage: string, col: string) => string | null; matrix: boolean }
+
+function gridOf(w: Workflow): Grid {
+  const rows = stagesOf(w)
+  // A matrix when each stage's steps are `<stage>-<feature>` over the same features.
+  const split = (id: string, stage: string) => (id.startsWith(`${stage}-`) ? id.slice(stage.length + 1) : null)
+  const stageNames = rows.map((ids) => {
+    const firstFeature = ids[0]?.split('-').slice(-1)[0] ?? ''
+    return ids[0]?.slice(0, ids[0].length - firstFeature.length - 1) ?? ''
+  })
+  const cols = rows[0]?.map((id) => split(id, stageNames[0] ?? '')) ?? []
+  const matrix = rows.length > 1 && cols.every((c) => c !== null) &&
+    rows.every((ids, k) => ids.length === cols.length && ids.every((id) => cols.includes(split(id, stageNames[k] ?? '') ?? '')))
+  if (matrix) {
+    const ids = new Set(w.steps.map((s) => s.step_id))
+    return { stages: stageNames, cols: cols as string[], cell: (s, c) => (ids.has(`${s}-${c}`) ? `${s}-${c}` : null), matrix: true }
+  }
+  return { stages: rows.map((_, k) => `Stage ${k + 1}`), cols: [], cell: () => null, matrix: false }
+}
+
+function cellState(t: Task | undefined): string {
+  if (!t) return 'unstarted'
+  if (t.state === 'PARKED' && t.park_reason === 'DEPENDENCY_INCOMPLETE') return 'waiting'
+  return t.state.toLowerCase()
+}
+
+function Cell({ stepId, t, picked, onPick, mini, label, dimmed }: { stepId: string; t: Task | undefined; picked: boolean; onPick: () => void; mini?: boolean; label?: string; dimmed?: boolean }) {
+  const st = cellState(t)
+  const pr = prOf(t)
+  const time = !t || st === 'waiting' ? null
+    : t.state === 'RUNNING' ? span(mins(t.started_at))
+      : t.completed_at && t.started_at ? span(mins(t.started_at, Date.parse(t.completed_at))) : null
+  const word = st === 'waiting' ? `waiting on ${(t?.depends_on ?? []).join(', ') || 'an earlier step'}` : st
+  const tip = `${stepId}: ${word}${time ? `, ${time}` : ''}${pr ? `, pull request #${pr.number}` : ''}${asksOwner(t) ? ', asks you a question' : ''}`
+  return (
+    <button
+      type="button"
+      className={`wd-cell is-${st}${picked ? ' is-picked' : ''}${dimmed ? ' is-dimmed' : ''}${mini ? ' is-mini' : ''}`}
+      onClick={onPick}
+      aria-pressed={picked}
+      aria-label={tip}
+      title={tip}
+    >
+      {label && <span className="wd-cell-name">{label}</span>}
+      {!mini && (
+        <span className="wd-cell-meta">
+          <span className="wd-cell-mark">{t && st !== 'waiting' ? <StatePill state={t.state} form="mark" /> : <span className="wd-wait" aria-hidden>◷</span>}</span>
+          {time && <span className="wd-cell-time">{time}</span>}
+          {pr && <span className="wd-cell-pr">#{pr.number}</span>}
+        </span>
+      )}
+      {asksOwner(t) && <span className="wd-ask" aria-hidden>?</span>}
+      {t && isLiveBrowser(t) && !mini && <span className="wd-cell-live" aria-hidden />}
+    </button>
+  )
+}
+
+function Matrix({ w, data, picked, onPick, mini = false, focus = null, onStage }: {
+  w: Workflow
+  data: Extract<WorkData, { status: 'ok' }>
+  picked: string | null
+  onPick: (stepId: string) => void
+  mini?: boolean
+  /** Steps to keep bright; the rest are dimmed (Needs you). */
+  focus?: Set<string> | null
+  /** A stage's counts open the Table on that stage. */
+  onStage?: (stage: string) => void
+}) {
+  const g = gridOf(w)
+  const stepTask = (id: string) => {
+    const s = w.steps.find((x) => x.step_id === id)
+    return s?.task_id ? data.taskById.get(s.task_id) : undefined
+  }
+  if (!g.matrix) {
+    const rows = stagesOf(w)
+    return (
+      <div className="wd-flow">
+        {rows.map((ids, k) => (
+          <div key={k} className="wd-flow-row">
+            <span className="wd-stage">{k + 1}</span>
+            {ids.map((id) => <Cell key={id} stepId={id} t={stepTask(id)} picked={picked === id} onPick={() => onPick(id)} label={id} mini={mini} />)}
+          </div>
+        ))}
+      </div>
+    )
+  }
+  return (
+    <div className={`wd-matrix${mini ? ' is-mini' : ''}`} role="grid" aria-label={`${w.steps.length} steps: a row per stage, a column per feature`} style={{ ['--wd-cols' as string]: g.cols.length }}>
+      <div className="wd-mrow is-head" role="row">
+        <span className="wd-stage" role="columnheader"><span className="wd-sr">Stage</span></span>
+        {g.cols.map((c) => <span key={c} className="wd-colhead" role="columnheader" title={c}>{c}</span>)}
+      </div>
+      {g.stages.map((s) => {
+        const ids = g.cols.map((c) => g.cell(s, c))
+        const ts = ids.map((id) => (id ? stepTask(id) : undefined))
+        const n = (st: string) => ts.filter((t) => cellState(t) === st).length
+        return (
+          <div key={s} className="wd-mrow" role="row">
+            <span className="wd-stage" role="rowheader">
+              <b>{s}</b>
+              {!mini && (
+                <span className="wd-stage-n" role={onStage ? 'button' : undefined} tabIndex={onStage ? 0 : undefined} onClick={() => onStage?.(s)} title={onStage ? `Open the Table on the ${s} stage` : undefined}>
+                  {n('succeeded') > 0 && <span className="wd-ok" title="done">✓{n('succeeded')}</span>}
+                  {n('failed') > 0 && <span className="wd-bad" title="failed">✗{n('failed')}</span>}
+                  {n('running') > 0 && <span className="wd-run" title="running">▶{n('running')}</span>}
+                  {n('waiting') > 0 && <span className="wd-dim" title="waiting on earlier steps">◷{n('waiting')}</span>}
+                </span>
+              )}
+            </span>
+            {ids.map((id, k) => (id ? (
+              <Cell key={id} stepId={id} t={ts[k]} picked={picked === id} onPick={() => onPick(id)} mini={mini} dimmed={focus !== null && !focus.has(id)} />
+            ) : <span key={k} />))}
+          </div>
+        )
+      })}
+    </div>
+  )
+}
+
+// --------------------------------------------------------------------------
+// ONE WORKFLOW: header, needs bar, views, the matrix; the inspector docked
+// --------------------------------------------------------------------------
+
+type WfView = 'graph' | 'table' | 'timeline' | 'changes'
+type DockSubject = { kind: 'workflow'; tab: 'overview' | 'browsers' | 'needs' } | { kind: 'step'; stepId: string }
+
+function DWorkflow({ data, at, nav, wst, go }: BaseProps) {
+  const id = at.id ?? HARD_WF
+  const vw = typeof window === 'undefined' ? 1440 : window.innerWidth
+  const [view, setView] = useState<WfView>('graph')
+  const [subject, setSubject] = useState<DockSubject>(
+    wst === 'open' || wst === 'logs' ? { kind: 'step', stepId: 'build-contacts' }
+      : wst === 'watch' ? { kind: 'workflow', tab: 'browsers' }
+        : wst === 'needs' ? { kind: 'workflow', tab: 'needs' } : { kind: 'workflow', tab: 'overview' },
+  )
+  const [big, setBig] = useState<string | null>(wst === 'watch' ? hardTaskId('build', 'contacts') : null)
+  const [w, setW] = useDockWidth(wst === 'watch' ? Math.round(vw * 0.46) : wst === 'open' ? Math.round(vw * 0.46) : Math.max(340, Math.round(vw * 0.27)))
+  const [phoneDock, setPhoneDock] = useState(wst !== 'rest')
+  // Under 1366 px the inspector starts folded at rest, so the matrix keeps its times and pull requests (the cost, notes.md).
+  const [dockOpen, setDockOpen] = useState(!(wst === 'rest' && vw < 1366))
+  const [stepPane, setStepPane] = useState<TaskPane>(wst === 'logs' ? 'logs' : 'detail')
+  const needs = useMemo(() => (data.status === 'ok' ? needsYou(data.tasks, id) : []), [data, id])
+  if (data.status !== 'ok') return <Loading data={data} />
+  const wf = data.workflows.find((x) => x.workflow_id === id)
+  if (!wf) return <p className="wd-dim">No workflow {id} in this dataset.</p>
+  const c = tally(wf, data.taskById)
+  const title = wfTitle(wf, data.taskById)
+  const stepOfTask = (taskId: string) => wf.steps.find((s) => s.task_id === taskId)?.step_id ?? null
+  const pickStep = (stepId: string, pane: TaskPane = 'detail') => {
+    setStepPane(pane)
+    setDockOpen(true)
+    setSubject({ kind: 'step', stepId })
+    setPhoneDock(true)
+  }
+  const pickTask = (taskId: string, pane: TaskPane = 'detail') => {
+    const s = stepOfTask(taskId)
+    if (s) pickStep(s, pane)
+    else nav({ screen: 'agent', id: taskId })
+  }
+  const needSteps = new Set(needs.map((n) => (n.taskId ? stepOfTask(n.taskId) : null)).filter((x): x is string => x !== null))
+  const liveTasks = wf.steps.map((s) => (s.task_id ? data.taskById.get(s.task_id) : undefined)).filter((t): t is Task => t !== undefined && isLiveBrowser(t))
+  const picked = subject.kind === 'step' ? subject.stepId : null
+  const mergeTask = data.tasks.find((t) => t.workflow_id === id && t.runner_profile === 'merge') ?? null
+  const after = (wf as unknown as { after_pull_requests?: { pull_requests: number[]; state: string } }).after_pull_requests
+
+  const main = (
+    <div className="wd-col">
+      <Breadcrumb crumbs={[{ key: 'wfs', label: 'Workflows', href: '/workflows' }, { key: 'wf', label: title, href: null }]} onGo={() => nav({ screen: 'workflows', id: null })} />
+      <div className="wd-head">
+        <StatePill state={wf.state as Task['state']} />
+        <h1 className="wd-h1 wd-trunc">{title}</h1>
+        <span className="wd-figs">
+          <span title="Steps">{wf.steps.length} steps</span>
+          <span title="Spent so far">{workflowSpend(wf, data.taskById)}</span>
+          <span className="wd-dim" title="Started">{span(mins(wf.created_at))} old</span>
+        </span>
+        <span className="wd-grow" />
+        {(!dockOpen || subject.kind === 'step') && <Button size="sm" onClick={() => { setSubject({ kind: 'workflow', tab: 'overview' }); setDockOpen(true); setPhoneDock(true) }}>Workflow details</Button>}
+      </div>
+      <TallyChips c={c} />
+      <NeedsBar items={needs} onOpen={() => { setSubject({ kind: 'workflow', tab: 'needs' }); setDockOpen(true); setPhoneDock(true) }} active={subject.kind === 'workflow' && subject.tab === 'needs'} />
+      <div className="wd-row wd-viewbar">
+        <Segmented<WfView>
+          label="View"
+          value={view}
+          onChange={setView}
+          role="tablist"
+          small
+          options={[
+            { key: 'graph', label: 'Graph' },
+            { key: 'table', label: 'Table' },
+            { key: 'timeline', label: 'Steps over time' },
+            { key: 'changes', label: 'Changes' },
+          ]}
+        />
+        {view === 'graph' && (
+          <span className="wd-legend wd-dim" aria-label="Legend">
+            <span><span className="wd-ok">✓</span> done</span>
+            <span><span className="wd-run">▶</span> running</span>
+            <span>◷ waiting</span>
+            <span><span className="wd-bad">✗</span> failed</span>
+            <span><span className="wd-ask is-inline">?</span> asks you</span>
+            <span><span className="wd-dot is-live" /> live browser</span>
+          </span>
+        )}
+        {view === 'graph' && liveTasks.length > 0 && (
+          <Button size="sm" kind={subject.kind === 'workflow' && subject.tab === 'browsers' ? 'primary' : 'secondary'} onClick={() => { setSubject({ kind: 'workflow', tab: 'browsers' }); setDockOpen(true); setPhoneDock(true) }}>
+            Watch {liveTasks.length} browsers
+          </Button>
+        )}
+      </div>
+      {view === 'graph' ? (
+        <Matrix w={wf} data={data} picked={picked} onPick={pickStep} onStage={() => setView('table')} focus={subject.kind === 'workflow' && subject.tab === 'needs' ? needSteps : null} />
+      ) : (
+        <div className="wd-embed">
+          <WorkflowsScreen view={`wf=${encodeURIComponent(id)}&tab=${view}`} onView={() => undefined} />
+        </div>
+      )}
+      {mergeTask && (
+        <div className={`wd-merge is-${mergeTask.state.toLowerCase()}`}>
+          <b>Merge</b>
+          <StatePill state={mergeTask.state} small label={mergeTask.park_reason === 'HUMAN_REQUIRED' ? 'waiting for you' : undefined} />
+          {after && <span className="wd-merge-prs" title="The pull requests this merge goes in after">after {after.pull_requests.map((n) => `#${n}`).join(' ')}</span>}
+          <span className="wd-dim wd-trunc" title={waitSummary(mergeTask) ?? undefined}>{waitSummary(mergeTask) ?? ''}</span>
+          <span className="wd-grow" />
+          <Button size="sm" onClick={() => { setSubject({ kind: 'workflow', tab: 'needs' }); setDockOpen(true); setPhoneDock(true) }}>Answer 2 questions</Button>
+        </div>
+      )}
+      {view === 'graph' && liveTasks.length > 0 && !(subject.kind === 'workflow' && subject.tab === 'browsers') && (
+        <section className="wd-strip" aria-label="Live browsers">
+          <h2 className="wd-h3">Live browsers <span className="wd-n">{liveTasks.length}</span> <span className="wd-dim">pick one to watch it</span></h2>
+          <div className="wd-strip-row">
+            {liveTasks.map((t) => <Still key={t.id} task={t} onOpen={() => pickTask(t.id, 'browser')} picked={picked !== null && stepOfTask(t.id) === picked} />)}
+          </div>
+        </section>
+      )}
+    </div>
+  )
+
+  let dock: ReactNode
+  if (subject.kind === 'step') {
+    const s = wf.steps.find((x) => x.step_id === subject.stepId)
+    const g = gridOf(wf)
+    const [stage, ...rest] = subject.stepId.split('-')
+    const feature = rest.join('-')
+    const si = g.stages.indexOf(subject.stepId.slice(0, subject.stepId.length - (g.cols.find((col) => subject.stepId.endsWith(`-${col}`))?.length ?? 0) - 1))
+    const col = g.cols.find((cc) => subject.stepId.endsWith(`-${cc}`)) ?? feature
+    const prev = si > 0 ? g.cell(g.stages[si - 1]!, col) : null
+    const next = si >= 0 && si < g.stages.length - 1 ? g.cell(g.stages[si + 1]!, col) : null
+    dock = (
+      <div className="wd-dock-step">
+        <div className="wd-dock-ctx">
+          <button type="button" className="wd-back" onClick={() => setSubject({ kind: 'workflow', tab: 'overview' })} aria-label="Back to the workflow">‹ {title}</button>
+          <span className="wd-dim">stage <b>{g.matrix ? g.stages[si] ?? stage : stage}</b> · {col}</span>
+          <span className="wd-grow" />
+          <button type="button" className="wd-step-nav" disabled={!prev} onClick={() => prev && pickStep(prev)} title={prev ? `Earlier step: ${prev}` : 'No earlier step'} aria-label="Earlier step">↑ {prev ? prev.split('-').slice(0, -1).join('-') : ''}</button>
+          <button type="button" className="wd-step-nav" disabled={!next} onClick={() => next && pickStep(next)} title={next ? `Next step: ${next}` : 'No next step'} aria-label="Next step">↓ {next ? next.split('-').slice(0, -1).join('-') : ''}</button>
+        </div>
+        {s?.task_id ? (
+          <DockAgent taskId={s.task_id} task={data.taskById.get(s.task_id)} pane={stepPane} nav={nav} go={go} onClose={() => setSubject({ kind: 'workflow', tab: 'overview' })} />
+        ) : (
+          <p className="wd-dim">Not started: waits on {s?.depends_on.join(', ') || 'nothing'}.</p>
+        )}
+      </div>
+    )
+  } else {
+    const tab = subject.tab
+    const bigTask = liveTasks.find((t) => t.id === big) ?? null
+    dock = (
+      <div className="wd-dock-body">
+        <DockHead onClose={() => { setPhoneDock(false); setDockOpen(false) }} closeLabel="Fold the inspector">
+          <Segmented<'overview' | 'browsers' | 'needs'>
+            label="Workflow inspector"
+            value={tab}
+            role="tablist"
+            small
+            onChange={(t) => setSubject({ kind: 'workflow', tab: t })}
+            options={[
+              { key: 'overview', label: 'Overview' },
+              { key: 'browsers', label: 'Browsers', count: liveTasks.length },
+              { key: 'needs', label: 'Needs you', count: needs.length },
+            ]}
+          />
+        </DockHead>
+        {tab === 'overview' && <WfOverview wf={wf} data={data} />}
+        {tab === 'browsers' && (
+          <>
+            {bigTask && (
+              <div className="wd-bigwrap">
+                <Still task={bigTask} onOpen={() => pickTask(bigTask.id, 'browser')} big />
+                <div className="wd-row">
+                  <Button size="sm" kind="primary" onClick={() => pickTask(bigTask.id, 'browser')}>Open {titleOf(bigTask)}</Button>
+                  <span className="wd-dim">Take control, logs and theater are in the step</span>
+                </div>
+              </div>
+            )}
+            <div className={`wd-wall${bigTask ? ' is-small' : ''}`}>
+              {liveTasks.filter((t) => t.id !== bigTask?.id).map((t) => <Still key={t.id} task={t} onOpen={() => setBig(t.id)} />)}
+            </div>
+          </>
+        )}
+        {tab === 'needs' && <NeedsList items={needs} data={data} onPick={pickTask} />}
+      </div>
+    )
+  }
+  return <DockPage main={main} dock={dockOpen ? dock : null} width={w} onWidth={setW} label="Inspector" phoneOpen={phoneDock} />
+}
+
+/** The workflow's own inspector: what the page's prose said, as figures, with the long words behind toggles. */
+function WfOverview({ wf, data }: { wf: Workflow; data: Extract<WorkData, { status: 'ok' }> }) {
+  const prs = wf.steps.map((s) => (s.task_id ? prOf(data.taskById.get(s.task_id)) : null)).filter((p): p is PR => p !== null)
+  const merged = prs.filter((p) => p.state === 'merged').length
+  const isHard = wf.workflow_id === HARD_WF
+  const after = (wf as unknown as { after_pull_requests?: { pull_requests: number[]; state: string } }).after_pull_requests
+  const spent = workflowSpend(wf, data.taskById)
+  return (
+    <div className="wd-ov">
+      <dl className="wd-dl">
+        <dt>Spent</dt>
+        <dd>
+          <b>{spent}</b>
+          {isHard && <span className="wd-dim"> · ${MOCK_SPEND.earlierAttemptsUsd.toFixed(2)} on earlier attempts</span>}
+        </dd>
+        <dt>Pull requests</dt>
+        <dd><b>{prs.length}</b> <span className="wd-dim">· {merged} merged · {prs.length - merged} open</span></dd>
+        <dt>Dispatch</dt>
+        <dd>a pull request per step</dd>
+        {after && (<><dt>Merge</dt><dd>after pull requests {after.pull_requests.map((n) => `#${n}`).join(', ')}: {after.state}</dd></>)}
+        <dt>On a failed step</dt>
+        <dd>{(() => { const f = (wf as unknown as { on_step_failure?: string }).on_step_failure; return f ? `${f.toLowerCase()} the others` : 'not read' })()}</dd>
+        <dt>Owner</dt>
+        <dd>{person(wf.submitted_by)}</dd>
+        <dt>Started</dt>
+        <dd>{span(mins(wf.created_at))} ago · changed {span(mins(wf.updated_at))} ago</dd>
+      </dl>
+      <details className="wd-details">
+        <summary>Policy</summary>
+        <p className="wd-dim">
+          Steps run when the step before them in the same column is done. A failed step does not stop the others; its later steps wait on it. Each
+          step opens its own pull request; the merge runs once every question is answered.
+        </p>
+      </details>
+      <details className="wd-details">
+        <summary>Workflow id and reads</summary>
+        <p className="wd-mono">{wf.workflow_id}</p>
+        <p className="wd-dim">{wf.steps.length} of {wf.steps.length} steps read · state derived from its steps</p>
+      </details>
+      <div className="wd-row">
+        <Button size="sm" kind="danger">Stop workflow</Button>
+        <Button size="sm" kind="ghost">Copy link</Button>
+      </div>
+    </div>
+  )
+}
+
+function Loading({ data }: { data: WorkData }) {
+  return <p className="wd-dim">{data.status === 'error' ? `Not read: ${data.why}` : 'Reading the agents and workflows…'}</p>
+}
+
+export const DIRECTION_D: DirectionScreens = { agents: DAgents, agent: DAgent, workflows: DWorkflows, workflow: DWorkflow }
