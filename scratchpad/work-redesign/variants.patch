+    rect(32, top + 470, 120, 40, '#2563eb', 6); text(62, top + 495, 'Save', 15, '#fff', 600)
+  }
+  return parts.join('')
+}
+
+const stillCache = new Map<string, string>()
+
+/** A data: URL of the still image drawn where the live canvas goes, or null when the task has no live browser. */
+export function mockStillUrl(taskId: string, mobile = false): string | null {
+  if (!mockLiveTask(taskId)) return null
+  const key = `${taskId}:${mobile}`
+  const hit = stillCache.get(key)
+  if (hit !== undefined) return hit
+  const [w, h] = mobile ? [393, 852] : [1440, 900]
+  const seed = stillIndex(taskId)
+  const kind = stillKind(taskId)
+  // The still is the page only, never browser chrome: its address is the Browser tab's own strip
+  // (mockOrigin), so it is drawn once (fix-d, verdict findings 3 and 16).
+  const site = taskId.startsWith('task_dpb_') ? 'Northwind CRM' : 'Roombook'
+  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">`
+    + `<rect width="${w}" height="${h}" fill="#f5f7fa"/>`
+    + `<rect width="${w}" height="44" fill="#ffffff"/><rect y="44" width="${w}" height="1" fill="#e5e7eb"/>`
+    + `<circle cx="22" cy="22" r="8" fill="#2563eb"/>`
+    + `<text x="40" y="27" font-family="Inter, Arial, sans-serif" font-size="14" font-weight="600" fill="#111827">${site}</text>`
+    + stillBody(kind, w, h, seed)
+    + `</svg>`
+  const url = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`
+  stillCache.set(key, url)
+  return url
+}
+
+/** The host a mock browser agent's page is on: the one address the Browser tab's strip and a large still show. */
+export function mockHost(taskId: string): string {
+  return taskId.startsWith('task_dpb_') ? 'staging.northwind-crm.example.com' : 'app.roombook.example.com'
+}
+
+/** The live session's reported origin for a mock browser agent, agreeing with mockHost. */
+export function mockOrigin(taskId: string): { origin: string; host: string; registrable_domain: string; scheme: string } {
+  const host = mockHost(taskId)
+  return { origin: `https://${host}`, host, registrable_domain: 'example.com', scheme: 'https:' }
+}
+
+/** The live session's browser tools (BrowserBadges.tsx): Playwright last used, Jev on, direct egress. */
+export function mockBrowserStatus(taskId: string): unknown {
+  return {
+    tool_selected: 'auto',
+    tools_available: ['playwright', 'dev-browser', 'jev'],
+    tool_last_used: { name: taskId.startsWith('task_dpb_') ? 'playwright' : 'jev', at: at(0.5) },
+    jev: { enabled: true, reason: null, key_scope: 'tenant' },
+    egress: { mode: 'direct', state: 'ok', country: null, last_error: null },
+  }
+}
+
+/** The parked hand-off's request event: its reason and host, read back by Handoff.tsx's useHandoffRequest (G12). */
+export function mockHandoffEvents(taskId: string): unknown[] {
+  if (!mockWorkOn()) return []
+  const t = mockTaskRows().find((x) => x.id === taskId)
+  if (!t || t.park_reason !== 'HUMAN_REQUIRED' || t.workflow_id) return []
+  return [{
+    type: 'human_handoff_requested', at: at(40), attempt_id: null, generation: 1,
+    detail: { reason: 'Sign in to the roombook admin with a two-factor code', expect: 'admin.roombook.example.com' },
+  }]
+}
