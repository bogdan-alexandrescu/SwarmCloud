+}
+/* The live strip under the matrix: every running browser of the workflow, small. */
+.wd-strip { display: flex; flex-direction: column; gap: var(--ctl-s1); min-width: 0; }
+.wd-strip-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: var(--ctl-s2); }
+
+/* The merge: one line under the matrix, amber while it waits on Bogdan. */
+.wd-merge { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ctl-s2); padding: 6px var(--ctl-s2); border: 1px solid var(--line); border-left: 4px solid var(--s-park); border-radius: var(--radius); background: var(--surface); min-width: 0; font-size: var(--t-meta); }
