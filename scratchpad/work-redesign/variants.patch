+.wd-need.is-faint:hover { text-decoration: none; }
+.wd-needlist .wd-need { cursor: default; padding: 0; font-weight: 600; }
+.wd-needlist .wd-need::before { display: none; }
+.wd-needlist .wd-need .wd-need-glyph { display: inline; }
+.wd-needlist .wd-need:hover { text-decoration: none; }
+/* Browsers only: a plain checkbox in the tools row. */
+.wd-check { display: inline-flex; align-items: center; gap: 6px; font: 400 var(--t-meta) / 1.3 var(--font); color: var(--text); cursor: pointer; white-space: nowrap; }
+/* A row's name truncates; its marks (your turn, question, silent) keep their place, on the phone too (finding 1). */
+.wd-namecell { display: flex; align-items: baseline; gap: 6px; min-width: 0; }
+.wd-namecell > .wd-rowlink { flex: 0 1 auto; min-width: 0; }
