+/** Small workflows' step tasks: a chain of 3, states chosen by the workflow's bucket. */
+function smallWorkflows(): { workflows: Workflow[]; tasks: Task[] } {
+  const workflows: Workflow[] = []
+  const tasks: Task[] = []
+  const BUCKETS: Array<{ wf: string; steps: TaskState[] }> = [
+    { wf: 'RUNNING', steps: ['SUCCEEDED', 'RUNNING', 'QUEUED'] },
+    { wf: 'PARKED', steps: ['SUCCEEDED', 'PARKED', 'QUEUED'] },
+    { wf: 'FAILED', steps: ['SUCCEEDED', 'FAILED', 'CANCELLED'] },
+    { wf: 'SUCCEEDED', steps: ['SUCCEEDED', 'SUCCEEDED', 'SUCCEEDED'] },
+  ]
+  for (let i = 0; i < 39; i += 1) {
+    const bucket = BUCKETS[i % 4]!
+    const id = `wf_${hex(700 + i)}${hex(800 + i)}`
+    const title = `${WF_NAMES[i % WF_NAMES.length]}${i >= WF_NAMES.length ? `-${Math.floor(i / WF_NAMES.length) + 1}` : ''}`
+    const stepIds = ['plan', 'do', 'check']
+    const minsAgo = 30 + i * 70
+    const steps: WorkflowStep[] = stepIds.map((s, k) => {
+      const tid = `task_${hex(900 + i * 3 + k)}`
+      const st = bucket.steps[k]!
+      // A running workflow's middle step is RUNNING, so its step bar has a running segment; these ten
+      // count among the Agents list's 34 live (fix-d, verdict finding 15).
+      const state: TaskState = st
+      tasks.push(mk(tid, state, k === 1 && i % 3 === 0 ? 'claude-code-browser' : 'claude-code', state === 'RUNNING' ? 12 + i : minsAgo - k * 10, {
+        workflow_id: id, step_id: s, depends_on: k === 0 ? [] : [stepIds[k - 1]],
+        submitted_by: OWNERS[i % OWNERS.length], metadata: { title },
+        repository_url: REPOS[i % 2],
+        park_reason: state === 'PARKED' ? 'CI_PENDING' : null,
+        waiting: state === 'PARKED' ? { reason: 'CI_PENDING', summary: 'CI on the pull request: 3 checks pending' }
+          : state === 'QUEUED' ? { reason: 'DEPENDENCY_INCOMPLETE', summary: `Waiting on 1 earlier step: ${stepIds[k - 1]}` } : undefined,
+        cost_usd_total: state === 'SUCCEEDED' || state === 'FAILED' ? Math.round((0.4 + k * 0.2 + (i % 7) * 0.13) * 100) / 100
+          : state === 'RUNNING' ? Math.round((0.15 + (i % 5) * 0.07) * 100) / 100 : null,
+        cost_incomplete: state === 'RUNNING' ? true : undefined,
+      } as Partial<Task>))
+      return {
+        step_id: s, runner_profile: 'claude-code', resource_class: 'standard',
+        depends_on: k === 0 ? [] : [stepIds[k - 1]], input_from: {}, timeout_seconds: 3600, task_id: tid,
+        input: { prompt: `${s} for ${title}` },
+      } as WorkflowStep
+    })
+    workflows.push(wfDoc(id, bucket.wf, steps, OWNERS[i % OWNERS.length]!, at(minsAgo + 6), at(Math.max(1, minsAgo - 25))))
+  }
+  return { workflows, tasks }
+}
+
+function wfDoc(id: string, state: string, steps: WorkflowStep[], by: string, created: string, updated: string,
+  extra: Partial<Workflow> = {}): Workflow {
+  return {
+    workflow_id: id,
+    tenant_id: MOCK_TENANT,
+    state,
+    stored_state: state,
+    state_source: 'derived',
+    rollup: {
+      state, complete: true, reason: null, counts: {}, unreadable_steps: [],
+      unstarted_steps: steps.filter((s) => !s.task_id).map((s) => s.step_id), steps_read: steps.length,
+    },
+    drift: { stored: state, derived: state, agrees: true, reason: null, steps_read: steps.length, unreadable_steps: [], repaired: false },
+    created_at: created,
+    updated_at: updated,
+    submitted_by: by,
+    priority: 0,
+    on_step_failure: 'CONTINUE',
+    cancel_requested: false,
+    steps,
+    ...extra,
+  } as unknown as Workflow
+}
+
+function hardWorkflow(): Workflow {
+  const steps: WorkflowStep[] = []
+  HARD_STAGES.forEach((stage, si) => {
+    HARD_FEATURES.forEach((feature) => {
+      const deps = si === 0 ? [] : [hardStepId(HARD_STAGES[si - 1]!, feature)]
+      steps.push({
+        step_id: hardStepId(stage, feature),
+        runner_profile: 'claude-code-browser',
+        resource_class: 'browser',
+        depends_on: deps,
+        input_from: si === 0 ? {} : { [deps[0]!]: 'report.md' },
+        timeout_seconds: 5400,
+        task_id: hardTaskId(stage, feature),
+        input: { prompt: `${stage} the ${feature} screen from the picked design, in a browser, and open a pull request.` },
+      } as WorkflowStep)
+    })
+  })
+  return wfDoc(HARD_WF, 'RUNNING', steps, PEOPLE.bogdan, at(52), at(1), {
+    after_pull_requests: { pull_requests: [2401, 2402], state: 'waiting' } as unknown as Workflow['after_pull_requests'],
+  })
+}
