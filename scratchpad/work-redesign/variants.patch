--- /dev/null
+++ b/apps/swarm-ui/src/workredesign/base.tsx
@@ -0,0 +1,195 @@
+// MOCK-HOOK FILE -- work-redesign mock-ups only. ?wa=base: the scaffold's plain, neutral layout.
+//
+// Each screen places every feature of features.md once: the console's own
+// screens (AgentsScreen, AgentSplit, WorkflowsScreen) carry the features they
+// have today, untouched, and the parts in parts.tsx add what the goals ask
+// for and today's screens do not draw (the needs-you strip, the browser wall,
+// the stage grid). A direction copies this file and rearranges.
+import { useState } from 'react'
+
+import type { TaskPane } from '../App'
+import { AgentSplit } from '../AgentSplit'
+import { AgentsScreen } from '../Agents'
+import { Breadcrumb, Chip, StatePill } from '../components'
+import type { AgentList } from '../agentlist'
+import { WorkflowsScreen } from '../Workflows'
+import { HARD_WF, HARD_WF_TITLE, hardTaskId } from './fixtures'
+import {
+  BrowserStill, BrowserWall, NeedsYou, Region, StageGrid, ageWords, splitCounts, useNeeds, workflowSpend,
+  type WorkAt, type WorkData, type WorkNav,
+} from './parts'
+import type { WorkState } from './switches'
+
+/** The agent the agent screen shows when the address names none: build-contacts, a running browser agent. */
+export const DEFAULT_AGENT = hardTaskId('build', 'contacts')
+
+export type BaseProps = {
+  data: WorkData
+  at: WorkAt
+  nav: WorkNav
+  wst: WorkState
+  /** The console's router, for anything outside the Work section. */
+  go: (to: string) => void
+  list: AgentList | null
+  onList: (list: AgentList) => void
+}
+
+function Loading({ data }: { data: WorkData }) {
+  return <p className="wr-dim">{data.status === 'error' ? `Not read: ${data.why}` : 'Reading the agents and workflows…'}</p>
+}
+
+/** An inline agent: the console's AgentSplit, its tab clicks kept inside the mock-up. */
+function InlineAgent({ taskId, pane, nav, go }: { taskId: string; pane: TaskPane; nav: WorkNav; go: (to: string) => void }) {
+  const [shown, setShown] = useState<TaskPane>(pane)
+  const base = `work/task/${encodeURIComponent(taskId)}`
+  const inner = (to: string) => {
+    if (to.startsWith(base)) {
+      const rest = to.slice(base.length).replace(/^\//, '').split('/')[0]
+      setShown((rest === '' ? 'detail' : rest) as TaskPane)
+      return
+    }
+    const other = /^work\/task\/([^/]+)/.exec(to)
+    if (other) return nav({ screen: 'agent', id: decodeURIComponent(other[1] ?? '') })
+    if (to.startsWith('work/running') || to === '/agents') return nav({ screen: 'agents', id: null })
+    go(to)
+  }
+  return (
+    <div className="wr-inline-agent">
+      <AgentSplit key={taskId} taskId={taskId} pane={shown} artifact={null} closeTo="work/running" go={inner} base={base} />
+    </div>
+  )
+}
+
+export function BaseAgents({ data, nav, wst, go, list, onList }: BaseProps) {
+  const needs = useNeeds(data)
+  if (data.status !== 'ok') return <Loading data={data} />
+  const c = splitCounts(data.tasks)
+  return (
+    <div className="wr-page">
+      <div className="wr-row wr-counts">
+        <Chip tone="live">Live <b>{c.live}</b></Chip>
+        <span className="wr-dim">of them browsers <b>{c.browsers}</b></span>
+        <Chip tone="park">Waiting <b>{c.waiting}</b></Chip>
+        <Chip>Recent <b>{c.recent}</b></Chip>
+      </div>
+      <NeedsYou items={needs} open={wst === 'needs'} nav={nav} />
+      <BrowserWall tasks={data.tasks} nav={nav} large={wst === 'watch' ? DEFAULT_AGENT : null} />
+      <div className={wst === 'open' ? 'wr-split' : undefined}>
+        <Region title="Agents" note="The console’s list: search, filters, Live / Waiting / Recent">
+          <AgentsScreen onOpen={(id: string) => nav({ screen: 'agent', id })} list={list} onList={onList} />
+        </Region>
+        {wst === 'open' && <InlineAgent taskId={DEFAULT_AGENT} pane="detail" nav={nav} go={go} />}
+      </div>
+    </div>
+  )
+}
+
+export function BaseAgent({ data, at, nav, wst, go }: BaseProps) {
+  const id = at.id ?? DEFAULT_AGENT
+  const task = data.status === 'ok' ? data.taskById.get(id) ?? null : null
+  const pane: TaskPane = wst === 'logs' ? 'logs' : wst === 'watch' ? 'browser' : 'detail'
+  return (
+    <div className="wr-page">
+      <Breadcrumb
+        crumbs={[
+          { key: 'agents', label: 'Agents', href: '/agents' },
+          ...(task?.workflow_id ? [{ key: 'wf', label: String(task.metadata?.title ?? task.workflow_id), href: `/workflows/${task.workflow_id}` }] : []),
+          { key: 'agent', label: task?.step_id ?? id, href: null },
+        ]}
+        onGo={(href) => (href === '/agents' ? nav({ screen: 'agents', id: null }) : nav({ screen: 'workflow', id: task?.workflow_id ?? null }))}
+      />
+      {task && (
+        <div className="wr-row">
+          <StatePill state={task.state} />
+          <span className="wr-mono">{task.id}</span>
+          <span className="wr-dim">started {ageWords(task.started_at)} ago</span>
+        </div>
+      )}
+      <div className="wr-split">
+        {task && task.runner_profile === 'claude-code-browser' && task.state === 'RUNNING' && (
+          <BrowserStill task={task} nav={nav} size="large" />
+        )}
+        <InlineAgent key={`${id}:${pane}`} taskId={id} pane={pane} nav={nav} go={go} />
+      </div>
+    </div>
+  )
+}
+
+export function BaseWorkflows({ data, nav, wst }: BaseProps) {
+  const needs = useNeeds(data)
+  const [view, setView] = useState('')
+  if (data.status !== 'ok') return <Loading data={data} />
+  const by = (s: string) => data.workflows.filter((w) => w.state === s).length
+  return (
+    <div className="wr-page">
+      <div className="wr-row wr-counts">
+        <Chip tone="live">Running <b>{by('RUNNING')}</b></Chip>
+        <Chip tone="park">Parked <b>{by('PARKED')}</b></Chip>
+        <Chip tone="bad">Failed <b>{by('FAILED')}</b></Chip>
+        <Chip>Done <b>{by('SUCCEEDED')}</b></Chip>
+      </div>
+      <NeedsYou items={needs} open={wst === 'needs'} nav={nav} />
+      <Region title="Workflows" note="The console’s board: search, filters, sort, stage cards">
+        <WorkflowsScreen
+          view={view}
+          onView={(v) => {
+            const wf = new URLSearchParams(v).get('wf')
+            if (wf) nav({ screen: 'workflow', id: wf })
+            else setView(v)
+          }}
+        />
+      </Region>
+    </div>
+  )
+}
+
+export function BaseWorkflow({ data, at, nav, wst }: BaseProps) {
+  const id = at.id ?? HARD_WF
+  const needs = useNeeds(data, id)
+  const [view, setView] = useState(`wf=${encodeURIComponent(id)}`)
+  const [step, setStep] = useState<string | null>(wst === 'open' ? 'build-invoices' : null)
+  if (data.status !== 'ok') return <Loading data={data} />
+  const w = data.workflows.find((x) => x.workflow_id === id)
+  if (w === undefined) return <p className="wr-dim">No workflow {id} in this dataset.</p>
+  const steps = w.steps.map((s) => (s.task_id ? data.taskById.get(s.task_id) : undefined))
+  const n = (pred: (t: (typeof steps)[number]) => boolean) => steps.filter(pred).length
+  const stepTasks = steps.filter((t): t is NonNullable<typeof t> => t !== undefined)
+  const sel = step === null ? null : w.steps.find((s) => s.step_id === step) ?? null
+  const selTask = sel?.task_id ? data.taskById.get(sel.task_id) ?? null : null
+  return (
+    <div className="wr-page">
+      <Breadcrumb crumbs={[{ key: 'wfs', label: 'Workflows', href: '/workflows' }, { key: 'wf', label: id === HARD_WF ? HARD_WF_TITLE : id, href: null }]} onGo={() => nav({ screen: 'workflows', id: null })} />
+      <div className="wr-row wr-counts">
+        <StatePill state={w.state as 'RUNNING'} />
+        <Chip tone="live">Running <b>{n((t) => t?.state === 'RUNNING')}</b></Chip>
+        <Chip tone="park">Waiting <b>{n((t) => t?.state === 'PARKED' || t?.state === 'QUEUED' || t?.state === 'READY' || t === undefined)}</b></Chip>
+        <Chip>Done <b>{n((t) => t?.state === 'SUCCEEDED')}</b></Chip>
+        <Chip tone="bad">Failed <b>{n((t) => t?.state === 'FAILED')}</b></Chip>
+        <span className="wr-dim">spent <b>{workflowSpend(w, data.taskById)}</b></span>
+      </div>
+      <NeedsYou items={needs} open={wst === 'needs' || wst === 'rest'} nav={nav} />
+      <div className={sel ? 'wr-split' : undefined}>
+        <Region title="Steps by stage" note={`${w.steps.length} steps; click one`}>
+          <StageGrid workflow={w} taskById={data.taskById} nav={nav} selected={step} onSelect={(s) => setStep((x) => (x === s ? null : s))} />
+        </Region>
+        {sel && (
+          <Region title={sel.step_id} note={selTask ? selTask.state.toLowerCase() : 'not started'}>
+            {selTask ? (
+              <div className="wr-col">
+                <button type="button" className="ctl-link" onClick={() => nav({ screen: 'agent', id: selTask.id })}>Open its agent</button>
+                {selTask.last_error && <p className="wr-bad">{selTask.last_error}</p>}
+                {selTask.runner_profile === 'claude-code-browser' && selTask.state === 'RUNNING' && <BrowserStill task={selTask} nav={nav} />}
+              </div>
+            ) : (
+              <p className="wr-dim">Waiting on {sel.depends_on.join(', ') || 'nothing'}.</p>
+            )}
+          </Region>
+        )}
+      </div>
+      <BrowserWall tasks={stepTasks} nav={nav} large={wst === 'watch' ? DEFAULT_AGENT : null} />
+      <Region title="Workflow" note="The console’s page: Graph / Table / Steps over time / Changes, policy, stop, reads">
+        <WorkflowsScreen view={view} onView={setView} />
+      </Region>
+    </div>
+  )
+}
diff --git a/apps/swarm-ui/src/workredesign/fixtures.ts b/apps/swarm-ui/src/workredesign/fixtures.ts
new file mode 100644
index 0000000..a41df88
--- /dev/null
+++ b/apps/swarm-ui/src/workredesign/fixtures.ts
@@ -0,0 +1,636 @@
+// MOCK-HOOK FILE -- work-redesign mock-ups only (LANE WORK-REDESIGN-MOCKUPS, 2026-11-02). Never committed.
+//
+// THE WORK SECTION'S MOCK DATASET. Invented data only: people at example.com,
+// repositories `northwind-crm` and `roombook`. When `mockWorkOn()` is true
+// (the fixture dev server, outside vitest, unless `?wfx=off`), api.ts's
+// `fixtureTaskRows()` and `fixtureWorkflowRows()` answer from here instead, so
+// every existing loader -- the Agents list, one agent, attempts, events, the
+// Workflows board, one workflow -- serves the same rows, and today's pages and
+// the redesign directions render the same data.
+//
+// THE HARD CASE, `wf_design_picks_build` ("design-picks-build"): 40 steps in
+// 4 stages of 10 (build, review, fix, re-review, one per feature). The brief's
+// counts (10 running, 25 waiting, 5 done, 1 failed) add to 41, and a chain per
+// feature holds at most one active step per feature: 10 running plus 1 failed is
+// 11 active in 10 chains, so a review would have to run after its failed build.
+// This file keeps the brief's 5 done, 1 failed and 25 waiting and draws 9 running
+// browser agents (5 + 1 + 9 + 25 = 40; fix-d, verdict finding 7); and the 2 owner questions are asked by two
+// finished build steps and hold the workflow's merge task (a 41st task of the
+// workflow, profile `merge`, PARKED HUMAN_REQUIRED, park_phase owner_questions),
+// which is also the "merge waiting". One pull request per started step.
+import type { Task, TaskState, Workflow, WorkflowStep } from '../types'
+
+/**
+ * The instant mock times count from: the page's own clock at load, to the minute. NOT api.ts's
+ * FIXTURE_CLOCK: a page on a running clock drew every mock agent as "13 d 16 h" old, which a
+ * layout review cannot read past. Ages and states are deterministic; the wall-clock times are not.
+ */
+export const MOCK_NOW = Math.floor(Date.now() / 60_000) * 60_000
+const at = (minsAgo: number) => new Date(MOCK_NOW - minsAgo * 60_000).toISOString()
+
+function param(name: string): string | null {
+  if (typeof window === 'undefined') return null
+  return new URLSearchParams(window.location.search).get(name)
+}
+
+/** Read ONCE at load, so the app's own canonical rewrite of the address cannot drop a switch mid-session. */
+const WFX = param('wfx')
+
+/** Whether the work-redesign dataset replaces the Work section's fixtures. */
+export function mockWorkOn(): boolean {
+  return import.meta.env.DEV && !import.meta.env.VITE_LIVE && import.meta.env.MODE !== 'test' && WFX !== 'off'
+}
+
+export const MOCK_TENANT = 'u-bogdan'
+export const PEOPLE = {
+  bogdan: 'bogdan@example.com',
+  ana: 'ana.moreau@example.com',
+  kenji: 'kenji.sato@example.com',
+  lea: 'lea.fontaine@example.com',
+  ravi: 'ravi.iyer@example.com',
+} as const
+const OWNERS = [PEOPLE.bogdan, PEOPLE.ana, PEOPLE.kenji, PEOPLE.lea, PEOPLE.ravi]
+
+export const HARD_WF = 'wf_design_picks_build'
+export const HARD_WF_TITLE = 'design-picks-build'
+export const HARD_MERGE_TASK = 'task_dpb_merge'
+export const HARD_STAGES = ['build', 'review', 'fix', 're-review'] as const
+export const HARD_FEATURES = [
+  'login', 'search', 'calendar', 'invoices', 'contacts', 'reports', 'settings', 'booking', 'export', 'onboarding',
+] as const
+export const HARD_SPENT_USD = 13.52
+
+const REPOS = ['https://github.com/example-org/northwind-crm', 'https://github.com/example-org/roombook']
+
+/** A step id of the hard case: `<stage>-<feature>`, stage `re-review` included. */
+export const hardStepId = (stage: string, feature: string) => `${stage}-${feature}`
+export const hardTaskId = (stage: string, feature: string) => `task_dpb_${stage.replace('-', '')}_${feature}`
+
+// --------------------------------------------------------------------------
+// One task, shaped as api.ts's fixture `mk` shapes it
+// --------------------------------------------------------------------------
+
+function mk(id: string, state: TaskState, profile: string, minsAgo: number, extra: Partial<Task> = {}): Task {
+  const terminal = state === 'SUCCEEDED' || state === 'FAILED' || state === 'CANCELLED'
+  const admitted = !(state === 'QUEUED' || state === 'READY' || state === 'SUBMITTED')
+  const live = state === 'LEASED' || state === 'DISPATCHED' || state === 'STARTING' || state === 'RUNNING'
+  const task = {
+    id,
+    tenant_id: MOCK_TENANT,
+    state,
+    runner_profile: profile,
+    resource_class: profile === 'claude-code-browser' ? 'browser' : 'standard',
+    provider: 'anthropic',
+    priority: 0,
+    created_at: at(minsAgo + 6),
+    updated_at: at(terminal ? minsAgo : Math.max(0, Math.min(minsAgo, 2))),
+    started_at: admitted ? at(minsAgo + 4) : null,
+    completed_at: terminal ? at(minsAgo) : null,
+    submitted_by: PEOPLE.bogdan,
+    attempt_count: admitted ? 1 : 0,
+    max_attempts: 3,
+    park_reason: null,
+    blocked_by: null,
+    workflow_id: null,
+    step_id: null,
+    depends_on: null,
+    cancel_requested: false,
+    repository_url: REPOS[0],
+    model: 'claude-opus-5',
+    timeout_seconds: 3600,
+    next_eligible_at: null,
+    metadata: null,
+    repository_ref: 'main',
+    current_generation: admitted ? 1 : 0,
+    current_lease_id: live ? `lease_${id.replace('task_', '')}` : null,
+    dispatch: { strategy: 'direct-pr', carrier: 'checkpoints', role: null, integrates: [] },
+    input: null,
+    last_error: state === 'FAILED' ? 'exit status 1: CI check "e2e / chromium" failed on the pull request' : null,
+    result_summary: state === 'SUCCEEDED' ? { artifacts: 2, checkpoints: 3 } : null,
+    latest_checkpoint: null,
+    // A lease's heartbeat (Agents.tsx silentWorkerLine, the inspector's beat age) and the child
+    // fields served, so the Children tab is offered (fix-d, verdict findings 9 and 12).
+    heartbeat: live ? 'read' : 'no lease',
+    heartbeat_at: live ? at(0.4) : null,
+    heartbeat_grace_seconds: live ? 120 : null,
+    parent_task_id: null,
+    ...extra,
+  }
+  return task as unknown as Task
+}
+
+// --------------------------------------------------------------------------
+// The hard case: design-picks-build
+// --------------------------------------------------------------------------
+
+type HardShape = { state: TaskState | null; minsAgo: number; question?: string; costUsd: number }
+
+/** Each step's state, by stage then feature index. null: not started (waiting on an earlier step). */
+function hardShape(stage: number, f: number): HardShape {
+  // build: login, search, calendar succeeded; invoices FAILED (red check); the other six running.
+  if (stage === 0) {
+    if (f < 3) {
+      return {
+        state: 'SUCCEEDED', minsAgo: 40 - f * 6, costUsd: [1.12, 0.98, 1.31][f] ?? 0,
+        question: f === 1 ? 'The search design pick shows filters in a side panel; the brief says a top bar. Which one ships?'
+          : f === 2 ? 'Calendar: week view by default, or month view as in the second pick?' : undefined,
+      }
+    }
+    if (f === 3) return { state: 'FAILED', minsAgo: 18, costUsd: 1.46 }
+    return { state: 'RUNNING', minsAgo: 1, costUsd: [0.71, 0.66, 0.58, 0.49, 0.44, 0.39][f - 4] ?? 0 }
+  }
+  // review: login, search succeeded; calendar running. review-invoices waits on its failed build: a step never
+  // runs after the step it depends on failed (fix-d, verdict finding 7).
+  if (stage === 1) {
+    if (f === 0) return { state: 'SUCCEEDED', minsAgo: 12, costUsd: 0.62 }
+    if (f === 1) return { state: 'SUCCEEDED', minsAgo: 6, costUsd: 0.41 }
+    if (f === 2) return { state: 'RUNNING', minsAgo: 1, costUsd: 0.37 }
+    return { state: null, minsAgo: 0, costUsd: 0 }
+  }
+  // fix: login, search running.
+  if (stage === 2 && f === 0) return { state: 'RUNNING', minsAgo: 1, costUsd: 0.33 }
+  if (stage === 2 && f === 1) return { state: 'RUNNING', minsAgo: 1, costUsd: 0.27 }
+  return { state: null, minsAgo: 0, costUsd: 0 }
+}
+// Spend check: 1.12+0.98+1.31+1.46+0.71+0.66+0.58+0.49+0.44+0.39+0.62+0.41+0.37+0.33+0.27 = 10.14;
+// the merge task and the attempts' own usage are not summed here. HARD_SPENT_USD is the brief's figure
+// for the workflow header; MOCK_SPEND below spreads the remaining 3.38 over earlier attempts.
+const MOCK_EARLIER_ATTEMPTS_USD = 3.38
+
+function hardTasks(): Task[] {
+  const out: Task[] = []
+  HARD_STAGES.forEach((stage, si) => {
+    HARD_FEATURES.forEach((feature, f) => {
+      const shape = hardShape(si, f)
+      const stepId = hardStepId(stage, feature)
+      const id = hardTaskId(stage, feature)
