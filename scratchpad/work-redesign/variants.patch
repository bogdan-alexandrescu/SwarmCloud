diff --git a/apps/swarm-ui/src/workredesign/D/DirectionD.tsx b/apps/swarm-ui/src/workredesign/D/DirectionD.tsx
new file mode 100644
index 0000000..7c25608
--- /dev/null
+++ b/apps/swarm-ui/src/workredesign/D/DirectionD.tsx
@@ -0,0 +1,1054 @@
+// MOCK-HOOK FILE -- work-redesign mock-ups only. Direction D: the graph with a docked inspector.
+//
+// Every screen is one shape: a dense main column (a one-line-per-row table, or
+// the workflow's stage x feature matrix) and a resizable inspector docked on
+// the right. The inspector's subject is a workflow (Overview / Browsers /
+// Needs you) or one agent (the console's own AgentSplit: Details, Browser,
+// Logs, Attempts, More: Changes, Children, Outputs, Checkpoints). Picking a row
+// or a chip changes the subject and keeps the main column where it was.
+import { Fragment, useEffect, useMemo, useRef, useState, type ReactNode } from 'react'
+
+import type { TaskPane } from '../../App'
+import { AgentSplit } from '../../AgentSplit'
+import { Breadcrumb, Button, LiveChip, PARK_WORD, Segmented, StatePill } from '../../components'
+import { WorkflowsScreen } from '../../Workflows'
+import { CANCEL_NOTE, WHOLE_TASK_ID, silentWorkerLine } from '../../Agents'
+import { CONCURRENCY_STATES, TERMINAL_STATES, WAITING_STATES, type ParkReason, type Task, type Workflow } from '../../types'
+import type { DirectionScreens } from '../WorkRedesign'
+import type { BaseProps } from '../base'
+import { HARD_WF, HARD_WF_TITLE, MOCK_NOW, MOCK_SPEND, hardTaskId, mockHost, mockStillUrl } from '../fixtures'
+import { NEED_WORD, needsYou, stagesOf, workflowSpend, type NeedItem, type WorkData, type WorkNav } from '../parts'
+import './d.css'
+
+const BROWSER = 'claude-code-browser'
+const DEFAULT_AGENT = hardTaskId('build', 'contacts')
+const isBrowser = (t: Task) => t.runner_profile === BROWSER
+const isLiveBrowser = (t: Task) => isBrowser(t) && t.state === 'RUNNING'
+
+// --------------------------------------------------------------------------
+// Small words: time, money, people
+// --------------------------------------------------------------------------
+
+function mins(fromIso: string | null | undefined, toMs: number = MOCK_NOW): number | null {
+  if (!fromIso) return null
+  return Math.max(0, Math.round((toMs - Date.parse(fromIso)) / 60_000))
+}
+function span(m: number | null): string {
+  if (m === null) return '—'
+  if (m < 60) return `${m}m`
+  if (m < 48 * 60) return `${Math.floor(m / 60)}h ${m % 60 ? `${m % 60}m` : ''}`.trim()
+  return `${Math.round(m / 1440)}d`
+}
+function money(n: number | null | undefined, incomplete = false): ReactNode {
+  if (typeof n !== 'number') return <span className="wd-dim" title="Not measured yet">—</span>
+  return (
+    <span title={incomplete ? 'Still running: more will be added' : undefined}>
+      ${n.toFixed(2)}
+      {incomplete ? <span className="wd-dim">+</span> : null}
+    </span>
+  )
+}
+function person(email: string | null | undefined): string {
+  if (!email) return '—'
+  const local = email.split('@')[0] ?? email
+  if (local === 'bogdan') return 'Bogdan'
+  return local.split('.').map((p) => p.charAt(0).toUpperCase() + p.slice(1)).join(' ')
+}
+type PR = { number: number; url: string; state: string }
+function prOf(t: Task | undefined | null): PR | null {
+  const g = (t?.result_summary as { git?: { pull_request?: PR } } | null | undefined)?.git
+  return g?.pull_request ?? null
+}
+function checksOf(t: Task | undefined | null): { passed: number; failed: number; failed_names?: string[] } | null {
+  const g = (t?.result_summary as { git?: { checks?: { passed: number; failed: number; failed_names?: string[] } } } | null | undefined)?.git
+  return g?.checks ?? null
+}
+const asksOwner = (t: Task | undefined | null) => (t?.owner_answers ?? []).some((a) => a.choice === null && a.text === null)
+const waitWord = (t: Task): string => {
+  const r = t.park_reason as ParkReason | null
+  if (r && PARK_WORD[r]) return PARK_WORD[r]
+  if (t.state === 'QUEUED') return 'in line'
+  if (t.state === 'READY') return 'waiting for a slot'
+  return t.state.toLowerCase()
+}
+const waitSummary = (t: Task): string | null => (t as unknown as { waiting?: { summary?: string } }).waiting?.summary ?? null
+const titleOf = (t: Task) => (t.step_id ? t.step_id : String(t.metadata?.title ?? t.id))
+
+// --------------------------------------------------------------------------
+// The dock: a resizable inspector on the right
+// --------------------------------------------------------------------------
+
+function useDockWidth(initial: number): [number, (w: number) => void] {
+  const [w, setW] = useState(initial)
+  useEffect(() => setW(initial), [initial])
+  return [w, setW]
+}
+
+/** The page: main column, a drag handle, the docked inspector. `dock` null folds it to a rail. */
+function DockPage({ main, dock, width, onWidth, label, phoneOpen }: {
+  main: ReactNode
+  dock: ReactNode | null
+  width: number
+  onWidth: (w: number) => void
+  label: string
+  /** On a phone the inspector is a sheet over the page, shown only once something is picked. */
+  phoneOpen: boolean
+}) {
+  const root = useRef<HTMLDivElement>(null)
+  const drag = (e: React.PointerEvent) => {
+    e.preventDefault()
+    const box = root.current?.getBoundingClientRect()
+    if (!box) return
+    const move = (ev: PointerEvent) => onWidth(Math.min(Math.max(box.right - ev.clientX, 340), box.width - 360))
+    const up = () => {
+      window.removeEventListener('pointermove', move)
+      window.removeEventListener('pointerup', up)
+    }
+    window.addEventListener('pointermove', move)
+    window.addEventListener('pointerup', up)
+  }
+  const key = (e: React.KeyboardEvent) => {
+    if (e.key === 'ArrowLeft') onWidth(width + 40)
+    if (e.key === 'ArrowRight') onWidth(Math.max(340, width - 40))
+  }
+  return (
+    <div ref={root} className={`wd${dock ? '' : ' is-folded'}${phoneOpen ? ' is-sheet' : ''}`} style={{ ['--wd-dock' as string]: `${width}px` }}>
+      <div className="wd-main">{main}</div>
+      {dock && (
+        <>
+          <div
+            className="wd-handle"
+            role="separator"
+            aria-orientation="vertical"
+            aria-label="Resize the inspector"
+            aria-valuenow={width}
+            tabIndex={0}
+            onPointerDown={drag}
+            onKeyDown={key}
+          />
+          <aside className="wd-dock" aria-label={label}>
+            {dock}
+          </aside>
+        </>
+      )}
+    </div>
+  )
+}
+
+function DockHead({ children, onClose, closeLabel = 'Close the inspector' }: { children: ReactNode; onClose?: () => void; closeLabel?: string }) {
+  return (
+    <div className="wd-dock-head">
+      <div className="wd-dock-title">{children}</div>
+      {onClose && (
+        <button type="button" className="wd-x" onClick={onClose} aria-label={closeLabel} title={closeLabel}>
+          ×
+        </button>
+      )}
+    </div>
+  )
+}
+
+/** One agent in the inspector: the console's AgentSplit, its own tab clicks kept inside the dock. */
+function DockAgent({ taskId, task, pane, nav, go, onClose }: { taskId: string; task?: Task; pane: TaskPane; nav: WorkNav; go: (to: string) => void; onClose: () => void }) {
+  const [shown, setShown] = useState<TaskPane>(pane)
+  useEffect(() => setShown(pane), [pane, taskId])
+  const base = `work/task/${encodeURIComponent(taskId)}`
+  const inner = (to: string) => {
+    if (to.startsWith(base)) {
+      const rest = to.slice(base.length).replace(/^\//, '').split(/[/?]/)[0]
+      setShown((rest === '' ? 'detail' : rest) as TaskPane)
+      return
+    }
+    const other = /^work\/task\/([^/]+)/.exec(to)
+    if (other) return nav({ screen: 'agent', id: decodeURIComponent(other[1] ?? '') })
+    if (to.startsWith('work/running') || to === '/agents') return onClose()
+    go(to)
+  }
+  const silent = task ? silentWorkerLine(task, MOCK_NOW) : null
+  const beat = task?.heartbeat === 'read' && task.heartbeat_at ? Math.max(0, Math.round((MOCK_NOW - Date.parse(task.heartbeat_at)) / 1000)) : null
+  return (
+    <div className="wd-agent">
+      {task && CONCURRENCY_STATES.has(task.state) && (
+        <p className={`wd-beat${silent ? ' is-bad' : ''}`} title={silent ?? 'The lease heartbeat: the worker says it is alive'}>
+          <span aria-hidden>♥</span> heartbeat {beat === null ? 'not read' : beat < 60 ? `${beat}s ago` : `${Math.floor(beat / 60)}m ago`}
+          {silent ? ' · silent' : ''}
+        </p>
+      )}
+      <AgentSplit key={taskId} taskId={taskId} pane={shown} artifact={null} closeTo="work/running" go={inner} base={base} />
+    </div>
+  )
+}
+
+// --------------------------------------------------------------------------
+// The browser still where the live canvas goes
+// --------------------------------------------------------------------------
+
+function Still({ task, onOpen, big = false, picked = false }: { task: Task; onOpen: () => void; big?: boolean; picked?: boolean }) {
+  const url = mockStillUrl(task.id)
+  return (
+    <figure className={`wd-still${big ? ' is-big' : ''}${picked ? ' is-picked' : ''}`}>
+      {big && (
+        <div className="wd-still-addr" title="The address the agent's browser reports">
+          <span className="wd-still-live is-inline"><LiveChip /></span>
+          <span className="wd-mono wd-trunc">{mockHost(task.id)}</span>
+        </div>
+      )}
+      <button type="button" className="wd-still-pic" onClick={onOpen} aria-label={`Watch ${titleOf(task)}`}>
+        {url !== null ? <img src={url} alt="" /> : <span className="wd-dim">No picture</span>}
+        {!big && <span className="wd-still-live"><LiveChip /></span>}
+        {task.human_wait ? <span className="wd-still-turn">◉ your turn</span> : null}
+      </button>
+      <figcaption>
+        <span className="wd-trunc">{titleOf(task)}</span>
+        <span className="wd-dim">{span(mins(task.started_at))}</span>
+      </figcaption>
+    </figure>
+  )
+}
+
+// --------------------------------------------------------------------------
+// Needs you: one line of counted chips, and the list behind it
+// --------------------------------------------------------------------------
+
+const NEED_KINDS: NeedItem['kind'][] = ['failed', 'question', 'merge', 'handoff']
+/** The glyph that stands for each kind when the bar is narrow; the word is kept as its label and tooltip. */
+const NEED_GLYPH: Record<NeedItem['kind'], string> = { failed: '✗', approval: '✓', question: '?', merge: '⇢', handoff: '◉' }
+
+function NeedsBar({ items, onOpen, active }: { items: NeedItem[]; onOpen: () => void; active?: boolean }) {
+  const n = (k: NeedItem['kind']) => items.filter((i) => i.kind === k).length
+  const total = items.length
+  return (
+    <div className={`wd-needs${total ? ' has-some' : ''}${active ? ' is-on' : ''}`} role="group" aria-label="Needs you">
+      <button type="button" className="wd-needs-btn" onClick={onOpen} aria-pressed={active}>
+        <b>Needs you</b> <span className="wd-needs-n">{total}</span>
+      </button>
+      {NEED_KINDS.map((k) => (n(k) > 0 ? (
+        <button key={k} type="button" className={`wd-need is-${k}`} onClick={onOpen} title={`${NEED_WORD[k]}: ${n(k)}`} aria-label={`${NEED_WORD[k]}: ${n(k)}`}>
+          <span className="wd-need-glyph" aria-hidden>{NEED_GLYPH[k]}</span>
+          <span className="wd-need-word">{NEED_WORD[k]}</span> <b>{n(k)}</b>
+        </button>
+      ) : null))}
+      <span className="wd-need is-faint" title="Approvals are read on Automate › Approvals; this dataset has none to count">
+        Approvals <b>not read</b>
+      </span>
+    </div>
+  )
+}
+
+function NeedsList({ items, data, onPick }: { items: NeedItem[]; data: Extract<WorkData, { status: 'ok' }>; onPick: (taskId: string) => void }) {
+  return (
+    <ul className="wd-needlist">
+      {items.map((i, k) => {
+        const t = i.taskId ? data.taskById.get(i.taskId) : undefined
+        const pr = prOf(t)
+        const [head, ...rest] = i.label.split(': ')
+        return (
+          <li key={k} className={`is-${i.kind}`}>
+            <div className="wd-need-top">
+              <span className={`wd-need is-${i.kind}`}><span className="wd-need-glyph" aria-hidden>{NEED_GLYPH[i.kind]}</span> {NEED_WORD[i.kind]}</span>
+              <b className="wd-trunc">{head}</b>
+              {pr && <a className="wd-pr" href={pr.url} onClick={(e) => e.preventDefault()}>#{pr.number}</a>}
+              <span className="wd-dim">{span(mins(t?.completed_at ?? t?.updated_at))} ago</span>
+            </div>
+            <p className="wd-need-text">{rest.join(': ')}</p>
+            <div className="wd-row">
+              {i.kind === 'question' && <Button size="sm" kind="primary" onClick={() => i.taskId && onPick(i.taskId)}>Answer</Button>}
+              {i.kind === 'failed' && <Button size="sm" kind="primary" onClick={() => i.taskId && onPick(i.taskId)}>Open logs</Button>}
+              {i.kind === 'merge' && <Button size="sm" onClick={() => i.taskId && onPick(i.taskId)}>See what holds it</Button>}
+              {i.kind === 'handoff' && <Button size="sm" kind="primary" onClick={() => i.taskId && onPick(i.taskId)}>Take the browser</Button>}
+              {i.kind === 'failed' && checksOf(t) && (
+                <span className="wd-dim">
+                  checks <span className="wd-ok">✓{checksOf(t)!.passed}</span> <span className="wd-bad">✗{checksOf(t)!.failed}</span>
+                </span>
+              )}
+            </div>
+          </li>
+        )
+      })}
+    </ul>
+  )
+}
+
+// --------------------------------------------------------------------------
+// AGENTS: a dense table beside the inspector
+// --------------------------------------------------------------------------
+
+type AgentTab = 'live' | 'waiting' | 'recent'
+const tabOf = (t: Task): AgentTab | null =>
+  CONCURRENCY_STATES.has(t.state) ? 'live' : WAITING_STATES.has(t.state) ? 'waiting' : TERMINAL_STATES.has(t.state) ? 'recent' : null
+
+function AgentsMain({ data, tab, setTab, picked, onPick, needs, onNeeds, needsOn }: {
+  data: Extract<WorkData, { status: 'ok' }>
+  tab: AgentTab
+  setTab: (t: AgentTab) => void
+  picked: string | null
+  onPick: (id: string) => void
+  needs: NeedItem[]
+  onNeeds: () => void
+  needsOn: boolean
+}) {
+  const [q, setQ] = useState('')
+  const [profile, setProfile] = useState('')
+  const [owner, setOwner] = useState('')
+  const [browsers, setBrowsers] = useState(false)
+  const [sort, setSort] = useState('newest')
