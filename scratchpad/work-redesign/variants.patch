+.wd-agent .ag-tabs-edge button em { text-transform: lowercase; }
+/* The beat line sits above the agent panel; the panel takes the rest of the height. */
+.wd-agent { display: flex; flex-direction: column; min-height: 0; }
+.wd-agent > .drawer.ag-split { height: auto; flex: 1 1 auto; min-height: 0; }
+.wd-namecell > .wd-pre { flex: 0 1000 auto; min-width: 2em; }
+/* Waiting, grouped by why: a header row per reason with its count (A13). */
+.wd-table tr.wd-group td { background: var(--surface-2, var(--bg)); font: 600 var(--t-meta) / 1.3 var(--font); color: var(--text); height: 30px; padding-top: 4px; padding-bottom: 4px; }
+.wd-table tr.wd-group td .wd-dim { font-weight: 400; margin-left: 6px; }
+/* The log bar's labels in words in the inspector ("No error matched", never "0 err ln"); the bar wraps to a second line instead (finding 18). */
+.wd-agent .ag-logs-bar { flex-wrap: wrap; row-gap: 6px; }
+.wd-agent .ag-logs-bar .ag-logs-short { display: none !important; }
+.wd-agent .ag-logs-bar .ag-logs-long { display: inline; position: static; width: auto; height: auto; overflow: visible; clip-path: none; }
+/* The inspector's tabs packed as the console packs them on a phone, so Overview, Browser, Logs, Changes and Attempts
