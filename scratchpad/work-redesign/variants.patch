+.wd-flow-row .wd-cell { flex: 0 1 180px; }
+.wd-after { margin: 0; }
+.wd-embed { min-width: 0; }
+
+/* The workflow overview. */
+.wd-ov { display: flex; flex-direction: column; gap: var(--ctl-s2); }
+.wd-dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px var(--ctl-s3); margin: 0; font-size: var(--t-meta); }
