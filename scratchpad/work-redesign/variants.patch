+/* MOCK-HOOK FILE -- work-redesign mock-ups only. Direction D: the graph with a docked inspector. */
+
+/* The page: main column | handle | dock, each scrolling on its own, one viewport tall. */
+.wd { --wd-dock: 440px; display: grid; grid-template-columns: minmax(0, 1fr) 9px minmax(0, var(--wd-dock)); /* 93px: the reads footer (29) and the page's own padding (16 + 48), so the page itself never scrolls (fix-d, finding 5). */ height: calc(100dvh - 93px); min-height: 480px; min-width: 0; max-width: 100%; }
+.wd.is-folded { grid-template-columns: minmax(0, 1fr); }
