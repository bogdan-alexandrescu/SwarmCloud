+type Tally = { done: number; running: number; waiting: number; failed: number; other: number; browsers: number }
+function tally(w: Workflow, byId: Map<string, Task>): Tally {
+  const c: Tally = { done: 0, running: 0, waiting: 0, failed: 0, other: 0, browsers: 0 }
+  for (const s of w.steps) {
+    const t = s.task_id ? byId.get(s.task_id) : undefined
+    if (!t) c.waiting += 1
+    else if (t.state === 'SUCCEEDED') c.done += 1
+    else if (t.state === 'FAILED') c.failed += 1
+    else if (CONCURRENCY_STATES.has(t.state)) {
+      c.running += 1
+      if (isLiveBrowser(t)) c.browsers += 1
+    } else if (WAITING_STATES.has(t.state)) c.waiting += 1
+    else c.other += 1
+  }
+  return c
+}
+
+function Progress({ c, total }: { c: Tally; total: number }) {
+  const seg = (n: number, cls: string, word: string) => (n > 0 ? <i className={cls} style={{ flexGrow: n }} title={`${n} ${word}`} /> : null)
+  return (
+    <span className="wd-prog" aria-label={`${c.done} done, ${c.running} running, ${c.waiting} waiting, ${c.failed} failed of ${total}`}>
+      {seg(c.done, 'is-done', 'done')}
+      {seg(c.failed, 'is-failed', 'failed')}
+      {seg(c.running, 'is-running', 'running')}
+      {seg(c.waiting, 'is-waiting', 'waiting')}
+      {seg(c.other, 'is-other', 'stopped')}
+    </span>
+  )
+}
