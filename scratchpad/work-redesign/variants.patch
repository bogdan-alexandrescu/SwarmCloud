+.wd-agent .drawer.ag-split { height: 100%; }
+.wd-agent .drawer.ag-split:focus, .wd-agent .drawer.ag-split:focus-visible { outline: none; }
+/* A narrow list beside a wide inspector: name and state only; the needs bar keeps its total. */
+@container wdmain (max-width: 420px) {
+  .wd-table .wdc-pic, .wd-table .wdc-time, .wd-table .wdc-cost, .wd-table .wdc-live, .wd-table .wdc-need { display: none; }
+  .wd-tools .wd-sel, .wd-tools .c-chip { flex: 1 1 40%; }
+  .wd-head .c-seg { max-width: 100%; overflow-x: auto; }
+}
+@container wdmain (max-width: 700px) { .wd-prog { width: 72px; } }
+@container wdmain (max-width: 620px) { .wd-table .wdc-live { display: none; } }
+@container wdmain (max-width: 420px) { .wd-pre { display: none; } }
+/* A narrow bar keeps every kind with its word and count: it wraps to more lines, never drops one (fix-d, finding 13). */
+/* The phone keeps each row's picture and time; the state shrinks to its mark's pill. */
+@media (max-width: 720px) {
+  .wd-table td.wdc-pic, .wd-table td.wdc-time { display: table-cell !important; }
+  .wd-table td.wdc-time { font-size: 12px; }
+  .wd-table td { padding: 4px 6px; }
+}
+.wd-stage-n[role=button] { cursor: pointer; }
+/* Table, Steps over time and Changes are the console's own views; their page header and tabs are already drawn above. */
+.wd-embed .c-phead, .wd-embed .c-count-note, .wd-embed .wfp-head, .wd-embed .wfp > .c-tabs { display: none; }
+
+/* fix-d: what needs Bogdan, as a mark and a word (design-system §6.6): sans, no border, no radius. */
+.wd-need { display: inline-flex; align-items: baseline; gap: 4px; border: 0; background: none; padding: 2px 4px; font: 400 var(--t-meta) / 1.3 var(--font); color: var(--text); cursor: pointer; }
