+.wd-handle { cursor: col-resize; position: relative; touch-action: none; }
+.wd-handle::before { content: ''; position: absolute; top: 0; bottom: 0; left: 4px; width: 1px; background: var(--line); }
+.wd-handle::after { content: ''; position: absolute; top: 50%; left: 2px; width: 5px; height: 36px; margin-top: -18px; border-radius: 3px; background: var(--line); }
+.wd-handle:hover::before, .wd-handle:focus-visible::before { background: var(--info); width: 2px; }
+.wd-dock { min-width: 0; overflow: auto; padding-left: var(--ctl-s2); container-type: inline-size; container-name: wddock; }
+
+.wd-col { display: flex; flex-direction: column; gap: var(--ctl-s2); min-width: 0; padding-bottom: var(--ctl-s4); }
