+/* MOCK-HOOK FILE -- work-redesign mock-ups only. The scaffold's plain layout, on the console's tokens. */
+.wr-root { display: flex; flex-direction: column; gap: var(--ctl-s3); min-width: 0; max-width: 100%; }
+.wr-page { display: flex; flex-direction: column; gap: var(--ctl-s3); min-width: 0; }
+.wr-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ctl-s2); min-width: 0; }
+.wr-col { display: flex; flex-direction: column; gap: var(--ctl-s2); }
+.wr-h { font: 600 var(--t-body) / var(--lh-body) var(--font); margin: 0; color: var(--text); }
+.wr-dim { color: var(--text-dim); font-size: var(--t-meta); }
+.wr-bad { color: var(--bad-ink, var(--s-bad)); margin: 0; }
+.wr-mono { font-family: var(--mono); font-size: var(--t-meta); }
+.wr-region { display: flex; flex-direction: column; gap: var(--ctl-s2); min-width: 0; }
+.wr-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--ctl-s3); align-items: start; }
+@media (max-width: 900px) { .wr-split { grid-template-columns: minmax(0, 1fr); } }
+.wr-inline-agent { position: relative; min-width: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
+.wr-needs { border: 1px solid var(--line); border-radius: var(--radius); padding: var(--ctl-s2) var(--ctl-s3); background: var(--surface); }
+.wr-needs-head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ctl-s2); }
+.wr-needs-list { list-style: none; margin: var(--ctl-s2) 0 0; padding: 0; display: flex; flex-direction: column; gap: var(--ctl-s1); font-size: var(--t-meta); }
+.wr-need-kind { display: inline-block; min-width: 7.5em; color: var(--text-dim); }
+.wr-need-kind.is-failed { color: var(--bad-ink, var(--s-bad)); }
+.wr-wall-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: var(--ctl-s2); }
+.wr-wall-cell { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.wr-wall-big { display: flex; flex-direction: column; gap: var(--ctl-s1); max-width: 960px; }
+.wr-still { margin: 0; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.wr-still-pic { position: relative; display: block; padding: 0; border: 1px solid var(--line); border-radius: var(--ctl-radius-sm, 6px); background: var(--surface-2); cursor: pointer; overflow: hidden; aspect-ratio: 16 / 10; width: 100%; }
+.wr-still-pic img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top left; }
+.wr-still.is-large .wr-still-pic { max-width: 960px; }
+.wr-still-live { position: absolute; top: 6px; left: 6px; background: var(--surface); border-radius: 999px; padding: 0 6px; }
+.wr-still figcaption { display: flex; gap: var(--ctl-s1); align-items: center; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.wr-grid { display: flex; flex-direction: column; gap: var(--ctl-s1); overflow-x: auto; }
+.wr-grid-row { display: grid; grid-template-columns: 7em repeat(10, minmax(84px, 1fr)); gap: 4px; align-items: stretch; }
+.wr-grid-stage { font-size: var(--t-meta); color: var(--text); align-self: center; }
+.wr-cell { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 4px 6px; min-width: 0; border: 1px solid var(--line); border-radius: var(--ctl-radius-sm, 6px); background: var(--surface); color: var(--text); font: inherit; font-size: var(--t-meta); text-align: left; cursor: pointer; }
+.wr-cell.is-running { border-color: var(--s-live); }
+.wr-cell.is-failed { border-color: var(--s-bad); background: var(--s-badb, var(--surface)); }
+.wr-cell.is-parked, .wr-cell.is-queued, .wr-cell.is-unstarted { color: var(--text-dim); }
+.wr-cell.is-selected { outline: 2px solid var(--info); outline-offset: 1px; }
+.wr-cell-name { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.wr-cell-meta { display: flex; gap: 4px; align-items: center; }
+.wr-ask { display: inline-grid; place-items: center; width: 16px; height: 16px; border-radius: 50%; background: var(--s-park); color: var(--surface); font-weight: 600; font-size: 12px; }
+/* The still image where the live canvas goes (LiveBrowser's .live-screen). */
+.live-screen .mock-still { display: block; width: 100%; height: 100%; object-fit: contain; }
+/* A link-styled button inside the scaffold: no box, the link's own colour. */
+.wr-root button.ctl-link { border: 0; background: none; padding: 0; font: inherit; color: var(--info); text-decoration: underline; cursor: pointer; text-align: left; }
+.wr-root button.ctl-link.wr-dim { color: var(--text-dim); }
+/* The console's agent drawer, drawn in the page rather than over it. */
+.wr-inline-agent .drawer.ag-split { position: relative; top: auto; right: auto; bottom: auto; left: auto; width: 100%; max-height: none; z-index: auto; box-shadow: none; }
+.wr-inline-agent .ag-divider, .wr-inline-agent .ag-scrim { display: none; }
