+// MOCK-HOOK FILE -- work-redesign mock-ups only. The URL switches, read once at load.
+//
+// ?wa=<direction>  base | a | b | c | d | e | f   (absent: today's console, untouched)
+// ?ws=<screen>     agents | agent | workflows | workflow   (default: agents)
+// ?wst=<state>     rest | open | watch | needs | logs     (default: rest)
+// ?wid=<id>        optional: the agent (ws=agent) or workflow (ws=workflow) to show;
+//                  defaults to the hard case's running browser agent / design-picks-build
+// ?wfx=off         serve the console's ordinary fixtures instead of the work-redesign dataset
+// The theme is the console's own switch (Profile, or `data-theme` on <html>); the snapshot kit's
+// frames also take ?theme=light|dark.
+//
+// Read ONCE at module load: App rewrites the address to its canonical form on
+// mount, which drops query keys it does not know.
+
+export type WorkDirection = 'base' | 'a' | 'b' | 'c' | 'd' | 'e' | 'f'
+export type WorkScreen = 'agents' | 'agent' | 'workflows' | 'workflow'
+export type WorkState = 'rest' | 'open' | 'watch' | 'needs' | 'logs'
+
+const DIRECTIONS: readonly WorkDirection[] = ['base', 'a', 'b', 'c', 'd', 'e', 'f']
+const SCREENS: readonly WorkScreen[] = ['agents', 'agent', 'workflows', 'workflow']
+const STATES: readonly WorkState[] = ['rest', 'open', 'watch', 'needs', 'logs']
+
+function pick<T extends string>(raw: string | null, allowed: readonly T[], fallback: T): T {
+  return raw !== null && (allowed as readonly string[]).includes(raw) ? (raw as T) : fallback
+}
+
+const q = typeof window === 'undefined' ? new URLSearchParams() : new URLSearchParams(window.location.search)
+const rawWa = q.get('wa')
+
+export const WORK_SWITCHES: {
+  /** null: no ?wa, today's console. */
+  wa: WorkDirection | null
+  ws: WorkScreen
+  wst: WorkState
+  wid: string | null
+} = {
+  wa: rawWa === null ? null : pick(rawWa, DIRECTIONS, 'base'),
+  ws: pick(q.get('ws'), SCREENS, 'agents'),
+  wst: pick(q.get('wst'), STATES, 'rest'),
+  wid: q.get('wid'),
+}
+
+/** The address of one mock-up frame: path `/agents` keeps the spine on Work. */
+export function workMockHref(wa: WorkDirection, ws: WorkScreen, wst: WorkState = 'rest', wid?: string): string {
+  const p = new URLSearchParams({ wa, ws, wst })
+  if (wid !== undefined) p.set('wid', wid)
+  return `/agents?${p.toString()}`
+}
