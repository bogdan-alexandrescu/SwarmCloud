@@ -0,0 +1,47 @@
+// MOCK-HOOK FILE -- work-redesign mock-ups only. The entry App renders for the Work section when ?wa is set.
+//
+// A direction registers its four screens in DIRECTIONS under its letter; a
+// letter with nothing registered falls back to the scaffold (base) and says so.
+import { useState, type ComponentType } from 'react'
+
+import type { AgentList } from '../agentlist'
+import { BaseAgent, BaseAgents, BaseWorkflow, BaseWorkflows, type BaseProps } from './base'
+import { useWorkData, type WorkAt } from './parts'
+import { WORK_SWITCHES, type WorkDirection, type WorkScreen } from './switches'
+
+export type DirectionScreens = Readonly<Record<WorkScreen, ComponentType<BaseProps>>>
+
+const BASE: DirectionScreens = { agents: BaseAgents, agent: BaseAgent, workflows: BaseWorkflows, workflow: BaseWorkflow }
+
+/** Each direction's screens. A direction adds one line here: `a: DIRECTION_A,`. */
+export const DIRECTIONS: Partial<Record<WorkDirection, DirectionScreens>> = {
+  base: BASE,
+}
+
+export function WorkRedesign({ go, list, onList }: { go: (to: string) => void; list: AgentList | null; onList: (list: AgentList) => void }) {
+  const wa = WORK_SWITCHES.wa ?? 'base'
+  const screens = DIRECTIONS[wa] ?? BASE
+  const [at, setAt] = useState<WorkAt>({ screen: WORK_SWITCHES.ws, id: WORK_SWITCHES.wid })
+  // A move inside the mock-up starts the new screen at rest.
+  const [wst, setWst] = useState(WORK_SWITCHES.wst)
+  const data = useWorkData()
+  const Screen = screens[at.screen]
+  return (
+    <div className="wr-root" data-wa={wa} data-ws={at.screen} data-wst={wst}>
+      {DIRECTIONS[wa] === undefined && <p className="wr-dim">Direction {wa} has no screens yet: showing the scaffold.</p>}
+      <Screen
+        data={data}
+        at={at}
+        nav={(to) => {
+          setAt(to)
+          setWst('rest')
+          if (typeof window !== 'undefined') window.scrollTo(0, 0)
+        }}
+        wst={wst}
+        go={go}
+        list={list}
+        onList={onList}
+      />
+    </div>
+  )
+}
diff --git a/apps/swarm-ui/src/workredesign/base.tsx b/apps/swarm-ui/src/workredesign/base.tsx
