@@ -0,0 +1,579 @@
+// MOCK-HOOK FILE -- work-redesign mock-ups only (LANE WORK-REDESIGN-MOCKUPS, 2026-11-02). Never committed.
+//
+// THE WORK SECTION'S MOCK DATASET. Invented data only: people at example.com,
+// repositories `northwind-crm` and `roombook`. When `mockWorkOn()` is true
+// (the fixture dev server, outside vitest, unless `?wfx=off`), api.ts's
+// `fixtureTaskRows()` and `fixtureWorkflowRows()` answer from here instead, so
+// every existing loader -- the Agents list, one agent, attempts, events, the
+// Workflows board, one workflow -- serves the same rows, and today's pages and
+// the redesign directions render the same data.
+//
+// THE HARD CASE, `wf_design_picks_build` ("design-picks-build"): 40 steps in
+// 4 stages of 10 (build, review, fix, re-review, one per feature). The brief's
+// counts (10 running, 25 waiting, 5 done, 1 failed) add to 41, so this file
+// reads them as: 4 succeeded + 1 failed = 5 finished; 10 running browser agents;
+// 25 waiting on earlier steps; and the 2 owner questions are asked by two
+// finished build steps and hold the workflow's merge task (a 41st task of the
+// workflow, profile `merge`, PARKED HUMAN_REQUIRED, park_phase owner_questions),
+// which is also the "merge waiting". One pull request per started step.
+import type { Task, TaskState, Workflow, WorkflowStep } from '../types'
+
+/**
+ * The instant mock times count from: the page's own clock at load, to the minute. NOT api.ts's
+ * FIXTURE_CLOCK: a page on a running clock drew every mock agent as "13 d 16 h" old, which a
+ * layout review cannot read past. Ages and states are deterministic; the wall-clock times are not.
+ */
+export const MOCK_NOW = Math.floor(Date.now() / 60_000) * 60_000
+const at = (minsAgo: number) => new Date(MOCK_NOW - minsAgo * 60_000).toISOString()
+
+function param(name: string): string | null {
+  if (typeof window === 'undefined') return null
+  return new URLSearchParams(window.location.search).get(name)
+}
+
+/** Read ONCE at load, so the app's own canonical rewrite of the address cannot drop a switch mid-session. */
+const WFX = param('wfx')
+
+/** Whether the work-redesign dataset replaces the Work section's fixtures. */
+export function mockWorkOn(): boolean {
+  return import.meta.env.DEV && !import.meta.env.VITE_LIVE && import.meta.env.MODE !== 'test' && WFX !== 'off'
+}
+
+export const MOCK_TENANT = 'u-bogdan'
+export const PEOPLE = {
+  bogdan: 'bogdan@example.com',
+  ana: 'ana.moreau@example.com',
+  kenji: 'kenji.sato@example.com',
+  lea: 'lea.fontaine@example.com',
+  ravi: 'ravi.iyer@example.com',
+} as const
+const OWNERS = [PEOPLE.bogdan, PEOPLE.ana, PEOPLE.kenji, PEOPLE.lea, PEOPLE.ravi]
+
+export const HARD_WF = 'wf_design_picks_build'
+export const HARD_WF_TITLE = 'design-picks-build'
+export const HARD_MERGE_TASK = 'task_dpb_merge'
+export const HARD_STAGES = ['build', 'review', 'fix', 're-review'] as const
+export const HARD_FEATURES = [
+  'login', 'search', 'calendar', 'invoices', 'contacts', 'reports', 'settings', 'booking', 'export', 'onboarding',
+] as const
+export const HARD_SPENT_USD = 13.52
+
+const REPOS = ['https://github.com/example-org/northwind-crm', 'https://github.com/example-org/roombook']
+
+/** A step id of the hard case: `<stage>-<feature>`, stage `re-review` included. */
+export const hardStepId = (stage: string, feature: string) => `${stage}-${feature}`
+export const hardTaskId = (stage: string, feature: string) => `task_dpb_${stage.replace('-', '')}_${feature}`
+
+// --------------------------------------------------------------------------
+// One task, shaped as api.ts's fixture `mk` shapes it
+// --------------------------------------------------------------------------
+
+function mk(id: string, state: TaskState, profile: string, minsAgo: number, extra: Partial<Task> = {}): Task {
+  const terminal = state === 'SUCCEEDED' || state === 'FAILED' || state === 'CANCELLED'
+  const admitted = !(state === 'QUEUED' || state === 'READY' || state === 'SUBMITTED')
+  const live = state === 'LEASED' || state === 'DISPATCHED' || state === 'STARTING' || state === 'RUNNING'
+  const task = {
+    id,
+    tenant_id: MOCK_TENANT,
+    state,
+    runner_profile: profile,
+    resource_class: profile === 'claude-code-browser' ? 'browser' : 'standard',
+    provider: 'anthropic',
+    priority: 0,
+    created_at: at(minsAgo + 6),
+    updated_at: at(terminal ? minsAgo : Math.max(0, Math.min(minsAgo, 2))),
+    started_at: admitted ? at(minsAgo + 4) : null,
+    completed_at: terminal ? at(minsAgo) : null,
+    submitted_by: PEOPLE.bogdan,
+    attempt_count: admitted ? 1 : 0,
+    max_attempts: 3,
+    park_reason: null,
+    blocked_by: null,
+    workflow_id: null,
+    step_id: null,
+    depends_on: null,
+    cancel_requested: false,
+    repository_url: REPOS[0],
+    model: 'claude-opus-5',
+    timeout_seconds: 3600,
+    next_eligible_at: null,
+    metadata: null,
+    repository_ref: 'main',
+    current_generation: admitted ? 1 : 0,
+    current_lease_id: live ? `lease_${id.replace('task_', '')}` : null,
+    dispatch: { strategy: 'direct-pr', carrier: 'checkpoints', role: null, integrates: [] },
+    input: null,
+    last_error: state === 'FAILED' ? 'exit status 1: CI check "e2e / chromium" failed on the pull request' : null,
+    result_summary: state === 'SUCCEEDED' ? { artifacts: 2, checkpoints: 3 } : null,
+    latest_checkpoint: null,
+    ...extra,
+  }
+  return task as unknown as Task
+}
+
+// --------------------------------------------------------------------------
+// The hard case: design-picks-build
+// --------------------------------------------------------------------------
+
+type HardShape = { state: TaskState | null; minsAgo: number; question?: string; costUsd: number }
+
+/** Each step's state, by stage then feature index. null: not started (waiting on an earlier step). */
+function hardShape(stage: number, f: number): HardShape {
+  // build: login, search, calendar succeeded; invoices FAILED (red check); the other six running.
+  if (stage === 0) {
+    if (f < 3) {
+      return {
+        state: 'SUCCEEDED', minsAgo: 40 - f * 6, costUsd: [1.12, 0.98, 1.31][f] ?? 0,
+        question: f === 1 ? 'The search design pick shows filters in a side panel; the brief says a top bar. Which one ships?'
+          : f === 2 ? 'Calendar: week view by default, or month view as in the second pick?' : undefined,
+      }
+    }
+    if (f === 3) return { state: 'FAILED', minsAgo: 18, costUsd: 1.46 }
+    return { state: 'RUNNING', minsAgo: 1, costUsd: [0.71, 0.66, 0.58, 0.49, 0.44, 0.39][f - 4] ?? 0 }
+  }
+  // review: login succeeded; search, calendar running; invoices running (reviewing the red check).
+  if (stage === 1) {
+    if (f === 0) return { state: 'SUCCEEDED', minsAgo: 12, costUsd: 0.62 }
+    if (f <= 3) return { state: 'RUNNING', minsAgo: 1, costUsd: [0, 0.41, 0.37, 0.29][f] ?? 0 }
+    return { state: null, minsAgo: 0, costUsd: 0 }
+  }
+  // fix: login running.
+  if (stage === 2 && f === 0) return { state: 'RUNNING', minsAgo: 1, costUsd: 0.33 }
+  return { state: null, minsAgo: 0, costUsd: 0 }
+}
+// Spend check: 1.12+0.98+1.31+1.46+0.71+0.66+0.58+0.49+0.44+0.39+0.62+0.41+0.37+0.29+0.33 = 10.16;
+// the merge task and the attempts' own usage are not summed here. HARD_SPENT_USD is the brief's figure
+// for the workflow header; MOCK_SPEND below spreads the remaining 3.36 over earlier attempts.
+const MOCK_EARLIER_ATTEMPTS_USD = 3.36
+
+function hardTasks(): Task[] {
+  const out: Task[] = []
+  HARD_STAGES.forEach((stage, si) => {
+    HARD_FEATURES.forEach((feature, f) => {
+      const shape = hardShape(si, f)
+      const stepId = hardStepId(stage, feature)
+      const id = hardTaskId(stage, feature)
+      const deps = si === 0 ? [] : [hardStepId(HARD_STAGES[si - 1]!, feature)]
+      const common: Partial<Task> = {
+        workflow_id: HARD_WF,
+        step_id: stepId,
+        depends_on: deps,
+        submitted_by: PEOPLE.bogdan,
+        repository_url: REPOS[f % 2],
+        metadata: { title: HARD_WF_TITLE },
+        input: { prompt: `${stage} the ${feature} screen from the picked design, in a browser, and open a pull request.` },
+      }
+      if (shape.state === null) {
+        out.push(mk(id, 'PARKED', 'claude-code-browser', 30, {
+          ...common,
+          park_reason: 'DEPENDENCY_INCOMPLETE',
+          attempt_count: 0,
+          current_generation: 0,
+          started_at: null,
+          waiting: { reason: 'DEPENDENCY_INCOMPLETE', summary: `Waiting on 1 earlier step: ${deps[0]}` },
+        } as Partial<Task>))
+        return
+      }
+      const pr = 2400 + si * 10 + f
+      const prState = shape.state === 'SUCCEEDED' ? 'merged' : 'open'
+      const failedCheck = shape.state === 'FAILED'
+      out.push(mk(id, shape.state, 'claude-code-browser', shape.minsAgo, {
+        ...common,
+        cost_usd_total: shape.costUsd > 0 ? shape.costUsd : null,
+        cost_incomplete: shape.state === 'RUNNING',
+        attempts: 1,
+        attempts_with_cost: shape.costUsd > 0 ? 1 : 0,
+        browser_used: true,
+        result_summary: {
+          ...(shape.state === 'SUCCEEDED' ? { artifacts: 2, checkpoints: 3 } : {}),
+          git: {
+            pull_request: { number: pr, url: `https://github.com/example-org/${f % 2 ? 'roombook' : 'northwind-crm'}/pull/${pr}`, state: prState, created: true },
+            checks: failedCheck ? { passed: 6, failed: 1, pending: 0, failed_names: ['e2e / chromium'] } : undefined,
+          },
+        },
+        owner_answers: shape.question
+          ? [{ question_index: 0, question: shape.question, history: [], choice: null, text: null, by: null, at: null }]
+          : undefined,
+      } as Partial<Task>))
+    })
+  })
+  // The merge, held by the two build steps' questions (Handoff.tsx ownerQuestionsHold).
+  out.push(mk(HARD_MERGE_TASK, 'PARKED', 'merge', 9, {
+    workflow_id: HARD_WF,
+    step_id: null,
+    submitted_by: PEOPLE.bogdan,
+    park_reason: 'HUMAN_REQUIRED',
+    metadata: { title: `${HARD_WF_TITLE} merge` },
+    blocked_by: [{
+      reason: 'HUMAN_REQUIRED',
+      park_phase: 'owner_questions',
+      owner_questions: {
+        unreadable: 0,
+        questions: [1, 2].map((f) => ({
+          task_id: hardTaskId('build', HARD_FEATURES[f]!),
+          step_id: hardStepId('build', HARD_FEATURES[f]!),
+          question_index: 0,
+          question: hardShape(0, f).question,
+        })),
+      },
+    }],
+    waiting: { reason: 'HUMAN_REQUIRED', summary: 'Merge held: 2 owner questions are not answered' },
+  } as Partial<Task>))
+  return out
+}
+
+// --------------------------------------------------------------------------
+// The rest of the Agents list: 34 live (18 browsers), 86 waiting, 110 recent
+// --------------------------------------------------------------------------
+
+const TOPICS = [
+  'Fix flaky invoice export', 'Add contact merge', 'Upgrade booking API client', 'Audit room permissions',
+  'Translate onboarding emails', 'Speed up search index', 'Check signup form on phones', 'Rename CRM fields',
+  'Write reports smoke test', 'Patch calendar timezone bug', 'Review accessibility of settings', 'Clean old feature flags',
+]
+const WAIT_REASONS: Array<{ reason: string; summary: string; park: string | null; state: TaskState }> = [
+  { reason: 'QUEUED', summary: 'In line for a standard runner: 4th of 9', park: null, state: 'QUEUED' },
+  { reason: 'READY_CAPACITY', summary: 'tenant:u-bogdan 20/20 units: waiting for a slot', park: null, state: 'READY' },
+  { reason: 'PROVIDER_QUOTA_EXHAUSTED', summary: 'Claude plan quota used up; resumes 13:10', park: 'PROVIDER_QUOTA_EXHAUSTED', state: 'PARKED' },
+  { reason: 'CI_PENDING', summary: 'CI on PR #2391: 5 checks pending; next check 12:04', park: 'CI_PENDING', state: 'PARKED' },
+  { reason: 'SCHEDULED_RETRY', summary: 'Retry 2 of 3 at 12:06 after "pytest collected 2 failures"', park: 'SCHEDULED_RETRY', state: 'PARKED' },
+  { reason: 'AWAITING_INPUT', summary: 'Asked the owner a question 14 minutes ago', park: 'AWAITING_INPUT', state: 'PARKED' },
+]
+const LIVE_STATES: TaskState[] = ['RUNNING', 'RUNNING', 'RUNNING', 'STARTING', 'DISPATCHED', 'LEASED']
+const RECENT_STATES: TaskState[] = ['SUCCEEDED', 'SUCCEEDED', 'SUCCEEDED', 'SUCCEEDED', 'FAILED', 'CANCELLED']
+
+function hex(n: number): string {
+  // Deterministic, id-shaped: 8 hex digits from n.
+  let x = (n + 1) * 2654435761
+  x = (x ^ (x >>> 15)) >>> 0
+  return x.toString(16).padStart(8, '0').slice(0, 8)
+}
+
+function otherTasks(): Task[] {
+  const out: Task[] = []
+  // Live: 24 more, 8 of them browsers (with the hard case's 10, 34 live and 18 browsers).
+  for (let i = 0; i < 24; i += 1) {
+    const browser = i < 8
+    const state = browser ? (i === 7 ? 'STARTING' : 'RUNNING') : LIVE_STATES[i % LIVE_STATES.length]
+    const extra: Partial<Task> = {
+      submitted_by: OWNERS[i % OWNERS.length],
+      repository_url: REPOS[i % 2],
+      metadata: { title: `${TOPICS[i % TOPICS.length]}${browser ? ' (browser)' : ''}` },
+      cost_usd_total: state === 'RUNNING' ? Math.round((0.2 + (i % 7) * 0.31) * 100) / 100 : null,
+      cost_incomplete: true,
+      browser_used: browser ? true : null,
+    }
+    // One browser agent asks for a person at its browser: a hand-off (Handoff.tsx).
+    if (i === 2) {
+      Object.assign(extra, {
+        human_wait: { reason: 'Sign in to the staging admin with a two-factor code', expect: 'admin.roombook.example.com',
+          requested_at: at(3), deadline: at(-27), controller: null },
+      })
+    }
+    out.push(mk(`task_${hex(i)}`, state as TaskState, browser ? 'claude-code-browser' : 'claude-code', 2 + i, extra))
+  }
+  // Waiting: 30 more (with the hard case's 25, its merge task and the small workflows' 30 waiting steps, 86 waiting).
+  for (let i = 0; i < 30; i += 1) {
+    const w = WAIT_REASONS[i % WAIT_REASONS.length]!
+    out.push(mk(`task_${hex(100 + i)}`, w.state, i % 5 === 0 ? 'claude-code-browser' : 'claude-code', 8 + i * 3, {
+      submitted_by: OWNERS[i % OWNERS.length],
+      repository_url: REPOS[i % 2],
+      park_reason: w.park,
+      next_eligible_at: w.state === 'PARKED' ? at(-6) : null,
+      metadata: { title: TOPICS[(i + 3) % TOPICS.length] },
+      waiting: { reason: w.reason, summary: w.summary },
+      attempt_count: w.state === 'PARKED' ? 1 : 0,
+      current_generation: w.state === 'PARKED' ? 1 : 0,
+      started_at: w.state === 'PARKED' ? at(10 + i * 3) : null,
+    } as Partial<Task>))
+  }
+  // Recent: 110 finished over the last two days.
+  for (let i = 0; i < 110; i += 1) {
+    const state = RECENT_STATES[i % RECENT_STATES.length]!
+    out.push(mk(`task_${hex(300 + i)}`, state, i % 4 === 0 ? 'claude-code-browser' : 'claude-code', 50 + i * 25, {
+      submitted_by: OWNERS[i % OWNERS.length],
+      repository_url: REPOS[i % 2],
+      metadata: { title: TOPICS[(i + 5) % TOPICS.length] },
+      cost_usd_total: Math.round((0.15 + (i % 11) * 0.27) * 100) / 100,
+      cost_incomplete: false,
+      attempts: 1,
+      attempts_with_cost: 1,
+      browser_used: i % 4 === 0,
+    } as Partial<Task>))
+  }
+  return out
+}
+
+// --------------------------------------------------------------------------
+// Workflows: the hard case and 39 more across running, parked, failed, done
+// --------------------------------------------------------------------------
+
+const WF_NAMES = [
+  'nightly-crm-audit', 'roombook-a11y-sweep', 'invoice-export-fix', 'contacts-dedupe', 'search-speedup',
+  'release-notes-draft', 'pricing-page-qa', 'calendar-tz-fix', 'onboarding-copy', 'reports-smoke',
+]
+
+/** Small workflows' step tasks: a chain of 3, states chosen by the workflow's bucket. */
+function smallWorkflows(): { workflows: Workflow[]; tasks: Task[] } {
+  const workflows: Workflow[] = []
+  const tasks: Task[] = []
+  const BUCKETS: Array<{ wf: string; steps: TaskState[] }> = [
+    { wf: 'RUNNING', steps: ['SUCCEEDED', 'RUNNING', 'QUEUED'] },
+    { wf: 'PARKED', steps: ['SUCCEEDED', 'PARKED', 'QUEUED'] },
+    { wf: 'FAILED', steps: ['SUCCEEDED', 'FAILED', 'CANCELLED'] },
+    { wf: 'SUCCEEDED', steps: ['SUCCEEDED', 'SUCCEEDED', 'SUCCEEDED'] },
+  ]
+  for (let i = 0; i < 39; i += 1) {
+    const bucket = BUCKETS[i % 4]!
+    const id = `wf_${hex(700 + i)}${hex(800 + i)}`
+    const title = `${WF_NAMES[i % WF_NAMES.length]}${i >= WF_NAMES.length ? `-${Math.floor(i / WF_NAMES.length) + 1}` : ''}`
+    const stepIds = ['plan', 'do', 'check']
+    const minsAgo = 30 + i * 70
+    const steps: WorkflowStep[] = stepIds.map((s, k) => {
+      const tid = `task_${hex(900 + i * 3 + k)}`
+      const st = bucket.steps[k]!
+      // Live steps of these workflows are not on the Agents list's counts: they are terminal or waiting.
+      const state: TaskState = st === 'RUNNING' ? 'SUCCEEDED' : st
+      tasks.push(mk(tid, state, k === 1 && i % 3 === 0 ? 'claude-code-browser' : 'claude-code', minsAgo - k * 10, {
+        workflow_id: id, step_id: s, depends_on: k === 0 ? [] : [stepIds[k - 1]],
+        submitted_by: OWNERS[i % OWNERS.length], metadata: { title },
+        repository_url: REPOS[i % 2],
+        park_reason: state === 'PARKED' ? 'CI_PENDING' : null,
+        waiting: state === 'PARKED' ? { reason: 'CI_PENDING', summary: 'CI on the pull request: 3 checks pending' }
+          : state === 'QUEUED' ? { reason: 'DEPENDENCY_INCOMPLETE', summary: `Waiting on 1 earlier step: ${stepIds[k - 1]}` } : undefined,
+        cost_usd_total: state === 'SUCCEEDED' || state === 'FAILED' ? 0.4 + k * 0.2 : null,
+      } as Partial<Task>))
+      return {
+        step_id: s, runner_profile: 'claude-code', resource_class: 'standard',
+        depends_on: k === 0 ? [] : [stepIds[k - 1]], input_from: {}, timeout_seconds: 3600, task_id: tid,
+        input: { prompt: `${s} for ${title}` },
+      } as WorkflowStep
+    })
+    workflows.push(wfDoc(id, bucket.wf, steps, OWNERS[i % OWNERS.length]!, at(minsAgo + 6), at(Math.max(1, minsAgo - 25))))
+  }
+  return { workflows, tasks }
+}
+
+function wfDoc(id: string, state: string, steps: WorkflowStep[], by: string, created: string, updated: string,
+  extra: Partial<Workflow> = {}): Workflow {
+  return {
+    workflow_id: id,
+    tenant_id: MOCK_TENANT,
+    state,
+    stored_state: state,
+    state_source: 'derived',
+    rollup: {
+      state, complete: true, reason: null, counts: {}, unreadable_steps: [],
+      unstarted_steps: steps.filter((s) => !s.task_id).map((s) => s.step_id), steps_read: steps.length,
+    },
+    drift: { stored: state, derived: state, agrees: true, reason: null, steps_read: steps.length, unreadable_steps: [], repaired: false },
+    created_at: created,
+    updated_at: updated,
+    submitted_by: by,
+    priority: 0,
+    on_step_failure: 'CONTINUE',
+    cancel_requested: false,
+    steps,
+    ...extra,
+  } as unknown as Workflow
+}
+
+function hardWorkflow(): Workflow {
+  const steps: WorkflowStep[] = []
+  HARD_STAGES.forEach((stage, si) => {
+    HARD_FEATURES.forEach((feature) => {
+      const deps = si === 0 ? [] : [hardStepId(HARD_STAGES[si - 1]!, feature)]
+      steps.push({
+        step_id: hardStepId(stage, feature),
+        runner_profile: 'claude-code-browser',
+        resource_class: 'browser',
+        depends_on: deps,
+        input_from: si === 0 ? {} : { [deps[0]!]: 'report.md' },
+        timeout_seconds: 5400,
+        task_id: hardTaskId(stage, feature),
+        input: { prompt: `${stage} the ${feature} screen from the picked design, in a browser, and open a pull request.` },
+      } as WorkflowStep)
+    })
+  })
+  return wfDoc(HARD_WF, 'RUNNING', steps, PEOPLE.bogdan, at(52), at(1), {
+    after_pull_requests: { pull_requests: [2401, 2402], state: 'waiting' } as unknown as Workflow['after_pull_requests'],
+  })
+}
+
+// --------------------------------------------------------------------------
+// What api.ts reads
+// --------------------------------------------------------------------------
+
+let cache: { tasks: Task[]; workflows: Workflow[] } | null = null
+
+function build(): { tasks: Task[]; workflows: Workflow[] } {
+  if (cache !== null) return cache
+  const small = smallWorkflows()
+  const tasks = [...hardTasks(), ...otherTasks(), ...small.tasks]
+  const byId = new Map(tasks.map((t) => [t.id, t]))
+  const workflows = [hardWorkflow(), ...small.workflows].map((w) => {
+    const counts: Record<string, number> = {}
+    for (const st of w.steps) {
+      const key = !st.task_id ? 'unstarted' : (byId.get(st.task_id)?.state ?? 'unreadable')
+      counts[key] = (counts[key] ?? 0) + 1
+    }
+    return { ...w, rollup: w.rollup ? { ...w.rollup, counts } : w.rollup } as Workflow
+  })
+  cache = { tasks, workflows }
+  return cache
+}
+
+/** Every mock task: the hard case's 41, 24 live, 30 waiting, 110 recent, and 117 small-workflow steps. */
+export function mockTaskRows(): Task[] {
+  return build().tasks
+}
+
+/** Every mock workflow: the hard case first, then 39 across running, parked, failed and done. */
+export function mockWorkflowRows(): Workflow[] {
+  return build().workflows
+}
+
+export const MOCK_SPEND = { workflowUsd: HARD_SPENT_USD, earlierAttemptsUsd: MOCK_EARLIER_ATTEMPTS_USD }
+
+/** Whether a mock task has a live browser session (a RUNNING browser agent). */
+export function mockLiveTask(taskId: string): boolean {
+  if (!mockWorkOn()) return false
+  const t = build().tasks.find((x) => x.id === taskId)
+  return t !== undefined && t.runner_profile === 'claude-code-browser' && t.state === 'RUNNING'
+}
+
+const PRESETS = ['desktop', 'desktop', 'iphone-15', 'desktop', 'ipad-7', 'desktop', 'pixel-8'] as const
+
+/** The device a mock browser agent's session reports, deterministic per id. */
+export function mockDevice(taskId: string): { preset: string; orientation: 'portrait' | 'landscape'; touch: boolean } {
+  const preset = PRESETS[stillIndex(taskId) % PRESETS.length]!
+  const mobile = preset !== 'desktop'
+  return { preset, orientation: mobile && preset !== 'ipad-7' ? 'portrait' : preset === 'ipad-7' ? 'portrait' : 'landscape', touch: mobile }
+}
+
+// --------------------------------------------------------------------------
+// The browser agents' still images: a plausible page per agent, as SVG
+// --------------------------------------------------------------------------
+
+function stillIndex(taskId: string): number {
+  let h = 0
+  for (const c of taskId) h = (h * 31 + c.charCodeAt(0)) >>> 0
+  return h
+}
+
+const KINDS = ['form', 'table', 'dashboard', 'calendar', 'login', 'kanban'] as const
+export type StillKind = (typeof KINDS)[number]
+
+export function stillKind(taskId: string): StillKind {
+  // The hard case draws the page its feature names, so a wall of them reads as different screens.
+  const f = HARD_FEATURES.findIndex((x) => taskId.endsWith(`_${x}`) && taskId.startsWith('task_dpb_'))
+  if (f >= 0) return (['login', 'table', 'calendar', 'table', 'form', 'dashboard', 'form', 'calendar', 'table', 'kanban'] as const)[f]!
+  return KINDS[stillIndex(taskId) % KINDS.length]!
+}
+
+const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;')
+
+function stillBody(kind: StillKind, w: number, h: number, seed: number): string {
+  const r = (i: number) => ((seed >>> (i % 24)) % 7) / 7
+  const parts: string[] = []
+  const rect = (x: number, y: number, ww: number, hh: number, fill: string, rx = 4) =>
+    parts.push(`<rect x="${x}" y="${y}" width="${ww}" height="${hh}" rx="${rx}" fill="${fill}"/>`)
+  const text = (x: number, y: number, s: string, size = 14, fill = '#1f2933', weight = 400) =>
+    parts.push(`<text x="${x}" y="${y}" font-family="Inter, Arial, sans-serif" font-size="${size}" font-weight="${weight}" fill="${fill}">${esc(s)}</text>`)
+  const top = 56
+  if (kind === 'login') {
+    const cx = w / 2 - 170
+    rect(cx, 150, 340, 330, '#ffffff', 10)
+    text(cx + 30, 200, 'Sign in to Northwind CRM', 20, '#111827', 600)
+    text(cx + 30, 245, 'Email', 13, '#4b5563'); rect(cx + 30, 255, 280, 38, '#f3f4f6')
+    text(cx + 42, 279, 'ana.moreau@example.com', 13, '#374151')
+    text(cx + 30, 320, 'Password', 13, '#4b5563'); rect(cx + 30, 330, 280, 38, '#f3f4f6')
+    rect(cx + 30, 395, 280, 42, '#2563eb', 6); text(cx + 140, 421, 'Sign in', 15, '#ffffff', 600)
+  } else if (kind === 'table') {
+    text(32, top + 44, 'Invoices', 22, '#111827', 600)
+    rect(w - 180, top + 22, 148, 34, '#2563eb', 6); text(w - 160, top + 44, 'New invoice', 14, '#fff', 600)
+    const cols = ['Number', 'Customer', 'Due', 'Amount', 'Status']
+    rect(32, top + 72, w - 64, 36, '#eef2f7', 0)
+    cols.forEach((c, i) => text(48 + i * ((w - 96) / 5), top + 95, c, 13, '#4b5563', 600))
+    for (let row = 0; row < 12; row += 1) {
+      const y = top + 108 + row * 40
+      if (y > h - 40) break
+      rect(32, y, w - 64, 40, row % 2 ? '#ffffff' : '#fafbfc', 0)
+      const vals = [`INV-${1040 + row}`, ['Kenji Sato', 'Ana Moreau', 'Roombook Ltd', 'Lea Fontaine'][row % 4] ?? '', `Oct ${10 + row}`,
+        `$${(120 + row * 37 + Math.round(r(row) * 90)).toFixed(2)}`, row % 3 === 0 ? 'Overdue' : 'Paid']
+      vals.forEach((v: string, i: number) => text(48 + i * ((w - 96) / 5), y + 25, v, 13, i === 4 && row % 3 === 0 ? '#b91c1c' : '#1f2933'))
+    }
+  } else if (kind === 'dashboard') {
+    text(32, top + 44, 'Reports', 22, '#111827', 600)
+    const cw = (w - 64 - 48) / 4
+    ;['Revenue', 'New contacts', 'Bookings', 'Churn'].forEach((label, i) => {
+      rect(32 + i * (cw + 16), top + 68, cw, 92, '#ffffff', 8)
+      text(48 + i * (cw + 16), top + 96, label, 13, '#6b7280')
+      text(48 + i * (cw + 16), top + 136, ['$48.2k', '312', '1,094', '2.1%'][i] ?? '', 26, '#111827', 600)
+    })
+    rect(32, top + 180, w - 64, h - top - 220, '#ffffff', 8)
+    const bars = 18
+    const bw = (w - 128) / bars
+    for (let i = 0; i < bars; i += 1) {
+      const bh = 40 + ((seed >>> (i % 20)) % 9) * 22
+      rect(64 + i * bw, h - 70 - bh, bw * 0.6, bh, '#60a5fa', 2)
+    }
+  } else if (kind === 'calendar') {
+    text(32, top + 44, 'Roombook: October', 22, '#111827', 600)
+    const gw = (w - 64) / 7
+    const gh = (h - top - 110) / 5
+    ;['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].forEach((d, i) => text(40 + i * gw, top + 80, d, 13, '#6b7280', 600))
+    for (let i = 0; i < 35; i += 1) {
+      const x = 32 + (i % 7) * gw
+      const y = top + 92 + Math.floor(i / 7) * gh
+      rect(x + 2, y + 2, gw - 4, gh - 4, '#ffffff', 4)
+      text(x + 10, y + 22, String((i % 31) + 1), 12, '#9ca3af')
+      if ((seed >>> (i % 23)) % 4 === 0) { rect(x + 8, y + 32, gw - 20, 20, '#c7d2fe', 4); text(x + 14, y + 46, 'Room A', 12, '#3730a3') }
+    }
+  } else if (kind === 'kanban') {
+    text(32, top + 44, 'Onboarding', 22, '#111827', 600)
+    const cw = (w - 64 - 32) / 3
+    ;['To do', 'Doing', 'Done'].forEach((c, i) => {
+      rect(32 + i * (cw + 16), top + 68, cw, h - top - 100, '#eef2f7', 8)
+      text(48 + i * (cw + 16), top + 94, c, 14, '#374151', 600)
+      for (let k = 0; k < 4 - i; k += 1) {
+        rect(44 + i * (cw + 16), top + 110 + k * 76, cw - 24, 64, '#ffffff', 6)
+        text(56 + i * (cw + 16), top + 136 + k * 76, TOPICS[(seed + i * 3 + k) % TOPICS.length]!.slice(0, 26), 13)
+      }
+    })
+  } else {
+    text(32, top + 44, 'New contact', 22, '#111827', 600)
+    ;['Full name', 'Email', 'Company', 'Phone', 'Notes'].forEach((label, i) => {
+      text(32, top + 90 + i * 72, label, 13, '#4b5563')
+      rect(32, top + 100 + i * 72, Math.min(520, w - 64), i === 4 ? 60 : 38, '#ffffff')
+      const v = ['Kenji Sato', 'kenji.sato@example.com', 'Northwind', '', ''][i]
+      if (v) text(44, top + 124 + i * 72, v, 13, '#1f2933')
+    })
+    rect(32, top + 470, 120, 40, '#2563eb', 6); text(62, top + 495, 'Save', 15, '#fff', 600)
+  }
+  return parts.join('')
+}
+
+const stillCache = new Map<string, string>()
+
+/** A data: URL of the still image drawn where the live canvas goes, or null when the task has no live browser. */
+export function mockStillUrl(taskId: string, mobile = false): string | null {
+  if (!mockLiveTask(taskId)) return null
+  const key = `${taskId}:${mobile}`
+  const hit = stillCache.get(key)
+  if (hit !== undefined) return hit
+  const [w, h] = mobile ? [393, 852] : [1440, 900]
+  const seed = stillIndex(taskId)
+  const kind = stillKind(taskId)
+  const host = taskId.startsWith('task_dpb_') ? 'staging.northwind-crm.example.com' : 'app.roombook.example.com'
+  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">`
+    + `<rect width="${w}" height="${h}" fill="#f5f7fa"/>`
+    + `<rect width="${w}" height="44" fill="#ffffff"/><rect y="44" width="${w}" height="1" fill="#e5e7eb"/>`
+    + `<circle cx="22" cy="22" r="8" fill="#2563eb"/>`
+    + `<text x="40" y="27" font-family="Inter, Arial, sans-serif" font-size="13" fill="#6b7280">${host}</text>`
+    + stillBody(kind, w, h, seed)
+    + `</svg>`
+  const url = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`
+  stillCache.set(key, url)
+  return url
+}
