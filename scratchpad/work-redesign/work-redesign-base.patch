@@ -0,0 +1,329 @@
+// MOCK-HOOK FILE -- work-redesign mock-ups only. Shared building blocks every direction can reuse.
+//
+// Everything reads through the console's own api.ts loaders, which the
+// work-redesign dataset (fixtures.ts) answers; nothing here calls a service.
+import { useEffect, useMemo, useState, type ReactNode } from 'react'
+
+import { loadTasks, loadWorkflowBoard } from '../api'
+import { Chip, Count, LiveChip, StatePill } from '../components'
+import { ownerQuestionsHold, handoffOf } from '../Handoff'
+import { CONCURRENCY_STATES, TERMINAL_STATES, WAITING_STATES, type Task, type Workflow } from '../types'
+import { MOCK_NOW, mockStillUrl, HARD_WF, HARD_SPENT_USD } from './fixtures'
+import type { WorkScreen } from './switches'
+import './workredesign.css'
+
+// --------------------------------------------------------------------------
+// Navigation inside the mock-up: one click, context kept
+// --------------------------------------------------------------------------
+
+/** Where a mock-up screen is: the screen and the agent or workflow it shows. */
+export type WorkAt = { screen: WorkScreen; id: string | null }
+export type WorkNav = (to: WorkAt) => void
+
+// --------------------------------------------------------------------------
+// The data every screen reads: the whole task list and the workflow board
+// --------------------------------------------------------------------------
+
+export type WorkData =
+  | { status: 'loading' }
+  | { status: 'error'; why: string }
+  | { status: 'ok'; tasks: Task[]; taskById: Map<string, Task>; workflows: Workflow[] }
+
+/** The Agents list's page and the Workflows board, read once. */
+export function useWorkData(): WorkData {
+  const [data, setData] = useState<WorkData>({ status: 'loading' })
+  useEffect(() => {
+    let live = true
+    void Promise.all([loadTasks(500, { view: 'summary' }), loadWorkflowBoard()]).then(([t, w]) => {
+      if (!live) return
+      if (t.status !== 'ok' || w.status !== 'ok') {
+        setData({ status: 'error', why: t.status === 'error' ? t.error.message : w.status === 'error' ? w.error.message : 'nothing was read' })
+        return
+      }
+      const tasks = t.data.tasks
+      setData({ status: 'ok', tasks, taskById: new Map(tasks.map((x) => [x.id, x])), workflows: w.data.workflows })
+    })
+    return () => {
+      live = false
+    }
+  }, [])
+  return data
+}
+
+/** The three lists' counts, as the Agents list splits them. */
+export function splitCounts(tasks: Task[]): { live: number; waiting: number; recent: number; browsers: number } {
+  let live = 0, waiting = 0, recent = 0, browsers = 0
+  for (const t of tasks) {
+    if (CONCURRENCY_STATES.has(t.state)) {
+      live += 1
+      if (t.runner_profile === 'claude-code-browser') browsers += 1
+    } else if (WAITING_STATES.has(t.state)) waiting += 1
+    else if (TERMINAL_STATES.has(t.state)) recent += 1
+  }
+  return { live, waiting, recent, browsers }
+}
+
+// --------------------------------------------------------------------------
+// What needs Bogdan: failed steps, owner questions, merges waiting, hand-offs, approvals
+// --------------------------------------------------------------------------
+
+export type NeedItem = {
+  kind: 'failed' | 'question' | 'merge' | 'handoff' | 'approval'
+  /** One line: what, where. */
+  label: string
+  taskId: string | null
+  workflowId: string | null
+}
+
+export const NEED_WORD: Readonly<Record<NeedItem['kind'], string>> = {
+  failed: 'Failed',
+  question: 'Question',
+  merge: 'Merge waiting',
+  handoff: 'Your turn in a browser',
+  approval: 'Approval',
+}
+
+/** Every item that waits on the owner, newest first, from the task list alone. */
+export function needsYou(tasks: Task[], workflowId: string | null = null): NeedItem[] {
+  const out: NeedItem[] = []
+  const inScope = (t: Task) => workflowId === null || t.workflow_id === workflowId
+  for (const t of tasks) {
+    if (!inScope(t)) continue
+    const hold = ownerQuestionsHold(t)
+    if (hold !== null) {
+      for (const q of hold.questions) {
+        out.push({ kind: 'question', label: `${q.step_id ?? q.task_id}: ${q.question ?? 'question not readable'}`, taskId: q.task_id, workflowId: t.workflow_id })
+      }
+      out.push({ kind: 'merge', label: `${t.metadata?.title ?? t.id}: held by ${hold.questions.length} questions`, taskId: t.id, workflowId: t.workflow_id })
+      continue
+    }
+    if (t.state === 'PARKED' && t.park_reason === 'AWAITING_INPUT') {
+      out.push({ kind: 'question', label: `${t.metadata?.title ?? t.id}: asked a question`, taskId: t.id, workflowId: t.workflow_id })
+    }
+    if (t.state === 'FAILED' && t.workflow_id !== null && t.workflow_id !== undefined) {
+      out.push({ kind: 'failed', label: `${t.step_id ?? t.id}: ${t.last_error ?? 'failed'}`, taskId: t.id, workflowId: t.workflow_id })
+    }
+    if (handoffOf(t) !== null) {
+      out.push({ kind: 'handoff', label: `${t.metadata?.title ?? t.id}: ${t.human_wait?.reason ?? 'asks for a person'}`, taskId: t.id, workflowId: t.workflow_id })
+    }
+  }
+  return out
+}
+
+/** The needs-you strip: counts per kind, then (open) one line per item. Approvals are not in this dataset and say so. */
+export function NeedsYou({ items, open, nav }: { items: NeedItem[]; open: boolean; nav: WorkNav }) {
+  const kinds: NeedItem['kind'][] = ['failed', 'question', 'merge', 'handoff']
+  return (
+    <section className="wr-needs" aria-label="Needs you">
+      <div className="wr-needs-head">
+        <h2 className="wr-h">Needs you</h2>
+        {kinds.map((k) => (
+          <Chip key={k} tone={k === 'failed' ? 'bad' : 'park'}>
+            {NEED_WORD[k]} <b>{items.filter((i) => i.kind === k).length}</b>
+          </Chip>
+        ))}
+        <Chip faint title="Approvals are read on Automate › Approvals; this mock-up's dataset has none to count.">
+          Approvals <b>not read here</b>
+        </Chip>
+      </div>
+      {open && (
+        <ul className="wr-needs-list">
+          {items.map((i, n) => (
+            <li key={n}>
+              <span className={`wr-need-kind is-${i.kind}`}>{NEED_WORD[i.kind]}</span>{' '}
+              {i.taskId !== null ? (
+                <button type="button" className="ctl-link" onClick={() => nav({ screen: 'agent', id: i.taskId })}>
+                  {i.label}
+                </button>
+              ) : (
+                i.label
+              )}
+              {i.workflowId && (
+                <>
+                  {' '}
+                  <button type="button" className="ctl-link wr-dim" onClick={() => nav({ screen: 'workflow', id: i.workflowId })}>
+                    workflow
+                  </button>
+                </>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  )
+}
+
+// --------------------------------------------------------------------------
+// Browser agents: the still image drawn where the live canvas goes
+// --------------------------------------------------------------------------
+
+/** One browser agent's picture, marked live as the console marks it, with its name under it. */
+export function BrowserStill({ task, nav, size = 'thumb' }: { task: Task; nav: WorkNav; size?: 'thumb' | 'large' }) {
+  const url = mockStillUrl(task.id)
+  return (
+    <figure className={`wr-still is-${size}`}>
+      <button type="button" className="wr-still-pic" onClick={() => nav({ screen: 'agent', id: task.id })} aria-label={`Open ${task.step_id ?? task.id}`}>
+        {url !== null ? <img src={url} alt={`${task.step_id ?? task.id}: still image of its browser page`} /> : <span className="wr-dim">No picture: not a live browser.</span>}
+        {url !== null && (
+          <span className="wr-still-live">
+            <LiveChip />
+          </span>
+        )}
+      </button>
+      <figcaption>
+        <span className="wr-mono">{task.step_id ?? task.id}</span>
+        {task.human_wait ? <Chip tone="park">your turn</Chip> : null}
+      </figcaption>
+    </figure>
+  )
+}
+
+/** Several browser agents at once; one of them large on demand. */
+export function BrowserWall({ tasks, nav, large = null }: { tasks: Task[]; nav: WorkNav; large?: string | null }) {
+  const [big, setBig] = useState<string | null>(large)
+  const live = tasks.filter((t) => t.runner_profile === 'claude-code-browser' && t.state === 'RUNNING')
+  const bigTask = live.find((t) => t.id === big) ?? null
+  return (
+    <section className="wr-wall" aria-label="Live browsers">
+      <div className="wr-row">
+        <h2 className="wr-h">Live browsers</h2>
+        <Count n={live.length} label="running browser agents" bare />
+      </div>
+      {bigTask && (
+        <div className="wr-wall-big">
+          <BrowserStill task={bigTask} nav={nav} size="large" />
+          <button type="button" className="ctl-link" onClick={() => setBig(null)}>Make it small again</button>
+        </div>
+      )}
+      <div className="wr-wall-grid">
+        {live.map((t) => (
+          <div key={t.id} className="wr-wall-cell">
+            <BrowserStill task={t} nav={nav} />
+            <button type="button" className="ctl-link" onClick={() => setBig(t.id)}>Watch large</button>
+          </div>
+        ))}
+      </div>
+    </section>
+  )
+}
+
+// --------------------------------------------------------------------------
+// A big workflow at a glance: one row per stage, one cell per step
+// --------------------------------------------------------------------------
+
+/** Each step's stage: the length of its longest chain of dependencies. */
+export function stagesOf(w: Workflow): string[][] {
+  const depth = new Map<string, number>()
+  const byId = new Map(w.steps.map((s) => [s.step_id, s]))
+  const d = (id: string, seen: Set<string>): number => {
+    const hit = depth.get(id)
+    if (hit !== undefined) return hit
+    if (seen.has(id)) return 0
+    seen.add(id)
+    const s = byId.get(id)
+    const v = s === undefined || s.depends_on.length === 0 ? 0 : 1 + Math.max(...s.depends_on.map((x) => d(x, seen)))
+    depth.set(id, v)
+    return v
+  }
+  const rows: string[][] = []
+  for (const s of w.steps) {
+    const k = d(s.step_id, new Set())
+    ;(rows[k] ??= []).push(s.step_id)
+  }
+  return rows
+}
+
+/** The stage grid: every step a cell with its state, its pull request and a mark for what needs you. */
+export function StageGrid({ workflow, taskById, nav, selected = null, onSelect }: {
+  workflow: Workflow
+  taskById: Map<string, Task>
+  nav: WorkNav
+  selected?: string | null
+  onSelect?: (stepId: string) => void
+}) {
+  const rows = stagesOf(workflow)
+  const stepById = new Map(workflow.steps.map((s) => [s.step_id, s]))
+  const stageName = (k: number, ids: string[]) => {
+    const prefix = ids[0]?.split('-').slice(0, -1).join('-')
+    return prefix && ids.every((i) => i.startsWith(`${prefix}-`)) ? prefix : `Stage ${k + 1}`
+  }
+  return (
+    <div className="wr-grid" role="table" aria-label={`${workflow.steps.length} steps by stage`}>
+      {rows.map((ids, k) => (
+        <div key={k} className="wr-grid-row" role="row">
+          <span className="wr-grid-stage" role="rowheader">
+            {stageName(k, ids)} <span className="wr-dim">{ids.length}</span>
+          </span>
+          {ids.map((id) => {
+            const step = stepById.get(id)
+            const task = step?.task_id ? taskById.get(step.task_id) : undefined
+            const pr = (task?.result_summary as { git?: { pull_request?: { number: number } } } | null)?.git?.pull_request?.number
+            const asks = (task?.owner_answers ?? []).some((a) => a.choice === null && a.text === null)
+            return (
+              <button
+                key={id}
+                type="button"
+                role="cell"
+                className={`wr-cell is-${(task?.state ?? 'unstarted').toLowerCase()}${selected === id ? ' is-selected' : ''}`}
+                aria-pressed={selected === id}
+                onClick={() => (onSelect ? onSelect(id) : task && nav({ screen: 'agent', id: task.id }))}
+                title={`${id}: ${task ? task.state.toLowerCase() : 'not started'}${pr ? `, pull request #${pr}` : ''}`}
+              >
+                <span className="wr-cell-name">{id.split('-').slice(-1)[0]}</span>
+                <span className="wr-cell-meta">
+                  {task ? <StatePill state={task.state} form="mark" /> : <span className="wr-dim">not started</span>}
+                  {pr ? <span className="wr-mono">#{pr}</span> : null}
+                  {asks ? <span className="wr-ask" aria-label="Open owner question">?</span> : null}
+                </span>
+              </button>
+            )
+          })}
+        </div>
+      ))}
+    </div>
+  )
+}
+
+// --------------------------------------------------------------------------
+// Small pieces
+// --------------------------------------------------------------------------
+
+/** A workflow's spend: the hard case carries the brief's figure; elsewhere the steps' summed cost, or not known. */
+export function workflowSpend(w: Workflow, taskById: Map<string, Task>): string {
+  if (w.workflow_id === HARD_WF) return `$${HARD_SPENT_USD.toFixed(2)}`
+  let sum = 0, known = 0
+  for (const s of w.steps) {
+    const c = s.task_id ? taskById.get(s.task_id)?.cost_usd_total : null
+    if (typeof c === 'number') {
+      sum += c
+      known += 1
+    }
+  }
+  return known === 0 ? 'not known' : `$${sum.toFixed(2)}${known < w.steps.length ? ' so far' : ''}`
+}
+
+/** Minutes since an instant, against the fixture clock: "4 min", "2 h", "3 d". */
+export function ageWords(iso: string | null | undefined): string {
+  if (!iso) return 'not known'
+  const m = Math.max(0, Math.round((MOCK_NOW - Date.parse(iso)) / 60_000))
+  return m < 60 ? `${m} min` : m < 48 * 60 ? `${Math.round(m / 60)} h` : `${Math.round(m / 1440)} d`
+}
+
+/** A labelled region of the scaffold: a plain heading and its parts. */
+export function Region({ title, note, children }: { title: string; note?: ReactNode; children: ReactNode }) {
+  return (
+    <section className="wr-region" aria-label={title}>
+      <div className="wr-row">
+        <h2 className="wr-h">{title}</h2>
+        {note ? <span className="wr-dim">{note}</span> : null}
+      </div>
+      {children}
+    </section>
+  )
+}
+
+/** The memoised needs list for one scope. */
+export function useNeeds(data: WorkData, workflowId: string | null = null): NeedItem[] {
+  return useMemo(() => (data.status === 'ok' ? needsYou(data.tasks, workflowId) : []), [data, workflowId])
+}
