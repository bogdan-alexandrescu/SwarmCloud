@@ -0,0 +1,951 @@
+// MOCK-HOOK FILE
+// Voice it's own speech, DIRECTION B: "Cards and a timeline". Settings is four
+// cards (Engine, Machine, Models, Behaviour), each carrying its own pending
+// change until the next start; Telemetry is one timeline: a live band, a heat
+// strip of days, then each session as a row that opens into its detail.
+// Drawn from fixtures.ts only; `?vs=b&vsstate=<state>` picks the frame.
+import { useState, type ReactNode } from 'react'
+
+import { PageHead } from '../../Shell'
+import { CATALOGUE, LIVE, OWN_SPEECH_MODELS, SESSIONS, SESSIONS_90, SETTINGS, STARTING, days, type Day, type Phase, type Session } from './fixtures'
+import { MOCK_VS_B, MOCK_VS_STATE } from './flag'
+import { VSB_CSS } from './vsb-css'
+
+function Style() {
+  return <style>{VSB_CSS}</style>
+}
+
+/** An explanation behind an (i): the surface carries none (Bogdan's console rule). */
+function Why({ say }: { say: string }) {
+  return (
+    <button type="button" className="vsb-why" title={say} aria-label={say}>
+      i
+    </button>
+  )
+}
+
+function Tick({ tone, children, say }: { tone: 'ok' | 'warn' | 'bad' | 'info' | 'idle'; children: ReactNode; say?: string }) {
+  return (
+    <span className={`vsb-tick t-${tone}`} title={say}>
+      <i aria-hidden="true" />
+      {children}
+    </span>
+  )
+}
+
+function Dash({ why }: { why: string }) {
+  return (
+    <span className="vsb-dash" title={why} aria-label={why}>
+      —
+    </span>
+  )
+}
+
+/* ------------------------------------------------------------------ Settings */
+
+type SState = 'admin' | 'key-link' | 'key-unset' | 'pending' | 'applied' | 'fetching' | 'refused' | 'conflict' | 'stockout' | 'error' | 'readonly'
+
+function sstate(): SState {
+  const s = MOCK_VS_STATE.replace(/^settings-/, '')
+  return (['admin', 'key-link', 'key-unset', 'pending', 'applied', 'fetching', 'refused', 'conflict', 'stockout', 'error', 'readonly'] as const).find((x) => x === s) ?? 'admin'
+}
+
+function Card({
+  title,
+  id,
+  aside,
+  band,
+  children,
+  foot,
+  tone,
+}: {
+  title: string
+  id: string
+  aside?: ReactNode
+  band?: ReactNode
+  children: ReactNode
+  foot?: ReactNode
+  tone?: 'pending' | 'bad' | 'warn' | 'busy' | 'ok'
+}) {
+  return (
+    <section className={`vsb-card${tone ? ` is-${tone}` : ''}`} aria-labelledby={`vsb-${id}`} data-card={id}>
+      <header className="vsb-card-head">
+        <h2 id={`vsb-${id}`}>{title}</h2>
+        {aside}
+      </header>
+      {band}
+      <div className="vsb-card-body">{children}</div>
+      {foot && <footer className="vsb-card-foot">{foot}</footer>}
+    </section>
+  )
+}
+
+function Band({ tone, children, actions }: { tone: 'pending' | 'bad' | 'warn' | 'busy' | 'ok'; children: ReactNode; actions?: ReactNode }) {
+  return (
+    <div className={`vsb-band is-${tone}`} role={tone === 'bad' || tone === 'warn' ? 'alert' : 'status'}>
+      <div className="vsb-band-text">{children}</div>
+      {actions && <div className="vsb-band-acts">{actions}</div>}
+    </div>
+  )
+}
+
+function Seg<K extends string>({ value, options, onPick, label, ro, mark, chips }: { value: K; options: readonly { key: K; label: ReactNode }[]; onPick: (k: K) => void; label: string; ro: boolean; mark?: Partial<Record<K, ReactNode>>; chips?: boolean }) {
+  if (ro) {
+    const o = options.find((x) => x.key === value)
+    return <span className="vsb-ro-val">{o?.label ?? value}</span>
+  }
+  return (
+    <div className={`vsb-seg${chips ? ' is-chips' : ''}`} role="radiogroup" aria-label={label}>
+      {options.map((o) => (
+        <button key={o.key} type="button" role="radio" aria-checked={o.key === value} className={o.key === value ? 'is-on' : ''} onClick={() => onPick(o.key)}>
+          {o.label}
+          {mark?.[o.key]}
+        </button>
+      ))}
+    </div>
+  )
+}
+
+function Row({ label, why, children, refused }: { label: string; why?: string; children: ReactNode; refused?: ReactNode }) {
+  return (
+    <div className={`vsb-row${refused ? ' is-refused' : ''}`}>
+      <div className="vsb-row-lbl">
+        {label}
+        {why && <Why say={why} />}
+      </div>
+      <div className="vsb-row-val">
+        {children}
+        {refused}
+      </div>
+    </div>
+  )
+}
+
+function Btn({ children, primary, quiet, onClick, small }: { children: ReactNode; primary?: boolean; quiet?: boolean; onClick?: () => void; small?: boolean }) {
+  return (
+    <button type="button" className={`vsb-btn${primary ? ' is-primary' : ''}${quiet ? ' is-quiet' : ''}${small ? ' is-sm' : ''}`} onClick={onClick}>
+      {children}
+    </button>
+  )
+}
+
+function money(n: number): string {
+  return `$${n.toFixed(2)}`
+}
+
+export function VsBSettingsScreen() {
+  const st = sstate()
+  const ro = st === 'readonly'
+  const [engine, setEngine] = useState(SETTINGS.engine)
+  const [machine, setMachine] = useState(st === 'pending' || st === 'applied' ? 'g2-standard-8' : st === 'refused' ? 'g2-standard-16' : SETTINGS.machine)
+  const [voice, setVoice] = useState(st === 'conflict' ? 'bf_emma' : SETTINGS.tts_voice)
+  const [idle, setIdle] = useState(SETTINGS.idle)
+  const stt = st === 'fetching' ? 'qwen3-asr-1.7b' : SETTINGS.stt_model
+  const applied = st === 'applied' ? { ...SETTINGS.applied, machine: 'g2-standard-8' } : SETTINGS.applied
+  const keySet = SETTINGS.openai_key.set && st !== 'key-unset'
+  // The head names the newest version read: in a conflict that is the other person's save (v15).
+  const head =
+    st === 'pending' || st === 'applied'
+      ? { v: 15, by: 'bogdan@example.com', at: 'bogdan, today 06:58' }
+      : st === 'conflict'
+        ? { v: 15, by: 'alex@example.com', at: 'alex, today 06:41' }
+        : { v: SETTINGS.version, by: SETTINGS.updated_by, at: 'bogdan, 4 Nov 22:10' }
+  if (!MOCK_VS_B) return null
+
+  if (st === 'error') {
+    // A failed read is never drawn as empty settings or as defaults (redesign-v2 honesty rule 1).
+    return (
+      <div className="vsb">
+        <Style />
+        <PageHead title="Settings" />
+        <div className="vsb-fail" role="alert">
+          <Tick tone="bad" say="GET /v1/voice/settings answered 503 at 07:02; nothing below is drawn from an older read">
+            Settings not read · 503 · 07:02
+          </Tick>
+          <Btn small>Retry</Btn>
+        </div>
+      </div>
+    )
+  }
+
+  return (
+    <div className="vsb">
+      <Style />
+      <PageHead title="Settings">
+        <span className="vsb-headfacts">
+          {st === 'fetching' ? (
+            <Tick tone="info" say="A session is starting the machine">Starting</Tick>
+          ) : (
+            <Tick tone="idle" say="The machine is stopped between sessions; it costs its disk only">Stopped</Tick>
+          )}
+          <span className="vsb-fact" title={`Version ${head.v}, saved by ${head.by}`}>
+            v{head.v} · {head.at}
+          </span>
+          {ro && (
+            <span className="vsb-lock" title="Only platform admins change Voice it's settings" aria-label="Read only: only platform admins change these">
+              <LockGlyph /> Read only
+            </span>
+          )}
+        </span>
+      </PageHead>
+
+      <div className="vsb-grid">
+        {/* ENGINE */}
+        <Card
+          title="Engine"
+          id="engine"
+          aside={<Why say="The engine every Start uses. When it cannot start, the session runs in text mode." />}
+        >
+          <Row label="Speech">
+            <Seg
+              ro={ro}
+              label="Engine"
+              value={engine}
+              onPick={setEngine}
+              options={[
+                { key: 'own', label: 'Own speech' },
+                { key: 'gpt-live', label: 'GPT-Live' },
+              ]}
+            />
+          </Row>
+          {engine === 'own' && (
+            <>
+              <Row label="Replies" why="A small, fast Claude model answers each spoken sentence at once, as you">
+                <span className="vsb-mono">{OWN_SPEECH_MODELS.replies}</span>
+                <span className="vsb-sub">{OWN_SPEECH_MODELS.replies_from}</span>
+              </Row>
+              <Row label="Plans and acts" why="Planning and actions go to the Claude planner, acting as the signed-in person">
+                <span>{OWN_SPEECH_MODELS.planner}</span>
+                <span className="vsb-sub">{OWN_SPEECH_MODELS.planner_class} class</span>
+              </Row>
+              <Row label="Fallback" why="If own speech cannot start (no free L4, not ready in 4 minutes), the session opens in text mode">
+                <span>Text mode</span>
+              </Row>
+            </>
+          )}
+          <div className="vsb-key">
+            <div className="vsb-key-head">
+              <span className="vsb-key-name">
+                OpenAI key
+                <Why say="GPT-Live's key, held by the quota broker; never shown here. Own speech uses no OpenAI." />
+              </span>
+              {keySet ? (
+                <Tick tone="ok" say={`Set by ${SETTINGS.openai_key.by} on ${SETTINGS.openai_key.at}`}>
+                  Set · {SETTINGS.openai_key.by} · {SETTINGS.openai_key.at}
+                </Tick>
+              ) : (
+                <Tick tone="warn" say="GPT-Live cannot start without it; own speech does not need it">
+                  Not set
+                </Tick>
+              )}
+            </div>
+            {st === 'key-link' ? (
+              <div className="vsb-link" role="status">
+                <div className="vsb-link-top">
+                  <span className="vsb-link-state">
+                    <Tick tone="info" say="A one-time link: ten minutes, single use">
+                      Link open
+                    </Tick>
+                    <span className="vsb-mono vsb-sub">until 07:09 · 9 min</span>
+                  </span>
+                  <span className="vsb-link-meter" aria-hidden="true">
+                    <i style={{ width: '90%' }} />
+                  </span>
+                </div>
+                <div className="vsb-link-url">
+                  <span className="vsb-mono" title="The link's token is shown only to the person who opened it">
+                    console.example.com/setup/key/••••••••
+                  </span>
+                  <Btn small primary>
+                    Copy link
+                  </Btn>
+                  <Btn small>Open</Btn>
+                </div>
+              </div>
+            ) : (
+              !ro && (
+                <div className="vsb-key-acts">
+                  <Btn small primary={!keySet}>{keySet ? 'Replace the OpenAI key' : 'Add an OpenAI API key for Voice it'}</Btn>
+                </div>
+              )
+            )}
+          </div>
+        </Card>
+
+        {/* MACHINE */}
+        <Card
+          title="Machine"
+          id="machine"
+          tone={st === 'pending' ? 'pending' : st === 'refused' ? 'bad' : st === 'stockout' ? 'warn' : st === 'applied' ? 'ok' : undefined}
+          aside={
+            <span className="vsb-card-aside">
+              <span className="vsb-mono vsb-sub">{SETTINGS.zone}</span>
+              <Why say="One zone, one stopped machine. A stock-out falls back to text mode." />
+            </span>
+          }
+          band={
+            st === 'pending' ? (
+              <Band tone="pending" actions={<Btn small quiet onClick={() => setMachine(applied.machine)}>Undo</Btn>}>
+                <strong>At next start</strong>
+                <span className="vsb-mono">
+                  {applied.machine} → g2-standard-8
+                </span>
+              </Band>
+            ) : st === 'refused' ? (
+              <Band tone="bad" actions={<Btn small>Reload the catalogue</Btn>}>
+                <strong>Refused</strong>
+                <span>
+                  <span className="vsb-mono">machine</span>: g2-standard-16 is not in the catalogue
+                </span>
+              </Band>
+            ) : st === 'applied' ? (
+              <Band tone="ok">
+                <strong>Applied</strong>
+                <span>
+                  <span className="vsb-mono">g2-standard-8</span> · start today 07:02
+                </span>
+              </Band>
+            ) : st === 'stockout' ? (
+              <Band tone="warn">
+                <strong>No free L4 at the last start</strong>
+                <span>
+                  <span className="vsb-mono">{SETTINGS.zone}</span> · today 06:12 · opened in text mode
+                </span>
+              </Band>
+            ) : undefined
+          }
+        >
+          <div className="vsb-mach-cols" aria-hidden="true">
+            <span>per hour</span>
+            <Why say="On-demand prices in us-central1, the machine with its L4. g2-standard-4's $0.71 is BGD's figure; the others are read from the Cloud Billing Catalog on 5 Nov 2026." />
+          </div>
+          <div className="vsb-machines" role={ro ? undefined : 'radiogroup'} aria-label="Machine">
+            {CATALOGUE.machines.map((m) => {
+              const on = m.name === machine
+              const max = 1.15
+              const cls = `vsb-mach${on ? ' is-on' : ''}${st === 'refused' && on ? ' is-refused' : ''}`
+              const body = (
+                <>
+                  <span className="vsb-radio" aria-hidden="true" />
+                  <span className="vsb-mach-id">
+                    <span className="vsb-mach-name vsb-mono">{m.name}</span>
+                    <span className="vsb-mach-spec">
+                      {m.vcpu} vCPU · {m.memory_gb} GB · 1 L4
+                    </span>
+                  </span>
+                  <span className="vsb-mach-bar" aria-hidden="true">
+                    <i style={{ width: `${(m.usd_per_hour / max) * 100}%` }} />
+                  </span>
+                  <span className="vsb-mach-price">{money(m.usd_per_hour)}</span>
+                </>
+              )
+              // Read only: the one machine as a value, not a picked option (no dot, no selected border).
+              if (ro) return on ? <div key={m.name} className="vsb-mach">{body}</div> : null
+              return (
+                <button key={m.name} type="button" role="radio" aria-checked={on} className={cls} onClick={() => setMachine(m.name)}>
+                  {body}
+                </button>
+              )
+            })}
+          </div>
+          <div className="vsb-facts">
+            <span>
+              <em>Disk</em> 150 GB, kept · $15/month
+            </span>
+            <span>
+              <em>Last start</em> {st === 'applied' ? 'today 07:02 · 1 min 24 s' : st === 'stockout' ? 'today 06:12 · no free L4' : 'today 06:12 · 1 min 18 s'}
+            </span>
+          </div>
+        </Card>
+
+        {/* MODELS */}
+        <Card
+          title="Models"
+          id="models"
+          tone={st === 'conflict' ? 'warn' : st === 'fetching' ? 'busy' : undefined}
+          band={
+            st === 'conflict' ? (
+              <Band
+                tone="warn"
+                actions={
+                  <>
+                    <Btn small onClick={() => setVoice('am_michael')}>Use theirs</Btn>
+                    <Btn small primary>Save mine over it</Btn>
+                  </>
+                }
+              >
+                <strong>Changed while you edited</strong>
+                <span>
+                  v15 · alex@example.com · 06:41 · voice <span className="vsb-mono">am_michael</span>
+                </span>
+              </Band>
+            ) : st === 'fetching' ? (
+              <Band tone="busy">
+                <strong>Fetching qwen3-asr-1.7b</strong>
+                <span className="vsb-fetch">
+                  <span className="vsb-fetch-bar" aria-hidden="true">
+                    <i style={{ width: '64%' }} />
+                  </span>
+                  <span className="vsb-mono">3.2 of 5.0 GB · 0:41</span>
+                </span>
+              </Band>
+            ) : undefined
+          }
+          foot={
+            st === 'conflict' ? (
+              <span className="vsb-sub">
+                Yours: voice <span className="vsb-mono">bf_emma</span>, on v14
+              </span>
+            ) : undefined
+          }
+        >
+          <Row label="Speech to text">
+            {ro ? (
+              <span className="vsb-mono">{stt}</span>
+            ) : (
+              <select className="vsb-select" defaultValue={stt} aria-label="Speech-to-text model">
+                {CATALOGUE.stt.map((m) => (
+                  <option key={m.name} value={m.name}>
+                    {m.name} · {m.disk_gb} GB
+                  </option>
+                ))}
+              </select>
+            )}
+            {st === 'fetching' ? (
+              <Tick tone="info" say="Not on the machine's disk yet: fetched from Hugging Face at this start, by pinned revision">
+                fetching
+              </Tick>
+            ) : (
+              <Tick tone="ok" say="On the machine's disk">on disk</Tick>
+            )}
+          </Row>
+          <Row label="Text to speech">
+            {ro ? (
+              <span className="vsb-mono">{SETTINGS.tts_model}</span>
+            ) : (
+              <select className="vsb-select" defaultValue={SETTINGS.tts_model} aria-label="Text-to-speech model">
+                {CATALOGUE.tts.map((m) => (
+                  <option key={m.name} value={m.name}>
+                    {m.name} · {m.disk_gb} GB
+                  </option>
+                ))}
+              </select>
+            )}
+            <Tick tone="ok" say="On the machine's disk">on disk</Tick>
+          </Row>
+          <Row label="Voice">
+            <Seg
+              ro={ro}
+              chips
+              label="Voice"
+              value={voice}
+              onPick={setVoice}
+              options={CATALOGUE.voices.map((v) => ({ key: v, label: <span className="vsb-mono">{v}</span> }))}
+            />
+          </Row>
+        </Card>
+
+        {/* BEHAVIOUR */}
+        <Card title="Behaviour" id="behaviour">
+          <Row label="Idle stop" why="With nobody speaking for this long, the session ends and the machine stops">
+            <Seg ro={ro} label="Idle stop" value={idle} onPick={setIdle} options={CATALOGUE.idle.map((v) => ({ key: v, label: v.replace('m', ' min') }))} />
+          </Row>
+          <Row label="Read-back" why="Cancel, merge, deploy, delete and approve are read back and wait for “go”. Set by the platform, not here.">
+            <span className="vsb-ro-val">cancel · merge · deploy · delete · approve</span>
+          </Row>
+        </Card>
+      </div>
+    </div>
+  )
+}
+
+function LockGlyph() {
+  return (
+    <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
+      <rect x="2" y="5.5" width="8" height="5.5" rx="1.2" fill="currentColor" />
+      <path d="M4 5.5V4a2 2 0 0 1 4 0v1.5" fill="none" stroke="currentColor" strokeWidth="1.3" />
+    </svg>
+  )
+}
+
+/* ----------------------------------------------------------------- Telemetry */
+
+type TState = 'live-idle' | 'live-starting' | 'live-session' | 'sessions' | 'session-detail' | 'days' | 'empty' | 'error'
+
+function tstate(): TState {
+  const s = MOCK_VS_STATE.replace(/^telemetry-/, '')
+  return (['live-idle', 'live-starting', 'live-session', 'sessions', 'session-detail', 'days', 'empty', 'error'] as const).find((x) => x === s) ?? 'live-idle'
+}
+
+/** One series, one colour, a 2px line; the latest value dotted. */
+function Spark({ data, max, tone, w = 120, h = 28, label, unit, area = false }: { data: number[]; max?: number; tone: 1 | 2 | 3 | 5; w?: number; h?: number; label: string; unit: string; area?: boolean }) {
+  if (data.length === 0) return <Dash why="Not measured: the session never reached the machine" />
+  const hi = max ?? Math.max(...data) * 1.1
+  const x = (i: number) => (i / Math.max(1, data.length - 1)) * (w - 4) + 2
+  const y = (v: number) => h - 2 - (Math.min(v, hi) / hi) * (h - 5)
+  const d = data.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join('')
+  const last = data[data.length - 1] ?? 0
+  return (
+    <svg className={`vsb-spark s-${tone}`} viewBox={`0 0 ${w} ${h}`} width={w} height={h} role="img" aria-label={`${label}: latest ${last} ${unit}, peak ${Math.max(...data)} ${unit}`}>
+      <title>{`${label}: latest ${last} ${unit} · peak ${Math.max(...data)} ${unit}`}</title>
+      {area && <path className="a" d={`${d}L${x(data.length - 1)},${h}L${x(0)},${h}Z`} />}
+      <path className="l" d={d} />
+      <circle className="p" cx={x(data.length - 1)} cy={y(last)} r="2.5" />
+    </svg>
+  )
+}
+
+/** Per-utterance latency: one thin bar per utterance from a zero baseline, with the p90 as a rule.
+ * The axis and p90 labels are HTML over the SVG, so they keep the 12px floor at any chart width. */
+function Bars({ data, tone, label, w = 520, h = 96 }: { data: number[]; tone: 1 | 3; label: string; w?: number; h?: number }) {
+  const hi = 1000
+  const bw = (w - 6) / data.length
+  const sorted = [...data].sort((a, b) => a - b)
+  const p90 = sorted[Math.floor(sorted.length * 0.9)] ?? 0
+  const y = (v: number) => h - 8 - (Math.min(v, hi) / hi) * (h - 16)
+  const top = (v: number) => `${(y(v) / h) * 100}%`
+  return (
+    <div className={`vsb-bars-wrap s-${tone}`}>
+      <div className="vsb-bars-ax" aria-hidden="true">
+        {[0, 500, 1000].map((g) => (
+          <span key={g} style={{ top: top(g) }}>
+            {g === 0 ? '0' : `${g / 1000}s`}
+          </span>
+        ))}
+      </div>
+      <div className="vsb-bars-plot">
+        <svg className={`vsb-bars s-${tone}`} viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" role="img" aria-label={`${label}, per utterance; p90 ${p90} ms`}>
+          {[0, 500, 1000].map((g) => (
+            <line key={g} className="g" x1="0" x2={w} y1={y(g)} y2={y(g)} />
+          ))}
+          {data.map((v, i) => (
+            <rect key={i} className="b" x={3 + i * bw + 1} width={Math.max(1.5, bw - 2)} y={y(v)} height={Math.max(1, y(0) - y(v))} rx="1.5">
+              <title>{`Utterance ${i + 1}: ${v} ms`}</title>
+            </rect>
+          ))}
+          <line className="p90" x1="0" x2={w} y1={y(p90)} y2={y(p90)} />
+        </svg>
+        <span className="vsb-bars-p90" style={{ top: top(p90) }} aria-hidden="true">
+          p90 {p90} ms
+        </span>
+      </div>
+    </div>
+  )
+}
+
+function PhaseTrack({ phases, live }: { phases: Phase[]; live?: boolean }) {
+  const shown = phases.filter((p) => p.state !== 'skip')
+  const total = live ? 240 : shown.reduce((a, p) => a + (p.s ?? 0), 0)
+  const elapsed = phases.reduce((a, p) => a + (p.s ?? 0), 0)
+  return (
+    <div className={`vsb-phases${live ? ' is-live' : ''}`}>
+      <div className="vsb-ptrack" role="img" aria-label={phases.map((p) => `${p.label} ${p.s === null ? p.state : `${p.s} s`}`).join(', ')}>
+        {shown.map((p) => (
+          <span
+            key={p.key}
+            className={`vsb-pseg k-${p.key} is-${p.state}`}
+            style={{ flexGrow: p.state === 'wait' ? 0 : (p.s ?? 0), flexBasis: p.state === 'wait' ? 0 : undefined }}
+            title={`${p.label}: ${p.s === null ? p.state : `${p.s} s`}`}
+          />
+        ))}
+        {live && <span className="vsb-pseg is-rest" style={{ flexGrow: Math.max(0, total - elapsed) }} />}
+        {live && <span className="vsb-pdeadline" title="Ready within 4 minutes, or the session opens in text mode" />}
+      </div>
+      <ol className="vsb-plist">
+        {phases.map((p) => (
+          <li key={p.key} className={`is-${p.state}`}>
+            <i className={`k-${p.key}`} aria-hidden="true" />
+            <span className="n">{p.label}</span>
+            <span className="v">{p.state === 'skip' ? 'skipped' : p.state === 'wait' ? 'next' : p.state === 'run' ? `${p.s} s…` : `${p.s} s`}</span>
+          </li>
+        ))}
+      </ol>
+    </div>
+  )
+}
