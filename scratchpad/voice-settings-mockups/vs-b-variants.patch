+
+function wave(n: number, seed: number, base: number, spread: number): number[] {
+  const out: number[] = []
+  let x = seed
+  for (let i = 0; i < n; i++) {
+    x = (x * 9301 + 49297) % 233280
+    const r = x / 233280
+    out.push(Math.round(base + spread * (r - 0.5) + spread * 0.35 * Math.sin(i / 3 + seed)))
+  }
+  return out
+}
+
+function phases(boot: number, server: number, update: number | null, fetch: number | null, load: number, warm: number): Phase[] {
+  return [
+    { key: 'boot', label: 'Machine', s: boot, state: 'done' },
+    { key: 'server', label: 'Server', s: server, state: 'done' },
+    { key: 'update', label: 'Update', s: update, state: update === null ? 'skip' : 'done' },
+    { key: 'fetch', label: 'Fetch model', s: fetch, state: fetch === null ? 'skip' : 'done' },
+    { key: 'load', label: 'Load models', s: load, state: 'done' },
+    { key: 'warmup', label: 'Warm-up', s: warm, state: 'done' },
+  ]
+}
