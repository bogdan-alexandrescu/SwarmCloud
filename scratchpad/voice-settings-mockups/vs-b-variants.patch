+const PROJECTS = [
+  'Workflow page redesign',
+  'Schedules retry policy',
+  'Release notes 4.2',
+  'Quota broker alerts',
+  'Workflow page redesign',
+  'Runner sizes cleanup',
+  'Inbox triage',
+  'Voice it read-backs',
+]
+
+function mk(i: number, day: number, when: string, minutes: number, flag?: Session['flag'], reason?: string): Session {
+  const u = Math.round(minutes * 1.7)
+  const lat = flag === 'stock-out' ? [] : wave(Math.max(8, Math.min(48, u)), i + 3, 410, 260)
+  const gpu = flag === 'stock-out' ? [] : wave(40, i + 11, 46, 50).map((v) => Math.max(4, Math.min(97, v)))
+  const sorted = [...lat].sort((a, b) => a - b)
+  return {
+    id: `vs-${String(1040 - i)}`,
+    day,
+    when,
+    project: PROJECTS[i % PROJECTS.length] ?? '',
+    minutes: flag === 'stock-out' ? 0 : minutes,
+    machine_minutes: flag === 'stock-out' ? 0 : minutes + 2.5,
+    cost: flag === 'stock-out' ? 0 : Math.round(((minutes + 2.5) / 60) * 0.71 * 100) / 100,
+    utterances: flag === 'stock-out' ? 0 : u,
+    p90_ms: sorted[Math.floor(sorted.length * 0.9)] ?? null,
+    gpu_peak: gpu.length ? Math.max(...gpu) : null,
+    latency: lat,
+    gpu,
+    phases: flag === 'stock-out' ? [] : phases(38 + (i % 5) * 3, 6 + (i % 3), i === 4 ? 52 : null, i === 6 ? 71 : null, 17 + (i % 4), 4),
+    flag,
+    fallback_reason: reason,
+  }
