+.vsb-cell.has-so::after { content: ''; position: absolute; left: 50%; top: 4px; width: 6px; height: 6px; margin-left: -3px; border-radius: 50%; background: var(--warn-ink); box-shadow: 0 0 0 1.5px var(--surface); }
