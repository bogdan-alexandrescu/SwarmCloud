+export type Day = { offset: number; label: string; dow: string; minutes: number; cost: number; utterances: number; p90_ms: number | null; stockouts: number; sessions: number }
+
+const DOW = ['Thu', 'Wed', 'Tue', 'Mon', 'Sun', 'Sat', 'Fri']
