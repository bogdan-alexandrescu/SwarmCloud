+/** Days are computed on read from the sessions (§12.3), never a second counter. */
+export function days(sessions: Session[], n = 30): Day[] {
+  const out: Day[] = []
+  for (let d = n - 1; d >= 0; d--) {
+    const s = sessions.filter((x) => x.day === d)
+    const date = new Date(Date.UTC(2026, 10, 5 - d))
+    const p90s = s.map((x) => x.p90_ms).filter((v): v is number => v !== null)
+    out.push({
+      offset: d,
+      label: `${date.getUTCDate()} ${date.toLocaleString('en-GB', { month: 'short', timeZone: 'UTC' })}`,
+      dow: DOW[d % 7] ?? '',
+      minutes: s.reduce((a, x) => a + x.machine_minutes, 0),
+      cost: Math.round(s.reduce((a, x) => a + x.cost, 0) * 100) / 100,
+      utterances: s.reduce((a, x) => a + x.utterances, 0),
+      p90_ms: p90s.length ? Math.max(...p90s) : null,
+      stockouts: s.filter((x) => x.flag === 'stock-out').length,
+      sessions: s.length,
+    })
+  }
+  return out
+}
