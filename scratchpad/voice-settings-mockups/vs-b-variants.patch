+
+type Metric = 'minutes' | 'cost' | 'utterances' | 'p90' | 'stockouts'
+const METRICS: readonly { key: Metric; label: string }[] = [
+  { key: 'minutes', label: 'Machine minutes' },
+  { key: 'cost', label: 'Cost' },
+  { key: 'utterances', label: 'Utterances' },
+  { key: 'p90', label: 'p90 latency' },
+  { key: 'stockouts', label: 'Stock-outs' },
+]
+
+function dayValue(d: Day, m: Metric): number | null {
+  if (m === 'minutes') return d.minutes
+  if (m === 'cost') return d.cost
+  if (m === 'utterances') return d.utterances
+  if (m === 'p90') return d.p90_ms
+  return d.stockouts
+}
+
+function fmt(m: Metric, v: number | null): string {
+  if (v === null) return '—'
+  if (m === 'cost') return money(v)
+  if (m === 'p90') return `${v} ms`
+  if (m === 'minutes') return `${v} min`
+  return String(v)
+}
+
+function HeatStrip({ ds, range, metric, setMetric, picked, setPicked }: { ds: Day[]; range: string; metric: Metric; setMetric: (m: Metric) => void; picked: number | null; setPicked: (n: number | null) => void }) {
+  const vals = ds.map((d) => dayValue(d, metric)).filter((v): v is number => v !== null)
+  const hi = Math.max(1, ...vals)
+  const tot = (k: 'minutes' | 'cost' | 'utterances' | 'stockouts') => ds.reduce((a, d) => a + d[k], 0)
+  return (
+    <section className={`vsb-days${ds.length > 30 ? ' is-long' : ''}`} aria-label="Days">
+      <div className="vsb-days-head">
+        <div className="vsb-seg is-sm" role="radiogroup" aria-label="Colour the days by">
+          {METRICS.map((m) => (
+            <button key={m.key} type="button" role="radio" aria-checked={m.key === metric} className={m.key === metric ? 'is-on' : ''} onClick={() => setMetric(m.key)}>
+              {m.label}
+            </button>
+          ))}
+        </div>
+        <span className="vsb-days-tot">
+          <span>
+            <em>{range}</em> {tot('minutes')} machine min
+          </span>
+          <span>{money(Math.round(tot('cost') * 100) / 100)}</span>
+          <span>{tot('utterances')} utterances</span>
+          <span>{tot('stockouts')} stock-out</span>
+        </span>
+      </div>
+      <div className="vsb-heat" role="list">
+        {ds.map((d) => {
+          const v = dayValue(d, metric)
+          const lvl = v === null || v === 0 ? 0 : Math.max(1, Math.ceil((v / hi) * 4))
+          const on = picked === d.offset
+          return (
+            <button
+              key={d.offset}
+              type="button"
+              role="listitem"
+              className={`vsb-cell l-${lvl}${on ? ' is-on' : ''}${d.stockouts ? ' has-so' : ''}`}
+              aria-pressed={on}
+              title={`${d.dow} ${d.label}: ${fmt(metric, v)} · ${d.sessions} session${d.sessions === 1 ? '' : 's'}`}
+              onClick={() => setPicked(on ? null : d.offset)}
+            >
+              <span className="vsb-cell-lbl">{d.offset % 7 === 0 || d.offset === 0 ? d.label : ''}</span>
+            </button>
+          )
+        })}
+      </div>
+      <div className="vsb-heat-key" aria-hidden="true">
+        <span>less</span>
+        {[0, 1, 2, 3, 4].map((l) => (
