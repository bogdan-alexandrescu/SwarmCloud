+  display: grid; grid-template-columns: 12px 132px minmax(0, 1fr) auto 186px 166px 72px 64px; align-items: center; gap: 14px; padding: 10px 18px; min-height: 48px; }
+.vsb-sline:hover { background: color-mix(in srgb, var(--surface-2) 60%, var(--surface)); }
