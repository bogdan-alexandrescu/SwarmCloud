+/** The name a workflow is shown by: its title, then its quality-check leg, which is what tells two legs of one target apart. */
+export function wcLegName(workflow: { metadata?: WcMetadata | null }, name: string): string {
+  const leg = workflow.metadata?.leg
+  return typeof leg === 'string' && leg.trim() !== '' ? `${name} · ${leg.trim()} leg` : name
