+/** Where a workflow was started from, as `metadata.origin.kind` will say. */
+export type WcOriginKind = 'claude_code' | 'console' | 'schedule' | 'issue' | 'quality_check'
+
+export interface WcMetadata {
+  title?: string | null
+  unit?: string | null
+  /** The quality-check leg this workflow is ('reviewer', 'moderator'); null for any other workflow. Its legs share one title. */
+  leg?: string | null
+  description?: string | null
+  description_source?: 'submitter' | 'generated' | null
+  feature?: { title: string; url: string | null } | null
+  origin?: { kind: WcOriginKind; ref: { label: string; url: string | null } | null } | null
+}
