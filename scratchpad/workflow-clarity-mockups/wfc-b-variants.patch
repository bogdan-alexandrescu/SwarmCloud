diff --git a/apps/swarm-ui/src/styles/wc.css b/apps/swarm-ui/src/styles/wc.css
new file mode 100644
index 00000000..71344bf0
--- /dev/null
+++ b/apps/swarm-ui/src/styles/wc.css
@@ -0,0 +1,100 @@
+/* MOCK-HOOK FILE
+   WORKFLOW CLARITY, DIRECTION B (?wc=b): the head's Facts card and the list's
+   Repository column. One box (design-system §13.3), the description in body
+   type, the facts as label/value pairs in the label rank (mono, faint, 13). */
+.wcb-card {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, max-content);
+  gap: var(--ctl-s3, 16px) 24px;
+  margin-top: 10px;
+  padding: 14px 16px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  background: var(--surface);
+  min-width: 0;
+}
+.wcb-desc { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; min-width: 0; }
+.wcb-label {
+  display: flex; align-items: center; gap: 8px; margin: 0;
+  font: 600 var(--t-meta)/var(--lh-meta, 1.45) var(--mono); color: var(--text-faint);
+}
+.wcb-gen { padding: 2px 8px; }
+.wcb-text { margin: 0; max-width: 68ch; font-size: var(--t-body); line-height: 1.55; color: var(--text); overflow-wrap: anywhere; }
+.wcb-text.is-generated { color: var(--text-dim); }
+.wcb-text.is-clamped { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 5; line-clamp: 5; overflow: hidden; }
+.wcb-more { padding: 0; border: 0; background: none; font: inherit; font-size: var(--t-meta); cursor: pointer; }
+.wcb-facts {
+  display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 14px;
+  margin: 0; padding-left: 20px; border-left: 1px solid var(--line); align-content: start; align-self: start; min-width: 0;
+}
+.wcb-facts > div { display: contents; }
+.wcb-facts dt { font: 600 var(--t-meta)/22px var(--mono); color: var(--text-faint); white-space: nowrap; }
+.wcb-facts dd { margin: 0; min-width: 0; font-size: var(--t-body); line-height: 22px; overflow-wrap: anywhere; }
+.wcb-from { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
+.wcb-from .c-chip { padding: 2px 8px; }
+.wcb-mono { font-family: var(--mono); font-size: var(--t-meta); }
+.wcb-dim { color: var(--text-dim); }
+.wcb-nowrap { white-space: nowrap; }
+.wcb-facts dd .wcb-mono { overflow-wrap: normal; }
+.wcb-gen-note { margin: 0; font-size: var(--t-meta); line-height: var(--lh-meta, 1.45); color: var(--text-faint); }
+.wcb-facts { max-width: 250px; }
+/* THE OWNER'S NAME, THEN THE WHOLE EMAIL UNDER IT (user-profile.md §4.4 keeps the email; the column keeps its width). */
+.wcb-facts .person-name { display: flex !important; flex-direction: column; max-width: 100%; }
+.wcb-facts .person-name-dot { display: none !important; }
+.wcb-facts .person-name-email { font-size: var(--t-micro); line-height: 18px; color: var(--text-dim); white-space: normal !important; overflow-wrap: anywhere; }
+@container work-main (max-width: 520px) { .wcb-facts { max-width: none; } }
+@media (max-width: 560px) { .wcb-facts { max-width: none; } }
+
+/* A NARROW PANE (the docked inspector open at 1280, or a phone): the facts
+   go under the description and the rule moves above them. */
+@container work-main (max-width: 520px) {
+  .wcb-card { grid-template-columns: minmax(0, 1fr); }
+  .wcb-facts { padding-left: 0; border-left: 0; padding-top: 12px; border-top: 1px solid var(--line); }
+}
+@media (max-width: 560px) {
+  .wcb-card { grid-template-columns: minmax(0, 1fr); padding: 12px; }
+  .wcb-facts { padding-left: 0; border-left: 0; padding-top: 12px; border-top: 1px solid var(--line); }
+}
+
+/* THE LIST'S REPOSITORY COLUMN: narrow and mono, the repository's name with its owner under it in the
+   faint ink, so a touch screen reads both without the hover. */
+.wfg-table [data-col="repo"] { width: 1%; max-width: 12em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-dim); }
+.wcb-repo-name, .wcb-repo-by { display: block; overflow: hidden; text-overflow: ellipsis; line-height: 16px; }
+.wcb-repo-by { font-size: var(--t-micro); color: var(--text-faint); }
+@container work-main (max-width: 1024px) { .wfg-table [data-col="repo"] { width: 150px; max-width: none; } }
+@container work-main (max-width: 940px) { .wfg-table [data-col="repo"] { display: none; } }
+.wcb-repo-under { display: none; }
+@container work-main (max-width: 940px) {
+  .wfg-table td[data-col="workflow"] .wcb-repo-under { display: block; font-size: var(--t-micro); line-height: 16px; color: var(--text-dim); font-weight: 400; white-space: normal; }
+}
+@media (max-width: 560px) {
+  .wfg-table [data-col="repo"] { display: none; }
+  .wfg-table td[data-col="workflow"] .wcb-repo-under { display: block; font-size: var(--t-micro); line-height: 16px; color: var(--text-dim); font-weight: 400; white-space: normal; }
+}
+
+/* THE NAME READS WHOLE, at every width: it wraps (two lines at most for the fixtures at 1440, three on a
+   phone) rather than being cut, and Spent's coverage note goes under its figure so the name gets that width. */
+.wcb-on .wfg-table td[data-col="workflow"] { white-space: normal; overflow-wrap: anywhere; text-overflow: clip; padding-top: 6px; padding-bottom: 6px; }
+.wcb-on .wfg-table td[data-col="workflow"] > a { line-height: 18px; }
+.wcb-on .wfg-table td[data-col="spent"] .wf-spend-cov { display: block; margin-left: 0; }
+.wcb-on .wfg-table td { vertical-align: top; padding-top: 8px; }
+/* ON A PHONE THE STEPS ARE A COUNT, NOT A BAR (the bar's 40px went to the name; the state glyph keeps the colour). */
+@container work-main (max-width: 570px) {
+  .wcb-on .wfg-table [data-col="steps"] { width: 52px; }
+  .wcb-on .wfg-table [data-col="needs"] { width: 56px; }
+  .wcb-on .wfg-table td[data-col="needs"] { white-space: normal; }
+  .wcb-on .wfg-bar > .c-bar { display: none; }
+}
+@media (max-width: 560px) {
+  .wcb-on .wfg-table [data-col="steps"] { width: 52px; }
+  .wcb-on .wfg-table [data-col="needs"] { width: 56px; }
+  .wcb-on .wfg-table td[data-col="needs"] { white-space: normal; }
+  .wcb-on .wfg-bar > .c-bar { display: none; }
+}
+/* RECENT IN THE SIDEBAR: two lines, so a quality-check leg's "· reviewer leg" is not cut off its shared title. */
+.wcb-on .sk-recent > a.sk-kid > span { align-items: flex-start; }
+.wcb-on .sk-recent > a.sk-kid > span > span:last-child { white-space: normal; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; }
+
+/* FOUND WHILE DRAWING THESE FRAMES, not part of the direction: the step bar's
+   count was a <small> at 11.7px, under the 12px floor (design-system §2). */
+.wfg-bar > small { font-size: var(--t-micro); }
