+/** The fixture tasks direction B adds: each step's task, carrying its workflow's title and unit. */
+export function wcTaskRows(mk: Mk): Task[] {
+  return SPECS.flatMap((w) =>
+    w.tasks.map((t) =>
+      mk(t.id, t.state, t.profile, t.mins, {
+        workflow_id: w.id,
+        step_id: t.step,
+        depends_on: t.deps,
+        submitted_by: w.by,
+        repository_url: w.repo,
+        metadata: { title: w.meta.title, unit: w.meta.unit },
+        ...(t.state === 'PARKED' ? { park_reason: 'DEPENDENCY_INCOMPLETE' } : {}),
+        ...t.extra,
+      }),
+    ),
+  )
+}
+
+/** The workflows themselves, and the repository and origin the older fixtures gain. */
+export function wcWorkflowRows(step: Step, spanOf: SpanOf, older: Workflow[]): Workflow[] {
+  const made = SPECS.map((w): Workflow => {
+    const rollupState = w.tasks.some((t) => t.state === 'RUNNING') ? 'RUNNING' : 'SUCCEEDED'
+    return {
+      workflow_id: w.id,
+      tenant_id: 'u-bogdan',
+      state: rollupState,
+      stored_state: rollupState,
+      state_source: 'derived',
+      rollup: { state: rollupState, complete: true, reason: 'steps_hold_capacity', counts: {}, unreadable_steps: [], unstarted_steps: [], steps_read: w.tasks.length },
+      ...spanOf(w.tasks.map((t) => t.id)),
+      submitted_by: w.by,
+      submitted_by_name: w.byName,
+      priority: 0,
+      on_step_failure: 'FAIL_WORKFLOW',
+      cancel_requested: false,
+      steps: w.tasks.map((t) => step(t.step, t.deps, t.id)),
+      metadata: w.meta,
+      repository_url: w.repo,
+    }
+  })
+  // THE OLDER FIXTURES SERVE A REPOSITORY TOO, and no description, feature or
+  // origin: a workflow submitted before the fields existed.
+  const aged = older.map((w) => ({ ...w, repository_url: 'https://github.com/example-org/agent-swarm-infra', metadata: w.metadata ?? null }))
+  return [...made, ...aged]
+}
+
+/** `owner/repo` of a GitHub URL, else the URL itself; null when none is served. */
+export function repoName(url: string | null | undefined): string | null {
+  if (url === null || url === undefined || url.trim() === '') return null
+  const m = /^https:\/\/github\.com\/([^/]+\/[^/]+?)(?:\.git)?\/?$/.exec(url.trim())
+  return m === null ? url.trim() : (m[1] ?? url)
+}
