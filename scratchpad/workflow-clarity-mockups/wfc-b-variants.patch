diff --git a/apps/swarm-ui/src/WcFacts.tsx b/apps/swarm-ui/src/WcFacts.tsx
new file mode 100644
index 00000000..92437650
--- /dev/null
+++ b/apps/swarm-ui/src/WcFacts.tsx
@@ -0,0 +1,216 @@
+// MOCK-HOOK FILE
+// WORKFLOW CLARITY, DIRECTION B (?wc=b): the head's card -- what the workflow
+// is meant to deliver on the left, a column of labelled facts on the right
+// (Repository, Feature, Started by, From, When), stacked under the description
+// on a phone -- and the list's Repository cell.
+import { useLayoutEffect, useRef, useState } from 'react'
+import { PersonName } from './PersonName'
+import { timeAgo, type Workflow } from './types'
+import { ORIGIN_WORDS, repoName } from './wcFixtures'
+import { utcStamp } from './Workflows'
+import './styles/wc.css'
+
+/** An http(s) URL, else null: a stored string becomes an href only when it is one. */
+function safeHref(url: string | null | undefined): string | null {
+  return typeof url === 'string' && /^https?:\/\//.test(url) ? url : null
+}
+
+/** A value that was not served: its slot and its label stay, the word says which kind of nothing. */
+function Absent({ children }: { children: string }) {
+  return <span className="ctl-mark is-absent">{children}</span>
+}
+
+/** Asked and there is none: a measured nothing (`.ctl-mark.is-zero`), not a missing read. */
+function None({ children }: { children: string }) {
+  return <span className="ctl-mark is-zero">{children}</span>
+}
+
+/** `owner/repo`, breaking only after the slash: a repository name never splits mid-word. */
+function RepoWords({ repo }: { repo: string }) {
+  const at = repo.indexOf('/')
+  if (at < 0) return <span className="wcb-nowrap">{repo}</span>
+  return (
+    <>
+      <span className="wcb-nowrap wcb-repo-owner">{repo.slice(0, at + 1)}</span>
+      <wbr />
+      <span className="wcb-nowrap">{repo.slice(at + 1)}</span>
+    </>
+  )
+}
+
+export function WcFactsCard({ workflow, now }: { workflow: Workflow; now: number }) {
+  const meta = workflow.metadata ?? null
+  const description = typeof meta?.description === 'string' && meta.description.trim() !== '' ? meta.description.trim() : null
+  const generated = meta?.description_source === 'generated'
+  const textRef = useRef<HTMLParagraphElement>(null)
+  const [open, setOpen] = useState(false)
+  const [clipped, setClipped] = useState(false)
+  // THE TOGGLE IS DRAWN ONLY WHEN THE CLAMP CUT SOMETHING: measured, not
+  // guessed from a character count, so a short description at a narrow width
+  // gets one and a long one at a wide width may not.
+  useLayoutEffect(() => {
+    const el = textRef.current
+    if (el === null || open) return
+    const measure = () => setClipped(el.scrollHeight > el.clientHeight + 1)
+    measure()
+    const ro = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(measure)
+    ro?.observe(el)
+    return () => ro?.disconnect()
+  }, [description, open])
+
+  const repo = repoName(workflow.repository_url)
+  const repoHref = safeHref(workflow.repository_url)
+  const feature = meta?.feature ?? null
+  const origin = meta?.origin ?? null
+  const started = utcStamp(workflow.created_at, now)
+  const ago = Number.isFinite(Date.parse(workflow.created_at)) ? timeAgo(workflow.created_at, now) : null
+  // `metadata` absent: a workflow submitted before these fields existed, so
+  // each is "not recorded"; present with a null feature: it was asked and has none.
+  const recorded = meta !== null
+
+  return (
+    <section className="wcb-card" aria-label="About this workflow">
+      <div className="wcb-desc">
+        <p className="wcb-label">
+          Description
+          {generated && (
+            <span className="c-chip wcb-gen" title="No description was submitted; a model wrote this one from the steps' prompts.">
+              generated
+            </span>
+          )}
+        </p>
+        {description === null ? (
+          <p className="wcb-text">
+            {recorded ? <None>none submitted</None> : <Absent>not recorded</Absent>}
+          </p>
+        ) : (
+          <>
+            <p ref={textRef} className={`wcb-text${open ? '' : ' is-clamped'}${generated ? ' is-generated' : ''}`} id={`wcb-d-${workflow.workflow_id}`}>
+              {description}
+            </p>
+            {generated && (
+              // WHO WROTE IT, IN WORDS A TOUCH SCREEN CAN READ: the chip's title is a hover only.
+              <p className="wcb-gen-note">A model wrote this from the steps' prompts; no description was submitted.</p>
+            )}
+            {(clipped || open) && (
+              <button
+                type="button"
+                className="ctl-link wcb-more"
+                aria-expanded={open}
+                aria-controls={`wcb-d-${workflow.workflow_id}`}
+                onClick={() => setOpen(!open)}
+              >
+                {open ? 'Show less' : 'Show all'}
+              </button>
+            )}
+          </>
+        )}
+      </div>
+      <dl className="wcb-facts">
+        <div>
+          <dt>Repository</dt>
+          <dd>
+            {repo === null ? (
+              <Absent>not recorded</Absent>
+            ) : repoHref === null ? (
+              <span className="wcb-mono">
+                <RepoWords repo={repo} />
+              </span>
+            ) : (
+              <a className="ctl-link wcb-mono" href={repoHref} target="_blank" rel="noreferrer" title={repoHref}>
+                <RepoWords repo={repo} />
+              </a>
+            )}
+          </dd>
+        </div>
+        <div>
+          <dt>Feature</dt>
+          <dd>
+            {feature === null ? (
+              recorded ? <None>none</None> : <Absent>not recorded</Absent>
+            ) : safeHref(feature.url) === null ? (
+              feature.title
+            ) : (
+              <a className="ctl-link" href={safeHref(feature.url) ?? undefined} target="_blank" rel="noreferrer" title={feature.url ?? undefined}>
+                {feature.title}
+              </a>
+            )}
+          </dd>
+        </div>
+        <div>
+          <dt>Started by</dt>
+          <dd>
+            {workflow.submitted_by === null || workflow.submitted_by === '' ? (
+              <Absent>not recorded</Absent>
+            ) : (
+              <PersonName email={workflow.submitted_by} name={workflow.submitted_by_name} variant="full" />
+            )}
+          </dd>
+        </div>
+        <div>
+          <dt>From</dt>
+          <dd className="wcb-from">
+            {origin === null ? (
+              <Absent>not recorded</Absent>
+            ) : (
+              <>
+                <span className="c-chip">{ORIGIN_WORDS[origin.kind]}</span>
+                {origin.ref !== null &&
+                  (safeHref(origin.ref.url) === null ? (
+                    <span className="wcb-mono">{origin.ref.label}</span>
+                  ) : (
+                    <a className="ctl-link wcb-mono" href={safeHref(origin.ref.url) ?? undefined} target="_blank" rel="noreferrer">
+                      {origin.ref.label}
+                    </a>
+                  ))}
+              </>
+            )}
+          </dd>
+        </div>
+        <div>
+          <dt>When</dt>
+          <dd title={workflow.created_at}>
+            {started === null ? (
+              <Absent>not recorded</Absent>
+            ) : (
+              // THE AGE IS THE CHIPS ROW'S ("16d 11h old"); the card gives the instant.
+              <span className="wcb-mono" title={ago === null ? workflow.created_at : `${workflow.created_at} · ${ago}`}>
+                {started}
+              </span>
+            )}
+          </dd>
+        </div>
+      </dl>
+    </section>
+  )
+}
+
+/** The list's Repository cell: the repository's name, its owner under it in the faint ink; the whole URL is its title. */
+export function WcRepoCell({ workflow }: { workflow: Workflow }) {
+  const repo = repoName(workflow.repository_url)
+  const at = repo === null ? -1 : repo.indexOf('/')
+  return (
+    <td className="wcb-repo" data-col="repo" title={workflow.repository_url ?? 'no repository recorded'}>
+      {repo === null ? (
+        <span className="wfg-absent">—</span>
+      ) : at < 0 ? (
+        <span className="wcb-mono">{repo}</span>
+      ) : (
+        <>
+          <span className="wcb-mono wcb-repo-name">{repo.slice(at + 1)}</span>
+          <span className="wcb-mono wcb-repo-by">{repo.slice(0, at)}</span>
+        </>
+      )}
+    </td>
+  )
+}
+
+/** The phone row has no Repository column: the whole `owner/repo` goes under the name, breaking after the slash. */
+export function WcRepoUnder({ workflow }: { workflow: Workflow }) {
+  const repo = repoName(workflow.repository_url)
+  return repo === null ? null : (
+    <span className="wcb-repo-under wcb-mono">
+      <RepoWords repo={repo} />
+    </span>
+  )
+}
