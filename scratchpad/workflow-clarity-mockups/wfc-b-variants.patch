+// MOCK-HOOK FILE
+// WORKFLOW CLARITY, DIRECTION B (?wc=b): invented fixtures for the head's Facts
+// card and the list's Repository column. Shaped as the server will serve them:
+// the workflow's `metadata` (title, unit, description, description_source,
+// feature {title, url}, origin {kind, ref}) and `repository_url`. Nothing here
+// is read outside the fixture build.
+import type { Task, TaskState, Workflow, WorkflowStep } from './types'
+
+/** Direction B is on: `?wc=b` in the address, kept for the tab once seen. */
+export function wcOn(): boolean {
+  if (typeof location === 'undefined') return false
+  const asked = new URLSearchParams(location.search).get('wc')
+  let on = asked === 'b'
+  try {
+    if (asked !== null) sessionStorage.setItem('swarm.wc', asked)
+    on = (asked ?? sessionStorage.getItem('swarm.wc')) === 'b'
+  } catch {
+    // no storage: the address alone decides
+  }
+  // `wcb-on` scopes wc.css's rules for surfaces this file does not draw (the list's name cell, Recent).
+  if (typeof document !== 'undefined') document.documentElement.classList.toggle('wcb-on', on)
+  return on
+}
