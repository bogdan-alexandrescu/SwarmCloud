+
+/** Steps by stage: a stage holds every step whose dependencies ran in earlier stages. */
+function stages(b: Brief): string[][] {
+  const left = b.steps.map((s) => s.id)
+  const done = new Set<string>()
+  const out: string[][] = []
+  while (left.length > 0) {
+    const ready = left.filter((id) => (b.steps.find((s) => s.id === id)?.after ?? []).every((d) => done.has(d)))
+    const stage = ready.length > 0 ? ready : [left[0]!]
+    out.push(stage)
+    for (const id of stage) {
+      done.add(id)
+      left.splice(left.indexOf(id), 1)
+    }
+  }
+  return out
+}
+
+function Steps({ b }: { b: Brief }) {
