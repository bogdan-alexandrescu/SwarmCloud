+                      <span className="mono ab-dim">{s.id}</span>
+                      {s.after.length > 0 && <span className="ab-after">after {s.after.map((d) => `step ${num(d)}`).join(', ')}</span>}
+                    </p>
+                    <ul className="ab-sfiles">
+                      {s.files.map((f) => {
