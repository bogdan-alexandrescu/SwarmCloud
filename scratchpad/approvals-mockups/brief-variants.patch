+                          </li>
+                        )
+                      })}
+                    </ul>
+                  </article>
+                )
+              })}
+            </div>
+          </li>
+        ))}
+      </ol>
+    </Card>
+  )
+}
+
+function Overlaps({ b }: { b: Brief }) {
