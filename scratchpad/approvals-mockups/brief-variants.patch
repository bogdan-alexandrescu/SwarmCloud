+.ab-page .ab-sfiles .mono, .ab-page .ab-tf, .ab-page .ab-over-t .ab-dim, .ab-page .ab-step-m .mono { font-size: 12px; }
+
+/* ---- the header ---------------------------------------------------------- */
+.ab-head {
+  display: grid; gap: 10px; padding: 18px 20px 16px; min-width: 0;
+  background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
