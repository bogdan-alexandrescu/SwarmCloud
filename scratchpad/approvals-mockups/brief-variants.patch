+// MOCK-HOOK FILE
+// The plan sections a parallel lane adds to the planner (purpose, why,
+// changes, risk, validation, graph), as the brief page reads them. The run
+// behind run:run_9b8af0113faa4165ab8e is the fixture: its issue, its one step,
+// its five files, its estimate, its three overlaps and its four requirements
+// are the run's; every field the planner does not serve yet is invented here.
+// The two other plans are invented outright: a high-risk plan that touches
+// admission and the frozen contract, and a three-step plan with dependencies.
+
+export type ChangeKind = 'add' | 'modify' | 'delete' | 'test'
+export type RiskLevel = 'low' | 'medium' | 'high'
+export type NodeKind = 'changed' | 'caller' | 'test'
+export type EdgeKind = 'calls' | 'imports' | 'tests'
+
+export interface BriefChange {
+  path: string
+  area: string
+  kind: ChangeKind
+  what: string
+  step: number
+}
+export interface BriefNode {
+  id: string
+  file: string
+  symbol: string
+  kind: NodeKind
+  /** A changed node's area: the graph groups changed files by it. */
+  area?: string
+  what: string
+  /** A changed node's step, drawn as its badge on a plan of several steps. */
+  step?: number
+  /** A test the plan adds, rather than one that already covers the file. */
+  added?: boolean
+}
+export interface BriefEdge {
+  from: string
+  to: string
+  kind: EdgeKind
+}
+export interface BriefStep {
+  id: string
+  title: string
+  files: string[]
+  after: string[]
+  hours: number
+  prompt: string
+}
+export interface BriefOverlap {
+  pr: number
+  title: string
+  where: string
+  files: string[]
+  effect: string
+  /** MOCK-HOOK: what the PR itself does to the shared files, one line. */
+  theirs?: string
+}
+export interface BriefInvariant {
+  n: number
+  words: string
+}
+export interface Brief {
+  approvalId: string
+  runId: string
+  issue: { number: number; title: string; url: string }
+  askedAt: string
+  expiresAt: string
+  purpose: string
+  why: { line: string; evidence: string[] }
+  estimateHours: number
+  changes: BriefChange[]
+  risk: {
+    level: RiskLevel
+    factors: string[]
+    blast: string
+    invariants: BriefInvariant[]
+    frozen: string[]
+    mitigations: string[]
+    rollback: string
+  }
+  requirements: { id: string; words: string; proofs: string[] }[]
+  validation: {
+    tests: { file: string; proves: string; req: string[] }[]
+    qa: { check: string; who: string; where: string }[]
+  }
+  graph: { nodes: BriefNode[]; edges: BriefEdge[] }
+  steps: BriefStep[]
+  overlaps: BriefOverlap[]
+  workflowId: string
+}
+
+const API = 'apps/swarm-api/swarm_api'
+const CP = 'tests/unit/control_plane'
+
+const OVERLAP_PROMPT = `Issue #3507: a run lane's plan names no overlap with work already in the merge train.
+
+Add overlap_refs(ctx, tenant_id, files) to ${API}/plancontext.py: read the merge train's open pull requests (mergetrain.train_order), keep those whose changed files share a territory with the step's files (issueruns.territory_overlap), and return, for each, its number, its train position and the shared files. Bound the read to 2 s; on a timeout or an unreadable train return no overlaps and the reason, never fail the planning.
+
+Extend issueruns.PlanOverlap with pr, position and files; PlanSpec.overlaps defaults to [] so a stored plan without it still parses.
+
+Serve plan.overlaps from GET /v1/runs/{run_id} in ${API}/routes/runs.py, [] when there is none.
+
+Red first: ${CP}/test_plancontext_overlap.py and ${CP}/test_runs_overlap_ref.py, committed failing before the change.
+
+Do not touch apps/common/swarm_common/. Do not change the hold logic in _territory_hold: the overlap is read, not enforced.`
+
+/** The fixture: issue 3507, one step over five files. */
+const OVERLAP: Brief = {
+  approvalId: 'run:run_9b8af0113faa4165ab8e',
+  runId: 'run_9b8af0113faa4165ab8e',
+  issue: { number: 3507, title: 'A run lane’s plan names no overlap with work already in the merge train', url: 'https://github.com/saga-xyz/swarm/issues/3507' },
+  askedAt: '2026-11-06T09:12:00Z',
+  expiresAt: '2026-11-08T09:12:00Z',
