+      summary: 'Plan for northwind-crm#412: 4 steps, about 2 hours of agent time', state: 'pending',
+      requested_at: ago(35 * MIN), expires_at: new Date(HOME_NOW + 23 * HOUR).toISOString(), approver_names: [HOME_ME.name],
+    }],
+  }
+}
+
+/** `/v1/onboarding`'s `config_setup.people` for the acting workspace, counted from the overrides above (today's fixture says "only you"). */
+export function homesetPeopleSetup(tenant: string) {
+  if (!HOME_WORKSPACES.some((w) => w.tenant_id === tenant)) {
+    return { applies: false, done: null, holders: null, admins: null, pending: null, reason: 'a personal workspace has nobody to invite', pending_reason: null }
+  }
+  const mine = OVERRIDES.filter((o) => o.tenant === tenant)
+  return { applies: true, done: mine.length > 0, holders: mine.length, admins: mine.filter((o) => o.role === 'admin').length, pending: 0, reason: null, pending_reason: null }
+}
+
+/** A workspace's platform memberships: engineering let 2 people in by an approved join request; the others none. */
+export function homesetMembers(tenant: string) {
+  const let_in = tenant === 'eng' ? [HOME_PEOPLE[10], HOME_PEOPLE[11]].filter((p): p is HomePerson => p !== undefined) : []
+  return {
+    platform_memberships: true,
+    members: let_in.map((p, n) => ({ email: p.email, by: n === 0 ? 'ana.moreau@example.com' : 'bogdan@example.com', at: ago((2 + 3 * n) * DAY), via: 'join_request', group_changed: n === 1, still_in_group: n === 0 ? true : null })),
+  }
+}
+/** The 'place' direction reads a workspace's roster and the role holders directly (each the shape of a route it already reads). */
+export const homesetRoster = roster // MOCK-HOOK
+export const HOME_OVERRIDES: readonly { tenant: string; email: string; role: string; reason: string; in_group: boolean }[] = OVERRIDES // MOCK-HOOK
+export const homesetPeopleDoc = people // MOCK-HOOK
+export const homesetScopedPeopleDoc = scopedPeople // MOCK-HOOK
+
+/**
+ * `GET /v1/notifications` for the hard case (fix-place): the bell and the Admin badges count what Home's band lists, so
+ * the platform admin's bell says 7 and Platform people's badge 3, and the member's bell is empty. Nothing waits on the
+ * workspace admin: no request to join engineering or design is open.
+ */
+export function homesetNotifications() {
+  const at = (ms: number) => ago(ms)
+  const items = !isAdmin
+    ? []
+    : [
+        { id: 'task:q1', group: 'needs_you', needs_you: true, title: 'An agent asks you a question', detail: 'Keep the old export format for one more release?', href: '/', at: at(7 * HOUR), read: false },
+        { id: 'task:q2', group: 'needs_you', needs_you: true, title: 'An agent asks you a question', detail: 'May the agent rename the public settings route?', href: '/', at: at(7 * HOUR), read: false },
+        { id: 'approval:apr_hs1', group: 'needs_you', needs_you: true, title: 'A plan waits for your approval', detail: null, href: '/automate/approvals', at: at(35 * MIN), read: false },
+        { id: 'task:hand', group: 'needs_you', needs_you: true, title: 'An agent waits for a person at its browser', detail: null, href: '/', at: at(4 * MIN), read: false },
+        { id: 'admin:ws:wsr_w-tomas', group: 'admin', needs_you: true, title: 'tomas.garcia@example.com asked for a workspace', detail: null, href: '/admin/people', at: at(160 * MIN), read: false },
+        { id: 'admin:ws:wsr_w-priya', group: 'admin', needs_you: true, title: 'Priya Raman asked for a workspace', detail: null, href: '/admin/people', at: at(85 * MIN), read: false },
+        { id: 'admin:loan:u-kenji', group: 'admin', needs_you: true, title: 'Kenji Sato asks to borrow a Claude account', detail: null, href: '/admin/people', at: at(25 * MIN), read: false },
+      ]
+  return { items, unread_needs_you: items.length, unread_updates: 0, admin_pending: isAdmin ? 3 : 0, tenants_waiting: null, platform_secrets_unset: null, read_at: new Date(HOME_NOW).toISOString() }
+}
