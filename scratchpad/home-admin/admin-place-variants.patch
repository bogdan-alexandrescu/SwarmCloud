+function rows(): Row[] {
+  const out: Row[] = HOME_PEOPLE.map((p: HomePerson) => ({ ...p, own: {}, signedIn: true }))
+  for (const o of HOME_OVERRIDES) {
+    let row = out.find((r) => r.email === o.email)
+    if (row === undefined) {
+      row = { email: o.email, name: null, workspace: '', state: 'none', roles: Object.fromEntries(HOME_WORKSPACES.map((w) => [w.tenant_id, 'none'])), own: {}, platform_admin: false, github: 'none', last_active: null, signedIn: false }
