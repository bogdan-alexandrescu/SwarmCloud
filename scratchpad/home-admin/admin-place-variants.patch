+// MOCK-HOOK FILE
+// THE HOME REDRAW SCAFFOLD (mock-ups of 2 November 2026, step 'foundation').
+// While `?homeset=<direction>` names a direction other than `today`, App.tsx
+// draws this in the console's main slot whatever the route: the direction's
+// screen named by `?homescreen=` in the state named by `?homestate=`. The
+// left menu and the header stay the console's own. `base` is the plain,
+// neutral layout: every item of features.md placed once, from the console's
+// existing page components; `desk` and `place` start as copies of it.
+import { useEffect, useState, type ReactNode } from 'react'
+import { loadApprovals, loadPeople, loadStats, loadTasks, type ApprovalItem } from '../api'
+import type { PeopleDoc, PersonRow, Stats, Task } from '../types'
+import type { Result } from '../fetch'
+import { Card, StatTile, ButtonLink, type TileValue } from '../components'
+import { OverviewScreen } from '../Overview'
+import { SetupCard } from '../Onboarding'
+import { WaitingOnYouCard } from '../Schedules'
+import { WorkspacePeopleScreen } from '../WorkspacePeople'
+import { WorkspaceSettingsScreen } from '../WorkspaceSettings'
+import { PeopleScreen, waitingRequests } from '../People'
+import { PersonWorkspaceRoles } from '../WorkspaceRolesAdmin'
+import { WorkspacesYouAdminScreen } from '../WorkspacesYouAdmin'
+import { needsYou, ownerQuestionsHold } from '../Handoff'
+import { agentPath } from '../OverviewRegions'
+import { HOMESET, HOMESCREEN, HOMESTATE, HOME_ME, HOME_PERSONA, HOME_PEOPLE, HOME_ADMINISTERED, HOME_WORKSPACES, HOME_OVERRIDE_NOT_IN_GROUP } from './fixtures'
+import '../styles/homeredraw.css'
+import { PLACE_SCREENS } from './place/Place' // MOCK-HOOK
+
+export const HOME_SCREENS = ['home', 'overview', 'people', 'person', 'settings', 'workspaces'] as const
+export type HomeScreen = (typeof HOME_SCREENS)[number]
+export const HOME_STATES = ['rest', 'answer', 'answered', 'open', 'changed'] as const
+export type HomeState = (typeof HOME_STATES)[number]
+export const HOME_DIRECTIONS = ['base', 'today', 'desk', 'place'] as const
+
+export interface ScreenProps {
+  go: (to: string) => void
+  state: HomeState
+}
+
+const SCREEN_WORDS: Readonly<Record<HomeScreen, string>> = {
+  home: 'Home', overview: 'Overview', people: 'People and roles', person: 'One person', settings: 'Workspace settings', workspaces: 'Workspaces you admin',
+}
+
+/** A read, as a hook: null until it lands. */
+export function useRead<T>(load: () => Promise<Result<T>>): Result<T> | null {
+  const [r, setR] = useState<Result<T> | null>(null)
+  useEffect(() => {
+    let live = true
+    void load().then((x) => live && setR(x))
+    return () => {
+      live = false
+    }
+  }, [load])
+  return r
+}
+
+const readTasks = () => loadTasks()
+const readStats = () => loadStats()
+const readApprovals = () => loadApprovals()
+const readPeople = () => loadPeople()
+
+function dataOf<T>(r: Result<T> | null): T | null {
+  return r !== null && (r.status === 'ok' || r.status === 'stale') ? r.data : null
+}
+
+/** A count tile: a dash with its reason until the read lands, never a zero. */
+function tile(n: number | null, why: string, note?: string): TileValue {
+  return n === null ? { kind: 'unknown', why } : { kind: 'value', value: n, ...(note === undefined ? {} : { note }) }
+}
+
+/** What waits on the signed-in person, from the reads the console already makes. */
+export function useWaiting() {
+  const tasks = dataOf(useRead(readTasks))?.tasks ?? null
+  const approvals = useRead(readApprovals)
+  const peopleRead = useRead(readPeople)
+  const people = dataOf(peopleRead)
+  const questions = tasks === null ? null : tasks.filter((t) => ownerQuestionsHold(t) !== null && t.submitted_by === HOME_ME.email)
+  const handoffs = tasks === null ? null : tasks.filter(needsYou)
+  const failed = tasks === null ? null : tasks.filter((t) => (t.state === 'FAILED' || t.state === 'DEAD_LETTERED') && t.submitted_by === HOME_ME.email)
+  const approvalList: ApprovalItem[] | null = approvals === null ? null : approvals.status === 'empty' ? [] : (dataOf(approvals)?.approvals ?? null)
+  const requests = people !== null && (people as PeopleDoc).scope === 'platform' ? waitingRequests((people as PeopleDoc).people as PersonRow[]) : people === null && peopleRead?.status !== 'error' ? null : []
+  return { tasks, questions, handoffs, failed, approvals: approvalList, requests }
+}
+
+function TaskLine({ t, say }: { t: Task; say: string }) {
+  const title = typeof t.metadata?.title === 'string' ? t.metadata.title : t.id
+  return (
+    <li>
+      <a href={agentPath(t)}>{title}</a> <small>{say}</small>
+    </li>
+  )
+}
+
+/** HOME (base): what waits on you, then the deployment in numbers. Overview stays its own screen. */
+function BaseHome({ go, state }: ScreenProps) {
+  const w = useWaiting()
+  const stats: Stats | null = dataOf(useRead(readStats))
+  const by = stats?.tasks_by_state ?? null
+  const sum = (ks: string[]) => (by === null ? null : ks.reduce((n, k) => n + (by[k] ?? 0), 0))
+  const total = (xs: unknown[] | null) => (xs === null ? null : xs.length)
+  return (
+    <div className="hr-stack">
+      <Card title="Waiting on you">
+        <div className="hr-tiles">
+          <StatTile label="Questions for you" tile={tile(total(w.questions), 'tasks not read yet')} />
+          <StatTile label="Approvals" tile={tile(total(w.approvals), 'approvals not read yet')} />
+          {HOME_PERSONA === 'platform-admin' && <StatTile label="Requests" tile={tile(total(w.requests), 'people not read yet')} />}
+          <StatTile label="Your failures today" tile={tile(total(w.failed), 'tasks not read yet', 'of the newest read')} />
+        </div>
+        <ul className="hr-list">
+          {(w.questions ?? []).map((t) => (
+            <TaskLine key={t.id} t={t} say={ownerQuestionsHold(t)?.questions[0]?.question ?? 'a question waits for your answer'} />
+          ))}
+          {(w.handoffs ?? []).map((t) => <TaskLine key={t.id} t={t} say="waits for a person at its browser" />)}
+          {(w.approvals ?? []).map((a) => (
+            <li key={a.approval_id}>
+              <a href="/automate/approvals">{a.summary}</a> <small>approval</small>
+            </li>
+          ))}
+          {(w.requests ?? []).map((r) => (
+            <li key={`${r.kind}-${r.row.email}`}>
+              <a href="/admin/people">{r.row.display_name ?? r.row.email}</a> <small>{r.kind === 'workspace' ? 'asks for a workspace' : 'asks to borrow a Claude account'}</small>
+            </li>
+          ))}
+          {(w.failed ?? []).map((t) => <TaskLine key={t.id} t={t} say={t.last_error ?? 'failed'} />)}
+        </ul>
+        <WaitingOnYouCard go={go} />
+      </Card>
+      <Card title="The deployment">
+        <div className="hr-tiles">
+          <StatTile label="Holding capacity" tile={tile(sum(['LEASED', 'DISPATCHED', 'STARTING', 'RUNNING']), 'stats not read yet')} />
+          <StatTile label="Waiting" tile={tile(sum(['QUEUED', 'READY', 'PARKED']), 'stats not read yet', 'costs nothing')} />
+          <StatTile label="Failed" tile={tile(sum(['FAILED', 'DEAD_LETTERED']), 'stats not read yet')} />
+        </div>
+        <details open={state === 'open'}>
+          <summary>What these count</summary>
+          <p>Holding capacity is every agent leased, dispatched, starting or running; waiting ones cost nothing until a pool has room. Overview breaks each down by state.</p>
+        </details>
+        <ButtonLink kind="secondary" href="/overview">Open Overview</ButtonLink>
+      </Card>
+      <SetupCard />
+    </div>
+  )
+}
+
+function BaseOverview({ go }: ScreenProps) {
+  return <OverviewScreen setup={<SetupCard />} waitingOnYou={<WaitingOnYouCard go={go} />} />
+}
+
+/** People and roles: the workspace's own page, then (an admin) the platform's people and the workspace roles grid. */
+function BasePeople() {
+  return (
+    <div className="hr-stack">
+      <WorkspacePeopleScreen view={null} />
+      {HOME_PERSONA !== 'member' && <PeopleScreen />}
+    </div>
+  )
+}
+
+/** One person: their roles in every group workspace (the Manage drawer's part a page of its own would hold). */
+function BasePerson() {
+  const email = new URLSearchParams(window.location.search).get('homeperson') ?? 'maximiliana.kowalczyk-wisniewska.contractor@example.com'
+  if (HOME_PERSONA !== 'platform-admin') {
+    return (
+      <Card title="One person">
+        <p>Only a platform admin reads a person's roles across workspaces; this read would be refused.</p>
+      </Card>
+    )
+  }
+  return <PersonWorkspaceRoles email={email} platformAdmin={HOME_PEOPLE.some((p) => p.email === email && p.platform_admin)} />
+}
+
+function BaseSettings({ go }: ScreenProps) {
+  return (
+    <div className="hr-stack">
+      <WorkspaceSettingsScreen part="settings" go={go} />
+      <WorkspaceSettingsScreen part="setup" go={go} />
+      {HOME_PERSONA === 'platform-admin' && <WorkspaceSettingsScreen part="new" go={go} />}
+    </div>
+  )
+}
+
+function BaseWorkspaces({ go }: ScreenProps) {
+  return <WorkspacesYouAdminScreen go={go} />
+}
+
+const BASE: Readonly<Record<HomeScreen, (p: ScreenProps) => ReactNode>> = {
+  home: BaseHome, overview: BaseOverview, people: BasePeople, person: BasePerson, settings: BaseSettings, workspaces: BaseWorkspaces,
+}
+
+/** Each direction's screens. A direction step replaces its entry; until then it draws the base layout and says so. */
+export const DIRECTIONS: Record<string, { screens: Readonly<Record<HomeScreen, (p: ScreenProps) => ReactNode>>; fromBase: boolean }> = {
+  base: { screens: BASE, fromBase: false },
+  desk: { screens: BASE, fromBase: true },
+  place: { screens: PLACE_SCREENS, fromBase: false }, // MOCK-HOOK
+}
+
+function switchHref(key: string, value: string): string {
+  const q = new URLSearchParams(window.location.search)
+  q.set(key, value)
+  return `${window.location.pathname}?${q.toString()}`
+}
+
+export function HomeRedraw({ go }: { go: (to: string) => void }) {
+  const direction = DIRECTIONS[HOMESET ?? 'base'] ?? DIRECTIONS.base!
+  const screen: HomeScreen = (HOME_SCREENS as readonly string[]).includes(HOMESCREEN) ? (HOMESCREEN as HomeScreen) : 'home'
+  const state: HomeState = (HOME_STATES as readonly string[]).includes(HOMESTATE) ? (HOMESTATE as HomeState) : 'rest'
+  const Screen = direction.screens[screen]
+  return (
+    <div className="hr-frame" data-homeset={HOMESET ?? 'base'} data-homescreen={screen} data-homestate={state}>
+      <nav className="hr-switch" aria-label="Mock-up screens">
+        {HOME_SCREENS.map((s) => (
+          <a key={s} href={switchHref('homescreen', s)} aria-current={s === screen ? 'page' : undefined}>
+            {SCREEN_WORDS[s]}
+          </a>
+        ))}
+      </nav>
+      {direction.fromBase && <p className="hr-note">This direction is not drawn yet: it shows the base layout.</p>}
+      <Screen go={go} state={state} />
+      <p className="hr-note">
+        {HOME_WORKSPACES.length} group workspaces · {HOME_PEOPLE.length} people signed in · you administer {HOME_ADMINISTERED.length} · {HOME_OVERRIDE_NOT_IN_GROUP.length} role kept for someone not in the group yet
+      </p>
+    </div>
+  )
+}
