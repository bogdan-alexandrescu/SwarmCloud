+// MOCK-HOOK FILE
+// The 'place' direction's screens, as HomeRedraw's DIRECTIONS entry: "One Home, and a page per workspace".
+import type { ReactNode } from 'react'
+import { HOME_PERSONA } from '../fixtures'
+import { PlaceHome } from './PlaceHome'
+import { PlacePeople, PlaceWorkspace, PlaceWorkspaces } from './PlacePeople'
+import { PLACE_WHO } from './common'
+import '../../styles/homeredraw-place.css'
+
+type P = { go: (to: string) => void; state: string }
+
+export const PLACE_SCREENS: Readonly<Record<'home' | 'overview' | 'people' | 'person' | 'settings' | 'workspaces', (p: P) => ReactNode>> = {
+  home: (p) => <PlaceHome {...p} at="home" who={PLACE_WHO} />,
+  overview: (p) => <PlaceHome {...p} at="overview" who={PLACE_WHO} />,
+  // A member has no Platform people: their People and roles is their workspace's People tab.
+  people: (p) => (HOME_PERSONA === 'member' ? <PlaceWorkspace {...p} /> : <PlacePeople {...p} />),
+  person: (p) => <PlacePeople {...p} />,
+  settings: (p) => <PlaceWorkspace {...p} />,
+  workspaces: (p) => <PlaceWorkspaces {...p} />,
+}
diff --git a/apps/swarm-ui/src/homeredraw/place/PlaceHome.tsx b/apps/swarm-ui/src/homeredraw/place/PlaceHome.tsx
