+function TabsInto({ children }: { children: ReactNode }) {
+  const [host, setHost] = useState<HTMLElement | null>(null)
+  useEffect(() => {
+    let n = 0
+    const find = () => {
+      const el = document.querySelector<HTMLElement>('#pl-dep .ov-page')
+      if (el !== null) setHost(el)
+      else if ((n += 1) < 100) window.setTimeout(find, 50)
+    }
+    find()
+  }, [])
+  return host === null ? null : createPortal(<div className="pl-into">{children}</div>, host)
+}
+
+/** The pools at their ceiling, each openable: what holds it and what waits on it. */
+function FullPools({ pools, tasks, cap, open }: { pools: Pool[] | null; tasks: Task[] | null; cap: Capacity | null; open: boolean }) {
+  const [opened, setOpened] = useState<string | null>(open && pools !== null && pools[0] !== undefined ? pools[0].name : null)
+  useEffect(() => {
+    if (open && opened === null && pools?.[0] !== undefined) setOpened(pools[0].name)
+  }, [open, opened, pools])
+  const binds = useMemo(() => {
+    const m = new Map<string, string[]>()
+    for (const [name, p] of Object.entries(cap?.runner_profiles ?? {})) for (const pool of p.pools) m.set(pool, [...(m.get(pool) ?? []), name])
+    return m
+  }, [cap])
+  if (pools === null) return <p className="pl-dim"><Dash why="pool state not read yet" /> reading the pools…</p>
+  if (pools.length === 0) return null
+  return (
+    <Card className="pl-full" title={<>At its ceiling <span className="pl-cnt">{pools.length}</span></>} action={<a className="c-link is-card" href="/admin/limits">Pool limits &rarr;</a>}>
+      {pools.map((p) => {
+        const profiles = binds.get(p.name) ?? []
+        const holding = (tasks ?? []).filter((t) => LIVE.includes(t.state) && profiles.includes(t.runner_profile ?? ''))
+        const waiting = (tasks ?? []).filter((t) => t.state === 'READY' && profiles.includes(t.runner_profile ?? ''))
+        const isOpen = opened === p.name
+        const byProfile = (xs: Task[]) => profiles.map((pr) => [pr, xs.filter((t) => t.runner_profile === pr).length] as const).filter(([, n]) => n > 0)
+        return (
+          <div key={p.name} className={`pl-pool${isOpen ? ' is-open' : ''}`}>
+            <button type="button" className="pl-pool-h" aria-expanded={isOpen} onClick={() => setOpened(isOpen ? null : p.name)}>
+              <ToneMark tone="bad" />
+              <b className="pl-id">{p.name}</b>
+              <span className="pl-meter" aria-hidden="true"><i style={{ width: '100%' }} /></span>
+              <span className="pl-num">{p.active} of {p.effective_limit} units</span>
+              <span className="pl-num">{tasks === null ? <Dash why="agents not read" /> : waiting.length} wait on it</span>
+              <span className="pl-chev" aria-hidden="true">{isOpen ? '▾' : '▸'}</span>
+            </button>
+            {isOpen && (
+              <div className="pl-pool-b">
+                <div className="pl-pool-col">
+                  <h3>Holding it <span className="pl-cnt">{holding.length}</span></h3>
+                  <ul className="pl-chips">
+                    {byProfile(holding).map(([pr, n]) => (
+                      <li key={pr}><Chip>{pr} · {n}</Chip></li>
+                    ))}
+                  </ul>
+                  <ul className="pl-mlist">
+                    {holding.slice(0, 6).map((t) => (
+                      <li key={t.id}><StatePill state={t.state} small /><a href={agentPath(t)}>{titleOf(t)}</a><small>{ago(t.created_at)}</small></li>
+                    ))}
+                  </ul>
+                  {holding.length > 6 && <a className="pl-more" href={`/capacity/holders?pool=${encodeURIComponent(p.name)}`}>All {holding.length} holders &rarr;</a>}
+                </div>
+                <div className="pl-pool-col">
+                  <h3>Waiting on it <span className="pl-cnt">{waiting.length}</span></h3>
+                  <ul className="pl-chips">
+                    {byProfile(waiting).map(([pr, n]) => (
+                      <li key={pr}><Chip tone="park">{pr} · {n}</Chip></li>
+                    ))}
+                  </ul>
+                  <ul className="pl-mlist">
+                    {waiting.slice(0, 6).map((t) => (
+                      <li key={t.id}><StatePill state={t.state} small /><a href={agentPath(t)}>{titleOf(t)}</a><small>{ago(t.created_at)}</small></li>
+                    ))}
+                  </ul>
+                  {waiting.length > 6 && <a className="pl-more" href="/agents/waiting">All {waiting.length} waiting &rarr;</a>}
+                </div>
+                <details className="pl-why">
+                  <summary>What these count</summary>
+                  <p>
+                    Holding: agents leased, dispatched, starting or running on a runner profile that binds {p.name}. Waiting: ready agents on those profiles; they cost nothing until it has room. Both are
+                    of the {tasks?.length ?? 0} newest agents read. Pools are reserved all at once, so an agent may also wait on another pool.
+                  </p>
+                </details>
+              </div>
+            )}
+          </div>
+        )
+      })}
+    </Card>
+  )
+}
