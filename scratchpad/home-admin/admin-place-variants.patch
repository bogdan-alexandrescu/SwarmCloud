+// MOCK-HOOK FILE
+// The left menu's Home panel in the 'place' direction: the personal band, then the deployment's five tabs.
+// A tab's count is the Overview count of the region it shows (count: the key Overview publishes). Failures reads the
+// tab's own count, failed and dead-lettered (5), which PlaceHome publishes as pl-failures: Overview's ov-failures
+// counts the cancelled with them (8), and one page may not give two numbers for one thing (fix-place).
+// Each id is an element on the Home page; a tab's link also selects its tab (PlaceHome listens for it).
+// A person with no workspace yet is shown no deployment, so their panel lists only For you.
+import { PLACE_WHO } from './common'
+
+export const PLACE_JUMPS: readonly { id: string; label: string; count?: string }[] =
+  PLACE_WHO === 'new'
+    ? [{ id: 'pl-you', label: 'For you' }]
+    : [
+        { id: 'pl-you', label: 'For you' },
+        { id: 'pl-tab-now', label: 'Now', count: 'ov-running' },
+        { id: 'pl-tab-waiting', label: 'Waiting', count: 'ov-waiting' },
+        { id: 'pl-tab-failures', label: 'Failures', count: 'pl-failures' },
+        { id: 'pl-tab-spend', label: 'Spend' },
+        { id: 'pl-tab-capacity', label: 'Capacity' },
+      ]
