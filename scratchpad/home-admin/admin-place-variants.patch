index 0000000..85f4f86
--- /dev/null
+++ b/apps/swarm-ui/src/homeredraw/place/PlaceHome.tsx
@@ -0,0 +1,514 @@
+// MOCK-HOOK FILE
+// THE 'place' DIRECTION'S HOME (mock-ups of 2 November 2026): Overview made
+// personal. On top, a band for the signed-in person -- what waits on them,
+// acted on in place, their own work and Start. Below it, the deployment: the
+// lifecycle numbers, then five tabs (Now, Waiting, Failures, Spend, Capacity)
+// over today's Overview regions, in place of one long column. `/overview`
+// opens this same page at its deployment part; the left menu keeps one item.
+import { useEffect, useMemo, useState, type ReactNode } from 'react'
+import { createPortal } from 'react-dom'
+import { loadCapacity, loadPeople, loadStats, loadTasks, loadApprovals, type ApprovalItem } from '../../api'
+import type { Capacity, PeopleDoc, PersonRow, Pool, Stats, Task } from '../../types'
+import type { Result } from '../../fetch'
+import { Button, ButtonLink, Card, Chip, Dash, Dialog, StatePill, Tabs, ToneMark, type TabDef } from '../../components'
+import { OverviewScreen } from '../../Overview'
+import { needsYou, ownerQuestionsHold } from '../../Handoff'
+import { agentPath } from '../../OverviewRegions'
+import { waitingRequests } from '../../People'
+import { HOME_ME, HOME_NOW, HOME_PERSONA } from '../fixtures'
+import { ago, dataOf, initials, useRead, type PlaceProps } from './common'
+
+const LIVE = ['LEASED', 'DISPATCHED', 'STARTING', 'RUNNING']
+const WAITS = ['QUEUED', 'READY', 'PARKED']
+const BAD = ['FAILED', 'DEAD_LETTERED']
+
+const readTasks = () => loadTasks()
+const readStats = () => loadStats()
+const readApprovals = () => loadApprovals()
+const readPeople = () => loadPeople()
+const readCapacity = () => loadCapacity()
+
+const titleOf = (t: Task) => (typeof t.metadata?.title === 'string' ? t.metadata.title : t.id)
+const sum = (by: Record<string, number> | null, ks: string[]) => (by === null ? null : ks.reduce((n, k) => n + (by[k] ?? 0), 0))
+
+export const DEP_TABS = ['now', 'waiting', 'failures', 'spend', 'capacity'] as const
+export type DepTab = (typeof DEP_TABS)[number]
+
+/** One thing waiting on the signed-in person, in the order the band draws them. */
+type Wait =
+  | { kind: 'question'; t: Task; q: string }
+  | { kind: 'approval'; a: ApprovalItem }
+  | { kind: 'browser'; t: Task }
+  | { kind: 'request'; row: PersonRow; loan: boolean; at: string | null }
+
+const KIND_WORD: Record<Wait['kind'], string> = { question: 'Question', approval: 'Plan to approve', browser: 'At a browser', request: 'Request' }
+
+/** The answer the 'answer' frame shows typed (an invented sentence, nothing secret). */
+const TYPED_ANSWER = 'Yes, keep the old export for one more release, and say in the changelog that 3.0 drops it.'
+
+export function PlaceHome({ state, at, who }: PlaceProps & { at: 'home' | 'overview'; who: 'person' | 'new' }) {
+  const tasksR = useRead(readTasks)
+  const statsR = useRead(readStats)
+  const approvalsR = useRead(readApprovals)
+  const peopleR = useRead(readPeople)
+  const capR = useRead(readCapacity)
+  const tasks = dataOf(tasksR)?.tasks ?? null
+  const stats: Stats | null = dataOf(statsR)
+  const cap: Capacity | null = dataOf(capR)
+  const answered = state === 'answered'
+  const [tab, setTab] = useState<DepTab>(() => {
+    const t = new URLSearchParams(window.location.search).get('tab')
+    return (DEP_TABS as readonly string[]).includes(t ?? '') ? (t as DepTab) : state === 'open' ? 'capacity' : 'now'
+  })
+  // The left menu's Home panel links each tab by id (place/jumps.ts): a click there selects it.
+  useEffect(() => {
+    const on = (e: MouseEvent) => {
+      const a = (e.target as HTMLElement | null)?.closest?.('a.sk-oj') as HTMLAnchorElement | null
+      const id = a?.getAttribute('href')?.split('#')[1] ?? ''
+      if (id.startsWith('pl-tab-')) setTab(id.slice(7) as DepTab)
+    }
+    document.addEventListener('click', on, true)
+    return () => document.removeEventListener('click', on, true)
+  }, [])
+
+  if (who === 'new') return <NewPerson />
+
+  const waits: Wait[] = []
+  for (const t of tasks ?? []) {
+    const q = ownerQuestionsHold(t)?.questions[0]?.question
+    if (q !== undefined && q !== null && t.submitted_by === HOME_ME.email) waits.push({ kind: 'question', t, q })
+  }
+  const approvals: ApprovalItem[] | null = approvalsR === null ? null : approvalsR.status === 'empty' ? [] : (dataOf(approvalsR)?.approvals ?? null)
+  for (const a of approvals ?? []) waits.push({ kind: 'approval', a })
+  for (const t of (tasks ?? []).filter(needsYou)) waits.push({ kind: 'browser', t })
+  const people = dataOf(peopleR) as PeopleDoc | null
+  if (people !== null && people.scope === 'platform') {
+    for (const r of waitingRequests(people.people as PersonRow[])) waits.push({ kind: 'request', row: r.row, loan: r.kind === 'loan', at: r.at })
+  }
+  const shown = answered ? waits.filter((w) => !(w.kind === 'question' && w === waits[0])) : waits
+  const mine = (tasks ?? []).filter((t) => t.submitted_by === HOME_ME.email)
+  // An agent already in Waiting on you (at a browser) is not listed again under Your work; it is still counted there.
+  const listed = new Set(waits.flatMap((w) => (w.kind === 'browser' || w.kind === 'question' ? [w.t.id] : [])))
+  const myLive = mine.filter((t) => LIVE.includes(t.state))
+  const myLiveRows = myLive.filter((t) => !listed.has(t.id))
+  const myFailed = mine.filter((t) => BAD.includes(t.state))
+  const resumed = answered ? (waits[0]?.kind === 'question' ? waits[0].t : null) : null
+  const by = stats?.tasks_by_state ?? null
+  const full = cap === null ? null : cap.pools.filter((p) => p.enabled && p.effective_limit !== null && p.effective_limit > 0 && p.active >= p.effective_limit)
+  const count = (n: number | null): number | null => n
+  const depTabs: TabDef[] = [
+    { key: 'now', label: 'Now', count: count(sum(by, LIVE)) },
+    { key: 'waiting', label: 'Waiting', count: count(sum(by, WAITS)) },
+    { key: 'failures', label: 'Failures', count: count(sum(by, BAD)) },
+    { key: 'spend', label: 'Spend' },
+    { key: 'capacity', label: 'Capacity', count: full === null ? null : full.length === 0 ? undefined : `${full.length} full` },
+  ]
+  const nQuestions = shown.filter((w) => w.kind === 'question').length
+  const nApprovals = shown.filter((w) => w.kind === 'approval').length
+  const nRequests = shown.filter((w) => w.kind === 'request').length
+  const nBrowser = shown.filter((w) => w.kind === 'browser').length
+  const known = tasks !== null && approvals !== null
+  const counts = (
+    <div className="pl-counts" role="list" aria-label="What waits on you, counted">
+      <Count n={known ? shown.length : null} label="wait on you" lead why="the agent list or the approvals are not read yet" />
+      <Count n={tasks === null ? null : nQuestions} label={nQuestions === 1 ? 'question' : 'questions'} why="agents not read yet" />
+      <Count n={approvals === null ? null : nApprovals} label={nApprovals === 1 ? 'approval' : 'approvals'} why="approvals not read yet" />
+      {HOME_PERSONA === 'platform-admin' && <Count n={people === null ? null : nRequests} label={nRequests === 1 ? 'request' : 'requests'} why="people not read yet" />}
+      {nBrowser > 0 && <Count n={nBrowser} label="at a browser" why="" />}
+      <span className="pl-count-sep" aria-hidden="true" />
+      <Count n={tasks === null ? null : myLive.length} label="yours running" why="agents not read yet" />
+      <Count n={tasks === null ? null : myFailed.length} label="yours failed" why="agents not read yet" tone={myFailed.length > 0 ? 'bad' : undefined} note={tasks === null ? undefined : `of the ${tasks.length} newest read`} />
+    </div>
+  )
+  // THE OVERVIEW ADDRESS OPENS THE DEPLOYMENT PART (fix-place): the person's band folds to its counts, one line, with the
+  // way back to it, so the deployment's numbers and tabs are the first screen without a scroll position to keep.
+  if (at === 'overview') {
+    return (
+      <div className="pl-home is-overview">
+        <section className="pl-you is-folded" id="pl-you" aria-label="For you, folded">
+          <a className="pl-fold-h" href="/?homeset=place&homescreen=home">For you</a>
+          {counts}
+        </section>
+        <Deployment tab={tab} setTab={setTab} depTabs={depTabs} full={full} tasks={tasks} cap={cap} open={state === 'open'} />
+      </div>
+    )
+  }
+  return (
+    <div className="pl-home">
+      <section className="pl-you" id="pl-you" aria-labelledby="pl-you-h">
+        <div className="pl-you-head">
+          <span className="pl-ava" aria-hidden="true">{initials(HOME_ME.name)}</span>
+          <div className="pl-you-t">
+            <h1 id="pl-you-h">Home</h1>
+            <p className="pl-sub">
+              {HOME_ME.name}
+              {HOME_PERSONA === 'platform-admin' ? ' · platform admin' : HOME_PERSONA === 'workspace-admin' ? ' · admin of engineering and design' : ' · member'}
+            </p>
+          </div>
+          <div className="pl-you-acts">
+            <ButtonLink kind="primary" href="/submit">Start an agent</ButtonLink>
+          </div>
+        </div>
+        {counts}
+        <div className="pl-you-grid">
+          <Card title="Waiting on you" className="pl-waits" action={shown.length > 0 ? <span className="pl-oldest">oldest first</span> : undefined}>
+            {!known ? (
+              <p className="pl-dim"><Dash why="not read yet" /> reading what waits on you…</p>
+            ) : shown.length === 0 ? (
+              <div className="pl-none">
+                <ToneMark tone="ok" />
+                <div>
+                  <b>Nothing waits on you</b>
+                  <p className="pl-dim">No question, approval or request names you. Your agents carry on without you.</p>
+                </div>
+              </div>
+            ) : (
+              <ul className="pl-wlist">
+                {shown.map((w, i) => (
+                  <WaitRow key={i} w={w} open={state === 'answer' && w === waits[0]} />
+                ))}
+              </ul>
+            )}
+            {resumed !== null && (
+              <p className="pl-said" role="status">
+                <ToneMark tone="ok" /> Answer sent to <a href={agentPath(resumed)}>{titleOf(resumed)}</a>. Its agent is back in line: <StatePill state="READY" small /> it starts when a pool has room.
+              </p>
+            )}
+          </Card>
+          <Card title="Your work" className="pl-mine" action={<a className="c-link is-card" href="/agents/running?mine=1">All yours &rarr;</a>}>
+            {tasks === null ? (
+              <p className="pl-dim"><Dash why="not read yet" /> reading your agents…</p>
+            ) : (
+              <ul className="pl-mlist">
+                {resumed !== null && (
+                  <li className="is-new">
+                    <StatePill state="READY" small />
+                    <a href={agentPath(resumed)}>{titleOf(resumed)}</a>
+                    <small>answered just now</small>
+                  </li>
+                )}
+                {myLiveRows.slice(0, 5).map((t) => (
+                  <li key={t.id}>
+                    <StatePill state={t.state} small />
+                    <a href={agentPath(t)}>{titleOf(t)}</a>
+                    <small>{ago(t.created_at)}</small>
+                  </li>
+                ))}
+                {myLiveRows.length > 5 && <li className="pl-more"><a href="/agents/running?mine=1">{myLiveRows.length - 5} more running</a></li>}
+                {myFailed.map((t) => (
+                  <li key={t.id} className="is-bad">
+                    <StatePill state={t.state} small />
+                    <a href={agentPath(t)}>{titleOf(t)}</a>
+                    <small className="pl-why-line" title={t.last_error ?? undefined}>{t.last_error ?? 'failed'} · {ago(t.updated_at)}</small>
+                  </li>
+                ))}
+                {myLive.length === 0 && myFailed.length === 0 && resumed === null && <li className="pl-dim">None of your agents is running.</li>}
+              </ul>
+            )}
+          </Card>
+        </div>
+      </section>
+
+      <Deployment tab={tab} setTab={setTab} depTabs={depTabs} full={full} tasks={tasks} cap={cap} open={state === 'open'} />
+    </div>
+  )
+}
+
+/**
+ * The deployment: today's Overview with the tab strip drawn into it. No setup card here (fix-place): a workspace's
+ * setup is its own page's Setup tab, and the person's own setup is Home's only content until it is done (NewPerson).
+ */
+function Deployment({ tab, setTab, depTabs, full, tasks, cap, open }: { tab: DepTab; setTab: (t: DepTab) => void; depTabs: TabDef[]; full: Pool[] | null; tasks: Task[] | null; cap: Capacity | null; open: boolean }) {
+  return (
+    <section className="pl-dep" id="pl-dep" data-tab={tab} aria-label="The deployment">
+      <OverviewScreen extraCounts={typeof depTabs[2]?.count !== 'number' ? {} : { 'pl-failures': { n: depTabs[2].count, why: 'failed and dead-lettered today, as the Failures tab counts them' } }} /> {/* MOCK-HOOK */}
+      <TabsInto>
+        <div className="pl-tabs" id={`pl-tab-${tab}`}>
+          <Tabs tabs={depTabs} current={tab} label="The deployment" onSelect={(k) => setTab(k as DepTab)} />
+        </div>
+        {tab === 'capacity' && <FullPools pools={full} tasks={tasks} cap={cap} open={open} />}
+      </TabsInto>
+    </section>
+  )
+}
+
+/** A number and its word; a dash with its reason while the read has not landed. */
+function Count({ n, label, why, lead = false, tone, note }: { n: number | null; label: string; why: string; lead?: boolean; tone?: 'bad'; note?: string }) {
+  return (
+    <span role="listitem" className={`pl-count${lead ? ' is-lead' : ''}${tone === 'bad' ? ' is-bad' : ''}${n === 0 ? ' is-zero' : ''}`} title={note}>
+      <b>{n === null ? <Dash why={why} /> : n}</b> {label}
+      {note !== undefined && <small className="pl-of">{note}</small>}
+    </span>
+  )
+}
+
+function WaitRow({ w, open }: { w: Wait; open: boolean }) {
+  const [answering, setAnswering] = useState(open)
+  const [denying, setDenying] = useState(false)
+  const [lending, setLending] = useState(false)
+  const [done, setDone] = useState<string | null>(null)
+  const head = (title: ReactNode, line: ReactNode, when: string | null) => (
+    <div className="pl-w-t">
+      <span className={`pl-kind is-${w.kind}`}>{w.kind === 'request' && 'loan' in w && w.loan ? 'Claude account loan' : w.kind === 'request' ? 'Workspace request' : KIND_WORD[w.kind]}</span>
+      <b className="pl-w-title">{title}</b>
+      <span className="pl-w-line">{line}</span>
+      {when !== null && <small className="pl-w-age">{ago(when)}</small>}
+    </div>
+  )
+  if (done !== null) {
+    return (
+      <li className="pl-w is-done" role="status">
+        <ToneMark tone="ok" /> {done}
+      </li>
+    )
+  }
+  if (w.kind === 'question') {
+    return (
+      <li className={`pl-w${answering ? ' is-open' : ''}`}>
+        {head(<a href={agentPath(w.t)}>{titleOf(w.t)}</a>, <q>{w.q}</q>, w.t.updated_at)}
+        {answering ? (
+          <form className="pl-answer" onSubmit={(e) => e.preventDefault()}>
+            <label className="pl-lbl" htmlFor={`ans-${w.t.id}`}>Your answer</label>
+            <textarea id={`ans-${w.t.id}`} rows={2} defaultValue={open ? TYPED_ANSWER : ''} maxLength={2000} />
+            <div className="pl-acts">
+              <Button kind="ghost" size="sm" type="button" onClick={() => setAnswering(false)}>Cancel</Button>
+              <Button kind="primary" size="sm" type="submit">Send answer</Button>
+            </div>
+            <small className="pl-dim">The agent is parked and holds no capacity; it goes back in line when you send.</small>
+          </form>
+        ) : (
+          <div className="pl-acts">
+            <Button kind="secondary" size="sm" onClick={() => setAnswering(true)}>Answer</Button>
+          </div>
+        )}
+      </li>
+    )
+  }
+  if (w.kind === 'approval') {
+    return (
+      <li className="pl-w">
+        {head(<a href="/automate/approvals">{w.a.summary}</a>, w.a.expires_at === null ? 'no expiry' : `expires in ${Math.round((Date.parse(w.a.expires_at) - HOME_NOW) / 3_600_000)} h`, w.a.requested_at)}
+        <div className="pl-acts">
+          <ButtonLink kind="ghost" size="sm" href="/automate/approvals">Read the plan</ButtonLink>
+          <Button kind="primary" size="sm" onClick={() => setDone('Plan approved: its run starts its first step.')}>Approve</Button>
+        </div>
+      </li>
+    )
+  }
+  if (w.kind === 'browser') {
+    const hw = w.t.human_wait as { reason?: string; deadline?: string } | null | undefined
