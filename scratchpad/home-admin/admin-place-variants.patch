+                    <small>{c.default_role}</small>
+                  </th>
+                ))}
+                {!scoped && <th className="is-wide">Own workspace</th>}
+                <th>Last active</th>
+                {!scoped && <th aria-label="Manage" />}
+              </tr>
+            </thead>
+            <tbody>
+              {shown.map((p) => (
+                <tr key={p.email} className={p.email === MEI && (changed || open === MEI) ? 'is-hl' : undefined}>
+                  <td>
+                    <Who
+                      email={p.email}
+                      name={p.name}
+                      sub={
+                        <span className="pl-who-tags">
+                          {p.platform_admin && <span className="pl-tag">platform admin</span>}
+                          {!p.signedIn && <span className="pl-tag">not signed in yet</span>}
+                          {!scoped && p.state === 'ready' && (
+                            <small className="pl-cell-sub" title="The Claude account they run on, and their ceiling: Manage changes both">
+                              {p.platform_admin ? '2 Claude accounts' : p.email === 'kenji.sato@example.com' ? 'asks to borrow a Claude account' : 'no Claude account'} · ceiling 40
+                            </small>
+                          )}
+                          {p.github === 'expired' && <ToneMark tone="warn">GitHub expired</ToneMark>}
+                        </span>
+                      }
+                    />
+                  </td>
+                  {cols.map((c) => (
+                    <td key={c.tenant_id} className="is-ws">
+                      {p.platform_admin ? <RoleChip role="admin" /> : <RoleChip role={p.roles[c.tenant_id] ?? 'none'} own={p.own[c.tenant_id] === true} />}
+                    </td>
+                  ))}
+                  {!scoped && (
+                    <td className="is-wide">
+                      {p.state === 'ready' ? <code className="pl-id">{p.workspace}</code> : p.state === 'requested' ? <span className="pl-tag is-warn">requested</span> : <span className="pl-dim">none</span>}
+
+                    </td>
+                  )}
+                  <td><small>{p.last_active === null ? <><Dash why={p.signedIn ? 'not reported' : 'never signed in'} /> {p.signedIn ? 'not reported' : 'never signed in'}</> : ago(p.last_active)}</small></td>
+                  {!scoped && (
+                    <td>
+                      <Button kind="ghost" size="sm" onClick={() => setOpen(p.email)}>Manage</Button>
+                    </td>
+                  )}
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+        <p className="c-card-foot">
+          {shown.length} shown · a Google group's members are not listed: these are the people who signed in and those with a role of their own; everyone else in a group holds its default. A marked role is their own.
+        </p>
+      </Card>
+      {open !== null && !scoped && <Manage email={open} all={all} onClose={() => setOpen(null)} picking={state === 'open'} />}
+    </div>
+  )
+}
+
+function Manage({ email, all, onClose, picking }: { email: string; all: Row[]; onClose: () => void; picking: boolean }) {
+  const p = all.find((r) => r.email === email)
+  const [pick, setPick] = useState<Record<string, string>>(picking ? { design: 'admin' } : {})
+  if (p === undefined) return null
+  const pending = Object.entries(pick).filter(([t, r]) => r !== (p.own[t] ? p.roles[t] : 'default'))
+  return (
+    <div className="pl-drawer-scrim" onClick={onClose}>
+      <aside className="pl-drawer" role="dialog" aria-label={`Manage ${p.name ?? p.email}`} onClick={(e) => e.stopPropagation()}>
+        <div className="pl-drawer-h">
+          <Who email={p.email} name={p.name} />
+          <Button kind="ghost" size="sm" onClick={onClose}>Close</Button>
+        </div>
+        <dl className="pl-facts">
+          <dt>Signed in</dt>
+          <dd>{p.signedIn ? ago(p.last_active) : <><Dash why="has not signed in" /> not yet</>}</dd>
+          <dt>Own workspace</dt>
+          <dd>{p.workspace === '' ? <span className="pl-dim">none</span> : <code className="pl-id">{p.workspace}</code>}</dd>
+          <dt>Ceiling</dt>
+          <dd>{p.signedIn ? <>40 agents <Button kind="ghost" size="sm">Change</Button></> : <Dash why="no workspace yet" />}</dd>
+          <dt>Claude account</dt>
+          <dd>{p.signedIn ? <>none of their own <Button kind="ghost" size="sm">Lend…</Button></> : <Dash why="no workspace yet" />}</dd>
+          <dt>Platform admin</dt>
+          <dd><label className="pl-switch"><input type="checkbox" role="switch" checked={p.platform_admin} readOnly disabled={!p.signedIn} /> {p.platform_admin ? 'on' : 'off'}</label></dd>
+        </dl>
+        <h3 className="pl-drawer-sub">Roles in workspaces</h3>
+        <ul className="pl-roles-edit">
+          {HOME_WORKSPACES.map((w) => {
+            const cur = p.own[w.tenant_id] ? p.roles[w.tenant_id]! : 'default'
+            const v = pick[w.tenant_id] ?? cur
+            return (
+              <li key={w.tenant_id} className={v !== cur ? 'is-changing' : undefined}>
+                <span className="pl-ws-n">
+                  <b>{w.name}</b>
+                  <small>{cur === 'default' ? `default · ${w.default_role}` : 'their own role'}</small>
+                </span>
+                <Segmented
+                  small
+                  label={`Role in ${w.name}`}
+                  value={v}
+                  onChange={(k) => setPick({ ...pick, [w.tenant_id]: k })}
+                  options={[{ key: 'default', label: 'default' }, { key: 'viewer', label: 'viewer' }, { key: 'member', label: 'member' }, { key: 'admin', label: 'admin' }]}
+                />
+              </li>
+            )
+          })}
+        </ul>
+        {pending.length > 0 && (
+          <div className="pl-confirm" role="status">
+            {pending.map(([t, r]) => (
+              <span key={t}>
+                {wsOf(t)?.name}: <RoleChip role={p.own[t] ? p.roles[t]! : (wsOf(t)?.default_role ?? 'viewer')} /> → <RoleChip role={r === 'default' ? (wsOf(t)?.default_role ?? 'viewer') : r} />
+              </span>
+            ))}
+            <div className="pl-acts">
+              <Button kind="ghost" size="sm" onClick={() => setPick({})}>Undo</Button>
+              <Button kind="primary" size="sm">Save {pending.length === 1 ? 'the change' : `${pending.length} changes`}</Button>
+            </div>
+          </div>
+        )}
+        <p className="pl-dim pl-small">Each role is recorded in Recent admin actions and in the workspace's role events.</p>
+      </aside>
+    </div>
+  )
+}
