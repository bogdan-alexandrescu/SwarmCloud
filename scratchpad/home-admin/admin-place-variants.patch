+/** A request's controls: Approve in one click; Deny asks for a reason in place; Lend asks which account (never beside Reclaim). */
+function ReqActs({ kind, who }: { kind: 'request' | 'loan'; who: string }) {
+  const [done, setDone] = useState<string | null>(null)
+  const [denying, setDenying] = useState(false)
+  const [lending, setLending] = useState(false)
+  if (done !== null) return <p className="pl-said" role="status"><ToneMark tone="ok" /> {done}</p>
+  if (denying) {
+    return (
+      <form className="pl-deny" onSubmit={(e) => { e.preventDefault(); setDone(kind === 'loan' ? `Declined; ${who} is told why.` : `Denied; ${who} is told why.`) }}>
+        <label className="pl-dim" htmlFor={`deny-${who}`}>Why? {who} reads this</label>
+        <textarea id={`deny-${who}`} rows={2} className="c-input" required />
+        <div className="pl-acts"><Button kind="ghost" size="sm" onClick={() => setDenying(false)}>Cancel</Button><Button kind="primary" size="sm" type="submit">{kind === 'loan' ? 'Decline' : 'Deny'}</Button></div>
+      </form>
+    )
+  }
+  return (
+    <div className="pl-acts">
+      <Button kind="ghost" size="sm" onClick={() => setDenying(true)}>{kind === 'loan' ? 'Decline' : 'Deny'}</Button>
+      {kind === 'request' ? (
+        <Button kind="primary" size="sm" onClick={() => setDone(`Approved: ${who}'s workspace is being built.`)}>Approve</Button>
+      ) : (
+        <Button kind="primary" size="sm" onClick={() => setLending(true)}>Lend…</Button>
+      )}
+      {lending && (
+        <Dialog title={`Lend a Claude account to ${who}`} onClose={() => setLending(false)} actions={<><Button kind="ghost" onClick={() => setLending(false)}>Cancel</Button><Button kind="primary" onClick={() => { setLending(false); setDone(`Main subscription lent to ${who}.`) }}>Lend</Button></>}>
+          <p>Which account? {who} runs on it until you reclaim it. The pool holds 3 accounts; 1 is lent.</p>
+          <label className="pl-radio"><input type="radio" name="lend-p" defaultChecked /> Main subscription</label>
+          <label className="pl-radio"><input type="radio" name="lend-p" /> Team subscription</label>
+        </Dialog>
+      )}
+    </div>
+  )
