+// MOCK-HOOK FILE
+// Small helpers shared by the 'place' direction's screens.
+import { useEffect, useState } from 'react'
+import type { Result } from '../../fetch'
+import { HOME_NOW } from '../fixtures'
+
+export interface PlaceProps {
+  go: (to: string) => void
+  state: string
+}
+
+/** A read, as a hook: null until it lands. */
+export function useRead<T>(load: () => Promise<Result<T>>): Result<T> | null {
+  const [r, setR] = useState<Result<T> | null>(null)
+  useEffect(() => {
+    let live = true
+    void load().then((x) => live && setR(x))
+    return () => {
+      live = false
+    }
+  }, [load])
+  return r
+}
+
+export function dataOf<T>(r: Result<T> | null): T | null {
+  return r !== null && (r.status === 'ok' || r.status === 'stale') ? r.data : null
+}
+
+/** An age against the fixture clock: "4 min ago", "3 h ago", "2 d ago"; a dash word for none. */
+export function ago(iso: string | null | undefined): string {
+  if (iso === null || iso === undefined) return 'never'
+  const m = Math.max(0, Math.round((HOME_NOW - Date.parse(iso)) / 60_000))
+  if (m < 1) return 'just now'
+  if (m < 60) return `${m} min ago`
+  const h = Math.round(m / 60)
+  if (h < 48) return `${h} h ago`
+  return `${Math.round(h / 24)} d ago`
+}
+
+export function initials(name: string | null, email = ''): string {
+  const src = name ?? email.split('@')[0]?.replace(/[._-]+/g, ' ') ?? '?'
+  const parts = src.trim().split(/\s+/)
+  return ((parts[0]?.[0] ?? '?') + (parts.length > 1 ? (parts[parts.length - 1]?.[0] ?? '') : '')).toUpperCase()
+}
+
+/** This direction's own switches, read once per page load. */
+const q = typeof window === 'undefined' ? new URLSearchParams() : new URLSearchParams(window.location.search)
+export const PLACE_WS: string = q.get('ws') ?? 'eng'
+export const PLACE_TAB: string | null = q.get('tab')
+export const PLACE_WHO: 'person' | 'new' = q.get('who') === 'new' ? 'new' : 'person'
