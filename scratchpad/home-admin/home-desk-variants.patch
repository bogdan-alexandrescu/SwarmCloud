+                  <span className="dk-picker-name">{w.name}{w === behind && setupOf(w) < totalOf(w) && <span className="dk-chip-warn">furthest behind</span>}</span>
+                  <span className="dk-meta dk-ellipsis">{w.group}</span>
+                  <Progress done={setupOf(w)} total={totalOf(w)} />
+                </a>
+              ))}
+              <a href={`?homeset=desk&homescreen=settings&homews=${HOME_ME.personal}`}><span className="dk-picker-name">Your own workspace</span><span className="dk-meta">{HOME_ME.personal} · you are its fixed admin</span></a>
+              {IS_ADMIN && <a href="?homeset=desk&homescreen=settings&homesec=new" className="dk-picker-new">+ Add a new workspace</a>}
+            </div>
+          )}
+          <ol className="dk-seclist">
+            <li><a {...jump('dk-settings')} aria-current="true">Settings</a><span className="dk-meta">which workspace, code intelligence, budget</span></li>
+            <li><a {...jump('dk-setup')}>Setup</a><span className="dk-meta">the checklist, step by step</span></li>
+            <li><a href="?homeset=desk&homescreen=people&homescope=this">People and roles</a><span className="dk-meta">default {current.default_role}</span></li>
+            {IS_ADMIN && <li><a {...jump('dk-new')}>Add a new workspace</a><span className="dk-meta">platform admins only</span></li>}
+          </ol>
+          <p className="dk-meta dk-secfoot">Pool limits, Runner sizes, Tenants, Platform counts, Platform secrets, Setup and Health stay under Admin.</p>
+        </nav>
+        <div className="dk-embed dk-sections">
+          <section id="dk-settings"><WorkspaceSettingsScreen part="settings" go={go} /></section>
+          <section id="dk-setup"><h2 className="dk-sechead">Setup</h2><WorkspaceSettingsScreen part="setup" go={go} /></section>
+          {IS_ADMIN && <section id="dk-new"><h2 className="dk-sechead">Add a new workspace</h2><WorkspaceSettingsScreen part="new" go={go} /></section>}
