@@ -0,0 +1,224 @@
+// MOCK-HOOK FILE
+// THE HOME REDRAW SCAFFOLD (mock-ups of 2 November 2026, step 'foundation').
+// While `?homeset=<direction>` names a direction other than `today`, App.tsx
+// draws this in the console's main slot whatever the route: the direction's
+// screen named by `?homescreen=` in the state named by `?homestate=`. The
+// left menu and the header stay the console's own. `base` is the plain,
+// neutral layout: every item of features.md placed once, from the console's
+// existing page components; `desk` and `place` start as copies of it.
+import { useEffect, useState, type ReactNode } from 'react'
+import { loadApprovals, loadPeople, loadStats, loadTasks, type ApprovalItem } from '../api'
+import type { PeopleDoc, PersonRow, Stats, Task } from '../types'
+import type { Result } from '../fetch'
+import { Card, StatTile, ButtonLink, type TileValue } from '../components'
+import { OverviewScreen } from '../Overview'
+import { SetupCard } from '../Onboarding'
+import { WaitingOnYouCard } from '../Schedules'
+import { WorkspacePeopleScreen } from '../WorkspacePeople'
+import { WorkspaceSettingsScreen } from '../WorkspaceSettings'
+import { PeopleScreen, waitingRequests } from '../People'
+import { PersonWorkspaceRoles } from '../WorkspaceRolesAdmin'
+import { WorkspacesYouAdminScreen } from '../WorkspacesYouAdmin'
+import { needsYou, ownerQuestionsHold } from '../Handoff'
+import { agentPath } from '../OverviewRegions'
+import { HOMESET, HOMESCREEN, HOMESTATE, HOME_ME, HOME_PERSONA, HOME_PEOPLE, HOME_ADMINISTERED, HOME_WORKSPACES, HOME_OVERRIDE_NOT_IN_GROUP } from './fixtures'
+import '../styles/homeredraw.css'
+import { DESK_SCREENS } from './desk/Desk' // MOCK-HOOK: the desk direction's screens
+
+export const HOME_SCREENS = ['home', 'overview', 'people', 'person', 'settings', 'workspaces'] as const
+export type HomeScreen = (typeof HOME_SCREENS)[number]
+export const HOME_STATES = ['rest', 'answer', 'answered', 'open', 'changed'] as const
+export type HomeState = (typeof HOME_STATES)[number]
+export const HOME_DIRECTIONS = ['base', 'today', 'desk', 'place'] as const
+
+export interface ScreenProps {
+  go: (to: string) => void
+  state: HomeState
+}
+
+const SCREEN_WORDS: Readonly<Record<HomeScreen, string>> = {
+  home: 'Home', overview: 'Overview', people: 'People and roles', person: 'One person', settings: 'Workspace settings', workspaces: 'Workspaces you admin',
+}
+
+/** A read, as a hook: null until it lands. */
+export function useRead<T>(load: () => Promise<Result<T>>): Result<T> | null {
+  const [r, setR] = useState<Result<T> | null>(null)
+  useEffect(() => {
+    let live = true
+    void load().then((x) => live && setR(x))
+    return () => {
+      live = false
+    }
+  }, [load])
+  return r
+}
+
+const readTasks = () => loadTasks()
+const readStats = () => loadStats()
+const readApprovals = () => loadApprovals()
+const readPeople = () => loadPeople()
+
+function dataOf<T>(r: Result<T> | null): T | null {
+  return r !== null && (r.status === 'ok' || r.status === 'stale') ? r.data : null
+}
+
+/** A count tile: a dash with its reason until the read lands, never a zero. */
+function tile(n: number | null, why: string, note?: string): TileValue {
+  return n === null ? { kind: 'unknown', why } : { kind: 'value', value: n, ...(note === undefined ? {} : { note }) }
+}
+
+/** What waits on the signed-in person, from the reads the console already makes. */
+export function useWaiting() {
+  const tasks = dataOf(useRead(readTasks))?.tasks ?? null
+  const approvals = useRead(readApprovals)
+  const peopleRead = useRead(readPeople)
+  const people = dataOf(peopleRead)
+  const questions = tasks === null ? null : tasks.filter((t) => ownerQuestionsHold(t) !== null && t.submitted_by === HOME_ME.email)
+  const handoffs = tasks === null ? null : tasks.filter(needsYou)
+  const failed = tasks === null ? null : tasks.filter((t) => (t.state === 'FAILED' || t.state === 'DEAD_LETTERED') && t.submitted_by === HOME_ME.email)
+  const approvalList: ApprovalItem[] | null = approvals === null ? null : approvals.status === 'empty' ? [] : (dataOf(approvals)?.approvals ?? null)
+  const requests = people !== null && (people as PeopleDoc).scope === 'platform' ? waitingRequests((people as PeopleDoc).people as PersonRow[]) : people === null && peopleRead?.status !== 'error' ? null : []
+  return { tasks, questions, handoffs, failed, approvals: approvalList, requests }
+}
+
+function TaskLine({ t, say }: { t: Task; say: string }) {
+  const title = typeof t.metadata?.title === 'string' ? t.metadata.title : t.id
+  return (
+    <li>
+      <a href={agentPath(t)}>{title}</a> <small>{say}</small>
+    </li>
+  )
+}
+
+/** HOME (base): what waits on you, then the deployment in numbers. Overview stays its own screen. */
+function BaseHome({ go, state }: ScreenProps) {
+  const w = useWaiting()
+  const stats: Stats | null = dataOf(useRead(readStats))
