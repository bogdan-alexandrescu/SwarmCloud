+function DeskSettings({ go, state, picker = false }: ScreenProps & { picker?: boolean }) {
+  // A workspace admin of a few workspaces sees the switcher's list open: three or fewer rows cost less than a click.
+  const [openPicker, setOpenPicker] = useState(picker || (!IS_ADMIN && HOME_ADMINISTERED.length > 0 && HOME_ADMINISTERED.length <= 3))
+  const wsId = q.get('homews') ?? 'eng'
+  const { setupOf, totalOf } = useSetup()
+  const current = HOME_WORKSPACES.find((w) => w.tenant_id === wsId) ?? HOME_WORKSPACES[0]
+  const mine = HOME_WORKSPACES.filter((w) => HOME_ADMINISTERED.includes(w.tenant_id)).slice().sort((a, b) => setupOf(a) / totalOf(a) - setupOf(b) / totalOf(b))
+  const behind = mine[0]
+  void state
+  return (
+    <div className="dk-page dk-settings">
+      <SetupStrip go={go} />
+      <div className="dk-settingsgrid">
+        <nav className="dk-secnav" aria-label="Workspace sections">
