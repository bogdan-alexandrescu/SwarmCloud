+  const r = homesetRoster(tenant)
+  const nameOf = (e: string) => HOME_PEOPLE.find((p) => p.email === e)?.name ?? e
+  return (
+    <div className="dk-roster">
+      <h3>Who holds a role of their own in {name} <em className="dk-count">{r.people.length}</em></h3>
