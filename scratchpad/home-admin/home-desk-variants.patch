+            </tr>
+          ))}
+        </tbody>
+      </table>
+      {ws.map((w) => <WorkspaceRoster key={w.tenant_id} tenant={w.tenant_id} name={w.display_name} />)}
+      <dl className="dk-permits">
+        {ROLE_PERMITS.map(([r, s]) => (
+          <div key={r}><dt><span className={`dk-role is-${r}`}>{r}</span></dt><dd>{s}</dd></div>
+        ))}
+      </dl>
