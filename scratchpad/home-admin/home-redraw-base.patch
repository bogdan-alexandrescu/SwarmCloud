+        repository_url: `https://github.com/example/${repo}`,
+        metadata: { ...(t.metadata ?? {}), title: `${repo}: ${['fix flaky login test', 'bump date library', 'add CSV export', 'tidy migrations', 'translate settings page'][n % 5]}` },
+        last_error: state === 'FAILED' || state === 'DEAD_LETTERED' ? (i % 2 === 0 ? 'tests failed after 3 fix rounds' : 'the agent ran past its time limit') : t.last_error,
+      }
+      if (state === 'PARKED') {
+        row.park_reason = i < 2 ? 'HUMAN_REQUIRED' : i < 8 ? 'PROVIDER_QUOTA_EXHAUSTED' : 'CI_PENDING'
+        row.blocked_by = i < 2
+          ? [{ reason: 'HUMAN_REQUIRED', park_phase: 'owner_questions', owner_questions: { unreadable: 0, questions: [{ task_id: row.id, step_id: 'review', question_index: 0, question: i === 0 ? 'Keep the old export format for one more release?' : 'May the agent rename the public settings route?' }] } } as unknown as NonNullable<Task['blocked_by']>[number]]
+          : t.blocked_by
+        row.submitted_by = i < 2 ? HOME_ME.email : row.submitted_by
+      }
+      if (state === 'RUNNING') row.human_wait = i === 0 && HOME_PERSONA !== 'member' ? ({ reason: 'sign in to the staging site', expect: 'a person signs in', deadline: new Date(HOME_NOW + 9 * MIN).toISOString(), controller: null } as unknown as Task['human_wait']) : null
+      tasks.push(row)
+    }
+  }
+  return { ...base, tasks, next_page_token: null, tenant_id: tenant }
+}
+
+/** `GET /v1/stats`: the same counts the task rows carry. */
+export function homesetStats(base: Stats): Stats {
+  const c = counts()
+  return { ...base, tenant_id: HOME_PERSONA === 'member' ? HOME_ME.personal : 'eng', tasks_by_state: c, ...(isAdmin ? { platform_tasks_by_state: c } : {}) }
+}
+
+/** `GET /v1/capacity`: today's pools with one at its ceiling. */
+export function homesetCapacity(base: Capacity): Capacity {
+  return {
+    ...base,
+    pools: base.pools.map((p, i) => {
+      const limit = p.effective_limit ?? p.hard_limit
+      return i === 0 && limit !== null ? { ...p, active: limit, available: 0 } : p
+    }),
+  }
+}
+
+/** `GET /v1/admin/leases`: one lease per task that holds capacity. */
+export function homesetLeases(base: LeasePage, tasks: TaskPage): LeasePage {
+  const live = new Set(['LEASED', 'DISPATCHED', 'STARTING', 'RUNNING'])
+  const template = base.leases[0]
+  if (template === undefined) return base
+  const leases = tasks.tasks.filter((t) => live.has(t.state)).map((t, i) => ({
+    ...template, task_id: t.id, lease_id: `lease_hs${i}`, attempt_id: `att_hs${i}`, tenant_id: t.tenant_id, units: 1, dispatch_state: t.state === 'LEASED' ? 'LEASED' : 'DISPATCHED',
+    created_at: ago((10 + i) * MIN), heartbeat_at: ago(5_000), expires_at: new Date(HOME_NOW + 5 * MIN).toISOString(), dispatch_deadline: new Date(HOME_NOW + 5 * MIN).toISOString(),
+    released_at: null, release_reason: null, released: false, expired: false, dispatch_overdue: false, silent_seconds: 5, heartbeat_ever: true, last_error: null,
+  }))
+  return { ...base, leases, units_held: leases.length }
+}
+
+/** `GET /v1/approvals`: one approval waits on the caller (none for the member). */
+export function homesetApprovals(): { approvals: { approval_id: string; kind: string; subject: Record<string, unknown>; summary: string; state: string; requested_at: string | null; expires_at: string | null; approver_names?: (string | null)[] | null }[] } {
+  if (HOME_PERSONA === 'member') return { approvals: [] }
+  return {
+    approvals: [{
+      approval_id: 'apr_hs1', kind: 'run_plan', subject: { run_id: 'run_hs1', issue: 'northwind-crm#412' },
+      summary: 'Plan for northwind-crm#412: 4 steps, about 2 hours of agent time', state: 'pending',
+      requested_at: ago(35 * MIN), expires_at: new Date(HOME_NOW + 23 * HOUR).toISOString(), approver_names: [HOME_ME.name],
+    }],
+  }
+}
+
+/** `/v1/onboarding`'s `config_setup.people` for the acting workspace, counted from the overrides above (today's fixture says "only you"). */
+export function homesetPeopleSetup(tenant: string) {
+  if (!HOME_WORKSPACES.some((w) => w.tenant_id === tenant)) {
+    return { applies: false, done: null, holders: null, admins: null, pending: null, reason: 'a personal workspace has nobody to invite', pending_reason: null }
+  }
+  const mine = OVERRIDES.filter((o) => o.tenant === tenant)
+  return { applies: true, done: mine.length > 0, holders: mine.length, admins: mine.filter((o) => o.role === 'admin').length, pending: 0, reason: null, pending_reason: null }
+}
+
+/** A workspace's platform memberships: engineering let 2 people in by an approved join request; the others none. */
+export function homesetMembers(tenant: string) {
+  const let_in = tenant === 'eng' ? [HOME_PEOPLE[10], HOME_PEOPLE[11]].filter((p): p is HomePerson => p !== undefined) : []
+  return {
+    platform_memberships: true,
+    members: let_in.map((p, n) => ({ email: p.email, by: n === 0 ? 'ana.moreau@example.com' : 'bogdan@example.com', at: ago((2 + 3 * n) * DAY), via: 'join_request', group_changed: n === 1, still_in_group: n === 0 ? true : null })),
+  }
+}
