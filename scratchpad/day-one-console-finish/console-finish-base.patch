+// MOCK-HOOK FILE: the console finish mock-ups' neutral scaffold, `?finish=base` (2026-11-02). Nothing is built from it until the owner picks a direction.
+/**
+ * THE BASE LAYOUT (`?finish=base`): a plain, neutral arrangement of every part
+ * the console finish draws today, from the console's own components, so each
+ * direction starts from working parts. Nothing here is new behaviour: every
+ * state is still read from `GET /v1/admin/setup` (`useSetupState`), every row
+ * is the checklist's own builder (AdminSetupSteps.tsx), and nothing is marked
+ * done by hand. A direction copies this file to `<Name>.tsx`, registers it in
+ * `LAYOUTS` below and draws its own arrangement at `?finish=<name>`.
+ */
+import { useCallback, useRef, type ReactNode } from 'react'
+import { SetupLead, SetupRead, SetupStrip, AdminSetupCallbackScreen } from '../AdminSetup'
+import { AdminSetupTeam } from '../AdminSetupTeam'
+import {
+  CapacityCard,
+  Checklist,
+  InstallerCard,
+  SendToTeam,
+  accountsRow,
+  addonsRow,
+  cloudRow,
+  githubRow,
+  sendRow,
+  signInRow,
+  teamRow,
+  useAction,
+  useAutoSelfCheck,
+  useNow,
+  useSetupState,
+  verifyRow,
+  type SetupRow,
+} from '../AdminSetupSteps'
+import type { SetupState } from '../api'
+import { Banner, Card } from '../components'
+import { SetupLinkScreen } from '../SetupLink'
+import { PageHead } from '../Shell'
+import { FINISH_LAYOUT, FINISH_MOMENT, FINISH_MOMENTS, momentIndex } from './moments'
+import '../styles/admin-setup.css'
+import './consolefinish.css'
+
+/** The page each switch draws: Admin › Setup, its GitHub App callback, or the one-time link page. */
+export type FinishPage = { page: 'setup' } | { page: 'callback'; search: string } | { page: 'link'; token: string | null }
+
+/** The layouts `?finish=` names. A direction adds `<name>: <Component>` here. */
+const LAYOUTS: Record<string, (p: FinishPage) => ReactNode> = {
+  base: (p) => <BaseFinish {...p} />,
+}
+
+/** The page `?finish` draws, or null to draw today's page (no switch, or a layout no direction registered). */
+export function consoleFinish(p: FinishPage): ReactNode | null {
+  if (FINISH_LAYOUT === null) return null
+  const draw = LAYOUTS[FINISH_LAYOUT]
+  return draw === undefined ? null : draw(p)
+}
+
+/**
+ * Which moment of the story this page answers, and the other thirteen, one
+ * click each (a whole page load, so the moment is read again). Shown only in
+ * the mock-ups, never in a built page.
+ */
+export function MomentBar({ links = true }: { links?: boolean }) {
+  const here = FINISH_MOMENT
+  const href = (m: string) => `/admin/setup?${new URLSearchParams({ ...(FINISH_LAYOUT === null ? {} : { finish: FINISH_LAYOUT }), moment: m }).toString()}`
+  return (
+    <nav className="cf-moments" aria-label="Mock-up moments">
+      <span className="cf-moments-h">
+        {here === null ? 'Mock-up: today’s fixture record (no moment chosen)' : `Mock-up: moment ${momentIndex(here).n} of ${FINISH_MOMENTS.length}, ${here}`}
+      </span>
+      {links && (
+        <ol className="cf-moments-list">
+          {FINISH_MOMENTS.filter((m) => m !== 'link-teammate').map((m) => (
+            <li key={m}>
+              <a href={href(m)} aria-current={m === here ? 'page' : undefined}>
+                {m}
+              </a>
+            </li>
+          ))}
+        </ol>
+      )}
+    </nav>
+  )
+}
+
+function BaseFinish(p: FinishPage) {
+  if (p.page === 'link') {
+    return (
+      <>
+        <MomentBar links={false} />
+        <SetupLinkScreen token=******** />
+      </>
+    )
+  }
+  if (p.page === 'callback') {
+    return (
+      <>
+        <MomentBar />
+        <AdminSetupCallbackScreen search={p.search} />
+      </>
+    )
+  }
+  return <BaseSetup />
+}
+
+function BaseSetup() {
+  const { result, reload } = useSetupState()
+  return (
+    <div className="ur-page asm-page cf-base">
+      <PageHead title="Setup" />
+      <MomentBar />
+      <SetupRead result={result} reload={reload}>
+        {(state) => <BaseBody state={state} onChanged={reload} />}
+      </SetupRead>
+    </div>
+  )
+}
+
+/** Every row of the checklist on its own card, the progress above them and the terminal and side cards beside them. */
+export function BaseBody({ state, now, onChanged }: { state: SetupState; now?: number; onChanged?: () => void }) {
+  const nowMs = useNow(now)
+  const changed = useRef(onChanged)
+  changed.current = onChanged
+  const reread = useCallback(() => changed.current?.(), [])
+  const githubAct = useAction(reread)
+  useAutoSelfCheck(state, githubAct)
+  const rows: SetupRow[] = [
+    signInRow(state, reread, nowMs),
+    cloudRow(state),
+    githubRow(state, reread, githubAct),
+    teamRow(state, reread, nowMs),
+    accountsRow(state, reread, nowMs),
+    addonsRow(state),
+    verifyRow(state, reread, nowMs),
+    sendRow(state),
+  ]
+  const nextKey = rows.find((r) => r.key !== 'addons' && r.state !== 'done')?.key
+  for (const r of rows) if (r.key === nextKey) r.next = true
+  return (
+    <>
+      <section className="cf-section" aria-label="Progress">
+        <SetupStrip state={state} />
+        <SetupLead state={state} now={now} />
+      </section>
+      <div className="cf-grid">
+        <section className="cf-col" aria-label="Steps">
+          <h2 className="cf-h">Steps</h2>
+          {rows.map((r) => (
+            <Card key={r.key} className="ob-card cf-row" title={r.title}>
+              <Checklist rows={[r]} />
+            </Card>
+          ))}
+        </section>
+        <section className="cf-col" aria-label="Beside the steps">
+          <h2 className="cf-h">The terminal</h2>
+          {!state.cli_running && (
+            <Banner tone="warn" title="swarm install is not running">
+              Run <code>swarm install</code> in a terminal to continue: the App’s switches and verify need it. The steps on this page stay usable meanwhile.
+            </Banner>
+          )}
+          <InstallerCard state={state} now={now} />
+          <h2 className="cf-h">Beside the steps</h2>
+          <SendToTeam state={state} />
+          <CapacityCard sizing={state.sizing} />
+          <Card title="Health" foot="The hourly doctor’s checks, read-only, on the live deployment; swarm doctor checks this machine and the deployment from a terminal.">
+            <p className="ur-hint">
+              Once setup is done, the scheduled doctor’s findings and each one’s repair are on <a href="/admin/setup/health">Admin › Setup › Health</a>.
+            </p>
+          </Card>
+        </section>
+      </div>
+      {state.teams.length > 0 && (
+        <section className="cf-section" aria-label="Later">
+          <h2 className="cf-h">Later: add a team</h2>
+          <AdminSetupTeam teams={state.teams} onChanged={onChanged} />
+        </section>
+      )}
+    </>
+  )
+}
