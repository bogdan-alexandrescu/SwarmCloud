+          mode: 'team',
+          members: 5,
+          pool_limits: { global: 12, default_tenant: 8, provider_tenant: 8 },
+          service_max_instances: { 'swarm-api': 2, 'swarm-scheduler': 1, 'swarm-quota-broker': 1, 'swarm-reconciler': 1 },
+          pool_accounts: 2,
+          budget_usd: 1000,
+        },
+  }
