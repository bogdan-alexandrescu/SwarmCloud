+      : { first_team: { needed: true, state: reached(m, 62) ? 'started' : 'todo', reason: null }, invites: { needed: true, state: reached(m, 90) ? 'done' : reached(m, 62) ? 'waiting' : 'todo', reason: null } },
+    sizing: onePerson
+      ? {
+          mode: 'individual',
+          members: 1,
+          pool_limits: { global: 4, default_tenant: 4, provider_tenant: 4 },
+          service_max_instances: { 'swarm-api': 1, 'swarm-scheduler': 1, 'swarm-quota-broker': 1, 'swarm-reconciler': 1 },
+          pool_accounts: 1,
+          budget_usd: 200,
+        }
