+            workspace: 'engineering',
+            workspace_id: 'w-engineering',
+            first_admin: ANA,
+            invites: [RAVI, LEA],
+            progress: { created_at: at(62), namespace: reached(m, 70) ? 'ready' : 'creating', identity: reached(m, 72) ? 'ready' : 'waiting' },
+            workspace_state: reached(m, 75) ? 'ready' : 'applying',
+            smoke,
