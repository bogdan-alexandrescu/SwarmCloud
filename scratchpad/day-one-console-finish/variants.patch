+// MOCK-HOOK FILE: the Day One console finish mock-ups' record moments (2026-11-02). Fixture build only; nothing here is read live.
+/**
+ * THE RECORD MOMENTS (console finish mock-ups, step 'foundation').
+ *
+ * `?moment=<name>` makes the fixture build's `GET /v1/admin/setup` answer the
+ * install record at one moment of the story both directions draw, in the
+ * route's own shape (what `normSetupState` reads). Every time is counted from
+ * the fixture clock (`FIXTURE_CLOCK` in api.ts, passed in as `nowMs`): each
+ * moment is the page read at that clock, with the install's history placed
+ * behind it, so "seen 20 s ago" and "21 hours left" read the same on every
+ * open. Without `?moment` nothing here is used and today's fixtures stand.
+ *
+ * The story, in minutes from the install's start (stage 0) to the read:
+ * cloud part done at 38 (11 of 11 stages), the hand-off at 38; arrive 39;
+ * signin-typing 44; signin-saved 47; github-callback 52; github-installed 55;
+ * team-building 68; Lea's link made at 70; accounts-waiting 250 (Ana came back
+ * hours later: 21 hours left on Lea's link); smoke-failed 256; terminal-closed
+ * 270 (terminal last seen at 256); verify-running 300; verify-failed 318;
+ * ready 340. one-person is its own install, read at its accounts step.
+ */
+
+export const FINISH_MOMENTS = [
+  'arrive',
+  'signin-typing',
+  'signin-saved',
+  'github-callback',
+  'github-installed',
+  'team-building',
+  'accounts-waiting',
+  'smoke-failed',
+  'terminal-closed',
+  'verify-running',
+  'verify-failed',
+  'ready',
