+
+export type FinishMoment = (typeof FINISH_MOMENTS)[number]
+
+/** The story minute each moment is read at (see above). */
+const READ_AT: Record<FinishMoment, number> = {
+  arrive: 39,
+  'signin-typing': 44,
+  'signin-saved': 47,
+  'github-callback': 52,
+  'github-installed': 55,
+  'team-building': 68,
+  'accounts-waiting': 250,
+  'smoke-failed': 256,
+  'terminal-closed': 270,
+  'verify-running': 300,
+  'verify-failed': 318,
+  ready: 340,
+  'link-teammate': 251,
+  'one-person': 52,
+}
+
+/** One moment's place in the story, for a direction that draws a timeline: index 1-14 and its read minute. */
+export function momentIndex(m: FinishMoment): { n: number; minute: number } {
+  return { n: FINISH_MOMENTS.indexOf(m) + 1, minute: READ_AT[m] }
+}
+
+function readParam(name: string): string | null {
+  if (typeof window === 'undefined') return null
+  return new URLSearchParams(window.location.search).get(name)
+}
+
+/**
+ * The moment this page load answers, read ONCE at module load (as the persona
+ * cookie is), so a page that rewrites its address (the callback page drops
+ * its query) keeps answering the same moment. Null without `?moment`, or with
+ * a name not in the story.
+ */
+export const FINISH_MOMENT: FinishMoment | null = (() => {
+  const m = readParam('moment')
+  return m !== null && (FINISH_MOMENTS as readonly string[]).includes(m) ? (m as FinishMoment) : null
+})()
+
+/** `?finish=<layout>`, read once: `base` is the neutral scaffold; a direction adds its own name. Null draws today's page. */
+export const FINISH_LAYOUT: string | null = (() => {
+  const f = readParam('finish')
+  return f !== null && /^[a-z][a-z0-9-]{0,31}$/.test(f) ? f : null
+})()
+
+/** True from `arrive` on; a story minute at or before this one is in the moment's past. */
+const reached = (m: FinishMoment, minute: number) => READ_AT[m] >= minute
+
+/** Hex made at run time (crypto), never a written literal: GitHub's one-time code and state for the callback frame. */
+export function runtimeHex(bytes: number): string {
+  const a = new Uint8Array(bytes)
+  globalThis.crypto.getRandomValues(a)
+  return Array.from(a, (b) => b.toString(16).padStart(2, '0')).join('')
+}
+
+/** The callback's query as GitHub sends it, `?code=…&state=…`, both made at run time. */
+export function momentCallbackSearch(): string {
+  return `?code=${runtimeHex(10)}&state=${runtimeHex(16)}`
+}
+
+/** `POST /v1/admin/setup/github-app/conversion`'s answer at the github-callback moment: the App's id and slug, never a secret. */
+export const MOMENT_APP = { id: '4242', slug: 'swarmcloud-console-example' }
+
+/** `POST /v1/setup/links/redeem`'s answer for Lea's link (link-teammate): her pool account, filed into the first team. */
+export const MOMENT_REDEEM = { kind: 'pool-account', label: 'lea', tenant: 'engineering' }
+
+/** The console verify runs' and the smoke agent's ids under a moment. */
+export const MOMENT_RUN_IDS = { task: 'task_verify_console', workflow: 'wf_verify_console', smoke: 'task_smoke_engineering' }
+
+/** The state `GET /v1/tasks/{id}` / `GET /v1/workflows/{id}` answers for a moment's run, or null for an id that is not one of them. */
+export function momentRunWord(m: FinishMoment, id: string): string | null {
+  if (id === MOMENT_RUN_IDS.smoke) return m === 'smoke-failed' ? 'FAILED' : reached(m, 270) ? 'SUCCEEDED' : 'RUNNING'
+  if (id === MOMENT_RUN_IDS.task) return m === 'verify-running' ? 'RUNNING' : 'SUCCEEDED'
+  if (id === MOMENT_RUN_IDS.workflow) return m === 'verify-running' ? 'PENDING' : 'SUCCEEDED'
+  return null
+}
+
+const SIGN_IN_PAGES = (() => {
+  const page = (path: string) => `https://console.cloud.google.com/auth/${path}?project=swarmcloud-example`
