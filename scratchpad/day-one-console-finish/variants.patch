+
+  const githubApp = onePerson
+    ? { started: true, id: 4242, slug: MOMENT_APP.slug, installed_on: 'example-org', secrets_written_at: at(47), self_check: { ok: true, reason: null, at: at(51), state: 'passed' } }
+    : !reached(m, 50)
+      ? null
+      : {
+          started: true,
+          id: reached(m, 52) ? 4242 : null,
+          slug: reached(m, 52) ? MOMENT_APP.slug : null,
+          installed_on: reached(m, 54) ? 'example-org' : null,
+          secrets_written_at: reached(m, 52) ? at(52) : null,
+          self_check: !reached(m, 55)
