+.trb-shot-frame { border: 1px solid var(--line); border-radius: var(--r-tile); overflow: hidden; max-width: 640px; background: #fff; color: #222; }
+.trb-shot-bar { display: flex; align-items: center; gap: 8px; padding: 6px 8px; background: #eef0f3; border-bottom: 1px solid #d5d9df; }
+.trb-shot-dots { width: 34px; height: 8px; background: radial-gradient(circle, #c9ced6 3.5px, transparent 4px) 0 0 / 12px 8px repeat-x; }
+.trb-shot-url { flex: 1; font: 12px var(--mono); color: #444; background: #fff; border-radius: 6px; padding: 2px 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.trb-shot-page { padding: 40px 48px 52px; background: #f0f0f2; font-family: -apple-system, 'Segoe UI', sans-serif; }
+.trb-shot-page h1 { margin: 0 0 14px; font-size: 26px; color: #111; }
+.trb-shot-page p { margin: 0 0 10px; font-size: 14px; line-height: 1.5; max-width: 52ch; color: #222; }
+.trb-shot-page u { color: #38488f; }
+.trb-shot figcaption { margin-top: 6px; color: var(--text-dim); font-size: 12px; }
+
+/* THE LIST FOLDED AWAY: the transcript reads full width; a strip on the left brings the list back. */
+.wi.is-docked.is-trwide { grid-template-columns: 40px minmax(0, 1fr); }
+.wi.is-docked.is-trwide > .wi-main, .wi.is-docked.is-trwide > .wi-handle { display: none; }
+.trb-strip { display: flex; flex-direction: column; align-items: center; gap: 10px; padding-top: 6px; border-right: 1px solid var(--line); }
+.trb-strip button { width: 30px; height: 30px; border: 1px solid var(--ctl-bd); border-radius: var(--r-ctl); background: var(--surface); color: var(--text); cursor: pointer; font-size: 14px; }
+.trb-strip span { writing-mode: vertical-rl; transform: rotate(180deg); color: var(--text-dim); font-size: 12px; }
+.trb.is-phone .trb-bar2 { gap: 6px; }
+.trb.is-phone .trb-chip { padding: 0 7px; }
