+/** The live agent's records so far: the first eight at once, then one more every 900 ms, as a tail grows. */
+export function trbSteps(taskId: string): { steps: TranscriptStep[]; bytes: number; whole: boolean } | null {
+  const which = TRB_TASKS[taskId]
+  if (which === undefined) return null
+  uuidN = 0
+  msgN = 0
+  let recs = which === 'coding' ? coding() : which === 'browser' ? browser() : which === 'failed' ? failed() : live()
+  if (which === 'live') {
+    if (liveFrom === null) liveFrom = Date.now()
+    const n = Math.min(recs.length, 8 + Math.floor((Date.now() - liveFrom) / 900))
+    recs = recs.slice(0, n)
+  }
+  const steps = toSteps(recs)
+  return { steps, bytes: recs.reduce((a, r) => a + JSON.stringify(r).length + 1, 0), whole: which !== 'live' }
+}
