+/**
+ * THE LIVE AGENT IS DATED FROM NOW, not from the fixture clock: its task and
+ * attempt times move by (now - fixture clock), so a running agent's head reads
+ * minutes, as the transcript beside it does, not the weeks since that clock.
+ */
+export function trbLiveNow<T>(taskId: string, read: T, fixtureNow: number): T {
+  if (!trbOn() || TRB_TASKS[taskId] !== 'live') return read
+  return shiftIso(read, Date.now() - fixtureNow) as T
