+const ISO = /^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d+)?Z$/
+function shiftIso(v: unknown, by: number): unknown {
+  if (typeof v === 'string') return ISO.test(v) ? new Date(Date.parse(v) + by).toISOString() : v
+  if (Array.isArray(v)) return v.map((x) => shiftIso(x, by))
+  if (v !== null && typeof v === 'object') return Object.fromEntries(Object.entries(v).map(([k, x]) => [k, shiftIso(x, by)]))
+  return v
+}
