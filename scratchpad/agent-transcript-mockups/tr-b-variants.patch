+/** `map_event`, client-side: one decoded record to one step per content block. */
+function mapRecord(rec: Rec, lineOffset: number): TranscriptStep[] {
+  const raw = JSON.stringify(rec)
+  const parent = typeof rec.parent_tool_use_id === 'string' ? rec.parent_tool_use_id : null
+  const base = (block: number, over: Partial<TranscriptStep>): TranscriptStep => ({
+    id: `L${lineOffset}:${block}`, line_offset: lineOffset, block, kind: 'other', role: null, parent_tool_use_id: parent,
+    text: null, tool: null, tool_result: null, meta: null, truncated_fields: [], raw, ...over,
+  })
+  const kind = rec.type
+  if (kind === 'system') {
+    if (rec.subtype === 'init') {
+      return [base(0, { kind: 'init', role: 'system', meta: { model: rec.model, permission_mode: rec.permissionMode, tool_count: Array.isArray(rec.tools) ? rec.tools.length : null } })]
+    }
+    return [base(0, { kind: 'system', role: 'system', meta: { subtype: rec.subtype } })]
+  }
+  if (kind === 'assistant' || kind === 'user') {
+    const role = kind
+    const content = (rec.message as Rec).content as Rec[]
+    return content.map((b, i) => {
+      if (b.type === 'text') return base(i, { kind: 'text', role, text: b.text as string })
+      if (b.type === 'thinking') return base(i, { kind: 'thinking', role, text: b.thinking as string })
+      if (b.type === 'tool_use') return base(i, { kind: 'tool_call', role, tool: { id: b.id as string, name: b.name as string, input: JSON.stringify(b.input, null, 2) } })
+      if (b.type === 'tool_result') {
+        const c = b.content
+        const text = typeof c === 'string' ? c : (c as Rec[]).filter((p) => p.type === 'text').map((p) => p.text as string).join('\n')
+        const images = typeof c === 'string' ? 0 : (c as Rec[]).filter((p) => p.type === 'image').length
+        return base(i, { kind: 'tool_result', role, tool_result: { tool_use_id: b.tool_use_id as string, is_error: b.is_error as boolean, content: text, images } })
+      }
+      return base(i, { kind: 'other', role, meta: { raw_type: b.type } })
+    })
+  }
+  if (kind === 'result') {
+    const m: Rec = {}
+    for (const k of ['subtype', 'is_error', 'num_turns', 'duration_ms', 'total_cost_usd', 'stop_reason', 'terminal_reason']) m[k] = rec[k] ?? null
+    return [base(0, { kind: 'result', text: (rec.result as string | undefined) ?? null, meta: m })]
+  }
+  if (kind === 'rate_limit_event') {
+    const m: Rec = {}
+    for (const [k, v] of Object.entries(rec)) {
+      if (k === 'type' || k === 'uuid' || k === 'session_id') continue
+      if (v !== null && typeof v === 'object') for (const [ik, iv] of Object.entries(v as Rec)) m[`${k}.${ik}`] = iv
+      else m[k] = v
+    }
+    return [base(0, { kind: 'rate_limit', meta: m })]
+  }
+  return [base(0, { kind: 'other', meta: { raw_type: typeof kind === 'string' ? kind : null } })]
+}
+
+function toSteps(recs: Rec[]): TranscriptStep[] {
+  let offset = 0
+  const out: TranscriptStep[] = []
+  for (const r of recs) {
+    out.push(...mapRecord(r, offset))
+    offset += JSON.stringify(r).length + 1
+  }
+  return out
+}
