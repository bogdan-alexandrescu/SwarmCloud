#!/usr/bin/env bash
# The call guard's kubectl (docs/workspaces.md §2.5). The workspace job puts this
# directory first on PATH, and scripts/lib/common.sh's kubectl_bin and
# prefer_local_bin return these shims while SWARM_CALL_GUARD is set, so every
# kubectl the job runs is judged by scripts/lib/workspace-guard.sh against
# scripts/lib/workspace-calls.json first. The guard runs the real kubectl, by
# absolute path, only on an allow; a refusal exits 86 with nothing done.
#
# Nothing else belongs in this file: a shim that decides anything is a second
# guard nobody reviews. Its directory is found by parameter expansion, not
# dirname, so the shim starts no process of its own before the guard (a bare
# name, `bash curl` from this directory, has no slash and means `.`).
set -euo pipefail
here="${BASH_SOURCE[0]%/*}"; [[ "${here}" != "${BASH_SOURCE[0]}" ]] || here=.
exec "$(cd -- "${here}/.." && pwd)/workspace-guard.sh" run kubectl "$@"
