      "rule": "C9",
      "expect": "refuse",
      "tool": "gcloud",
      "argv": [
        "iam",
        "service-accounts",
        "set-iam-policy",
        "{worker_email}",
        "{casedir}/policy.json",
        "--project",
        "{project_id}"
      ]
    },
    {
      "name": "delete the worker account",
      "rule": "C9",
      "expect": "refuse",
      "tool": "gcloud",
      "argv": [
        "iam",
        "service-accounts",
        "delete",
        "{worker_email}",
        "--project",
        "{project_id}",
        "--quiet"
      ]
    },
    {
      "name": "kubectl delete in our own namespace",
      "rule": "C9",
      "expect": "refuse",
      "tool": "kubectl",
      "argv": [
        "--context=gke_{project_id}_{gke_location}_{gke_cluster}",
        "delete",
        "rolebinding",
        "swarm-worker",
        "-n",
        "{namespace}"
      ]
    },
    {
      "name": "a Firestore DELETE of our own tenant",
      "rule": "C9",
      "expect": "refuse",
      "tool": "curl",
      "argv": [
        "-sS",
        "-m",
        "30",
        "-K",
        "-",
        "-X",
        "DELETE",
        "-o",
        "{casedir}/out",
        "-w",
        "%{http_code}",
        "{firestore_base}/{tenant_doc}"
      ],
      "stdin": "{auth_config}"
    },
    {
      "name": "a commit that deletes",
      "rule": "C9",
      "expect": "refuse",
      "tool": "curl",
      "argv": [
        "-sS",
        "-m",
        "30",
        "-K",
        "-",
        "-X",
        "POST",
        "-H",
        "Content-Type: application/json",
        "--data-binary",
        "{\"writes\":[{\"update\":{\"name\":\"{firestore_docs_prefix}/{workspace_doc}\",\"fields\":{\"state\":{\"stringValue\":\"applying\"}}},\"updateMask\":{\"fieldPaths\":[\"state\"]}},{\"delete\":\"{firestore_docs_prefix}/{tenant_doc}\"}],\"transaction\":\"dHg=\"}",
        "-o",
        "{casedir}/out",
        "-w",
        "%{http_code}",
        "{firestore_base}:commit"
      ],
      "stdin": "{auth_config}"
    },
    {
      "name": "an update-only commit is not a delete",
      "rule": "C9",
      "expect": "allow",
      "tool": "curl",
      "argv": [
        "-sS",
        "-m",
        "30",
        "-K",
        "-",
        "-X",
        "POST",
        "-H",
        "Content-Type: application/json",
        "--data-binary",
        "{\"writes\":[{\"update\":{\"name\":\"{firestore_docs_prefix}/{workspace_doc}\",\"fields\":{\"state\":{\"stringValue\":\"applying\"}}},\"updateMask\":{\"fieldPaths\":[\"state\"]}},{\"update\":{\"name\":\"{firestore_docs_prefix}/{tenant_doc}\",\"fields\":{\"state\":{\"stringValue\":\"applying\"}}},\"updateMask\":{\"fieldPaths\":[\"state\"]}},{\"update\":{\"name\":\"{firestore_docs_prefix}/{pool_doc}\",\"fields\":{\"state\":{\"stringValue\":\"applying\"}}},\"updateMask\":{\"fieldPaths\":[\"state\"]}}],\"transaction\":\"dHg=\"}",
        "-o",
        "{casedir}/out",
        "-w",
        "%{http_code}",
        "{firestore_base}:commit"
      ],
      "stdin": "{auth_config}",
      "by": "C8"
    },
    {
      "name": "an add of a binding is not a removal",
      "rule": "C9",
      "expect": "allow",
      "tool": "gcloud",
      "argv": [
        "secrets",
        "add-iam-policy-binding",
        "{forge_slot}",
        "--project",
        "{project_id}",
        "--member",
        "serviceAccount:{worker_email}",
        "--role",
        "roles/secretmanager.secretAccessor"
      ],
      "by": "C6"
    }
  ]
}
