# Keep the build context small and free of anything that must never reach an
# image: local virtualenvs, terraform state (which holds secrets), and git
# history. The image Dockerfiles copy only apps/common and apps/agent-worker.
.git/
.github/
.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.ruff_cache/
**/.DS_Store
.env
docs/
scripts/
terraform/
kubernetes/
tests/
uv.lock
**/*.tfstate
**/*.tfstate.backup
**/.terraform/
# The credential file google-github-actions/auth writes into the checkout, at
# any depth. .gcloudignore already keeps it out of the Cloud Build workspace;
# this keeps it out of any other build context that starts at the repo root.
**/gha-creds-*.json
