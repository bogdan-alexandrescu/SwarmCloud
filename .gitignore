.env
.venv/
__pycache__/
*.pyc
.terraform/
*.tfstate
*.tfstate.backup
.tfplan
tfplan.json
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.gstack/

# Ephemeral git worktrees created by the Workflow tool for isolated agents.
# They are real clones; committing them embeds a repository inside this one.
.claude/worktrees/

# The credential file google-github-actions/auth writes into the checkout.
# Never committed; and .gcloudignore includes this file, so every Cloud Build
# source upload follows the same rule (build-images.sh checks that it does).
gha-creds-*.json

# The never-touch list lives in gs://<state-bucket>/config/<env>/deny-list.json
# and its cache outside the clone; a copy written here is never committed.
deny-list.json

# Local test and scan output, an agent's verification note and scratch files:
# none belongs in the repository.
.coverage
*.sarif
/verification.md
scratchpad/

# A deployment's real tfvars is private: it lives under the state bucket's
# config/<env>/ prefix (scripts/lib/resolve.sh tfvars), never in the
# repository. Only the *.tfvars.example placeholders are tracked.
/terraform/bootstrap/terraform.tfvars
/terraform/environments/*/*.tfvars
