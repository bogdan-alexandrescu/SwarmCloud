#!/usr/bin/env python3
"""The files of gstack each agent image ships, derived, checked and staged.

The owner, 3 November 2026: gstack is baked into the agent images at a pinned
version through the build mirror, and the first catalogue leaves /cso out
(docs/design/agent-plugins-packaging.md, "The image build proposal"). The
image build runs gstack's `./setup` once at the final path,
/opt/swarm/plugins/gstack, and then copies only two checked-in lists of it:

  * the BASE list (images/agent-runtime-base/gstack-base-files.txt), which the
    base image ships: the catalogue skills' closure as
    scripts/gstack_packaging_measure.py's `skill_closure` walks it, without
    its compiled binaries. No `node_modules`; the helpers run on the Bun in
    /usr/local/bin.
  * the BROWSER list (images/agent-runtime-browser/gstack-browser-files.txt),
    which the browser image adds: the compiled `browse`, the files its server
    (`bun run browse/src/server.ts`) imports inside browse/src and lib, and the
    node_modules packages those import with their own dependencies, less what
    the base list already holds.

Of the two compiled binaries the skills' walk reaches, `browse/dist/browse`
goes to the browser list and `design/dist/design` to neither: every command
it has calls an outside image model, and outside AI is off at first. Two packages the server imports stay
out: `@ngrok/ngrok`, the pair-agent tunnel (pair-agent is not offered, and it
opens a tunnel to an outside service), and every `linuxmusl` platform package
(the images are glibc).

  check   derive both lists from a built install and fail, naming every file,
          when either differs from the checked-in one. The image build runs
          it, so a pin bump that changes the closure cannot ship unnoticed.
  derive  write both lists from a built install (a pin bump regenerates them).
  stage   copy one list's files from the install into a folder, every
          directory 0755, every file 0644, or 0755 when its owner could run it;
          a listed path that is missing, a link, absolute, climbs out with
          `..` or names `.git` fails the copy.

Unit tests: tests/unit/scripts/test_gstack_image.py (small installs in a
temporary folder; no Bun, no network).
"""

from __future__ import annotations

import argparse
import importlib.util
import os
import shutil
import sys
from pathlib import Path

#: The first catalogue's skills: the spike's offered list less `cso`, which
#: the owner left out (its launcher is not built: GSTACK_SETUP_SKIP_CSO_BUILD=1).
CATALOGUE_SKILLS = (
    "review",
    "investigate",
    "health",
    "qa-only",
    "qa",
    "design-review",
    "document-generate",
    "document-release",
    "ship",
    "plan-eng-review",
    "plan-design-review",
    "autoplan",
    "office-hours",
    "plan-ceo-review",
    "plan-devex-review",
    "spec",
    "design-consultation",
    "design-html",
)

BROWSER_BINARY = "browse/dist/browse"
BROWSER_ENTRY = "browse/src/server.ts"
#: Where the walk from the browser's server follows a reference.
BROWSER_FOLLOW = ("browse/src/", "lib/")
EXCLUDED_PACKAGES = ("@ngrok/ngrok",)
EXCLUDED_PLATFORM = "linuxmusl"

HEADER = (
    "# gstack {version}: the files {image} ships under /opt/swarm/plugins/gstack.\n"
    "# Generated by images/agent-runtime-base/gstack-layers derive; the image build\n"
    "# fails when its own closure differs (gstack-layers check). One path per line.\n"
)


def load_measure(path: Path):
    """scripts/gstack_packaging_measure.py, imported from where the build mounts it."""
    spec = importlib.util.spec_from_file_location("gstack_packaging_measure", path)
    if spec is None or spec.loader is None:
        raise SystemExit(f"gstack-layers: cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def base_files(measure, root: Path, skills=CATALOGUE_SKILLS) -> list[str]:
    root = root.resolve()
    closure = measure.skill_closure(root, list(skills))
    missing = sorted(s for s, v in closure["skills"].items() if v.get("status") != "ok")
    if missing:
        raise SystemExit(f"gstack-layers: the install has no SKILL.md for: {', '.join(missing)}")
    return [rel for rel in closure["union"]["file_list"] if not measure._is_elf(root / rel)]


def browser_files(measure, root: Path, base: list[str]) -> list[str]:
    root = root.resolve()
    for rel in (BROWSER_BINARY, BROWSER_ENTRY):
        if not (root / rel).is_file():
            raise SystemExit(f"gstack-layers: the install has no {rel}")
    pending = [root / BROWSER_ENTRY]
    seen: set[Path] = set()
    packages: set[str] = set()
    while pending:
        current = pending.pop()
        if current in seen:
            continue
        seen.add(current)
        text = measure._read_text(current)
        if text is None:
            continue
        found, names = measure.references(root, current, text)
        packages |= names
        pending.extend(
            p for p in found if p not in seen and str(p.relative_to(root)).startswith(BROWSER_FOLLOW)
        )
    packages -= set(EXCLUDED_PACKAGES)
    closure = measure.package_closure(root, packages)["packages"]
    files = {str(p.relative_to(root)) for p in seen} | {BROWSER_BINARY}
    modules = root / "node_modules"
    for name in closure:
        if EXCLUDED_PLATFORM in name:
            continue
        for path in measure._walk(modules / name, set()):
            if path.is_file() and not path.is_symlink():
                files.add(str(path.relative_to(root)))
    return sorted(files - set(base))


def read_list(path: Path) -> list[str]:
    return [
        line.strip()
        for line in path.read_text(encoding="utf-8").splitlines()
        if line.strip() and not line.startswith("#")
    ]


def write_list(path: Path, files: list[str], *, version: str, image: str) -> None:
    path.write_text(HEADER.format(version=version, image=image) + "".join(f"{f}\n" for f in files), encoding="utf-8")


def _version(root: Path) -> str:
    version = root / "VERSION"
    return version.read_text(encoding="utf-8").strip() if version.is_file() else "(no VERSION)"


def _differences(name: str, want: list[str], got: list[str]) -> list[str]:
    out = [f"{name}: in the install's closure, not in the checked-in list: {f}" for f in sorted(set(got) - set(want))]
    out += [f"{name}: in the checked-in list, not in the install's closure: {f}" for f in sorted(set(want) - set(got))]
    return out


def check(measure, root: Path, base_list: Path, browser_list: Path) -> list[str]:
    """Every difference between the derived lists and the checked-in ones (empty: equal)."""
    base = base_files(measure, root)
    browser = browser_files(measure, root, base)
    return _differences(str(base_list), read_list(base_list), base) + _differences(
        str(browser_list), read_list(browser_list), browser
    )


def _refuse(rel: str) -> str | None:
    parts = Path(rel).parts
    if not rel or rel.startswith("/") or ".." in parts:
        return "is not a path inside the install"
    if ".git" in parts:
        return "names .git"
    return None


def stage(root: Path, files: list[str], out: Path) -> int:
    """Copy `files` from `root` into `out` with the image's modes; the count copied."""
    for rel in files:
        why = _refuse(rel)
        source = root / rel
        if why is None and (source.is_symlink() or not source.is_file()):
            why = "is missing or not a regular file"
        if why is not None:
            raise SystemExit(f"gstack-layers: {rel} {why}")
    out.mkdir(parents=True, exist_ok=True)
    os.chmod(out, 0o755)
    for rel in files:
        target = out / rel
        for parent in reversed(target.relative_to(out).parents[:-1]):
            folder = out / parent
            folder.mkdir(exist_ok=True)
            os.chmod(folder, 0o755)
        shutil.copyfile(root / rel, target)
        os.chmod(target, 0o755 if os.stat(root / rel).st_mode & 0o100 else 0o644)
    return len(files)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    parser.add_argument("command", choices=("check", "derive", "stage"))
    parser.add_argument("--measure", type=Path, required=True, help="scripts/gstack_packaging_measure.py")
    parser.add_argument("--install", type=Path, required=True, help="gstack after ./setup")
    parser.add_argument("--base-list", type=Path, required=True)
    parser.add_argument("--browser-list", type=Path)
    parser.add_argument("--list", choices=("base", "browser"), help="stage: which list")
    parser.add_argument("--out", type=Path, help="stage: the folder to copy into")
    args = parser.parse_args(argv)
    measure = load_measure(args.measure)
    if args.command == "stage":
        if args.list is None or args.out is None or (args.list == "browser" and args.browser_list is None):
            parser.error("stage needs --list, --out and that list's file")
        listed = read_list(args.base_list if args.list == "base" else args.browser_list)
        print(f"gstack-layers: staged {stage(args.install, listed, args.out)} files of the {args.list} list")
        return 0
    if args.browser_list is None:
        parser.error(f"{args.command} needs --browser-list")
    if args.command == "derive":
        base = base_files(measure, args.install)
        browser = browser_files(measure, args.install, base)
        version = _version(args.install)
        write_list(args.base_list, base, version=version, image="agent-runtime-base")
        write_list(args.browser_list, browser, version=version, image="agent-runtime-browser (over the base)")
        print(f"gstack-layers: {len(base)} base files, {len(browser)} browser files")
        return 0
    differences = check(measure, args.install, args.base_list, args.browser_list)
    for line in differences:
        print(line, file=sys.stderr)
    if differences:
        print(f"gstack-layers: {len(differences)} differences; regenerate with `gstack-layers derive`", file=sys.stderr)
        return 1
    print(f"gstack-layers: both lists equal the closure of gstack {_version(args.install)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
