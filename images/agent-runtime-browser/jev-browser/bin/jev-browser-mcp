#!/usr/bin/env bash
# `jev-browser-mcp` on claude-code-browser: the pinned jev-browser MCP server,
# attached to the live browser and nothing else (JEV-IMAGE, owner decision
# 2026-10-14, part of #1030). Installed at /opt/swarm/jev-browser/bin/, off PATH;
# the claude-code runner registers it as an MCP server (JEV-RUNNER).
#
# Upstream jev-browser 0.2.0 only ever launches a browser of its own. The
# image's copy is patched (jev-browser/patches/jev-browser+0.2.0.patch) to
# attach over CDP to JEV_BROWSER_CDP_ENDPOINT -- the browser's EXISTING default
# context, no new context, no viewport, no device emulation, the WebMCP init
# script left out, and close() only disconnecting -- and to refuse every
# launch and every Chromium download. This wrapper is what makes the endpoint
# the live browser's:
#
#   * it refuses to start without SWARM_CDP_ENDPOINT (only the live browser
#     sets it), so the server never runs in a state where its first tool call
#     would fail far from the cause;
#   * JEV_BROWSER_CDP_ENDPOINT is always SWARM_CDP_ENDPOINT -- the gate's CDP
#     proxy, whose method policy (livegate/cdppolicy.py) applies to every
#     command -- never a value the caller brought;
#   * JEV_BROWSER_PROFILE and JEV_BROWSER_HEADED, which would ask for a
#     launched browser, are dropped, and JEV_BROWSER_NO_INSTALL=1 and
#     PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 are set besides the patch's refusal;
#   * JEV_API_URL and JEV_MODEL are dropped, so page text and labels go only
#     to TypeSafe's own API (api.typesafe.ai), the one destination the owner
#     accepted on 2026-10-14. TYPESAFE_API_KEY is passed through untouched and
#     never printed.
#   * JEV_API_COMPAT is passed through (JUDGE-ADAPT): `internal` makes the
#     patched jev() reshape each request for Saga's internal decision API and
#     send a placeholder key instead of TYPESAFE_API_KEY. Whoever points
#     JEV_API_URL at an internal backend (JUDGE-SELECT) must set it too. While
#     this wrapper still drops JEV_API_URL, `internal` would aim at TypeSafe,
#     and the patched jev() refuses that rather than sending it.
#
# This is guidance, not a sandbox: the agent can run node on the package by
# its path, and the pod and the gate are the boundary
# (docs/design/live-browser.md §3.2).
set -euo pipefail

NODE="/usr/local/bin/node"
SERVER="/opt/swarm/jev-browser/node_modules/jev-browser/bin/jev-browser-mcp.mjs"

endpoint="${SWARM_CDP_ENDPOINT:-}"
if [[ -z "${endpoint}" ]]; then
  cat >&2 <<'MSG'
jev-browser-mcp: refused: SWARM_CDP_ENDPOINT is not set, so there is no live browser to attach to.
jev-browser here drives only the live browser the person watches, at $SWARM_CDP_ENDPOINT; it never
launches a browser of its own. Only claude-code-browser with the live browser sets that endpoint.
MSG
  exit 2
fi

unset JEV_BROWSER_PROFILE JEV_BROWSER_HEADED JEV_API_URL JEV_MODEL
# The client tag (BSTATUS-API; agent_worker/browser_tools.py `tag_endpoint`):
# the gate attributes this connection to jev and strips the tag before
# anything reaches Chromium. Only a bare http origin is tagged.
if [[ "${endpoint}" =~ ^https?://[^/?#]+/?$ ]]; then
  endpoint="${endpoint%/}/client/jev"
fi
export JEV_BROWSER_CDP_ENDPOINT="${endpoint}"
export JEV_BROWSER_NO_INSTALL=1
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

exec "${NODE}" "${SERVER}" "$@"
