# The owner's bootstrap root: an example with placeholders
# (docs/design/generic-repository.md section 3.1). A deployment's real
# terraform.tfvars is private: it lives under the state bucket's config/
# prefix, never in this repository.
#
#   terraform -chdir=terraform/bootstrap init -backend-config=...
#   terraform -chdir=terraform/bootstrap plan -var-file=<the private tfvars>

project_id = "example-project"
region     = "us-central1"
location   = "US-CENTRAL1"

# Keyless CI. Leave false until the repository exists and the workflow is ready.
enable_github_wif   = true
github_repository   = "example-org/example-repo"
github_allowed_refs = ["refs/heads/main"]

# The CI fixer's account (ci_fix.tf, docs/ci.md "The CI fixer"): bound to
# .github/workflows/ci-fix.yml on refs/heads/main and to nothing else. It must
# also be in frontend_iap_members as serviceAccount:<email>. Empty binds nothing.
ci_fix_service_account = "swarm-ci-fix@example-project.iam.gserviceaccount.com"

# Who reaches the console through IAP: fully qualified IAM members.
frontend_iap_members = [
  "group:eng@example.com",
  "serviceAccount:swarm-ci-fix@example-project.iam.gserviceaccount.com",
  # The console QA identity (qa_identity.tf's qa_account_id in this project).
  "serviceAccount:qa-console@example-project.iam.gserviceaccount.com",
]
frontend_iap_backends = ["swarm-ui-backend"]

# swarmGithubHooksDedup (github_hooks_role.tf) joins the deployer's grantable
# roles only while this is on; it defaults to false. Committed here as applied:
# a -var not recorded here reads as false on the next plan and destroys the role.
enable_github_hooks_dedup_role = true

# Workspace secrets (docs/design/secrets-store.md): the bootstrap side of the
# per-workspace secret store.
enable_workspace_secrets = true
