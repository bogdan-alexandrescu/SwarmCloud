# Production environment: an example with placeholders
# (docs/design/generic-repository.md section 3.1). A deployment's real
# prod.tfvars is private: it lives under the state bucket's config/prod/
# prefix, never in this repository.
#
#   terraform -chdir=terraform/infra init \
#     -backend-config="bucket=swarm-tfstate-example-project" \
#     -backend-config="prefix=infra/prod"
#   terraform -chdir=terraform/infra plan -var-file=<the private prod.tfvars>
#
# deletion_protection is true and MUST stay true: terraform/infra/variables.tf
# refuses a prod plan with it off unless allow_unprotected_prod is also set.

project_id  = "example-project"
region      = "us-central1"
environment = "prod"

deletion_protection    = true
allow_unprotected_prod = false
bucket_force_destroy   = false

extra_labels = {
  "swarm-owner" = "platform"
  "swarm-tier"  = "production"
}

# --- network ---------------------------------------------------------------
subnet_cidr         = "10.60.0.0/20"
pods_cidr           = "10.64.0.0/14"
services_cidr       = "10.68.0.0/20"
gke_master_cidr     = "172.16.48.0/28"
nat_static_ip_count = 2
restrict_egress     = false

# --- GKE Autopilot ---------------------------------------------------------
enable_gke_autopilot        = true
gke_release_channel         = "STABLE"
gke_enable_private_endpoint = false
gke_master_authorized_cidrs = []

# Voice it's own speech engine (terraform/infra/voice_speech.tf): off in prod.
voice_speech = {
  enabled = false
}

# --- data ------------------------------------------------------------------
firestore_database      = "swarm"
artifact_retention_days = 180
immutable_image_tags    = true

# --- capacity --------------------------------------------------------------
pool_limits = {
  global          = 100
  default_tenant  = 20
  provider_tenant = 10
  resource_classes = {
    standard = 100
    browser  = 20
    large    = 8
  }
  runner_profiles = {
    mock        = 10
    generic     = 40
    claude-code = 60
    codex       = 40
    browser     = 20
  }
  backends = {
    CLOUD_RUN_JOB = 100
    GKE_AUTOPILOT = 20
  }
  providers = {
    anthropic = 60
    openai    = 40
  }
}


# --- identity --------------------------------------------------------------
allowed_domains = ["example.com"]

tenants = {
  eng = {
    kind           = "group"
    principal      = "eng@example.com"
    display_name   = "Engineering"
    providers      = ["anthropic", "openai"]
    max_active     = 40
    capacity_units = 80
  }
}

api_invokers         = ["group:eng@example.com"]
secret_admin_members = ["group:swarm-admins@example.com"]

# The shared project's other-team resources nothing may touch (rendered on
# swarm-api as SWARM_SHARED_DENY_LIST). A project that shares nothing: [].
shared_deny_list = ["peer-cluster", "peer-vpc", "peer-subnet", "peer-bucket", "peer-runner@example-shared-project.iam.gserviceaccount.com"]

# --- operations ------------------------------------------------------------
create_alerts       = true
alert_emails        = ["swarm-alerts@example.com"]
spec_signature_mode = "enforce"

# The release acceptance job's fixture tenant and its accounts
# (terraform/infra/acceptance.tf). The QA case stays skipped here: prod sets no
# acceptance_qa_tenant or acceptance_console_url.
enable_acceptance_fixture = true
